#!/usr/bin/env node
// The coordinator's controller: compares the observed state with the
// desired one and prints what to do about the difference. See --help;
// the rules are in lib/reconcile.js. Node's standard library only, plus
// bot-board, bot-heartbeat, bot-capacity and gh (through
// bot-priority-health's REST helpers, with their ETag cache).
"use strict";

const { execFile } = require("node:child_process");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { promisify } = require("node:util");

const execFileP = promisify(execFile);

const PROG = path.basename(process.argv[1] || "bot-reconcile");
const BIN_DIR = path.dirname(fs.realpathSync(process.argv[1] || __filename));
const ROOT = path.join(BIN_DIR, "..");
const rec = require(path.join(ROOT, "lib", "reconcile.js"));
const cap = require(path.join(ROOT, "lib", "capacity.js"));
const pace = require(path.join(ROOT, "lib", "pacing.js"));
const operator = require(path.join(ROOT, "lib", "operator.js"));
const disp = require(path.join(ROOT, "lib", "dispatch.js"));
const ms = require(path.join(ROOT, "lib", "midstream.js"));

const tool = (name) => process.env[`BOT_RECONCILE_${name.replace(/^bot-/, "").toUpperCase()}`] || path.join(BIN_DIR, name);
const STATE_HOME = process.env.XDG_STATE_HOME || path.join(os.homedir(), ".local", "state");
const SWEEP_DIR = path.join(STATE_HOME, "bot-sweep");
// bot-watch's last-seen state of the coordinator's sweep.
const WATCH_STATE = path.join(STATE_HOME, "bot-watch", "watch.json");
const ACTIVITY_FILE = path.join(process.env.BOT_OPERATOR_ACTIVITY_STATE || path.join(STATE_HOME, "bot-operator-activity"), "repos.json");
const POLICY_DIR = process.env.UPSTREAM_POLICY_DIR || path.join(ROOT, "upstream-policy");
const TOPIC_SKILL = path.join(ROOT, "dotfiles", ".agents", "skills", "topic-lead", "SKILL.md");
const STATE_VERSION = 1;
// The inputs each rule reads; only those of the rules run are read.
// prs follows from the sweep, and children from the board.
const RULE_INPUTS = {
  capacity: ["items", "capacity", "activity", "children"],
  dispatch: ["items", "capacity", "activity", "children"],
  escalate: ["items"],
  heartbeat: ["items", "heartbeat", "children"],
  "lead-orphan": ["items", "heartbeat", "children"],
  drive: ["sweep", "prs", "items", "epicItems"],
  "patch-ready": ["items"],
  "answer-unapplied": ["questions"],
  "closed-not-done": ["items", "contentStates"],
  "stale-lead": ["items"],
  midstream: ["midstreams"],
};
const MAX_BUFFER = 256 << 20;
const GH = process.env.BOT_RECONCILE_GH || "gh";
const EX_ERROR = 1;
const EX_USAGE = 2;
// bot-runs' exit status for an exhausted GitHub quota (EX_TEMPFAIL).
const EX_RATELIMIT = 75;

function usage() {
  const rules = Object.keys(rec.RULES).join(", ");
  return `Usage: ${PROG} [--json] [--apply] [--state FILE [--resync MIN]] [--rule NAME]...
       [--board-file F] [--epic-board-file F] [--sweep-dir D] [--prs-file F]
       [--heartbeat-file F] [--children-file F] [--capacity-file F]
       [--questions-file F] [--midstreams-file F] [--activity-file F] [--issues-file F] [--watch-state F]
       [--now TIME]

Reconciles like a Kubernetes controller: reads the observed state, compares
it with the desired one, and prints the actions that would close the gap,
each with a stable key, a kind, the item's URL and what to do. It changes
nothing itself, except with --apply (see closed-not-done, stale-lead, midstream and dispatch). Run it on each
wake, do the actions, then run it again to confirm they converged
("Actions: none").

Observed: the board (bot-board list) and the P0 epic's, the sub-issues of
the coordinator's In Progress issues, the latest complete bot-sweep run
(${SWEEP_DIR.replace(os.homedir(), "~")}) and the PRs of its P0 health lines (their
author, and when ${operator.loadOrExit(PROG).operator.login}'s review was requested), the heartbeat
(bot-heartbeat show), the week's capacity (bot-capacity --json), and the
question issues of ${operator.loadOrExit(PROG).tracker_repo} answered in the last ${rec.ANSWER_WINDOW_MS / 3600e3}h, and
bot-watch's last-seen state of the board's issues and PRs
(${WATCH_STATE.replace(os.homedir(), "~")}). Only the inputs of the rules run are read.

Rules (${rules}):
  capacity          pacing.agents work agents busy (In Progress with a Lead
                    or Run), pacing.harness_agents of them on the harness,
                    the rest upstream; a lane under its target gets the top
                    Todo candidates (by priority, spread over repositories,
                    toward the operator's recent activity; not topic
                    sessions', asks, manual items, or bot text for a
                    human-text repository; an umbrella, see lead-orphan,
                    isn't busy), but only while the total is under its
                    target: a lane short while the other runs over is only
                    noted in the Observed line. The targets shrink with the
                    week's capacity: half, P0 only, at bot-capacity's P0-only
                    mark; none once it is used up. A busy task whose Actual
                    tokens passed its Budget tokens is a 'budget' action.
  dispatch          auto-dispatch: a lane with a free slot, while the remote
                    runs are under their share of the agents (pacing.opencode_share,
                    1 in 4 by default: agent.yml runs only opencode),
                    gets its top Todo issue labeled '${disp.DISPATCH_LABEL}' (the opt-in, on
                    issues in the bot's own repositories) as one
                    'bot-runs dispatch'. The target is its repository, else a
                    'Repo: OWNER/REPO' line in the issue body (and an optional
                    'Base: REF'). --apply builds the brief from the issue: its
                    title, body, the operator's comments and its acceptance
                    criteria (text of the operator's or the bot's issues only),
                    removes the label (one dispatch per label: a run that fails
                    returns the item to Todo, unlabeled), then dispatches. A failure
                    leaves 'auto-dispatch failed: ...' in the item's Why, which
                    keeps the rule off it. A labeled item that can't be dispatched
                    is a dispatch-failed action.
  escalate          an open issue labeled '${disp.ESCALATE_LABEL}', which the dispatcher filed
                    for the coordinator's judgment (see the dispatcher skill):
                    read it, decide or ask the operator, answer on it, close it.
  heartbeat         the heartbeat is fresh (${rec.HEARTBEAT_MAX_AGE_MS / 60e3} min, or until its next
                    wake) and lists a worker for each busy item
                    (bot-poll-loop drops the workers of Done items
                    itself, with bot-heartbeat prune).
  lead-orphan       each of the coordinator's busy items (Lead not a topic
                    of the topic-lead skill) has a worker in the heartbeat,
                    each worker a busy item; In Progress items with neither
                    Lead nor Run are nobody's. An umbrella item (an epic)
                    needs no worker: it is busy through an open sub-issue
                    whose item is ${rec.CHILD_BUSY_STATUSES.join(", ")}.
  drive             the latest sweep's P0 drive blockers that need the
                    coordinator, its P0 health lines, and approved fork
                    PRs its promotions didn't take, carried over as they are.
                    A health line is left out while its PR waits on a human
                    with an ask under ${rec.ASK_MAX_AGE_MS / 864e5} days old: the operator's review
                    requested, or, on someone else's PR, a dated "waits on
                    the author" note in a board item's Why or Next (on the
                    bot's own PR, only for staleness); an older ask fires as
                    a nudge. When the sweep's P0 drive or priority health
                    step failed (bot-watch warned that its section is
                    incomplete), the previous run's actions of that kind
                    (from --state) are carried over as still open, and the
                    Observed line says so.
  patch-ready       a Draft item whose Why says a devspace run's patch is ready
                    for bot-runs apply (bot-runs reconcile sets that): apply
                    it with a local Opus worker (apply-preamble.md in the
                    coordinator skill), which reviews it and opens or updates
                    the PR, and never merges it. Reported only, as waiting for
                    the operator, while APPLY_UNATTENDED in lib/reconcile.js
                    is false.
  answer-unapplied  a question the operator answered whose Unblocks items
                    are still open and untouched since the answer.
  closed-not-done   an item whose own issue or PR is closed or merged is
                    Done, once none of its Branch PRs is open (or unknown).
                    A PR closed unmerged needs a human: listed, but not
                    carried out, and not at all when its item is Needs
                    human (bot-watch's question to the operator). --apply
                    carries it out: 'bot-board set ITEM --status Done
                    --news ...' for each; bot-watch --apply runs it.
  stale-lead        an item that isn't In Progress has no Lead coordinator
                    (a worker's claim, which ends there; a topic's Lead
                    stays). --apply clears it ('bot-board set ITEM --field
                    Lead ""'); bot-watch --apply runs it.
  midstream         the forge's midstreams (repositories with the ${ms.MIDSTREAM_TOPIC}
                    topic, or forks with neither it nor ${ms.FORK_TOPIC}; see bot-pr
                    fork-setup) stay mirrors of upstream whose PRs never
                    merge: an open PR into the default branch that isn't a
                    draft is converted back to one with a comment saying
                    why (--apply carries that out), and a main ahead of
                    upstream's is a drift action, for the coordinator to fix
                    by saving the extra commits to saved/main-DATE and
                    resetting it.

With --state FILE it remembers the actions across runs, and marks with '*'
(--json: "fired") the ones that are new, or still there ${rec.RESYNC_MS / 3600e3}h (--resync) after
they last fired; an action that is gone is forgotten. An input that can't
be read is listed as such, its rules' earlier actions are kept as they
were, and the exit status is 1.

The --*-file options read an input from a file instead (tests); --now
sets the time.
`;
}

class Exit extends Error {
  constructor(status, message) {
    super(message);
    this.status = status;
  }
}

function parseArgs(argv) {
  const opts = { json: false, apply: false, rules: [], resync: rec.RESYNC_MS };
  const values = ["state", "resync", "rule", "board-file", "epic-board-file", "sweep-dir", "prs-file", "heartbeat-file", "children-file", "capacity-file",
    "questions-file", "midstreams-file", "activity-file", "issues-file", "watch-state", "now"];
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    if (a === "-h" || a === "--help") throw new Exit(0, null);
    if (a === "--json" || a === "--apply") {
      opts[a.slice(2)] = true;
      continue;
    }
    const name = a.replace(/^--/, "");
    if (!a.startsWith("--") || !values.includes(name)) throw new Exit(EX_USAGE, `unexpected argument '${a}'\n\n${usage()}`);
    if (i + 1 >= argv.length) throw new Exit(EX_USAGE, `${a} needs a value`);
    const v = argv[++i];
    if (name === "rule") {
      if (!(v in rec.RULES)) throw new Exit(EX_USAGE, `unknown rule '${v}'; rules: ${Object.keys(rec.RULES).join(", ")}`);
      opts.rules.push(v);
    } else if (name === "resync") {
      if (!(Number(v) > 0)) throw new Exit(EX_USAGE, `--resync takes minutes, not '${v}'`);
      opts.resync = Number(v) * 60e3;
    } else opts[name] = v;
  }
  if (!opts.rules.length) opts.rules = Object.keys(rec.RULES);
  opts.now = opts.now ? Date.parse(opts.now) : Date.now();
  if (Number.isNaN(opts.now)) throw new Exit(EX_USAGE, "--now: not a time");
  return opts;
}

const readJsonFile = (f) => JSON.parse(fs.readFileSync(f, "utf8"));
const runJson = async (cmd, args) => JSON.parse((await execFileP(cmd, args, { maxBuffer: MAX_BUFFER })).stdout);
const firstLine = (e) => String((e.stderr && e.stderr.trim()) || e.message).split("\n").pop();

// latestSweep(dir): {run, ended_at, watch, inbox} of the last complete
// bot-sweep run.
function latestSweep(dir) {
  const st = readJsonFile(path.join(dir, "status.json"));
  const last = st.last_complete;
  if (!last || !last.run) throw new Error(`no complete sweep in ${dir} yet`);
  const read = (name) => {
    try {
      return fs.readFileSync(path.join(dir, "runs", last.run, `${name}.txt`), "utf8");
    } catch (e) {
      if (e.code === "ENOENT") return "";
      throw e;
    }
  };
  return { run: last.run, ended_at: last.ended_at, watch: read("watch"), inbox: read("inbox") };
}

// questions(config, now): the tracker's question issues updated in the
// window, each with the operator's answer (their first comment) and the
// state of the items it unblocks, for the answers in the window.
async function questions(config, now) {
  const { restGet, pages, pool } = require(path.join(BIN_DIR, "bot-priority-health"));
  // Since the start of the day, so that the listing's ETag holds all day.
  const since = new Date(now - rec.ANSWER_WINDOW_MS);
  since.setUTCHours(0, 0, 0, 0);
  const issues = await pages(`repos/${config.tracker_repo}/issues?labels=question&state=all&since=${since.toISOString()}`);
  const out = await pool(issues.filter((i) => !i.pull_request && i.comments > 0), async (i) => {
    const answer = (await pages(`repos/${config.tracker_repo}/issues/${i.number}/comments`))
      .find((c) => c.user && c.user.login === config.operator.login);
    if (!answer || now - Date.parse(answer.created_at) > rec.ANSWER_WINDOW_MS) return null;
    const urls = rec.unblocks(i.body);
    const unblocks = await pool(urls, async (url) => {
      const m = /^https:\/\/github\.com\/([^/]+\/[^/]+)\/(?:issues|pull)\/(\d+)/.exec(url);
      const it = m && (await restGet(`repos/${m[1]}/issues/${m[2]}`));
      return { url, state: it ? it.state : "gone", updated_at: it ? it.updated_at : null };
    });
    return { url: i.html_url, answer: { at: answer.created_at, url: answer.html_url, text: String(answer.body || "").trim().split("\n")[0] }, unblocks };
  });
  return out.filter(Boolean);
}

// prs(config, sweep): {URL: {author, requested, requested_at}} of the
// PRs of the sweep's P0 health lines: requested is whether the
// operator's review is requested on it, requested_at when it last was.
async function prs(config, sweep) {
  const { restGet, pages, pool, PR_URL_RE } = require(path.join(BIN_DIR, "bot-priority-health"));
  const login = config.operator.login.toLowerCase();
  const urls = [...new Set(rec.healthLines(sweep).map((h) => h.url))];
  const out = await pool(urls, async (url) => {
    const m = PR_URL_RE.exec(url);
    if (!m) return null;
    const repo = `${m[2]}/${m[3]}`;
    const pr = await restGet(`repos/${repo}/pulls/${m[4]}`);
    if (!pr) return null;
    const requested = (pr.requested_reviewers || []).some((u) => u.login.toLowerCase() === login);
    let at = null;
    if (requested) {
      for (const e of await pages(`repos/${repo}/issues/${m[4]}/events`)) {
        if (e.event === "review_requested" && e.requested_reviewer && e.requested_reviewer.login.toLowerCase() === login && !(at >= e.created_at)) at = e.created_at;
      }
    }
    return [url, { author: pr.user && pr.user.login, requested, requested_at: at }];
  });
  return Object.fromEntries(out.filter(Boolean));
}

// children(items, topics): {item URL (normalized): [{url, state}]}, the
// sub-issues of the coordinator's In Progress issues (see
// rec.umbrellaItems).
async function children(items, topics) {
  const { pages, pool } = require(path.join(BIN_DIR, "bot-priority-health"));
  const parents = items.filter((it) => rec.isCoordinatorLed(it, topics) && it.content && it.content.type === "Issue");
  const out = await pool(parents, async (it) => {
    const m = /^https:\/\/github\.com\/([^/]+\/[^/]+)\/issues\/(\d+)$/.exec(it.content.url);
    if (!m) return null;
    const subs = await pages(`repos/${m[1]}/issues/${m[2]}/sub_issues`);
    return [cap.normalizeItem(it.content.url), subs.map((c) => ({ url: c.html_url, state: c.state }))];
  });
  return Object.fromEntries(out.filter(Boolean));
}

// contentStates(file): {URL: state} of bot-watch's last-seen state.
function contentStates(file) {
  const w = readJsonFile(file);
  return Object.fromEntries(Object.entries(w.items || {}).map(([url, v]) => [url, v && v.state]));
}

// observe(opts): the observed state the rules run need, and the inputs
// that couldn't be read.
async function observe(opts) {
  const config = operator.loadOrExit(PROG);
  const errors = [];
  const obs = { now: opts.now, config, activity: {} };
  const needed = new Set(opts.rules.flatMap((r) => RULE_INPUTS[r]));
  const get = async (key, what, fn) => {
    if (!needed.has(key)) return;
    try {
      obs[key] = await fn();
    } catch (e) {
      errors.push(`${what}: ${firstLine(e)}`);
    }
  };
  const fromFile = (opt, fn) => (opts[opt] ? () => readJsonFile(opts[opt]) : fn);
  await Promise.all([
    get("items", "the board", fromFile("board-file", () => runJson(tool("bot-board"), ["list", "--json"]))),
    get("sweep", "the latest sweep", () => latestSweep(opts["sweep-dir"] || SWEEP_DIR)),
    get("heartbeat", "the heartbeat", fromFile("heartbeat-file", () => runJson(tool("bot-heartbeat"), ["show"]))),
    get("capacity", "the week's capacity", fromFile("capacity-file", () => runJson(tool("bot-capacity"), ["--json"]))),
    get("questions", "the answered questions", fromFile("questions-file", () => questions(config, opts.now))),
    get("midstreams", "the midstreams", fromFile("midstreams-file", () => midstreams(config))),
    get("contentStates", "bot-watch's last-seen state", () => contentStates(opts["watch-state"] || WATCH_STATE)),
    get("activity", "the operator's activity", () => pace.readActivity(opts["activity-file"] || ACTIVITY_FILE, opts.now)),
  ]);
  obs.activity = obs.activity || {};
  obs.verdicts = pace.readVerdicts(POLICY_DIR);
  try {
    obs.topics = rec.topics(fs.readFileSync(TOPIC_SKILL, "utf8"));
  } catch (e) {
    errors.push(`the topics (${TOPIC_SKILL}): ${e.message}`);
    obs.topics = [];
  }
  // These follow from the inputs above; without those, they stay unread
  // and the rules act as without them.
  const epic = Object.keys(config.board.epics)[0];
  await Promise.all([
    epic && get("epicItems", `the ${epic} board`, fromFile("epic-board-file", () => runJson(tool("bot-board"), ["--project", epic, "list", "--json"]))),
    obs.sweep && get("prs", "the P0 health PRs", fromFile("prs-file", () => prs(config, obs.sweep))),
    obs.items && get("children", "the sub-issues", fromFile("children-file", () => children(obs.items, obs.topics))),
  ]);
  return { obs, errors };
}

// midstreams(config): [{repo, upstream, ahead, ready_prs}] of the forge's
// midstreams (lib/midstream.js): how many commits the default branch has
// that its upstream's lacks, and the open PRs into it that aren't drafts.
async function midstreams(config) {
  const { restGet, pages, pool } = require(path.join(BIN_DIR, "bot-priority-health"));
  const repos = (await pages(`orgs/${config.forge_org}/repos`)).filter((r) => !r.archived && ms.kind(r, config.forge_org) === "midstream" && r.fork);
  return pool(repos, async (r) => {
    const full = await restGet(`repos/${r.full_name}`);
    const parent = full && full.parent;
    if (!parent) throw new Error(`${r.full_name} is a midstream, but GitHub shows no parent repository`);
    const cmp = await restGet(`repos/${r.full_name}/compare/${parent.owner.login}:${parent.default_branch}...${r.default_branch}?per_page=1`);
    const prs = await pages(`repos/${r.full_name}/pulls?state=open`);
    return { repo: r.full_name, upstream: `${parent.full_name}:${parent.default_branch}`, ahead: cmp ? cmp.ahead_by : 0,
      ready_prs: prs.filter((p) => !p.draft && p.base.ref === r.default_branch).map((p) => ({ url: p.html_url, number: p.number, title: p.title })) };
  });
}

function readState(file) {
  try {
    const s = readJsonFile(file);
    return s && s.version === STATE_VERSION ? s.actions || {} : {};
  } catch (e) {
    if (e.code === "ENOENT") return {};
    throw new Exit(EX_ERROR, `cannot read ${file}: ${e.message}`);
  }
}

function writeState(file, actions, now) {
  fs.mkdirSync(path.dirname(path.resolve(file)), { recursive: true });
  const tmp = `${file}.tmp.${process.pid}`;
  fs.writeFileSync(tmp, `${JSON.stringify({ version: STATE_VERSION, updated_at: new Date(now).toISOString(), actions })}\n`);
  fs.renameSync(tmp, file);
}

// readIssue(url, opts): {author, body, state, comments: [{author, at, body}]}
// of the issue a dispatch action is for, from --issues-file ({URL: issue},
// tests) or GitHub's REST API.
async function readIssue(url, opts) {
  if (opts["issues-file"]) {
    const it = readJsonFile(opts["issues-file"])[url];
    if (!it) throw new Error(`${url} is not in ${opts["issues-file"]}`);
    return it;
  }
  const m = /^https:\/\/github\.com\/([^/]+\/[^/]+)\/issues\/(\d+)$/.exec(url);
  if (!m) throw new Error(`${url} is not an issue URL`);
  const { restGet, pages } = require(path.join(BIN_DIR, "bot-priority-health"));
  const issue = await restGet(`repos/${m[1]}/issues/${m[2]}`);
  if (!issue) throw new Error(`${url} does not exist`);
  const comments = await pages(`repos/${m[1]}/issues/${m[2]}/comments`);
  return { author: issue.user && issue.user.login, body: issue.body || "", state: issue.state,
    comments: comments.map((c) => ({ author: c.user && c.user.login, at: c.created_at, body: c.body })) };
}

// setDispatchLabel(url, on): adds or removes the dispatch label of an issue.
async function setDispatchLabel(url, on) {
  const repoIssue = /^https:\/\/github\.com\/([^/]+\/[^/]+)\/issues\/(\d+)$/.exec(url);
  const base = `repos/${repoIssue[1]}/issues/${repoIssue[2]}/labels`;
  const args = on ? ["api", "-X", "POST", base, "-f", `labels[]=${disp.DISPATCH_LABEL}`] : ["api", "-X", "DELETE", `${base}/${disp.DISPATCH_LABEL}`];
  await execFileP(GH, args, { maxBuffer: MAX_BUFFER });
}

// The text bot-runs dispatch prints once the run exists: any failure after
// it leaves the run running, so the dispatch must not be tried again.
const STARTED_RE = /^Dispatched run \d+:/m;
const NOT_FOUND_RE = /HTTP 404|Not Found/;

// dispatchOne(a, opts, config): carries out a dispatch action: checks the
// issue is still open and the operator's or the bot's, takes the target from
// its live text, consumes its label (so that a run that fails and returns
// the item to Todo isn't dispatched again unlabeled; a label already gone
// means another run of this took it), and runs bot-runs dispatch with the
// brief built from the issue. Throws Error with the reason; err.deferred
// when only a rate limit stopped it before any run started (the label is
// back), err.skipped when someone else took the label.
async function dispatchOne(a, opts, config) {
  const d = a.dispatch;
  const issue = await readIssue(d.url, opts);
  if (issue.state && issue.state !== "open") throw new Error("the issue is closed");
  if (!disp.trusted(issue, config)) throw new Error(`the issue was written by ${issue.author}, neither the operator nor the bot, so its text can't brief a run unread`);
  const live = disp.target({ content: { body: issue.body } }, d.from_body ? null : d.repo);
  if (!live.repo) throw new Error("the issue no longer names a target repository: its Repo: line is gone");
  const brief = disp.buildBrief({ item: { title: d.title, content: { url: d.url } }, repo: live.repo, base: live.base, issue, comments: issue.comments, config });
  try {
    await setDispatchLabel(d.url, false);
  } catch (e) {
    if (!NOT_FOUND_RE.test(`${e.stderr}${e.message}`)) throw new Error(`removing the ${disp.DISPATCH_LABEL} label: ${firstLine(e)}`);
    const err = new Error(`the ${disp.DISPATCH_LABEL} label was already gone: someone else took it`);
    err.skipped = true;
    throw err;
  }
  const p = execFileP(tool("bot-runs"), ["dispatch", "--item", d.id, "--repo", live.repo, "--base", live.base, "-"], { maxBuffer: MAX_BUFFER });
  p.child.stdin.end(brief);
  try {
    await p;
  } catch (e) {
    if (STARTED_RE.test(e.stdout || "")) throw new Error(`the run started, but bot-runs failed after: ${firstLine(e)}`);
    if (e.code !== EX_RATELIMIT) throw new Error(firstLine(e));
    await setDispatchLabel(d.url, true);
    const err = new Error(`GitHub's rate limit: ${firstLine(e)}`);
    err.deferred = true;
    throw err;
  }
}

// What a PR converted back to a draft is told.
const MIDSTREAM_DRAFT_COMMENT = `Converted back to a draft: this repository is a midstream (topic ${ms.MIDSTREAM_TOPIC}), whose main mirrors upstream and only moves by fast-forward sync, so its PRs are review vehicles and are never merged.\n\nGenerated-by: https://github.com/cgwalters/#llms`;

// apply(actions, errors, opts, config): carries out the actions that have an
// `apply` (a board change), a `draft` (a PR to convert) or a `dispatch`, recording the result in each. A
// failed dispatch leaves its reason in the item's Why, so that the rule
// leaves the item alone until someone looks.
async function apply(actions, errors, opts, config) {
  for (const a of actions.filter((x) => x.apply)) {
    try {
      await execFileP(tool("bot-board"), ["set", a.apply.id, ...a.apply.set], { maxBuffer: MAX_BUFFER });
      a.applied = "done";
    } catch (e) {
      a.applied = `failed: ${firstLine(e)}`;
      errors.push(`applying ${a.key}: ${firstLine(e)}`);
    }
  }
  for (const a of actions.filter((x) => x.draft)) {
    try {
      await execFileP(GH, ["pr", "ready", String(a.draft.number), "--repo", a.draft.repo, "--undo"], { maxBuffer: MAX_BUFFER });
      a.applied = "done";
    } catch (e) {
      a.applied = `failed: ${firstLine(e)}`;
      errors.push(`applying ${a.key}: ${firstLine(e)}`);
      continue;
    }
    try {
      await execFileP(GH, ["pr", "comment", String(a.draft.number), "--repo", a.draft.repo, "--body", MIDSTREAM_DRAFT_COMMENT], { maxBuffer: MAX_BUFFER });
    } catch (e) {
      errors.push(`commenting on ${a.url}: ${firstLine(e)}`);
    }
  }
  for (const a of actions.filter((x) => x.dispatch)) {
    try {
      await dispatchOne(a, opts, config);
      a.applied = "dispatched";
    } catch (e) {
      a.applied = e.deferred ? `deferred: ${e.message}` : e.skipped ? `skipped: ${e.message}` : `failed: ${e.message}`;
      if (e.deferred || e.skipped) continue;
      errors.push(`applying ${a.key}: ${e.message}`);
      try {
        await execFileP(tool("bot-board"), ["set", a.dispatch.id, "--why", disp.failure(e.message)], { maxBuffer: MAX_BUFFER });
      } catch (e2) {
        errors.push(`recording that ${a.key} failed: ${firstLine(e2)}`);
      }
    }
  }
}

async function main(argv) {
  const opts = parseArgs(argv);
  const { obs, errors } = await observe(opts);
  const previous = opts.state ? readState(opts.state) : {};
  obs.previous = Object.keys(previous);
  let actions = rec.reconcile(obs, opts.rules).map((a) => ({ ...a, fired: null }));
  if (opts.apply) await apply(actions, errors, opts, obs.config);
  if (opts.state) {
    const r = rec.edge(previous, actions, opts.now, opts.resync, rec.unreadKinds(obs, opts.rules));
    actions = r.actions;
    writeState(opts.state, r.state, opts.now);
  }
  const o = rec.observed(obs);
  if (opts.json) process.stdout.write(`${JSON.stringify({ observed: o, errors, actions, fired: actions.filter((a) => a.fired).length }, null, 2)}\n`);
  else process.stdout.write(rec.render(o, actions, errors));
  return errors.length ? EX_ERROR : 0;
}

main(process.argv.slice(2)).then((code) => process.exit(code), (e) => {
  if (e instanceof Exit) {
    if (e.status === 0) process.stdout.write(usage());
    else process.stderr.write(`${PROG}: ${e.message}\n`);
    process.exit(e.status);
  }
  process.stderr.write(`${PROG}: error: ${e.stack || e.message}\n`);
  process.exit(EX_ERROR);
});
