#!/usr/bin/env node
// Contribution policy records for upstream repositories, and the gate
// that 'bot-pr promote' and 'bot-pr signoff' run before anything of the
// bot's goes upstream; see --help. Node's standard library only, and
// 'gh api' for GitHub, like the bash tools next to it.
"use strict";

const { execFileSync } = require("node:child_process");
const crypto = require("node:crypto");
const fs = require("node:fs");
const path = require("node:path");

const PROG = path.basename(process.argv[1]);
// The records live in homegit's upstream-policy/OWNER/REPO.md, next to
// this script's bin/ (through the ~/.local/bin symlink). The override is
// only for tests: the gate is the records in homegit.
const POLICY_DIR =
  process.env.UPSTREAM_POLICY_DIR ||
  path.join(path.dirname(fs.realpathSync(process.argv[1])), "..", "upstream-policy");
// A record counts only as pushed: it must be what this remote's branch
// has, and GitHub vouches for whoever loosened a verdict there.
const REMOTE = "origin";
const REMOTE_BRANCH = "main";
const HOMEGIT_REPO = "cgwalters-bot/homegit";
// The only login that may loosen a verdict: in a commit GitHub verified,
// or by approving the pull request that merged it.
const OWNER_LOGIN = "cgwalters";
// Where check remembers the last REMOTE_BRANCH it accepted, per remote.
const STATE_DIR = path.join(
  process.env.XDG_STATE_HOME || path.join(require("node:os").homedir(), ".local", "state"),
  "upstream-policy",
);
// Verdicts from the loosest to the strictest.
const VERDICTS = {
  "bot-ok": "the bot may write the code and the text, with the AI trailer",
  "human-text": "code by the bot is fine, but the PR title and body, commit messages and comments must be cgwalters' own",
  "human-only": "no AI-generated contributions at all",
  "no-go": "the bot does not contribute here",
};
const REQUIRED_KEYS = ["verdict", "ai-trailer", "dco", "sources", "checked"];
const SOURCE_KEYS = ["repo", "path", "sha"];
const SHA_RE = /^[0-9a-f]{40}$/;
// OWNER/REPO, neither of them all dots ('..' would leave the records).
const REPO_RE = /^(?!\.+\/)[A-Za-z0-9_.-]+\/(?!\.+$)[A-Za-z0-9_.-]+$/;
// The directories scanned for policy files, in the repository and in its
// owner's '.github' repository (which holds the org-wide defaults).
const SCAN_DIRS = ["", ".github", "docs", "doc"];
const ORG_REPO = ".github";
// A file or directory in SCAN_DIRS is a policy source if its name, up to
// the first dot, matches this (case-insensitively): contribution guides,
// agent instructions, PR templates, DCO texts, and anything named for AI.
const SOURCE_NAME_RE =
  /^(contributing.*|agents|claude|gemini|copilot-instructions|pull_request_template|dco|developer[-_]certificate[-_]of[-_]origin|(.*[^a-z0-9])?(ai|llms?|genai)([^a-z0-9].*)?)$/i;

// Exit statuses; bot-pr tells EX_HUMAN_TEXT apart, and EX_RATELIMIT is
// EX_TEMPFAIL, as in the bash tools.
const EX_ERROR = 1;
const EX_USAGE = 2;
const EX_MISSING = 3;
const EX_STALE = 4;
const EX_HUMAN_TEXT = 5;
const EX_REFUSED = 6;
const EX_INVALID = 7;
const EX_RATELIMIT = 75;

class Exit extends Error {
  constructor(status, message) {
    super(message);
    this.status = status;
  }
}

function usage() {
  return `Usage: ${PROG} COMMAND OWNER/REPO [OPTIONS]

Contribution policy records for upstream repositories: git and markdown,
in homegit's upstream-policy/OWNER/REPO.md (now ${POLICY_DIR}).
Each record starts with a front matter:

  ---
  verdict: bot-ok | human-text | human-only | no-go
  ai-trailer: the AI trailer or policy (Assisted-by, Generated-by, none, ...)
  dco: yes|no, and how that was detected
  sources:
    - repo: OWNER/REPO (or OWNER/.github, for org-wide files)
      path: CONTRIBUTING.md
      sha: the blob (or tree) id read, on the default branch
  checked: DATE by WHO
  ---

and its body quotes what the verdict rests on, with a one-paragraph
rationale. The verdicts: ${Object.entries(VERDICTS).map(([v, d]) => `${v}: ${d}`).join("; ")}.

Commands:
  check OWNER/REPO [--allow-human-text]
        The promote gate: print the verdict and succeed only if the record
        exists, is committed to git and valid, is current, and its verdict
        is bot-ok (or human-text, with --allow-human-text, for when
        cgwalters wrote the text himself). Current means that every
        source still has its recorded id on the default branch of its
        repository, and that the scan below finds no source missing from
        the record (e.g. a newly added AI policy). Exit status: ${EX_MISSING}
        no record, ${EX_STALE} stale (re-check the policy), ${EX_HUMAN_TEXT} human-text,
        ${EX_REFUSED} human-only or no-go, ${EX_INVALID} an invalid or uncommitted record,
        ${EX_RATELIMIT} rate limited, ${EX_ERROR} any other failure.
  scan OWNER/REPO
        Print the policy sources found on the default branches of
        OWNER/REPO and OWNER/${ORG_REPO}, as the 'sources:' block of a
        record: the files and directories in ${SCAN_DIRS.map((d) => d || "the top").join(", ")}
        named like CONTRIBUTING*, AGENTS, CLAUDE, GEMINI,
        copilot-instructions, PULL_REQUEST_TEMPLATE, DCO, or with AI or
        LLM as a word in their name. A record may list more sources
        (anywhere in those repositories); it must list all of these.

A record counts only when it is committed and is what ${REMOTE}/${REMOTE_BRANCH}
has (check fetches it first), as a regular file (no symlinks). Its
verdict may be no looser than the strictest it held, across deletions
and moves of the record, since ${OWNER_LOGIN} last loosened it (human-text to
bot-ok, say) in a commit GitHub reports as verified and authored by him,
or merged from a pull request whose merged head he approved (his last
review verdict on it): the policy-check subagent creates records and may
tighten them, but only he loosens one, and anyone else's loosening
counts until the verdict is tightened back. ${REMOTE}/${REMOTE_BRANCH} must also
descend from the one the last check accepted (kept in ${STATE_DIR}),
so that rewritten history can't hide a loosening. A renamed
repository's record must move to its new name.

UPSTREAM_POLICY_DIR overrides the records' directory, for tests only.
REST only: a few calls per repository.
`;
}

// gh(args, allow404): the parsed JSON 'gh api ARGS' prints; null for a
// 404 if ALLOW404, which only the optional OWNER/.github repository is:
// anything else missing fails, rather than looking like no policy.
function gh(args, allow404 = false) {
  try {
    const out = execFileSync("gh", ["api", ...args], {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "pipe"],
    });
    return JSON.parse(out);
  } catch (e) {
    const err = String(e.stderr || e.message);
    if (allow404 && /HTTP 404/.test(err)) return null;
    if (/rate limit|abuse/i.test(err)) {
      throw new Exit(EX_RATELIMIT, `GitHub is rate limiting the bot: ${err.trim()}`);
    }
    throw new Exit(EX_ERROR, `'gh api ${args.join(" ")}' failed: ${err.trim()}`);
  }
}

// A repository's default branch, read once per run, with its trees by
// directory. get() returns null only for an OPTIONAL one (OWNER/.github)
// that doesn't exist.
class Repo {
  static cache = new Map();

  static get(name, optional = false) {
    const key = name.toLowerCase();
    if (!Repo.cache.has(key)) {
      const info = gh([`repos/${name}`], optional);
      let repo = null;
      if (info) {
        if (typeof info.full_name !== "string" || !info.default_branch) {
          throw new Exit(EX_ERROR, `GitHub gave no name or default branch for ${name}`);
        }
        // GitHub redirects a renamed repository, and a record under the
        // old name would then vouch for another one's policy.
        if (info.full_name.toLowerCase() !== key) {
          throw new Exit(
            EX_ERROR,
            `${name} was renamed to ${info.full_name}; the record belongs in upstream-policy/${info.full_name}.md`,
          );
        }
        repo = new Repo(info.full_name, info.default_branch);
      }
      Repo.cache.set(key, repo);
    }
    return Repo.cache.get(key);
  }

  constructor(name, branch) {
    this.name = name;
    this.branch = branch;
    this.trees = new Map();
  }

  // entries(dir): the entries of directory DIR ("" for the top) on the
  // default branch, as a Map of name to {sha, type}; empty if it doesn't
  // exist.
  entries(dir) {
    if (!this.trees.has(dir)) {
      let entries = new Map();
      let sha = this.branch;
      if (dir !== "") {
        const parent = this.entries(path.posix.dirname(dir) === "." ? "" : path.posix.dirname(dir));
        const e = parent.get(path.posix.basename(dir));
        sha = e && e.type === "tree" ? e.sha : null;
      }
      if (sha) {
        const tree = gh([`repos/${this.name}/git/trees/${encodeURIComponent(sha)}`]);
        if (!tree || !Array.isArray(tree.tree)) {
          throw new Exit(EX_ERROR, `GitHub gave no tree for ${dir || "the top"} of ${this.name}`);
        }
        if (tree.truncated) throw new Exit(EX_ERROR, `the tree of ${dir || "the top"} in ${this.name} is truncated`);
        entries = new Map(tree.tree.map((e) => [e.path, { sha: e.sha, type: e.type }]));
      }
      this.trees.set(dir, entries);
    }
    return this.trees.get(dir);
  }

  // sha(file): the id of FILE (a blob or a tree) on the default branch,
  // or null.
  sha(file) {
    const clean = file.replace(/\/+$/, "");
    const dir = path.posix.dirname(clean);
    const e = this.entries(dir === "." ? "" : dir).get(path.posix.basename(clean));
    return e ? e.sha : null;
  }
}

// scan(name): the policy sources in NAME and its owner's .github
// repository, as [{repo, path, sha}], sorted.
function scan(name) {
  const repos = [Repo.get(name)];
  const org = `${name.split("/")[0]}/${ORG_REPO}`;
  if (org.toLowerCase() !== name.toLowerCase()) {
    const r = Repo.get(org, true);
    if (r) repos.push(r);
  }
  const found = [];
  for (const repo of repos) {
    for (const dir of SCAN_DIRS) {
      for (const [entry, { sha, type }] of repo.entries(dir)) {
        if (type !== "blob" && type !== "tree") continue;
        if (!SOURCE_NAME_RE.test(entry.replace(/^\./, "").split(".")[0])) continue;
        found.push({ repo: repo.name, path: dir ? `${dir}/${entry}` : entry, sha });
      }
    }
  }
  return found;
}

// parseRecord(text, file): the front matter of a record as an object.
// Only the subset of YAML the records use: 'key: value' lines, and the
// 'sources:' list of 'key: value' mappings (or '[]').
function parseRecord(text, file) {
  const lines = text.split(/\r?\n/);
  const bad = (n, why) => new Exit(EX_INVALID, `${file}:${n + 1}: ${why}`);
  if (lines[0] !== "---") throw bad(0, "a record starts with a '---' front matter line");
  const end = lines.indexOf("---", 1);
  if (end < 0) throw bad(0, "the front matter has no closing '---' line");
  const fields = {};
  let sources = null;
  for (let n = 1; n < end; n++) {
    const line = lines[n];
    if (/^\s*(#.*)?$/.test(line)) continue;
    let m;
    if (sources && (m = line.match(/^\s+(- )?\s*([a-z-]+):\s*(.*)$/))) {
      if (m[1]) sources.push({ line: n });
      const current = sources[sources.length - 1];
      if (!current) throw bad(n, "a source starts with '- '");
      if (!SOURCE_KEYS.includes(m[2])) throw bad(n, `unknown source key '${m[2]}' (expected ${SOURCE_KEYS.join(", ")})`);
      if (m[2] in current) throw bad(n, `the source's '${m[2]}' is set twice`);
      current[m[2]] = unquote(m[3]);
    } else if ((m = line.match(/^([a-z-]+):\s*(.*)$/))) {
      if (m[1] in fields) throw bad(n, `'${m[1]}' is set twice`);
      sources = null;
      if (m[1] === "sources") {
        if (m[2] !== "" && m[2] !== "[]") throw bad(n, "'sources:' is followed by a list, or is '[]'");
        sources = [];
        fields.sources = sources;
      } else {
        fields[m[1]] = unquote(m[2]);
      }
    } else {
      throw bad(n, `cannot parse '${line}'`);
    }
  }
  for (const key of REQUIRED_KEYS) {
    if (!(key in fields) || fields[key] === "") throw bad(0, `the front matter has no '${key}'`);
  }
  if (!(fields.verdict in VERDICTS)) {
    throw bad(0, `unknown verdict '${fields.verdict}' (expected one of ${Object.keys(VERDICTS).join(", ")})`);
  }
  if (!/^(yes|no)\b/.test(fields.dco)) throw bad(0, "'dco' starts with yes or no");
  for (const s of fields.sources) {
    if (!s.path) throw bad(s.line, "a source has no 'path'");
    if (!SHA_RE.test(s.sha || "")) throw bad(s.line, `the source ${s.path} has no 40-hex 'sha'`);
    if (s.repo && !REPO_RE.test(s.repo)) throw bad(s.line, `invalid repo '${s.repo}'`);
  }
  if (!lines.slice(end + 1).some((l) => l.trim() !== "")) throw bad(end, "the record has no body (quotes and rationale)");
  return fields;
}

function unquote(v) {
  const m = v.trim().match(/^(["'])(.*)\1$/);
  return m ? m[2] : v.trim();
}

// The records' checkout is only read (and fetched into): no hooks.
const GIT_ARGS = ["-c", "core.hooksPath=/dev/null"];

// git(dir, args, what): git's output in DIR, or an EX_INVALID failure
// saying it couldn't WHAT.
function git(dir, args, what) {
  try {
    return execFileSync("git", [...GIT_ARGS, "-C", dir, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] }).trim();
  } catch (e) {
    throw new Exit(EX_INVALID, `cannot ${what}: ${String(e.stderr || e.message).trim()}`);
  }
}

// gitMaybe(dir, args): git's output in DIR, or null if it fails.
function gitMaybe(dir, args) {
  try {
    return execFileSync("git", [...GIT_ARGS, "-C", dir, ...args], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] });
  } catch {
    return null;
  }
}

// verdictAt(dir, rev, rel): the verdict in the front matter of REV:REL;
// null if REL doesn't exist there, "" if it has no front matter verdict
// (which ranks as the strictest, see strictness).
function verdictAt(dir, rev, rel) {
  const text = gitMaybe(dir, ["show", `${rev}:${rel}`]);
  if (text === null) return null;
  const lines = text.split(/\r?\n/);
  if (lines[0] !== "---") return "";
  for (const line of lines.slice(1)) {
    if (line === "---") break;
    const m = line.match(/^verdict:[ \t]*(.*)$/);
    if (m) return unquote(m[1]);
  }
  return "";
}

// strictness(verdict): its rank, loosest first; anything unknown ranks as
// the strictest, so that leaving it is a loosening.
function strictness(verdict) {
  const i = Object.keys(VERDICTS).indexOf(verdict);
  return i < 0 ? Infinity : i;
}

// history(top, rel): the verdicts REL had, oldest first, as [{commit,
// verdict}]: one per first-parent commit on the remote branch that added
// or changed a record that is REL under another name, deletions left out.
// Records are the same when their paths differ only in case (the same
// repository) or git's rename detection saw one moved to the other, so
// deleting a record or moving it doesn't make it look new.
function history(top, rel) {
  const dir = rel.split("/")[0];
  const log = git(top, ["log", "-m", "--first-parent", "-M", "--format=@%H", "--name-status", `${REMOTE}/${REMOTE_BRANCH}`, "--", `${dir}/`], "read the records' history");
  const entries = [];
  let commit = null;
  for (const line of log.split("\n")) {
    if (line.startsWith("@")) commit = line.slice(1);
    else if (commit && line.includes("\t")) {
      const [status, ...paths] = line.split("\t");
      entries.push({ commit, status: status[0], paths });
    }
  }
  // Union the names that are one record, keyed by lower case.
  const parent = new Map();
  const find = (k) => {
    while (parent.has(k) && parent.get(k) !== k) k = parent.get(k);
    return k;
  };
  const union = (a, b) => {
    const [ra, rb] = [find(a.toLowerCase()), find(b.toLowerCase())];
    if (ra !== rb) parent.set(ra, rb);
  };
  for (const e of entries) if (e.status === "R" || e.status === "C") union(e.paths[0], e.paths[1]);
  const group = find(rel.toLowerCase());
  return entries
    .reverse()
    .filter((e) => e.status !== "D" && find(e.paths[e.paths.length - 1].toLowerCase()) === group)
    .map((e) => ({ commit: e.commit, verdict: verdictAt(top, e.commit, e.paths[e.paths.length - 1]) }));
}

// vouched(top, commit): whether OWNER_LOGIN vouches for COMMIT of
// homegit, and what GitHub says. Either GitHub reports it as verified and
// authored by him, or it came from a pull request into REMOTE_BRANCH
// whose merged head he approved (see approvedPull).
function vouched(top, commit) {
  const info = gh([`repos/${HOMEGIT_REPO}/commits/${commit}`]);
  const verified = Boolean(info && info.commit && info.commit.verification && info.commit.verification.verified === true);
  const login = (info && info.author && info.author.login) || "unknown";
  if (verified && login === OWNER_LOGIN) return { ok: true, why: `verified: ${verified}, author: ${login}` };
  const pull = approvedPull(top, commit);
  return { ok: pull.ok, why: `verified: ${verified}, author: ${login}; ${pull.why}` };
}

// The review states that are a verdict on a pull request: a later change
// request or a dismissal withdraws an approval.
const REVIEW_VERDICTS = ["APPROVED", "CHANGES_REQUESTED", "DISMISSED"];

// approvedPull(top, commit): whether COMMIT came from a merged pull
// request into REMOTE_BRANCH whose last review verdict by OWNER_LOGIN
// approved the head that was merged, and why not. Main takes changes only
// through pull requests that are rebase-merged, which re-commits them as
// the merger, unsigned, so his approval of that exact head is what
// vouches for them (he can't approve his own pull requests: a loosening
// of his goes through one the bot opens). Rebased onto an up-to-date
// main, the merged tip has the approved head's tree; if it doesn't, more
// was merged than he approved.
function approvedPull(top, commit) {
  const pulls = gh([`repos/${HOMEGIT_REPO}/commits/${commit}/pulls`]);
  const pr = (Array.isArray(pulls) ? pulls : []).find(
    (p) => p && p.merged_at && p.base && p.base.ref === REMOTE_BRANCH && p.base.repo && p.base.repo.full_name === HOMEGIT_REPO,
  );
  if (!pr) return { ok: false, why: "not merged from a pull request" };
  const name = `pull request #${pr.number}`;
  const head = (pr.head && pr.head.sha) || "";
  const tip = pr.merge_commit_sha || "";
  if (!SHA_RE.test(head) || !SHA_RE.test(tip)) return { ok: false, why: `GitHub gave no head or merged commit for ${name}` };
  const reviews = gh([`repos/${HOMEGIT_REPO}/pulls/${pr.number}/reviews?per_page=100`]);
  const his = (Array.isArray(reviews) ? reviews : []).filter(
    (r) => r && r.user && r.user.login === OWNER_LOGIN && REVIEW_VERDICTS.includes(r.state),
  );
  const last = his[his.length - 1];
  if (!last || last.state !== "APPROVED" || last.commit_id !== head) {
    return { ok: false, why: `${name} is not approved by ${OWNER_LOGIN} at its merged head ${head.slice(0, 12)}` };
  }
  const approved = gh([`repos/${HOMEGIT_REPO}/git/commits/${head}`]);
  const merged = gitMaybe(top, ["rev-parse", "--verify", `${tip}^{tree}`]);
  if (!approved || !approved.tree || !merged || merged.trim() !== approved.tree.sha) {
    return { ok: false, why: `${name} merged ${tip.slice(0, 12)}, whose tree is not that of the head ${OWNER_LOGIN} approved` };
  }
  return { ok: true, why: `${name} approved by ${OWNER_LOGIN}` };
}

// checkLoosening(top, rel): REL's verdict may be no looser than the
// strictest one it held since cgwalters last loosened it (or since it was
// created), across deletions and moves (see history). He loosens by
// changing the verdict in a commit he vouches for (see vouched; merely
// touching an already loosened record doesn't vouch for it). Anyone else's loosening doesn't count, but
// tightening the verdict again undoes it. The policy-check subagent
// creates and tightens.
function checkLoosening(top, rel) {
  let baseline = null;
  let previous = null;
  let unvouched = null;
  for (const { commit, verdict } of history(top, rel)) {
    if (baseline === null || strictness(verdict) >= strictness(baseline)) {
      baseline = verdict;
      unvouched = null;
    } else if (verdict !== previous) {
      const v = vouched(top, commit);
      if (v.ok) {
        baseline = verdict;
        unvouched = null;
      } else {
        unvouched = { commit, from: previous, why: v.why };
      }
    }
    previous = verdict;
  }
  if (unvouched) {
    throw new Exit(
      EX_INVALID,
      `${rel}'s verdict went from ${unvouched.from || "none"} to ${previous || "none"} in ${unvouched.commit.slice(0, 12)}, which is not a commit by ${OWNER_LOGIN} that GitHub verified, nor from a pull request he approved (${unvouched.why}), and it is still looser than ${baseline || "none"}; only he loosens a verdict, or set it back`,
    );
  }
}

// checkHistoryKept(top): REMOTE_BRANCH must descend from the one the last
// check accepted, recorded in STATE_DIR: a force-push could otherwise
// rewrite a record's history so that it looks created as it is now.
function checkHistoryKept(top) {
  const upstream = `${REMOTE}/${REMOTE_BRANCH}`;
  const tip = git(top, ["rev-parse", upstream], `read ${upstream}`);
  const url = git(top, ["remote", "get-url", REMOTE], `read ${REMOTE}'s URL`);
  const file = path.join(STATE_DIR, `${crypto.createHash("sha256").update(url).digest("hex").slice(0, 16)}.accepted`);
  let accepted = null;
  try {
    accepted = fs.readFileSync(file, "utf8").trim();
  } catch (e) {
    if (e.code !== "ENOENT") throw new Exit(EX_ERROR, `cannot read ${file}: ${e.message}`);
  }
  if (accepted && gitMaybe(top, ["merge-base", "--is-ancestor", accepted, tip]) === null) {
    throw new Exit(
      EX_INVALID,
      `${upstream} (${tip.slice(0, 12)}) does not descend from ${accepted.slice(0, 12)}, which the last check accepted: its history was rewritten, which could hide how a verdict was loosened. If cgwalters did that on purpose, he removes ${file}`,
    );
  }
  return () => {
    fs.mkdirSync(STATE_DIR, { recursive: true });
    fs.writeFileSync(`${file}.tmp`, `${tip}\n`);
    fs.renameSync(`${file}.tmp`, file);
  };
}

// readRecord(name): the path and parsed record of NAME. Git is the source
// of truth: the record must be committed, and be what REMOTE's
// REMOTE_BRANCH has, which it fetches first, so that a verdict tightened
// there counts even before this checkout pulls it.
function readRecord(name) {
  const file = path.join(POLICY_DIR, `${name}.md`);
  let stat = null;
  try {
    stat = fs.lstatSync(file);
  } catch (e) {
    if (e.code !== "ENOENT") throw new Exit(EX_ERROR, `cannot read ${file}: ${e.message}`);
  }
  if (!stat) {
    throw new Exit(
      EX_MISSING,
      `${name} has no policy record (${file}); have a policy-check subagent write one (see homegit's dotfiles/.claude/skills/coordinator/policy-check.md)`,
    );
  }
  // A symlink would make its target's history the record's.
  if (!stat.isFile()) throw new Exit(EX_INVALID, `${file} is not a regular file (a symlink?); a record must be one`);
  // The path in git, unresolved below the records' directory's parent,
  // so that a symlinked directory there is refused too (see below).
  const parent = fs.realpathSync(path.dirname(POLICY_DIR));
  const top = git(parent, ["rev-parse", "--show-toplevel"], `find the git repository of ${file}`);
  const rel = path.posix.join(path.relative(top, parent).split(path.sep).join("/"), path.basename(POLICY_DIR), `${name}.md`);
  if (git(top, ["status", "--porcelain", "--", rel], `tell whether ${file} is committed`) !== "") {
    throw new Exit(EX_INVALID, `${file} has uncommitted changes; commit and push it first`);
  }
  const upstream = `${REMOTE}/${REMOTE_BRANCH}`;
  git(top, ["fetch", "-q", REMOTE, REMOTE_BRANCH], `fetch ${upstream} to check ${file} against it`);
  // Git's view: a regular file at that very path (a symlink, or a path
  // through one, doesn't list as 100644), the same at HEAD and upstream.
  const entry = (rev) => (gitMaybe(top, ["ls-tree", rev, "--", rel]) || "").trim();
  const pushed = entry(upstream);
  const local = entry("HEAD");
  if (!/^100644 blob [0-9a-f]+\t/.test(local)) {
    throw new Exit(EX_INVALID, `${rel} is not a regular file in git at HEAD (${local || "missing"}); a record must be one`);
  }
  if (pushed !== local) {
    throw new Exit(
      EX_INVALID,
      pushed
        ? `${file} differs from ${upstream}'s; pull (git pull --ff-only) or push, so that the gate reads what ${upstream} has`
        : `${file} is not on ${upstream}; push it first`,
    );
  }
  const accept = checkHistoryKept(top);
  const record = parseRecord(git(top, ["show", `HEAD:${rel}`], `read ${rel}`), file);
  checkLoosening(top, rel);
  accept();
  return { file, record };
}

// staleness(name, record): what changed upstream since the record was
// written, one line per source.
function staleness(name, record) {
  const changes = [];
  const key = (s) => `${(s.repo || name).toLowerCase()}:${s.path.replace(/\/+$/, "")}`;
  const recorded = new Set(record.sources.map(key));
  const org = `${name.split("/")[0]}/${ORG_REPO}`.toLowerCase();
  for (const s of record.sources) {
    const r = s.repo || name;
    const repo = Repo.get(r, r.toLowerCase() === org);
    const now = repo && repo.sha(s.path);
    if (!now) changes.push(`${key(s)} is gone`);
    else if (now !== s.sha) changes.push(`${key(s)} changed (${s.sha.slice(0, 12)} -> ${now.slice(0, 12)})`);
  }
  for (const s of scan(name)) {
    if (!recorded.has(key(s))) changes.push(`${key(s)} is not in the record`);
  }
  return changes;
}

function check(requested, allowHumanText) {
  // The record is under the repository's canonical name (see Repo.get).
  const name = Repo.get(requested).name;
  const { file, record } = readRecord(name);
  const changes = staleness(name, record);
  if (changes.length) {
    throw new Exit(
      EX_STALE,
      `${name}'s policy record is stale; re-check the policy (a policy-check subagent updates ${file}):\n${changes.map((c) => `  ${c}`).join("\n")}`,
    );
  }
  const verdict = record.verdict;
  const why = `${name}'s policy is ${verdict} (${file}, checked ${record.checked}): ${VERDICTS[verdict]}`;
  if (verdict === "human-text" && !allowHumanText) throw new Exit(EX_HUMAN_TEXT, why);
  if (verdict === "human-only" || verdict === "no-go") throw new Exit(EX_REFUSED, why);
  return verdict;
}

function main(argv) {
  if (argv.includes("-h") || argv.includes("--help")) {
    process.stdout.write(usage());
    return;
  }
  const [command, name, ...rest] = argv;
  if (!command || !name || !REPO_RE.test(name)) throw new Exit(EX_USAGE, `usage: ${PROG} check|scan OWNER/REPO (see --help)`);
  if (command === "check") {
    const allow = rest.length === 1 && rest[0] === "--allow-human-text";
    if (rest.length > (allow ? 1 : 0)) throw new Exit(EX_USAGE, `unknown arguments for check: ${rest.join(" ")}`);
    console.log(check(name, allow));
  } else if (command === "scan") {
    if (rest.length) throw new Exit(EX_USAGE, `unknown arguments for scan: ${rest.join(" ")}`);
    const found = scan(name);
    console.log(found.length ? "sources:" : "sources: []");
    for (const s of found) console.log(`  - repo: ${s.repo}\n    path: ${s.path}\n    sha: ${s.sha}`);
  } else {
    throw new Exit(EX_USAGE, `unknown command '${command}' (see --help)`);
  }
}

try {
  main(process.argv.slice(2));
} catch (e) {
  if (!(e instanceof Exit)) throw e;
  console.error(`error: ${e.message}`);
  process.exit(e.status);
}
