#!/usr/bin/env bash
# Route cgwalters-bot's GitHub notifications (mentions, review requests,
# assignments): requests from cgwalters become request records for the
# agent to put on the board; anything from anyone else is filed as an issue
# for cgwalters and never acted on.
# GraphQL queries and jq programs hold literal $variables.
# shellcheck disable=SC2016
set -euo pipefail
shopt -s inherit_errexit

readonly BOT_LOGIN=cgwalters-bot
# The only login whose asks are acted on.
readonly REQUESTER=cgwalters
# Fork PRs in the forge are handled by 'bot-pr inbox'.
readonly FORGE_ORG=cgwalters-forge
# Notification reasons that ask something of the bot. The rest (comment,
# author, state_change, ci_activity, subscribed) are about threads the bot
# already follows, which are on the board, where bot-watch reports them,
# except in TRACKER_REPO.
readonly SELECT_REASONS='["mention", "team_mention", "review_requested", "assign"]'
# The bot's own issues, questions for REQUESTER among them (labelled
# QUESTION_LABEL). Every comment REQUESTER makes on one is routed, as
# reason COMMENT_REASON: on a question it is his answer, printed as an
# 'answer' record; on any other issue there, a 'request'. Everyone else's
# comments there, the bot's own included, are left to bot-watch.
readonly TRACKER_REPO=cgwalters-forge/tracker
readonly QUESTION_LABEL=question
readonly COMMENT_REASON=comment
readonly API=https://api.github.com
readonly DEFAULT_LOOKBACK_DAYS=7
readonly PER_PAGE=50
readonly EXCERPT_LEN=300
# A 304 leaves the state alone, but 'since' is rewritten at least this
# often, so it tracks the last poll rather than the last notification.
readonly SINCE_REFRESH_SECS=3600
# The safety net for asks the notifications miss: REQUESTER's public
# events (ETag-cached here, with the hits found in them) and a search for
# mentions of the bot. Both lag, so they look this far before 'since'.
readonly SAFETY_LOOKBACK_SECS=3600
# The events API serves at most 300 events, 100 per page.
readonly EVENTS_PER_PAGE=100
readonly EVENTS_MAX_PAGES=3
# The poll state and the requests printed but not acked yet (plus
# recently acked ones, so they aren't printed again) live on the Workstream
# board, in the archived draft item 'bot-state: notifications' (see
# 'bot-board state-get'), so they are shared by every machine the bot
# runs on.
readonly STATE_NAME=notifications
# Local to this machine: the lock and the triggers already filed as
# issues (a cache; the issues' markers are what counts).
readonly LOCAL_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/bot-notify
readonly FILED_FILE=${LOCAL_DIR}/filed.json
readonly EVENTS_FILE=${LOCAL_DIR}/events.json
# Where the requests were kept before; merged into the board's on first
# use.
readonly LEGACY_PENDING_FILE=${LOCAL_DIR}/pending.json
readonly LOCAL_VERSION=1
# Acked requests are remembered this long, well past any notification lag.
readonly ACKED_KEEP_DAYS=30
# What an assignment by REQUESTER becomes on the board.
readonly ASSIGN_STATUS=Todo
readonly ASSIGN_PRIORITY=P1
# Where issues about asks by others are filed, and who they notify.
readonly DEFAULT_ISSUE_REPO=cgwalters-bot/cgwalters-bot
# Hidden marker in each filed issue's body, keyed by the trigger's URL, so
# a retried run never files the same trigger twice.
readonly MARKER_PREFIX='bot-notify-trigger:'
# jq def that keeps "@login" in text from notifying anyone.
readonly UNMENTION_JQ='def unmention: gsub("@(?=[A-Za-z0-9])"; "@​");'
# Exit status for an exhausted quota (EX_TEMPFAIL), as in bot-board.
readonly EX_RATELIMIT=75
# Returned by ghapi() when GitHub says the resource does not exist.
readonly EX_NOTFOUND=4
BOT_BOARD=$(dirname "$(readlink -f "$0")")/bot-board
readonly BOT_BOARD
# shellcheck source=bin/gh-http.sh disable=SC1091 # followed with shellcheck -x
source "$(dirname "$(readlink -f "$0")")/gh-http.sh" || {
    echo "error: ${0##*/} needs gh-http.sh from homegit's bin/ next to it" 1>&2
    exit 1
}

usage() {
    cat <<EOF
Usage: $(basename "$0") [--dry-run] [--repo OWNER/REPO] [--no-mention]
       $(basename "$0") ack THREAD_ID...

Poll ${BOT_LOGIN}'s GitHub notifications once, and route every new
mention, team mention, review request and assignment. GitHub doesn't
reliably notify the bot, so every run also looks for them in
${REQUESTER}'s public events (his reviews, comments, assignments and
review requests that mention or name @${BOT_LOGIN}, and his comments in
${TRACKER_REPO}) and searches for
mentions of @${BOT_LOGIN} since the last poll; what that finds is routed
the same way, as threads whose THREAD_ID is the issue or PR URL:

  - an assignment by ${REQUESTER} (by GitHub login) in a public repository:
    add the issue or PR to the board as ${ASSIGN_STATUS}, ${ASSIGN_PRIORITY}, unless it is on it already;
  - any other ask by ${REQUESTER}: print a 'request' record, one JSON object
    per line, for the agent to turn into a board item. Every run prints
    them again until 'ack THREAD_ID' says they're on the board, which
    also marks a notification thread read;
  - a comment by ${REQUESTER} on an issue in ${TRACKER_REPO}, where the
    bot's own issues are: on a question (labelled '${QUESTION_LABEL}') it is
    his answer, printed as an 'answer' record with the option letter he
    picked (a first line that is just the letter) in 'choice'; elsewhere
    there a 'request'. Both stay until acked, like requests. Comments by
    anyone else there, the bot's own included, are left to bot-watch;
  - from anyone else: file an issue in ${DEFAULT_ISSUE_REPO} mentioning
    @${REQUESTER}, once per trigger (deduped locally, then by a hidden
    marker in the issues); the bot never acts on it. For a non-public
    source the issue has links only.

Threads in ${FORGE_ORG} other than ${TRACKER_REPO} are skipped: 'bot-pr
inbox' covers them. Other threads are marked read once routed, unless
they hold unacked requests.
The poll state (since, Last-Modified) and the unacked requests are kept
in the archived 'bot-state: ${STATE_NAME}' draft item on the board,
shared by every machine. The poll state only advances when every thread,
safety net included, was routed, so a failed run is retried. It is
written once, at the end of a run, and only if something changed (a 304
from GitHub means nothing new, though 'since' still moves up hourly),
with a checked write that merges in what another machine wrote
meanwhile. Filed triggers and the events' ETag are cached in
${LOCAL_DIR}.

Options:
  --dry-run           Report only: file and add nothing, mark nothing read,
                      record nothing locally, keep the state
  --repo OWNER/REPO   Repository to file issues in (default: ${DEFAULT_ISSUE_REPO})
  --no-mention        Don't mention @${REQUESTER} in filed issues (for testing)
  -h, --help          Show this help

This is a one-shot command; it prints GitHub's X-Poll-Interval, the
minimum time to wait before polling again. The token needs the classic
'notifications' scope. REST is used for everything but the state (one
GraphQL read per run, and a reread and a write per run that changed it);
the safety net adds a conditional events request (free when it is a
304) and a search request per run.
EOF
}

fatal() {
    echo "error: $*" 1>&2
    exit 1
}

warn() {
    echo "warning: $*" 1>&2
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || fatal "'$1' not found in PATH; $2"
}

rate_limited() {
    echo "error: GitHub is rate limiting the bot ($1); retry after $(gh api rate_limit --jq ".resources.$2.reset | todate" 2>/dev/null || echo "the reset")" 1>&2
    exit "${EX_RATELIMIT}"
}

# check_rate_limit ERRFILE RESOURCE: exits if ERRFILE reports rate limiting.
check_rate_limit() {
    local reason
    if reason=$(grep -iE -m1 'rate limit|abuse' "$1"); then
        rm -f "$1"
        rate_limited "${reason}" "$2"
    fi
}

# ghapi ARGS...: 'gh api', turning rate limiting into a clear exit and a
# 404 into EX_NOTFOUND (with no output).
ghapi() {
    local out err rc=0
    err=$(mktemp)
    out=$(gh api "$@" 2>"${err}") || rc=$?
    if test "${rc}" -ne 0; then
        check_rate_limit "${err}" core
        if grep -q 'HTTP 404' "${err}"; then
            rm -f "${err}"
            return "${EX_NOTFOUND}"
        fi
        cat "${err}" 1>&2
        rm -f "${err}"
        return "${rc}"
    fi
    rm -f "${err}"
    test -z "${out}" || printf '%s\n' "${out}"
}

# gql QUERY [ARGS...]: a GraphQL call; prints .data.
gql() {
    local query=$1 out err rc=0
    shift
    err=$(mktemp)
    out=$(gh api graphql -f query="${query}" "$@" --jq .data 2>"${err}") || rc=$?
    if test "${rc}" -ne 0; then
        check_rate_limit "${err}" graphql
        cat "${err}" 1>&2
        rm -f "${err}"
        return "${rc}"
    fi
    rm -f "${err}"
    printf '%s\n' "${out}"
}

iso_now() {
    date -u +%FT%TZ
}

# is_thread_id ID: whether ID is a notification thread's, rather than the
# issue or PR URL standing for a thread the safety net found.
is_thread_id() {
    [[ "$1" =~ ^[0-9]+$ ]]
}

# The safety net's hits in REQUESTER's public events, one JSON object each:
# {repo, number, pr, reason, url (the trigger, if known), title, at,
# private, source}. PR event payloads carry neither body nor title.
readonly EVENT_HITS_JQ='
def names_bot: (. // "") | test("@" + $bot + "(?![A-Za-z0-9-])"; "i");
.[] | select(.actor.login == $requester) | .payload as $p
| {repo: .repo.name, at: .created_at, private: (.public | not), source: "events"} + (
    if .type == "IssueCommentEvent" and $p.action == "created" and ($p.comment.body | names_bot) then
        {number: $p.issue.number, pr: ($p.issue.pull_request != null), reason: "mention",
         url: $p.comment.html_url, title: $p.issue.title}
    elif .type == "PullRequestReviewCommentEvent" and $p.action == "created" and ($p.comment.body | names_bot) then
        {number: $p.pull_request.number, pr: true, reason: "mention", url: $p.comment.html_url}
    elif .type == "PullRequestReviewEvent" and ($p.review.body | names_bot) then
        {number: $p.pull_request.number, pr: true, reason: "mention", url: $p.review.html_url}
    elif .type == "IssueCommentEvent" and $p.action == "created" and (.repo.name | ascii_downcase) == $tracker
        and $p.issue.pull_request == null then
        {number: $p.issue.number, pr: false, reason: "comment", url: $p.comment.html_url, title: $p.issue.title}
    elif .type == "IssuesEvent" and $p.action == "opened" and ($p.issue.body | names_bot) then
        {number: $p.issue.number, pr: false, reason: "mention", url: $p.issue.html_url, title: $p.issue.title}
    elif .type == "IssuesEvent" and $p.action == "assigned" and $p.assignee.login? == $bot then
        {number: $p.issue.number, pr: false, reason: "assign", title: $p.issue.title}
    elif .type == "PullRequestEvent" and $p.action == "opened" and ($p.pull_request.body | names_bot) then
        {number: $p.number, pr: true, reason: "mention", url: $p.pull_request.html_url, title: $p.pull_request.title}
    elif .type == "PullRequestEvent" and $p.action == "review_requested" and $p.requested_reviewer.login? == $bot then
        {number: $p.number, pr: true, reason: "review_requested"}
    elif .type == "PullRequestEvent" and $p.action == "assigned" and $p.assignee.login? == $bot then
        {number: $p.number, pr: true, reason: "assign"}
    else empty end)'
# The same for a search/issues result.
readonly SEARCH_HITS_JQ='.items[] | {repo: (.repository_url | sub("^.*/repos/"; "")), number,
    pr: (.pull_request != null), reason: "mention", title, at: .updated_at, private: null, source: "search"}'
# An array of hits to threads shaped like the notifications API's, one
# per issue or PR and reason, with the issue or PR URL as the id, and read
# at $window, so that only triggers after it count. Hits from before
# $window, or whose trigger is in $known, are dropped.
readonly HITS_TO_THREADS_JQ='
map(select(.at > $window and (.url == null or (.url as $u | $known | index($u) | not))))
| group_by([.repo, .number, .reason]) | .[]
| .[0].repo as $repo | (if any(.[]; .pr) then "pull" else "issues" end) as $kind
| {id: "https://github.com/\($repo)/\($kind)/\(.[0].number)", reason: .[0].reason, unread: true,
   updated_at: (map(.at) | max), last_read_at: $window, source: (map(.source) | unique | join("+")),
   subject: {type: (if $kind == "pull" then "PullRequest" else "Issue" end), title: (map(.title // empty) | first),
             url: "https://api.github.com/repos/\($repo)/issues/\(.[0].number)", latest_comment_url: null},
   repository: {full_name: $repo, owner: {login: ($repo | split("/")[0])}, private: (map(.private) | first),
                html_url: "https://github.com/\($repo)"}}'

dry_run=false
issue_repo=${DEFAULT_ISSUE_REPO}
mention=true
# Hidden test hook: a JSON array of notification threads, processed as if
# the poll had returned them too (the real poll still runs).
from_file=
# Hidden test hook: prints the threads the safety net makes of an events
# JSON array, looking back to a given time, offline, and exits.
events_file=
events_window=
# Hidden test hook: another repository standing for TRACKER_REPO (a
# throwaway one), with --from-file or --event-threads only.
tracker_repo=${TRACKER_REPO}
subcmd=poll
ack_ids=()
if test "${1:-}" = ack; then
    subcmd=ack
    shift
    test $# -gt 0 || fatal "usage: $(basename "$0") ack THREAD_ID..."
    for id in "$@"; do
        is_thread_id "${id}" || [[ "${id}" =~ ^https://github\.com/[^/]+/[^/]+/(issues|pull)/[0-9]+$ ]] ||
            fatal "not a notification thread id, nor an issue or PR URL: '${id}'"
    done
    ack_ids=("$@")
    set --
fi
while test $# -gt 0; do
    case "$1" in
        --dry-run) dry_run=true; shift ;;
        --repo) test $# -ge 2 || fatal "--repo requires OWNER/REPO"; issue_repo=$2; shift 2 ;;
        --repo=*) issue_repo=${1#--repo=}; shift ;;
        --no-mention) mention=false; shift ;;
        --from-file) test $# -ge 2 || fatal "--from-file requires a file"; from_file=$2; shift 2 ;;
        --event-threads) test $# -ge 3 || fatal "--event-threads requires a file and a time"
            events_file=$2; events_window=$3; shift 3 ;;
        --tracker-repo) test $# -ge 2 || fatal "--tracker-repo requires OWNER/REPO"; tracker_repo=$2; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) fatal "unknown argument: $1 (see --help)" ;;
    esac
done
[[ "${issue_repo}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fatal "--repo must be OWNER/REPO, not '${issue_repo}'"
if test "${tracker_repo}" != "${TRACKER_REPO}" && test -z "${from_file}${events_file}"; then
    fatal "--tracker-repo is a test hook and needs --from-file or --event-threads"
fi
if test -n "${from_file}"; then
    jq -e 'type == "array"' "${from_file}" >/dev/null 2>&1 || fatal "--from-file ${from_file} is not a JSON array of notification threads"
fi
if test -n "${events_file}"; then
    jq -c --arg bot "${BOT_LOGIN}" --arg requester "${REQUESTER}" --arg tracker "${tracker_repo,,}" "${EVENT_HITS_JQ}" "${events_file}" |
        jq -sc --arg window "${events_window}" --argjson known '[]' "${HITS_TO_THREADS_JQ}"
    exit 0
fi
# Logins whose asks are acted on. Test hook: BOT_NOTIFY_TRUSTED adds one
# (the bot, say, since only it can assign in a throwaway repository), and
# only together with --from-file, so it can't leak into a real run.
trusted=("${REQUESTER}")
if test -n "${BOT_NOTIFY_TRUSTED:-}"; then
    test -n "${from_file}" || fatal "BOT_NOTIFY_TRUSTED is a test hook and needs --from-file"
    trusted+=("${BOT_NOTIFY_TRUSTED}")
    warn "testing: treating @${BOT_NOTIFY_TRUSTED} like @${REQUESTER}"
fi

require_cmd gh "install the GitHub CLI (https://cli.github.com) and authenticate it as ${BOT_LOGIN}"
require_cmd jq "install jq"
require_cmd flock "install util-linux"

login=$(ghapi user --jq .login) || fatal "'gh api user' failed; authenticate gh as ${BOT_LOGIN}"
test "${login}" = "${BOT_LOGIN}" || fatal "gh is authenticated as '${login}', not ${BOT_LOGIN}; these would be someone else's notifications"

# Two runs on this machine must not both route the same threads or race on
# the state. (Runs on different machines are serialized by nothing: the
# issue dedupe keeps filing safe, and the checked state write merges their
# requests and acks.)
mkdir -p "${LOCAL_DIR}"
exec {lock_fd}>"${LOCAL_DIR}/lock" || fatal "cannot open ${LOCAL_DIR}/lock"
flock -n "${lock_fd}" || fatal "another $(basename "$0") run holds ${LOCAL_DIR}/lock"

# --- Local state ----------------------------------------------------------

# load_local FILE KEY...: prints FILE's JSON, or a fresh object with the
# given keys as empty objects if FILE doesn't exist yet.
load_local() {
    local file=$1
    shift
    if test -s "${file}"; then
        jq -ce --argjson v "${LOCAL_VERSION}" 'if .version == $v then . else error("unsupported version \(.version)") end' "${file}" ||
            fatal "cannot parse ${file}; fix it or move it away"
    else
        jq -nc --argjson v "${LOCAL_VERSION}" '$ARGS.positional | map({(.): {}}) | add + {version: $v}' --args "$@"
    fi
}

# save_local FILE JSON: atomically replaces FILE (not in a dry run).
save_local() {
    ${dry_run} && return 0
    printf '%s\n' "$2" >"$1.tmp.$$"
    mv -f "$1.tmp.$$" "$1"
}

# {filed: {TRIGGER_URL: issue URL}}
FILED_JSON=$(load_local "${FILED_FILE}" filed)

# --- State on the board ---------------------------------------------------

# board_failed STATUS MESSAGE: after a failed bot-board call, pass a
# rate-limit exit through (bot-board printed why), else fail.
board_failed() {
    test "$1" -ne "${EX_RATELIMIT}" || exit "${EX_RATELIMIT}"
    fatal "$2"
}

# {since, last_modified, pending: {TRIGGER_URL: record},
#  acked: {TRIGGER_URL: time}, updated_at, host}
track=(--track)
! ${dry_run} || track=()
STATE_JSON=$("${BOT_BOARD}" state-get "${track[@]}" "${STATE_NAME}") || board_failed $? "reading the state failed"
# {pending, acked}, changed as the run goes and written by save_state.
PENDING_JSON=$(jq -c '{pending: (.pending // {}), acked: (.acked // {})}' <<<"${STATE_JSON}")
if test -s "${LEGACY_PENDING_FILE}"; then
    PENDING_JSON=$(jq -c --slurpfile old "${LEGACY_PENDING_FILE}" '($old[0] | {pending, acked}) * .' <<<"${PENDING_JSON}") ||
        fatal "cannot parse ${LEGACY_PENDING_FILE}, the old unacked requests; fix it or move it away"
fi

# save_state [SINCE LAST_MODIFIED]: writes PENDING_JSON's requests, and
# the new poll position if given, unless nothing changed (or in a dry
# run). Changes that an earlier run on this machine failed to write are
# part of STATE_JSON already, so the checked write is made anyway; with
# nothing to write it costs no call.
save_state() {
    local new failed="recording the state failed; the next run will redo this poll"
    test $# -gt 0 || failed="recording the requests failed; they are kept locally for the next run"
    new=$(jq -c --argjson p "${PENDING_JSON}" '. + $p
        | if $ARGS.positional != [] then .since = $ARGS.positional[0] | .last_modified = $ARGS.positional[1] else . end' \
        --args "$@" <<<"${STATE_JSON}")
    if jq -e --argjson new "${new}" 'del(.updated_at, .host) == ($new | del(.updated_at, .host))' <<<"${STATE_JSON}" >/dev/null; then
        ${dry_run} || "${BOT_BOARD}" state-put --checked "${STATE_NAME}" "${STATE_JSON}" || board_failed $? "${failed}"
        echo "No changes; state unchanged."
        return 0
    fi
    if ${dry_run}; then
        echo "Dry run: state unchanged."
        return 0
    fi
    new=$(jq -c --arg now "$(iso_now)" --arg host "$(hostname)" '.updated_at = $now | .host = $host' <<<"${new}")
    "${BOT_BOARD}" state-put --checked "${STATE_NAME}" "${new}" || board_failed $? "${failed}"
    STATE_JSON=${new}
    if test -e "${LEGACY_PENDING_FILE}"; then
        mv -f "${LEGACY_PENDING_FILE}" "${LEGACY_PENDING_FILE}.migrated" ||
            fatal "cannot move ${LEGACY_PENDING_FILE} away; its requests are on the board now, so remove it"
        echo "Moved the unacked requests from ${LEGACY_PENDING_FILE} to the board; the old file is ${LEGACY_PENDING_FILE}.migrated." 1>&2
    fi
    if test $# -gt 0; then
        echo "State advanced to since=$1."
    else
        echo "Recorded the requests; the poll state is unchanged."
    fi
}

# mark_read ID: marks a notification thread read (a no-op for a thread
# the safety net found, which GitHub knows nothing about).
mark_read() {
    local rc=0
    ${dry_run} && return 0
    is_thread_id "$1" || return 0
    ghapi -X PATCH "notifications/threads/$1" >/dev/null || rc=$?
    case "${rc}" in
        0) ;;
        "${EX_NOTFOUND}") warn "thread $1 no longer exists; nothing to mark read" ;;
        *) warn "marking thread $1 read failed"; return 1 ;;
    esac
}

# print_pending: prints every request not acked yet, one record per line.
print_pending() {
    local n
    n=$(jq '.pending | length' <<<"${PENDING_JSON}")
    test "${n}" -gt 0 || return 0
    echo "${n} requests and answers from ${REQUESTER} to act on; then 'bot-notify ack THREAD_ID...':"
    jq -r '.pending | to_entries | sort_by(.value.thread_id, .key) | .[].value
        | {type: (if .question then "answer" else "request" end)} + .
        | "\(.type) \(tojson)"' <<<"${PENDING_JSON}"
}

if test "${subcmd}" = ack; then
    now=$(iso_now)
    rc=0
    for id in "${ack_ids[@]}"; do
        n=$(jq --arg id "${id}" '[.pending[] | select(.thread_id == $id)] | length' <<<"${PENDING_JSON}")
        test "${n}" -gt 0 || warn "thread ${id} has no pending request; marking it read anyway"
        mark_read "${id}" || { rc=1; continue; }
        PENDING_JSON=$(jq -c --arg id "${id}" --arg now "${now}" '
            ([.pending | to_entries[] | select(.value.thread_id == $id) | .key]) as $urls
            | .acked += ($urls | map({(.): $now}) | add // {})
            | .pending |= with_entries(select(.value.thread_id != $id))' <<<"${PENDING_JSON}")
        if is_thread_id "${id}"; then
            echo "Acked thread ${id} (${n} requests); marked it read."
        else
            echo "Acked ${id} (${n} requests)."
        fi
    done
    save_state >/dev/null
    exit "${rc}"
fi

PENDING_JSON=$(jq -c --arg cutoff "$(date -u -d "${ACKED_KEEP_DAYS} days ago" +%FT%TZ)" \
    '.acked |= with_entries(select(.value >= $cutoff))' <<<"${PENDING_JSON}")

# --- Poll position --------------------------------------------------------

since=$(jq -r '.since // empty' <<<"${STATE_JSON}")
last_modified=$(jq -r '.last_modified // empty' <<<"${STATE_JSON}")
test -n "${since}" || since=$(date -u -d "${DEFAULT_LOOKBACK_DAYS} days ago" +%FT%TZ)

# --- Poll -----------------------------------------------------------------

scratch=$(mktemp -d)
trap 'rm -rf "${scratch}"' EXIT

# fetch_page PATH [HEADER]: GETs PATH, with a request HEADER such as
# If-Modified-Since if given, with headers into ${scratch}/headers and
# the body into ${scratch}/body; prints the status.
fetch_page() {
    local args=(-i "$1") rc=0 status
    test -z "${2:-}" || args+=(-H "$2")
    gh api "${args[@]}" >"${scratch}/raw" 2>"${scratch}/err" || rc=$?
    split_http_response "${scratch}/raw" "${scratch}/headers" "${scratch}/body"
    status=$(awk 'NR == 1 { print $2 }' "${scratch}/headers")
    # gh fails on a 304, which is an answer, not an error.
    if test "${rc}" -ne 0 && test "${status}" != 304; then
        check_rate_limit "${scratch}/err" core
        cat "${scratch}/err" 1>&2
        return 1
    fi
    echo "${status}"
}

header() {
    awk -v name="$1" 'index(tolower($0), tolower(name) ":") == 1 {
        sub(/^[^:]*:[[:space:]]*/, ""); print; exit }' "${scratch}/headers"
}

poll_start=$(iso_now)
status=$(fetch_page "notifications?all=true&since=${since}&per_page=${PER_PAGE}" \
    "${last_modified:+If-Modified-Since: ${last_modified}}") ||
    fatal "polling the notifications failed"
poll_interval=$(header X-Poll-Interval)
if server_date=$(header Date) && test -n "${server_date}"; then
    # GitHub's clock, so that local skew can't skip notifications.
    poll_start=$(date -u -d "${server_date}" +%FT%TZ)
fi
new_last_modified=${last_modified}
threads='[]'
case "${status}" in
    304)
        # Unacked requests are still printed below.
        echo "Nothing new since ${last_modified} (304 Not Modified); poll again in ${poll_interval:-?}s at the earliest."
        ;;
    200)
        # An empty list has no Last-Modified; its Date works just as well
        # for If-Modified-Since.
        new_last_modified=$(header Last-Modified)
        test -n "${new_last_modified}" || new_last_modified=${server_date:-${last_modified}}
        threads=$(jq -c . "${scratch}/body")
        next=$(header Link | grep -oP '<\K[^>]+(?=>; rel="next")' || true)
        while test -n "${next}"; do
            status=$(fetch_page "${next#"${API}"/}") || fatal "fetching ${next} failed"
            threads=$(jq -c --slurpfile page "${scratch}/body" '. + $page[0]' <<<"${threads}")
            next=$(header Link | grep -oP '<\K[^>]+(?=>; rel="next")' || true)
        done
        echo "$(jq length <<<"${threads}") notification threads updated since ${since}; poll again in ${poll_interval:-?}s at the earliest."
        ;;
    *) fatal "unexpected HTTP status '${status}' polling notifications" ;;
esac
if test -n "${from_file}"; then
    threads=$(jq -c --slurpfile extra "${from_file}" '. + $extra[0]' <<<"${threads}")
    echo "Added $(jq -c --slurpfile extra "${from_file}" -n '$extra[0] | length') threads from ${from_file}."
fi

# --- Safety net -----------------------------------------------------------

# GitHub doesn't reliably notify the bot: for a long while the bot's
# notifications were empty (even with all=true) although it watches busy
# repositories and cgwalters mentioned it. So REQUESTER's public events,
# which include his review bodies, and a search for mentions (which
# doesn't cover review bodies, but covers everyone else) are checked on
# every run too. Private repositories only show up in the search.

# event_hits WINDOW: prints the hits in REQUESTER's recent public events,
# using and updating the ETag cache in EVENTS_FILE.
event_hits() {
    local window=$1 cache etag status hits next pages=1 oldest
    cache='{}'
    if test -s "${EVENTS_FILE}"; then
        cache=$(jq -ce --argjson v "${LOCAL_VERSION}" 'select(.version == $v)' "${EVENTS_FILE}") ||
            { warn "ignoring ${EVENTS_FILE}, which can't be parsed"; cache='{}'; }
    fi
    etag=$(jq -r '.etag // empty' <<<"${cache}")
    status=$(fetch_page "users/${REQUESTER}/events/public?per_page=${EVENTS_PER_PAGE}" \
        "${etag:+If-None-Match: ${etag}}") || return 1
    case "${status}" in
        304)
            jq -c '.hits[]' <<<"${cache}"
            return 0
            ;;
        200) ;;
        *) warn "unexpected HTTP status '${status}' reading ${REQUESTER}'s events"; return 1 ;;
    esac
    etag=$(header ETag)
    hits=$(jq -c --arg bot "${BOT_LOGIN}" --arg requester "${REQUESTER}" --arg tracker "${tracker_repo,,}" "${EVENT_HITS_JQ}" "${scratch}/body")
    oldest=$(jq -r '.[-1].created_at // empty' "${scratch}/body")
    next=$(header Link | grep -oP '<\K[^>]+(?=>; rel="next")' || true)
    while test -n "${next}" && test -n "${oldest}" && [[ "${oldest}" > "${window}" ]] && test "${pages}" -lt "${EVENTS_MAX_PAGES}"; do
        status=$(fetch_page "${next#"${API}"/}") || return 1
        hits+=$'\n'$(jq -c --arg bot "${BOT_LOGIN}" --arg requester "${REQUESTER}" --arg tracker "${tracker_repo,,}" "${EVENT_HITS_JQ}" "${scratch}/body")
        oldest=$(jq -r '.[-1].created_at // empty' "${scratch}/body")
        next=$(header Link | grep -oP '<\K[^>]+(?=>; rel="next")' || true)
        pages=$((pages + 1))
    done
    if test -n "${oldest}" && [[ "${oldest}" > "${window}" ]]; then
        warn "${REQUESTER}'s public events only go back to ${oldest}; asks there before it may be missed"
    fi
    save_local "${EVENTS_FILE}" "$(jq -sc --arg etag "${etag}" --argjson v "${LOCAL_VERSION}" \
        '{version: $v, etag: $etag, hits: .}' <<<"${hits}")"
    printf '%s\n' "${hits}"
}

# safety_threads: prints a JSON array of threads for what the safety net
# found that isn't in THREADS already.
safety_threads() {
    local window hits known
    window=$(date -u -d "@$(($(date -u -d "${since}" +%s) - SAFETY_LOOKBACK_SECS))" +%FT%TZ)
    hits=$(event_hits "${window}") || return 1
    hits+=$'\n'$(ghapi -X GET search/issues -f q="mentions:${BOT_LOGIN} updated:>${window} -user:${FORGE_ORG}" \
        -f sort=updated -f per_page=100 --jq "${SEARCH_HITS_JQ}") || return 1
    known=$(jq -c '[.pending, .acked | keys[]]' <<<"${PENDING_JSON}")
    jq -sc --arg window "${window}" --argjson known "${known}" "${HITS_TO_THREADS_JQ}" <<<"${hits}" |
        jq -sc --argjson threads "${threads}" '
            ($threads | map("\(.repository.full_name)#\(.subject.url // "" | capture("/(?<n>[0-9]+)$").n // "")")) as $seen
            | map(select("\(.repository.full_name)#\(.subject.url | capture("/(?<n>[0-9]+)$").n)" as $k | $seen | index($k) | not))'
}

safety_failed=false
if extra=$(safety_threads); then
    if test "$(jq length <<<"${extra}")" -gt 0; then
        echo "The safety net found $(jq length <<<"${extra}") issues and PRs that may hold asks the notifications lack."
        threads_all=$(jq -c --argjson extra "${extra}" '. + $extra' <<<"${threads}")
    else
        threads_all=${threads}
    fi
else
    warn "the safety net (${REQUESTER}'s events, the mention search) failed"
    safety_failed=true
    threads_all=${threads}
fi

# --- Find what triggered each thread -------------------------------------

# is_trusted AUTHOR AUTHOR_TYPE: whether GitHub recorded one of the
# trusted logins (a user, not a bot or an organization).
is_trusted() {
    local login
    test "$2" = User || return 1
    for login in "${trusted[@]}"; do
        test "$1" = "${login}" && return 0
    done
    return 1
}

excerpt_jq="(. // \"\" | gsub(\"\\\\s+\"; \" \") | if length > ${EXCERPT_LEN} then .[:${EXCERPT_LEN}] + \"...\" else . end)"

# triggers THREAD: prints one JSON object per new trigger in the thread:
# {author, author_type, url, body, located}. Nothing if the thread has no
# trigger newer than its last read; fails if GitHub can't be read.
triggers() {
    local thread=$1 reason type subject_url latest last_read repo number self=true
    reason=$(jq -r .reason <<<"${thread}")
    # GitHub never notifies anyone of their own mentions, but the safety
    # net would find the bot's, unless the bot is trusted for testing.
    if jq -e .source <<<"${thread}" >/dev/null && ! is_trusted "${BOT_LOGIN}" User; then
        self=false
    fi
    type=$(jq -r .subject.type <<<"${thread}")
    subject_url=$(jq -r '.subject.url // empty' <<<"${thread}")
    latest=$(jq -r '.subject.latest_comment_url // empty' <<<"${thread}")
    last_read=$(jq -r '.last_read_at // empty' <<<"${thread}")
    repo=$(jq -r .repository.full_name <<<"${thread}")
    local found='' issue html
    if [[ "${type}" =~ ^(Issue|PullRequest)$ ]] && [[ "${subject_url}" =~ /([0-9]+)$ ]]; then
        number=${BASH_REMATCH[1]}
        issue=$(ghapi "repos/${repo}/issues/${number}") || return 1
        html=$(jq -r .html_url <<<"${issue}")
        case "${reason}" in
            mention|team_mention)
                local pattern candidates
                # A login ends at a character that can't be part of one.
                if test "${reason}" = mention; then
                    pattern="@${BOT_LOGIN}(?![A-Za-z0-9-])"
                else
                    pattern='@[A-Za-z0-9-]+/[A-Za-z0-9_.-]+'
                fi
                candidates=$(
                    jq -c --arg lr "${last_read}" 'select($lr == "" or .created_at > $lr)
                        | {author: .user.login, author_type: .user.type, url: .html_url, body, at: .created_at}' <<<"${issue}"
                    ghapi --paginate "repos/${repo}/issues/${number}/comments?per_page=100${last_read:+&since=${last_read}}" \
                        --jq '.[] | {author: .user.login, author_type: .user.type, url: .html_url, body, at: .updated_at}' || exit 1
                    if test "${type}" = PullRequest; then
                        ghapi --paginate "repos/${repo}/pulls/${number}/comments?per_page=100${last_read:+&since=${last_read}}" \
                            --jq '.[] | {author: .user.login, author_type: .user.type, url: .html_url, body, at: .updated_at}' || exit 1
                        ghapi --paginate "repos/${repo}/pulls/${number}/reviews?per_page=100" \
                            --jq '.[] | {author: .user.login, author_type: .user.type, url: .html_url, body, at: .submitted_at}' || exit 1
                    fi
                ) || return 1
                found=$(jq -c --arg lr "${last_read}" --arg re "${pattern}" --argjson self "${self}" --arg bot "${BOT_LOGIN}" \
                    'select(($lr == "" or .at > $lr) and (.body // "" | test($re; "i")) and ($self or .author != $bot))
                     | del(.at) + {located: true}' <<<"${candidates}")
                ;;
            "${COMMENT_REASON}")
                # Only what a trusted login wrote: on a question, that's
                # the answer. Nothing else here is filed or acted on, and
                # there's nothing to fall back on below.
                local trusted_json
                trusted_json=$(printf '%s\n' "${trusted[@]}" | jq -Rsc 'split("\n") | map(select(. != ""))')
                found=$(ghapi --paginate "repos/${repo}/issues/${number}/comments?per_page=100${last_read:+&since=${last_read}}" \
                    --jq '.[] | {author: .user.login, author_type: .user.type, url: .html_url, body, at: .created_at}' |
                    jq -c --arg lr "${last_read}" --argjson trusted "${trusted_json}" \
                        'select(($lr == "" or .at > $lr) and .author_type == "User" and (.author | IN($trusted[])))
                         | del(.at) + {located: true}') || return 1
                test -n "${found}" || return 0
                ;;
            review_requested|assign)
                local filter
                if test "${reason}" = assign; then
                    filter="select(.event == \"assigned\" and .assignee.login == \"${BOT_LOGIN}\")"
                else
                    filter="select(.event == \"review_requested\" and (.requested_reviewer.login == \"${BOT_LOGIN}\" or .requested_team != null))"
                fi
                found=$(ghapi --paginate "repos/${repo}/issues/${number}/events?per_page=100" --jq ".[] | ${filter}" |
                    jq -c --arg lr "${last_read}" --arg html "${html}" 'select($lr == "" or .created_at > $lr)
                        | {author: .actor.login, author_type: .actor.type,
                           url: "\($html)#event-\(.id)", body: "", located: true}') || return 1
                # The thread's own text is the context of a request.
                if test -n "${found}"; then
                    found=$(jq -c --argjson issue "${issue}" '.body = "\($issue.title)\n\n\($issue.body // "")"' <<<"${found}")
                fi
                ;;
        esac
        if test -z "${found}" && test -n "${last_read}"; then
            # Read before, and nothing new that concerns the bot.
            return 0
        fi
        if test -n "${found}"; then
            # A comment on a question in the tracker is an answer, whether
            # or not it also mentions the bot.
            found=$(jq -c --argjson issue "${issue}" --arg label "${QUESTION_LABEL}" --argjson tracker "$(
                test "${repo,,}" = "${tracker_repo,,}" && echo true || echo false)" \
                '. + {issue_title: $issue.title, question: ($tracker and any($issue.labels[]?; .name == $label))}' <<<"${found}")
        fi
    fi
    if test -z "${found}"; then
        # Some other subject (a discussion, a commit...), or the trigger
        # wasn't found: fall back to the latest comment, without trusting
        # it as a request unless its login says so.
        if test -n "${latest}"; then
            found=$(ghapi "${latest#"${API}"/}" --jq '{author: .user.login, author_type: .user.type,
                url: .html_url, body: (.body // ""), located: false}') || return 1
        else
            found=$(jq -c '{author: null, author_type: null, url: .repository.html_url,
                body: "", located: false}' <<<"${thread}")
        fi
    fi
    printf '%s\n' "${found}"
}

# --- Route ----------------------------------------------------------------

declare -A private_repo=()
is_private() {
    local repo=$1
    if test -z "${private_repo[${repo}]:-}"; then
        # Unknown visibility is treated as private.
        private_repo[${repo}]=$(ghapi "repos/${repo}" --jq '.visibility != "public"' 2>/dev/null || echo true)
    fi
    test "${private_repo[${repo}]}" = true
}


filed_markers=
markers_loaded=false
load_markers() {
    ${markers_loaded} && return 0
    # Exact where search would lag, and the repository is small.
    filed_markers=$(ghapi --paginate "repos/${issue_repo}/issues?state=all&per_page=100" \
        --jq ".[] | .html_url as \$u | .body // \"\" | scan(\"${MARKER_PREFIX}(\\\\S+) -->\") | \"\(.[0]) \(\$u)\"") ||
        { warn "cannot list the issues in ${issue_repo}; does it exist, with issues enabled?"; return 1; }
    markers_loaded=true
}

# record_filed TRIGGER_URL ISSUE_URL
record_filed() {
    FILED_JSON=$(jq -c --arg url "$1" --arg issue "$2" '.filed[$url] = $issue' <<<"${FILED_JSON}")
    save_local "${FILED_FILE}" "${FILED_JSON}"
}

# file_issue TRIGGER: files (once) an issue about a trigger by someone
# other than REQUESTER.
file_issue() {
    local t=$1 url existing title body
    url=$(jq -r .url <<<"${t}")
    # The local record first: the issue list lags behind a new issue.
    existing=$(jq -r --arg url "${url}" '.filed[$url] // empty' <<<"${FILED_JSON}")
    if test -z "${existing}"; then
        load_markers || return 1
        existing=$(awk -v url="${url}" '$1 == url { print $2; exit }' <<<"${filed_markers}")
        test -z "${existing}" || record_filed "${url}" "${existing}"
    fi
    if test -n "${existing}"; then
        echo "  already filed as ${existing}"
        return 0
    fi
    title=$(jq -r '"\({mention: "Mention", team_mention: "Team mention", review_requested: "Review request",
                       assign: "Assignment"}[.reason] // "Notification"): \(if .author then "@" + .author else "someone" end) on \(.repo)#\(.number // "?")"' <<<"${t}")
    if ${dry_run}; then
        echo "  would file: ${title}"
        nfiled=$((nfiled + 1))
        return 0
    fi
    # The issue repository is public: for any other source, links only.
    # Only REQUESTER is to be notified, so every other '@' is defused.
    local what='"\(if .author then "@" + .author | unmention else "Someone (author unknown)" end) \({mention: "mentioned the bot",
        team_mention: "mentioned a team the bot is in", review_requested: "requested a review from the bot",
        assign: "assigned the bot"}[.reason] // "notified the bot (\(.reason))") in \(.repo)#\(.number // "?"): \(.url)\n\nThread: \(.thread_url)"'
    if test "$(jq -r .private <<<"${t}")" = true || is_private "$(jq -r .repo <<<"${t}")"; then
        body=$(jq -r "${UNMENTION_JQ} ${what}"' + "\n\nThe source repository is not public, so there is no excerpt here; read the thread."' <<<"${t}")
    else
        body=$(jq -r "${UNMENTION_JQ} ${what}"' + " (\(.title | unmention))"
            + (if .excerpt != "" then "\n\n> \(.excerpt | unmention)" else "" end)
            + (if .located then "" else "\n\nThe trigger could not be located; this is the latest comment in the thread." end)' <<<"${t}")
    fi
    body+=$'\n\n'"${BOT_LOGIN} does not act on requests from anyone but its operator; this is for a human to decide on."
    if ${mention}; then
        body+=$'\n\n'"@${REQUESTER}, please take a look."
    fi
    body+=$'\n\n'"<!-- ${MARKER_PREFIX}${url} -->"
    local issue_url
    issue_url=$(ghapi -X POST "repos/${issue_repo}/issues" -f title="${title}" -f body="${body}" --jq .html_url) ||
        { warn "creating an issue in ${issue_repo} for ${url} failed"; return 1; }
    record_filed "${url}" "${issue_url}"
    echo "  filed ${issue_url}: ${title}"
    nfiled=$((nfiled + 1))
}

readonly ITEM_STATUS_QUERY='query($id: ID!) { node(id: $id) { ... on ProjectV2Item {
    fieldValueByName(name: "Status") { ... on ProjectV2ItemFieldSingleSelectValue { name } } } } }'

# add_assignment TRIGGER: puts an issue or PR assigned to the bot by a
# trusted login on the board, unless it is there already.
add_assignment() {
    local t=$1 issue_url event_url author id status=
    issue_url=$(jq -r .thread_url <<<"${t}")
    event_url=$(jq -r .url <<<"${t}")
    author=$(jq -r .author <<<"${t}")
    if ${dry_run}; then
        echo "  would add ${issue_url} to the board as ${ASSIGN_STATUS}, ${ASSIGN_PRIORITY}"
        return 0
    fi
    id=$("${BOT_BOARD}" list --json | jq -r --arg url "${issue_url}" '.[] | select(.content.url == $url) | .id' | head -n1) ||
        { warn "listing the board failed"; return 1; }
    if test -z "${id}"; then
        # The listing lags behind writes by minutes; adding an item that is
        # already there returns the existing one, whose Status then shows it.
        id=$("${BOT_BOARD}" add "${issue_url}") || { warn "adding ${issue_url} to the board failed"; return 1; }
        status=$(gql "${ITEM_STATUS_QUERY}" -f id="${id}" | jq -r '.node.fieldValueByName.name // empty') ||
            { warn "reading the status of board item ${id} failed"; return 1; }
        if test -z "${status}"; then
            "${BOT_BOARD}" set "${id}" --status "${ASSIGN_STATUS}" --priority "${ASSIGN_PRIORITY}" \
                --why "Assigned to the bot by ${author} (${event_url})." >/dev/null ||
                { warn "setting up board item ${id} for ${issue_url} failed"; return 1; }
            echo "  added to the board as ${id}: ${ASSIGN_STATUS}, ${ASSIGN_PRIORITY}"
            return 0
        fi
    fi
    echo "  already on the board as ${id}${status:+ (${status})}; left as is"
}

# ack_trigger URL: remembers a trigger as handled.
ack_trigger() {
    PENDING_JSON=$(jq -c --arg url "$1" --arg now "$(iso_now)" '.acked[$url] = $now | del(.pending[$url])' <<<"${PENDING_JSON}")
}

# add_pending TRIGGER: keeps a request until 'ack' says it's on the board.
add_pending() {
    PENDING_JSON=$(jq -c --argjson t "$1" '.pending[$t.url] = $t' <<<"${PENDING_JSON}")
}

nselected=0
nrequests=0
nassigned=0
nfiled=0
nfailed=0
nskipped=0
# New requests only the safety net found.
nunnotified=0
while IFS= read -r thread; do
    test -n "${thread}" || continue
    id=$(jq -r .id <<<"${thread}")
    desc=$(jq -r '"\(.reason) in \(.repository.full_name): \(.subject.title // .id) [\(if .source then "found in \(.source)" else "thread \(.id)" end)]"' <<<"${thread}")
    # Already routed (only this script reads the bot's notifications), and
    # not updated since.
    if jq -e '.unread == false and .last_read_at != null and .last_read_at >= .updated_at' <<<"${thread}" >/dev/null; then
        continue
    fi
    nselected=$((nselected + 1))
    if test "$(jq -r .repository.owner.login <<<"${thread}")" = "${FORGE_ORG}" &&
        test "$(jq -r '.repository.full_name | ascii_downcase' <<<"${thread}")" != "${tracker_repo,,}"; then
        echo "Skipped ${desc}: ${FORGE_ORG} fork PRs are for 'bot-pr inbox'"
        nskipped=$((nskipped + 1))
        mark_read "${id}" || nfailed=$((nfailed + 1))
        continue
    fi
    echo "Thread ${desc}"
    if ! found=$(triggers "${thread}"); then
        warn "cannot read what triggered thread ${id}; will retry next run"
        nfailed=$((nfailed + 1))
        continue
    fi
    if test -z "${found}"; then
        echo "  nothing new for the bot since it was last read"
    fi
    ok=true
    while IFS= read -r trig; do
        test -n "${trig}" || continue
        # Everything a record or an issue needs, in one object.
        t=$(jq -c --argjson th "${thread}" "(.body | ${excerpt_jq}) as \$ex
            | {reason: \$th.reason, repo: \$th.repository.full_name, private: \$th.repository.private,
               number: ((\$th.subject.url // \"\" | capture(\"/(?<n>[0-9]+)\$\") | .n) // null),
               title: (\$th.subject.title // .issue_title), thread_url: (.url | sub(\"#.*\"; \"\")),
               thread_id: \$th.id, author, url, excerpt: \$ex, located, question: (.question // false),
               choice: ((.body // \"\") | split(\"\\n\") | (.[0] // \"\") | gsub(\"^\\\\s+|\\\\s+\$\"; \"\")
                        | if test(\"^[A-Z]\$\") then . else null end)}" <<<"${trig}")
        if jq -e '.private == null' <<<"${t}" >/dev/null; then
            priv=false
            ! is_private "$(jq -r .repo <<<"${t}")" || priv=true
            t=$(jq -c --argjson p "${priv}" '.private = $p' <<<"${t}")
        fi
        url=$(jq -r .url <<<"${t}")
        author=$(jq -r '.author // "unknown"' <<<"${trig}")
        # Only the login GitHub recorded counts, never what the text says.
        if ! is_trusted "${author}" "$(jq -r '.author_type // ""' <<<"${trig}")"; then
            echo "  from @${author} (not ${REQUESTER}): filing, never acting on it"
            file_issue "${t}" || ok=false
        elif jq -e --arg url "${url}" '.acked[$url]' <<<"${PENDING_JSON}" >/dev/null; then
            echo "  request ${url} already acked"
        elif test "$(jq -r .reason <<<"${t}")" = assign && jq -e '.located' <<<"${t}" >/dev/null &&
            ! { test "$(jq -r .private <<<"${t}")" = true || is_private "$(jq -r .repo <<<"${t}")"; }; then
            echo "  assigned by @${author}"
            if add_assignment "${t}"; then
                ack_trigger "${url}"
                nassigned=$((nassigned + 1))
            else
                ok=false
            fi
        elif jq -e --arg url "${url}" '.pending[$url]' <<<"${PENDING_JSON}" >/dev/null; then
            echo "  request from @${author}, already pending"
        else
            # A private source never goes on the board; the agent reports it.
            add_pending "${t}"
            nrequests=$((nrequests + 1))
            ! jq -e .source <<<"${thread}" >/dev/null || nunnotified=$((nunnotified + 1))
            if jq -e .question <<<"${t}" >/dev/null; then
                echo "  answer from @${author}$(jq -r '.choice // empty | " (picked \(.))"' <<<"${t}"), pending until acked"
            else
                echo "  request from @${author}, pending until acked"
            fi
        fi
    done <<<"${found}"
    if ! ${ok}; then
        nfailed=$((nfailed + 1))
    elif jq -e --arg id "${id}" 'any(.pending[]; .thread_id == $id)' <<<"${PENDING_JSON}" >/dev/null; then
        if is_thread_id "${id}"; then
            echo "  left unread until 'bot-notify ack ${id}'"
        else
            echo "  kept until 'bot-notify ack ${id}'"
        fi
    else
        mark_read "${id}" || nfailed=$((nfailed + 1))
    fi
done < <(jq -c --argjson reasons "${SELECT_REASONS}" --arg tracker "${tracker_repo,,}" --arg comment "${COMMENT_REASON}" '
    .[] | (.reason as $r | $reasons | index($r) != null) as $asks
    | select($asks or (.repository.full_name | ascii_downcase) == $tracker)
    | if $asks then . else .reason = $comment end' <<<"${threads_all}")
! ${safety_failed} || nfailed=$((nfailed + 1))

filed_verb=filed
! ${dry_run} || filed_verb="to file"
echo "Routed ${nselected} threads: ${nrequests} new requests and ${nassigned} assignments from ${REQUESTER}, ${nfiled} triggers by others ${filed_verb}, ${nskipped} skipped."
print_pending
if test "${nunnotified}" -gt 0; then
    warn "${nunnotified} new requests were only found by the safety net, not in ${BOT_LOGIN}'s notifications; check that its notification settings deliver 'On GitHub' for participating and watched activity"
fi

# --- Advance the state ---------------------------------------------------

if test "${nfailed}" -gt 0; then
    echo "${nfailed} threads failed; the poll state stays at since=${since} so the next run retries them." 1>&2
    save_state
    exit 1
fi
# By GitHub's clock, like poll_start.
since_age=$(($(date -u -d "${poll_start}" +%s) - $(date -u -d "${since}" +%s)))
if test "$(jq length <<<"${threads}")" -eq 0 && test "${new_last_modified}" = "${last_modified}" &&
    test "${since_age}" -lt "${SINCE_REFRESH_SECS}"; then
    save_state
else
    save_state "${poll_start}" "${new_last_modified}"
fi
