#!/usr/bin/env bash
# Propose the bot's changes as draft PRs on forks in the forge organization,
# where cgwalters reviews them, and open the upstream PR only once he approves.
set -euo pipefail
shopt -s inherit_errexit

readonly BOT_LOGIN=cgwalters-bot
# The only login whose reviews and comments on a fork PR are acted on.
readonly REVIEWER=cgwalters
# The organization holding the forks where fork PRs are opened. Its forks
# start with a clean default branch, and both the bot and REVIEWER can push
# to them and edit PRs. They run no CI by default (see fork_setup): the
# bot tests every change on a devspace, and upstream CI runs once promoted.
readonly FORGE_ORG=${BOT_PR_FORGE:-cgwalters-forge}
readonly BRANCH_PREFIX=bot/
# A board item id, as recorded in a fork PR's bot-meta section.
readonly ITEM_ID_RE='PVTI_[A-Za-z0-9_-]+'
readonly META_START='<!-- bot-meta -->'
readonly META_END='<!-- /bot-meta -->'
readonly LLMS_TRAILER='Generated-by: https://github.com/cgwalters/#llms'
# A line consisting of this, in a comment or review by REVIEWER, asks for
# the upstream PR to be opened as a draft.
readonly DRAFT_COMMAND=/draft
# ... and this, later, takes that back.
readonly READY_COMMAND=/ready
# A line consisting of this, in a conversation comment by REVIEWER,
# approves the head the fork PR had when he wrote the comment, like an
# approving review of that commit.
readonly PROMOTE_COMMAND=/promote
# Comments by REVIEWER matching this (case-insensitively) read like a
# go-ahead. They approve nothing, but inbox and promote point them out so
# that he can be asked for a '/promote' line or an approval.
readonly GO_AHEAD_RE='\b(go ahead|ship it|lgtm|looks (good|fine)|(push|open|send|file|submit)( up)?( a| an| the| it| this)?( upstream)? pr( to| for)?( the)? upstream|(push|send|take|open) (it|this) upstream|promote (it|this))\b'
# The inbox state lives on the Workstream board, in the archived draft
# item 'bot-state: pr-inbox' (see 'bot-board state-get'), so that every
# machine the bot runs on shares it; STATE_DIR only holds the local lock.
readonly STATE_NAME=pr-inbox
readonly STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/bot-pr
# Where the state was kept before; merged into the board's on first use.
readonly LEGACY_STATE_FILE=${STATE_DIR}/inbox.json
readonly STATE_VERSION=2
readonly CLONE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/bot-pr/clones
# Prefix of the URLs git fetches from and pushes to, followed by OWNER/REPO.
readonly GIT_URL_PREFIX=${BOT_PR_GIT_URL:-https://github.com/}
readonly DEFAULT_LOOKBACK_DAYS=7
# How far back each inbox run re-searches closed PRs, for search index lag.
readonly SEARCH_OVERLAP="1 hour"
readonly SEARCH_PER_PAGE=100
# Where inbox looks for fork PRs: the forge, plus the bot's own forks, which
# still have fork PRs from before the forge existed.
readonly SEARCH_SCOPES=("org:${FORGE_ORG}" "user:${BOT_LOGIN}")
# How long fork-pr waits for a newly created fork to become usable.
readonly FORK_READY_TIMEOUT=300
readonly FORK_READY_POLL=5
readonly EXCERPT_LEN=120
# The git identity of the bot's commits. The email is what tells them apart
# from cgwalters' own; older ones have the name cgwalters-bot.
readonly BOT_GIT_NAME="Colin Walters"
readonly BOT_GIT_EMAIL=walters+llm@verbum.org
# Exit status for an exhausted quota (EX_TEMPFAIL), as in bot-board.
readonly EX_RATELIMIT=75
# Returned by ghapi() when GitHub says the resource does not exist.
readonly EX_NOTFOUND=4
# Returned by rebase_onto_upstream() when the rebase conflicts.
readonly EX_CONFLICT=10
# Part of the name of the required status check the DCO app (dco-2)
# reports, which makes a repository require a Signed-off-by on every commit.
readonly DCO_CHECK=DCO
# Where a repository installs the /signoff command (bootc-dev/actions'
# pr-signoff workflow; bootc-dev/infra syncs this stub to its org).
readonly SIGNOFF_WORKFLOW=.github/workflows/signoff.yml
# REVIEWER's DCO sign-off, as on his own commits. His approval of a fork
# PR's head lets promote add it to the bot's commits (and, with
# --include-others, to anyone else's) when the upstream repository
# requires DCO; see add_signoff. Nothing else ever adds it.
readonly SIGNOFF_NAME="Colin Walters"
readonly SIGNOFF_EMAIL=walters@verbum.org
readonly SIGNOFF_TRAILER="Signed-off-by: ${SIGNOFF_NAME} <${SIGNOFF_EMAIL}>"
# The start of the hidden last line of the bot's fork PR comment that
# records a sign-off push: the approved head, the head it pushed, and the
# approval (its URL, and review id or "none" for a '/promote' comment).
readonly SIGNOFF_RECORD='<!-- bot-pr signoff'
# shellcheck disable=SC2016 # jq, not shell
readonly SIGNOFF_RECORD_RE='<!-- bot-pr signoff approved=(?<approved>[0-9a-f]{40}) signed=(?<signed>[0-9a-f]{40}) approval=(?<approval>[^ ]+) review=(?<review>[^ ]+) -->[[:space:]]*$'
# Returned by add_signoff() when commits by others lack the sign-off.
readonly EX_OTHERS=11
BOT_BOARD=$(dirname "$(readlink -f "$0")")/bot-board
readonly BOT_BOARD

usage() {
    cat <<EOF
Usage: $(basename "$0") COMMAND [ARGS...]

Review loop for the bot's changes: a tested branch is first proposed as a
draft PR on a fork in the ${FORGE_ORG} organization, where ${REVIEWER}
reviews it, and only his approval opens the upstream PR.

Commands:
  fork-pr --repo OWNER/REPO --base BRANCH --branch ${BRANCH_PREFIX}SLUG --item PVTI_...
          --title TITLE --body-file FILE [--from DIR] [--force] [--ci WORKFLOW]...
        Fork OWNER/REPO into ${FORGE_ORG} if needed, set up its Actions
        (see fork-setup; --ci is passed on), sync the fork's
        BRANCH with upstream, push
        ${BRANCH_PREFIX}SLUG to the fork from the git repository DIR (default:
        the current one) if it has that branch, and open a draft PR from
        ${BRANCH_PREFIX}SLUG into BRANCH; print its URL. A non-default BRANCH
        (e.g. a Renovate branch) is copied from upstream under the same
        name. TITLE and FILE are the future upstream PR: why, what was
        tested, caveats, ending with '${LLMS_TRAILER}'.
        A trailing ${META_START} section records the upstream target
        and board item, with instructions for the reviewer. It refuses if
        another open fork PR in the fork already records that item, which
        is usually a copied id (after splitting a PR, the new part needs
        its own item); --force allows that.
  fork-setup REPO [--ci WORKFLOW]... [--no-ci]
        Turn off CI on the fork ${FORGE_ORG}/REPO: Actions stays enabled,
        but every workflow is disabled, and the queued and running runs of
        those it disables are cancelled. The forge's forks share one pool
        of runners that a big project's CI matrix fills for hours, and the
        bot tests every change on a devspace anyway; upstream CI runs once
        a fork PR is promoted. Only the workflows opted in stay enabled:
        --ci adds WORKFLOW (a file in .github/workflows) to the fork's
        opt-in list, kept in its Actions variable ${CI_VARIABLE}, and
        --no-ci empties that list first. Opt in only to exercise a change
        to a workflow itself; it then runs for every PR and push on the
        fork, and for 'gh api -X POST repos/${FORGE_ORG}/REPO/actions/workflows/WORKFLOW/dispatches
        -f ref=BRANCH' if it has workflow_dispatch, until '--no-ci'. An
        opted-in workflow that can't work on a fork gets a warning saying
        why: one that only runs on a schedule; one that uses upstream's
        secrets and doesn't test new code (pull_request_target, closed or
        labeled PRs, issues, workflow_run: PR bots, release jobs); a gh-aw
        coding agent; or one listed in WORKFLOW_OVERRIDES in this script.
        fork-pr does this on every run; safe to repeat.
  promote FORK_PR_URL [--draft] [--why TEXT] [--include-others] [--no-signoff] [--dry-run]
        Open the upstream PR for a fork PR whose current head ${REVIEWER}
        approved (commits pushed after his approval need a new one, except
        promote's own sign-off push, below, after an approving review).
        Approving is an approving review, or a conversation comment with
        a '${PROMOTE_COMMAND}' line, which approves the head the PR had
        when he wrote it (per the fork's push log and the PR's timeline;
        if that can't be told, it approves nothing). Other comments never
        approve, but one that reads like a go-ahead is pointed out. Then:
        rebase onto the upstream base if it moved (on conflicts, dismiss
        the approval and stop). If the base branch's rules require the
        DCO check, his approval also signs off: add '${SIGNOFF_TRAILER}'
        to each commit since the merge-base that lacks it, keeping its
        tree, author and message and making him its committer (the DCO
        check wants the author's or committer's sign-off), force-push
        that with a lease on the approved head, and record it on the
        fork PR, so that a rerun still counts his approving review once
        it checked that in git (a '${PROMOTE_COMMAND}' needs repeating). Commits by
        others than ${BOT_LOGIN} and ${REVIEWER} stop it, unless he asked
        for their sign-off too (--include-others), or for none at all
        (--no-signoff). Then open the PR from ${FORGE_ORG}:${BRANCH_PREFIX}SLUG
        with the fork PR's current title and body minus the bot-meta
        section, plus, for DCO, a line naming the approval behind his
        sign-off (with --no-signoff, one telling maintainers to comment
        '/signoff', or how to sign off by hand where ${SIGNOFF_WORKFLOW}
        doesn't exist), link and close the fork PR, and set the board item In
        Review with Branch = the upstream PR (and Why = TEXT, if given).
        The upstream PR is a draft with --draft, or when ${REVIEWER}'s latest
        '${DRAFT_COMMAND}' or '${READY_COMMAND}' comment line is '${DRAFT_COMMAND}'. --dry-run checks
        everything and prints what would happen without changing anything.
  set-item FORK_PR_URL PVTI_... [--force]
        Change the board item recorded in a fork PR's bot-meta section,
        which promote moves to In Review, and leave the rest of the body
        as is. Like set-body, this is recorded as the bot's edit. It
        refuses if another open fork PR in that fork records the item,
        unless --force. The board's own Branch fields are not changed.
  prune-runs [--dry-run] [REPO...]
        Cancel the queued, pending and in-progress Actions runs in the
        forks REPO (default: every fork in ${FORGE_ORG}) that CI started
        for a commit since superseded: pull_request runs for a commit that
        is no longer the head of an open PR there, and push runs for one
        that is also no longer the head of its branch or the default
        branch. All forks in ${FORGE_ORG} share its runners, so every
        force-push otherwise leaves the old head's CI queued ahead of
        current work. Runs of other events (e.g. workflow_dispatch) are
        never cancelled. fork-pr and promote run this for their fork; run
        it after force-pushing to a fork PR by hand. --dry-run lists what
        would be cancelled.
  get-body FORK_PR_URL
        Print a fork PR's description without its bot-meta section, to
        edit and pass to set-body, and remember it as the base that
        set-body checks for changes.
  set-body FORK_PR_URL --body-file FILE [--force]
        Replace a fork PR's description with FILE, keeping its bot-meta
        section, and record it as the bot's, so that inbox doesn't report
        it as an edit. Use this for every change the bot makes to a fork
        PR's body, starting from get-body's output. It refuses if the body
        changed since get-body, or, without get-body, if ${REVIEWER}
        edited it since the bot last wrote it: then run get-body again,
        keep his text in FILE, and rerun (--force skips the checks).
        GitHub can't make the write conditional, so an edit in the second
        between the check and the write is still overwritten.
  inbox [--since DATE] [--dry-run]
        List the bot's open fork PRs in ${FORGE_ORG} (and, from before
        it, in ${BOT_LOGIN}'s own forks) with activity by ${REVIEWER} since the last
        check (or DATE): reviews, review and issue comments, title and body
        edits, and fork PRs he closed. Approved PRs are always listed, since
        they are waiting for 'promote'. A listed PR that isn't approved but
        has a comment of his since its last push that reads like a
        go-ahead gets a hint to ask him for '${PROMOTE_COMMAND}' or an approval.
        --dry-run doesn't record the check.
  -h, --help
        Show this help

REST is used, except to find out who edited a fork PR's body, which only
GraphQL says: one call when set-body finds a body that isn't the bot's
last write, and in inbox per fork PR whose body changed other than
through set-body. The GraphQL quota is shared with the board tooling.
Only activity whose GitHub author is the '${REVIEWER}' login counts.
The inbox state lives in the archived 'bot-state: ${STATE_NAME}' draft
item on the board, shared by every machine: each command that uses it
reads it once (one GraphQL call) and writes it at most once (two: a
checked write, merging with whatever another machine wrote meanwhile).
BOT_PR_FORGE overrides the organization (${FORGE_ORG}), and BOT_PR_GIT_URL
the prefix of the URLs git uses (${GIT_URL_PREFIX}, then OWNER/REPO).
EOF
}

# rate_limited() usually runs in a command substitution, so it can't exit
# the script itself; it leaves this flag, and fatal() passes EX_RATELIMIT on.
RATE_LIMIT_FLAG=$(mktemp -u "${TMPDIR:-/tmp}/bot-pr-ratelimit.XXXXXX")
readonly RATE_LIMIT_FLAG
trap 'rm -f "${RATE_LIMIT_FLAG}"' EXIT

fatal() {
    test -e "${RATE_LIMIT_FLAG}" && exit "${EX_RATELIMIT}"
    echo "error: $*" 1>&2
    exit 1
}

warn() {
    echo "warning: $*" 1>&2
}

info() {
    echo "$*" 1>&2
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || fatal "'$1' not found in PATH; $2"
}

rate_limited() {
    : >"${RATE_LIMIT_FLAG}"
    echo "error: GitHub is rate limiting the bot ($1); retry after $(gh api rate_limit --jq ".resources.$2.reset | todate" 2>/dev/null || echo "the reset")" 1>&2
    exit "${EX_RATELIMIT}"
}

# ghapi ARGS...: 'gh api', turning rate limiting into a clear exit and a
# 404 into EX_NOTFOUND (with no output), so callers can tell "absent" from
# "failed".
ghapi() {
    local out err rc=0
    err=$(mktemp)
    out=$(gh api "$@" 2>"${err}") || rc=$?
    if test "${rc}" -ne 0; then
        if grep -qiE 'rate limit|abuse' "${err}"; then
            local reason
            reason=$(grep -iE -m1 'rate limit|abuse' "${err}")
            rm -f "${err}"
            local resource=core
            [[ " $* " == *" search/"* ]] && resource=search
            rate_limited "${reason}" "${resource}"
        fi
        if grep -q 'HTTP 404' "${err}"; then
            rm -f "${err}"
            return "${EX_NOTFOUND}"
        fi
        cat "${err}" 1>&2
        rm -f "${err}"
        return "${rc}"
    fi
    rm -f "${err}"
    test -z "${out}" || printf '%s\n' "${out}"
}

check_login() {
    local login
    login=$(ghapi user --jq .login) || fatal "'gh api user' failed; authenticate gh as ${BOT_LOGIN}"
    test "${login}" = "${BOT_LOGIN}" || fatal "gh is authenticated as '${login}', not ${BOT_LOGIN}"
}

valid_repo() {
    [[ "$1" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]]
}

# ref_sha REPO BRANCH: prints the branch's commit, or nothing if it doesn't
# exist.
ref_sha() {
    local rc=0 sha
    sha=$(ghapi "repos/$1/git/ref/heads/$2" --jq .object.sha) || rc=$?
    test "${rc}" -eq "${EX_NOTFOUND}" && return 0
    test "${rc}" -eq 0 || fatal "cannot read branch $2 of $1"
    echo "${sha}"
}

# ensure_fork UPSTREAM: prints the forge's fork of UPSTREAM, creating it
# if needed, and waits until it is usable.
# GitHub names the fork after UPSTREAM's repository, with a suffix if the
# forge already has an unrelated repository of that name.
ensure_fork() {
    local upstream=$1 fork network rc=0
    fork=${FORGE_ORG}/${upstream#*/}
    network=$(ghapi "repos/${fork}" --jq '"\(.parent.full_name) \(.source.full_name)"') || rc=$?
    test "${rc}" -eq 0 || test "${rc}" -eq "${EX_NOTFOUND}" || fatal "cannot read ${fork}"
    if test "${rc}" -eq 0 && [[ " ${network} " == *" ${upstream} "* ]]; then
        echo "${fork}"
        return 0
    fi
    # Only the default branch: other bases are copied by sync_base.
    fork=$(ghapi -X POST "repos/${upstream}/forks" -f organization="${FORGE_ORG}" -F default_branch_only=true --jq .full_name) ||
        fatal "forking ${upstream} into ${FORGE_ORG} failed"
    info "Forking ${upstream} as ${fork}"
    # Forking is asynchronous; the fork is usable once it has its branch.
    local default waited=0
    default=$(ghapi "repos/${upstream}" --jq .default_branch) || fatal "cannot read ${upstream}"
    while test -z "$(ref_sha "${fork}" "${default}")"; do
        test "${waited}" -lt "${FORK_READY_TIMEOUT}" ||
            fatal "${fork} still has no ${default} branch after ${FORK_READY_TIMEOUT}s; rerun fork-pr once GitHub has finished forking"
        sleep "${FORK_READY_POLL}"
        waited=$((waited + FORK_READY_POLL))
    done
    echo "${fork}"
}

# The classification below only matters for workflows opted in to run on
# a fork (see fork_setup), to warn about those that can't work there.
#
# Triggers that make a scheduled workflow part of fork PRs' CI, so that
# fork_setup doesn't warn about it. Not workflow_dispatch: many upstream
# scheduled jobs (releases, dependency bumps) also allow manual runs,
# which nobody does on a fork.
readonly CI_TRIGGERS='["pull_request", "pull_request_target", "push", "merge_group"]'
# Triggers that make a workflow that needs upstream's secrets part of the
# project's build and test CI, so that fork_setup only notes that its
# failures on the fork may be the missing secrets. Not
# pull_request_target: it runs the base branch's workflow with the base
# repository's secrets, which is how projects give PR bots and triage
# jobs their tokens, and a fork has none of them.
readonly CODE_TRIGGERS='["push", "merge_group"]'
# ... and pull_request, unless limited to activity types (closed,
# labeled...) other than these, the ones for new code.
readonly CODE_PR_TYPES='["opened", "synchronize", "reopened"]'
# Triggers only a person uses: a workflow with no others never runs by
# itself, so fork_setup has no reason to warn about it.
readonly MANUAL_TRIGGERS='["workflow_dispatch", "workflow_call"]'
# A line of the header gh-aw writes into the workflows it compiles
# (*.lock.yml). They are coding agents, which need an LLM API key and app
# tokens that forks don't have, whatever their triggers.
readonly GH_AW_HEADER_RE='^# (gh-aw-metadata: |This file was automatically generated by gh-aw)'

# jq over a workflow file as JSON: prints "CLASS<TAB>TRIGGERS", plus
# "<TAB>SECRETS" if it references secrets other than GITHUB_TOKEN (as
# secrets.NAME). CLASS is one of:
#   "unknown": no readable 'on:';
#   "agentic": $agentic, a gh-aw workflow;
#   "scheduled": schedule and no CI_TRIGGERS;
#   "secrets": secrets, and neither CODE_TRIGGERS, nor pull_request for
#     CODE_PR_TYPES, nor only MANUAL_TRIGGERS: e.g. a pull_request_target
#     PR bot, or a release job for merged PRs (pull_request 'closed');
#   "mixed": schedule and some CI_TRIGGERS;
#   "unscheduled": anything else.
# TRIGGERS lists the events, each with the activity types it is limited
# to in parentheses. 'on' is YAML 1.1's boolean true, which PyYAML turns
# into the key "true".
# shellcheck disable=SC2016 # jq, not shell
readonly TRIGGERS_JQ='
def types($on): . as $e | ($on | objects | .[$e] | objects | .types | arrays | map(tostring)) // null;
(if type == "object" then [.on, .true, .True] | map(select(. != null)) | first else null end) as $on
| ($on | if type == "string" then [.]
         elif type == "array" then map(tostring)
         elif type == "object" then keys
         else [] end) as $t
| [$t[] | types($on) as $ty
  | select(IN($code[]) or (. == "pull_request" and ($ty == null or any($ty[]; IN($code_pr[])))))] as $code_t
| ([.. | strings | scan("\\bsecrets\\.([A-Za-z_][A-Za-z0-9_]*)") | .[0] | ascii_upcase
   | select(. != "GITHUB_TOKEN")] | unique) as $secrets
| (if $t == [] then "unknown"
   elif $agentic then "agentic"
   elif ($t | index("schedule")) != null and (any($t[]; IN($ci[])) | not) then "scheduled"
   elif $secrets != [] and $code_t == [] and any($t[]; IN($manual[]) | not) then "secrets"
   elif ($t | index("schedule")) != null then "mixed"
   else "unscheduled" end) as $class
| [$class, ($t | map(types($on) as $ty | if $ty then "\(.)(\($ty | join("|")))" else . end) | join(","))]
  + (if $secrets == [] then [] else [$secrets | join(",")] end)
| join("\t")
'

# How yaml_to_json converts; set by require_yaml_parser.
YAML_PARSER=""

require_yaml_parser() {
    if python3 -c 'import yaml' >/dev/null 2>&1; then
        YAML_PARSER=pyyaml
    elif command -v yq >/dev/null 2>&1; then
        if yq --version 2>&1 | grep -q mikefarah; then
            YAML_PARSER=yq-go
        else
            YAML_PARSER=yq-py
        fi
    else
        fatal "parsing workflow files needs python3 with PyYAML (e.g. dnf install python3-pyyaml) or yq"
    fi
}

# yaml_to_json < YAML: prints the (first) document as JSON.
yaml_to_json() {
    case "${YAML_PARSER}" in
        pyyaml) python3 -c '
import json, sys, yaml
try:
    doc = yaml.safe_load(sys.stdin)
except yaml.YAMLError as e:
    sys.exit(" ".join(str(e).split()))
print(json.dumps(doc, default=str))' ;;
        yq-go) yq -p yaml -o json '.' ;;
        yq-py) yq -c '.' ;;
        *) fatal "internal error: require_yaml_parser was not called" ;;
    esac
}

# classify_workflow < YAML: prints "CLASS<TAB>TRIGGERS[<TAB>SECRETS]"
# (see TRIGGERS_JQ).
classify_workflow() {
    local yaml agentic=false
    yaml=$(cat)
    ! grep -qE "${GH_AW_HEADER_RE}" <<<"${yaml}" || agentic=true
    yaml_to_json <<<"${yaml}" | jq -r --argjson ci "${CI_TRIGGERS}" --argjson code "${CODE_TRIGGERS}" \
        --argjson code_pr "${CODE_PR_TYPES}" --argjson manual "${MANUAL_TRIGGERS}" \
        --argjson agentic "${agentic}" "${TRIGGERS_JQ}"
}

# Where fork_setup's heuristics are wrong about a workflow opted in on a
# fork: "REPO/FILE" (FILE in .github/workflows of ${FORGE_ORG}/REPO) ->
# "disable" (it can't work there: warn) or "keep" (it can: don't).
declare -rA WORKFLOW_OVERRIDES=(
    # Upstream's jobs that sync files and labels to its other repositories
    # when main changes, as it does whenever fork-pr syncs the fork: they
    # need its app's key, but push isn't a sign of PR-less jobs in general.
    [infra/sync-common.yml]=disable
    [infra/sync-labels.yml]=disable
    # Hourly Renovate run with upstream's app key; its PR-time config
    # validation isn't worth an hourly failure on the fork.
    [infra/renovate.yml]=disable
)

# The Actions variable of a fork that lists the workflows opted in to run
# there (see fork_setup), separated by spaces. On the fork itself, so that
# every fork-pr run and every machine sees the same list, and cgwalters
# can change it in the fork's settings.
readonly CI_VARIABLE=BOT_PR_CI
# What --ci takes: a file name in .github/workflows.
readonly WORKFLOW_FILE_RE='^[A-Za-z0-9_.-]+\.ya?ml$'

# Set by fork_setup: the workflows left enabled on the fork (opted in).
CI_ACTIVE=()
# ... those of them with a schedule trigger, because they also run for
# PRs or pushes.
SCHEDULED_ACTIVE=()
# ... and those that reference upstream's secrets, as "FILE (SECRET,...)",
# because they run for new code: their failures on the fork may be the
# missing secrets.
SECRETS_ACTIVE=()

# active_runs FORK: prints FORK's runs that hold or wait for a runner, as
# a JSON array of {id, workflow_id, event, status, name, head_sha,
# head_branch, created_at}.
active_runs() {
    local fork=$1 status
    for status in "${ACTIVE_RUN_STATUSES[@]}"; do
        ghapi --paginate "repos/${fork}/actions/runs?status=${status}&per_page=100" \
            --jq '.workflow_runs[] | {id, workflow_id, event, status, name, head_sha, head_branch, created_at}' ||
            { warn "cannot list the ${status} Actions runs of ${fork}"; return 1; }
    done | jq -sc 'unique_by(.id)'
}

# workflow_problem FORK DEFAULT PATH: sets PROBLEM to why the workflow at
# PATH can't work on FORK (see TRIGGERS_JQ and WORKFLOW_OVERRIDES), or to
# nothing if it can, and then records it in SCHEDULED_ACTIVE or
# SECRETS_ACTIVE if it has a schedule or uses upstream's secrets. Nothing
# for a workflow that isn't on DEFAULT, such as one a fork PR adds.
workflow_problem() {
    local fork=$1 default=$2 path=$3 name=${3#.github/workflows/} yaml cls triggers secrets="" rc=0
    PROBLEM=""
    yaml=$(ghapi -H "Accept: application/vnd.github.raw+json" \
        "repos/${fork}/contents/${path}?ref=$(jq -rn --arg b "${default}" '$b | @uri')") || rc=$?
    test "${rc}" -ne "${EX_NOTFOUND}" || return 0
    if test "${rc}" -ne 0; then
        warn "cannot read ${fork}:${default}/${path}; cannot tell whether it works on the fork"
        return 0
    fi
    if ! cls=$(classify_workflow <<<"${yaml}") || test -z "${cls}"; then
        warn "cannot parse ${fork}:${default}/${path}; cannot tell whether it works on the fork"
        return 0
    fi
    IFS=$'\t' read -r cls triggers secrets <<<"${cls}"
    case "${WORKFLOW_OVERRIDES[${fork#*/}/${name}]:-}:${cls}" in
        disable:*) PROBLEM="it is listed in bot-pr's WORKFLOW_OVERRIDES (on: ${triggers})" ;;
        keep:*) ;;
        :scheduled) PROBLEM="it only runs on a schedule (on: ${triggers})" ;;
        :secrets) PROBLEM="it needs upstream's secrets (${secrets}) and doesn't test new code (on: ${triggers})" ;;
        :agentic) PROBLEM="it is a gh-aw coding agent, which needs upstream's secrets (${secrets:-none named})" ;;
        :unknown) warn "${fork}:${default}/${path} has no readable 'on:' triggers" ;;
        *)
            test "${cls}" != mixed || SCHEDULED_ACTIVE+=("${name}")
            test -z "${secrets}" || SECRETS_ACTIVE+=("${name} (${secrets})")
            ;;
    esac
}

# fork_setup FORK CLEAR [WORKFLOW...]: turn off CI on a fork in the forge.
# Its forks share one pool of runners, which one project's CI matrix per
# fork PR (bootc's is ~20 jobs) keeps busy for hours, while every change
# the bot proposes was already tested on a devspace, and upstream CI runs
# once it is promoted. So Actions stays enabled, to keep running one
# workflow possible, but every workflow is disabled except those opted in
# (the fork's CI_VARIABLE; CLEAR=true empties it first, and the WORKFLOWs
# are added to it), and the active runs of those it disables are
# cancelled. Workflows opted in are enabled whatever their state, with a
# warning if they can't work on a fork (see workflow_problem).
#
# A workflow that isn't on the default branch yet (a fork PR adding one)
# runs for that PR, being new; the next fork_setup disables it unless it
# is opted in. Idempotent. Failing to turn CI off is a warning, since the
# fork PR is useful either way; failing to record an opt-in is fatal.
fork_setup() {
    local fork=$1 clear=$2
    shift 2
    local want=("$@") w
    for w in "${want[@]}"; do
        w=${w#.github/workflows/}
        [[ "${w}" =~ ${WORKFLOW_FILE_RE} ]] ||
            fatal "--ci takes a workflow file name in .github/workflows (e.g. ci.yml), not '${w}'"
    done
    CI_ACTIVE=()
    SCHEDULED_ACTIVE=()
    SECRETS_ACTIVE=()
    ghapi -X PUT "repos/${fork}/actions/permissions" -F enabled=true -f allowed_actions=all >/dev/null ||
        warn "enabling Actions on ${fork} failed; opted-in workflows won't run there until someone does"

    local recorded rc=0 optins
    recorded=$(ghapi "repos/${fork}/actions/variables/${CI_VARIABLE}" --jq .value) || rc=$?
    if test "${rc}" -eq "${EX_NOTFOUND}"; then
        recorded=""
    elif test "${rc}" -ne 0; then
        if test "${#want[@]}" -gt 0 || ${clear}; then
            fatal "cannot read the ${CI_VARIABLE} variable of ${fork}, so cannot record the opt-in"
        fi
        warn "cannot read the ${CI_VARIABLE} variable of ${fork}, so cannot tell which workflows are opted in; leaving its workflows as they are"
        return 0
    fi
    local old=() new=()
    read -ra old <<<"${recorded}"
    ${clear} || new=("${old[@]}")
    new+=("${want[@]#.github/workflows/}")
    optins=$(printf '%s\n' "${new[@]}" | sed '/^$/d' | sort -u | paste -sd' ')
    if test "${optins}" != "$(printf '%s\n' "${old[@]}" | sed '/^$/d' | sort -u | paste -sd' ')"; then
        if test -z "${optins}"; then
            ghapi -X DELETE "repos/${fork}/actions/variables/${CI_VARIABLE}" >/dev/null ||
                fatal "removing the ${CI_VARIABLE} variable of ${fork} failed"
        elif test "${rc}" -eq "${EX_NOTFOUND}"; then
            ghapi -X POST "repos/${fork}/actions/variables" -f name="${CI_VARIABLE}" -f value="${optins}" >/dev/null ||
                fatal "creating the ${CI_VARIABLE} variable of ${fork} failed"
        else
            ghapi -X PATCH "repos/${fork}/actions/variables/${CI_VARIABLE}" -f value="${optins}" >/dev/null ||
                fatal "updating the ${CI_VARIABLE} variable of ${fork} failed"
        fi
        info "Workflows opted in on ${fork}: ${optins:-none}"
    fi

    local default workflows id state path name PROBLEM
    local disabled_ids=() disabled=() enabled=() seen=()
    default=$(ghapi "repos/${fork}" --jq .default_branch) ||
        { warn "cannot read ${fork}; check its workflows by hand"; return 0; }
    workflows=$(ghapi --paginate "repos/${fork}/actions/workflows?per_page=100" \
        --jq '.workflows[] | [.id, .state, .path] | @tsv') ||
        { warn "cannot list the workflows of ${fork}; check them by hand"; return 0; }
    while IFS=$'\t' read -r id state path; do
        test -n "${id}" || continue
        # GitHub's own dynamic workflows (CodeQL setup, Dependabot) have
        # no file and are configured elsewhere.
        [[ "${path}" == .github/workflows/* ]] || continue
        name=${path#.github/workflows/}
        if [[ " ${optins} " != *" ${name} "* ]]; then
            test "${state}" = active || continue
            if ghapi -X PUT "repos/${fork}/actions/workflows/${id}/disable" >/dev/null; then
                disabled_ids+=("${id}")
                disabled+=("${name}")
            else
                warn "disabling ${name} on ${fork} failed; it stays active"
            fi
            continue
        fi
        seen+=("${name}")
        workflow_problem "${fork}" "${default}" "${path}"
        test -z "${PROBLEM}" || warn "${name} is opted in on ${fork}, although ${PROBLEM}"
        if test "${state}" != active; then
            if ghapi -X PUT "repos/${fork}/actions/workflows/${id}/enable" >/dev/null; then
                enabled+=("${name}")
            else
                warn "enabling ${name} on ${fork} failed; it stays ${state}"
                continue
            fi
        fi
        CI_ACTIVE+=("${name}")
    done <<<"${workflows}"
    read -ra new <<<"${optins}"
    for w in "${new[@]}"; do
        [[ " ${seen[*]} " == *" ${w} "* ]] ||
            warn "${w} is opted in on ${fork} but GitHub lists no such workflow there; a fork PR adding it runs it anyway, and the next fork-setup enables it once it is listed"
    done
    test "${#enabled[@]}" -eq 0 || info "Enabled on ${fork}: ${enabled[*]}"
    test "${#disabled[@]}" -eq 0 || info "Disabled on ${fork}: ${disabled[*]}"
    if test "${#SCHEDULED_ACTIVE[@]}" -gt 0; then
        warn "opted in on ${fork} with schedule triggers, which also run: ${SCHEDULED_ACTIVE[*]}"
    fi
    if test "${#SECRETS_ACTIVE[@]}" -gt 0; then
        local list
        list=$(printf '%s, ' "${SECRETS_ACTIVE[@]}")
        warn "opted in on ${fork} although they use upstream's secrets; their failures there may just be the missing secrets: ${list%, }"
    fi
    # Disabling a workflow doesn't stop its runs already queued.
    local ncancel=0
    if test "${#disabled_ids[@]}" -gt 0; then
        local runs run_id line ids
        ids=$(printf '%s\n' "${disabled_ids[@]}" | jq -sc 'map(tonumber)')
        if runs=$(active_runs "${fork}"); then
            while IFS=$'\t' read -r run_id line; do
                test -n "${run_id}" || continue
                if ghapi -X POST "repos/${fork}/actions/runs/${run_id}/cancel" >/dev/null; then
                    ncancel=$((ncancel + 1))
                else
                    # e.g. 409: it finished in the meantime.
                    warn "cancelling ${fork} run ${run_id} failed: ${line}"
                fi
            done < <(jq -r --argjson ids "${ids}" '.[] | select(.workflow_id | IN($ids[]))
                | "\(.id)\t\(.name) for \(.event) \(.head_branch), \(.status)"' <<<"${runs}")
        else
            warn "the runs of the workflows just disabled on ${fork} may still be queued; cancel them by hand"
        fi
    fi
    local summary="off"
    test "${#CI_ACTIVE[@]}" -eq 0 ||
        summary="only ${CI_ACTIVE[*]} (opted in; '$(basename "$0") fork-setup ${fork#*/} --no-ci' turns it off)"
    test "${#disabled[@]}" -eq 0 || summary+="; ${#disabled[@]} workflow(s) disabled"
    test "${ncancel}" -eq 0 || summary+=", ${ncancel} run(s) cancelled"
    info "CI on ${fork}: ${summary}"
}

# Run statuses that still hold, or wait for, one of the organization's
# runners.
readonly ACTIVE_RUN_STATUSES=(requested waiting pending queued in_progress)
# The only events whose runs prune_runs cancels: the CI of a pushed commit.
# Runs of anything else, such as workflow_dispatch runs started on purpose
# on a bot branch, are never touched.
readonly PRUNE_EVENTS='["pull_request", "push"]'

# prune_runs FORK DRY_RUN [KEEP_SHA...]: cancels FORK's active pull_request
# and push runs for commits that were superseded, since all forks in the
# forge share its runners and a force-pushed branch otherwise leaves the
# old head's full CI queued ahead of everyone's current work. A
# pull_request run is superseded when its commit is no longer the head of
# an open PR in FORK; a push run when its commit is also no longer the
# head of its branch or of the default branch. Push runs whose ref isn't
# a branch any more (a deleted branch, a tag) are left alone. KEEP_SHAs
# are never superseded: fork-pr passes what it just pushed, in case the
# PR listing lags behind the push.
prune_runs() {
    local fork=$1 dry_run=$2
    shift 2
    [[ "${fork}" == "${FORGE_ORG}/"* ]] || return 0
    local runs
    runs=$(active_runs "${fork}" | jq -c --argjson ev "${PRUNE_EVENTS}" 'map(select(.event | IN($ev[])))') ||
        fatal "cannot list the Actions runs of ${fork}"
    if test "$(jq length <<<"${runs}")" -eq 0; then
        return 0
    fi
    local pr_heads default default_sha keep
    pr_heads=$(ghapi --paginate "repos/${fork}/pulls?state=open&per_page=100" --jq '.[].head.sha' | jq -Rsc 'split("\n") - [""]') ||
        fatal "cannot list the open PRs of ${fork}"
    default=$(ghapi "repos/${fork}" --jq .default_branch) || fatal "cannot read ${fork}"
    default_sha=$(ref_sha "${fork}" "${default}")
    keep=$(jq -nc --argjson prs "${pr_heads}" --arg d "${default_sha}" '$prs + [$d] + $ARGS.positional - [""]' --args "$@")
    # Branch heads, for push runs only, looked up once per branch.
    local branches heads="{}" branch sha
    branches=$(jq -r --argjson keep "${keep}" \
        '.[] | select(.event == "push" and (.head_sha | IN($keep[]) | not)) | .head_branch // empty' <<<"${runs}" | sort -u)
    while IFS= read -r branch; do
        test -n "${branch}" || continue
        sha=$(ref_sha "${fork}" "${branch}")
        heads=$(jq -c --arg b "${branch}" --arg s "${sha}" '.[$b] = $s' <<<"${heads}")
    done <<<"${branches}"
    local superseded ncancel=0 id line
    superseded=$(jq -r --argjson keep "${keep}" --argjson heads "${heads}" '.[]
        | select(.head_sha | IN($keep[]) | not)
        | select(.event == "pull_request"
                 or (.head_sha as $run | $heads[.head_branch // ""] // "" | . != "" and . != $run))
        | "\(.id)\t\(.event) \(.head_branch) \(.head_sha[:12]), \(.name), \(.status) since \(.created_at)"' \
        <<<"${runs}") || fatal "internal error: selecting the superseded runs of ${fork} failed"
    while IFS=$'\t' read -r id line; do
        test -n "${id}" || continue
        if ${dry_run}; then
            echo "would cancel ${fork} run ${id}: ${line}"
        elif ghapi -X POST "repos/${fork}/actions/runs/${id}/cancel" >/dev/null; then
            info "Cancelled ${fork} run ${id}: ${line}"
        else
            # e.g. 409: it finished in the meantime.
            warn "cancelling ${fork} run ${id} failed: ${line}"
            continue
        fi
        ncancel=$((ncancel + 1))
    done <<<"${superseded}"
    if ${dry_run} || test "${ncancel}" -gt 0; then
        info "${fork}: $(jq length <<<"${runs}") active pull_request/push run(s), ${ncancel} superseded$(${dry_run} || echo " and cancelled")"
    fi
}

# sync_base UPSTREAM FORK BRANCH: make the fork's copy of BRANCH match
# upstream's. The forge's forks are direct forks of upstream, so the
# default branch is synced with merge-upstream, which fails if the fork's
# copy has commits of its own: nothing should be committed there. Any
# other BRANCH is a copy (upstream may force-push it, as Renovate does),
# so it is set to the upstream commit, which the fork network already has.
sync_base() {
    local upstream=$1 fork=$2 base=$3 up_sha fork_sha default
    up_sha=$(ref_sha "${upstream}" "${base}")
    test -n "${up_sha}" || fatal "${upstream} has no branch '${base}'"
    fork_sha=$(ref_sha "${fork}" "${base}")
    if test "${fork_sha}" = "${up_sha}"; then
        info "${fork}:${base} is up to date with ${upstream}"
        return 0
    fi
    default=$(ghapi "repos/${upstream}" --jq .default_branch) || fatal "cannot read ${upstream}"
    if test "${base}" = "${default}" && test -n "${fork_sha}"; then
        ghapi -X POST "repos/${fork}/merge-upstream" -f branch="${base}" >/dev/null ||
            fatal "syncing ${fork}:${base} with ${upstream} failed; if it has commits of its own, reset it to ${upstream}:${base}"
    elif test -z "${fork_sha}"; then
        ghapi -X POST "repos/${fork}/git/refs" -f ref="refs/heads/${base}" -f sha="${up_sha}" >/dev/null ||
            fatal "creating ${fork}:${base} at ${upstream}'s ${up_sha} failed"
    else
        ghapi -X PATCH "repos/${fork}/git/refs/heads/${base}" -f sha="${up_sha}" -F force=true >/dev/null ||
            fatal "updating ${fork}:${base} to ${upstream}'s ${up_sha} failed"
    fi
    fork_sha=$(ref_sha "${fork}" "${base}")
    test "${fork_sha}" = "${up_sha}" ||
        warn "${fork}:${base} is at ${fork_sha}, not upstream's ${up_sha}; the fork PR's diff may include extra commits"
    info "Synced ${fork}:${base} with ${upstream} (${up_sha:0:12})"
}

# push_branch DIR FORK BRANCH: pushes BRANCH from the git repository DIR to
# the fork, if DIR has it. An existing fork branch is only fast-forwarded:
# replacing reviewed commits is a deliberate force-push, not fork-pr's job.
push_branch() {
    local dir=$1 fork=$2 branch=$3 sha
    require_cmd git "install git"
    sha=$(git -C "${dir}" rev-parse -q --verify "refs/heads/${branch}^{commit}" 2>/dev/null) || return 0
    # Quietly: GitHub's "create a pull request" hint doesn't apply here.
    local out
    out=$(git -C "${dir}" push -q "$(git_url "${fork}")" "${sha}:refs/heads/${branch}" 2>&1) ||
        fatal "pushing ${branch} from ${dir} to ${fork} failed: ${out}"
    info "Pushed ${branch} (${sha:0:12}) to ${fork}"
}

# The bot-meta section appended to fork PR bodies. Its "Upstream:" and
# "Board item:" lines are parsed back by promote.
meta_section() {
    local upstream=$1 base=$2 item=$3 notes list
    if test "${#CI_ACTIVE[@]}" -eq 0; then
        notes=$'\n'"- Fork CI: off; the devspace testing described above is this PR's CI, and upstream CI runs once it is opened there"
    else
        list=$(printf "\`%s\`, " "${CI_ACTIVE[@]}")
        notes=$'\n'"- Fork CI: only ${list%, }, opted in on this fork"
    fi
    if test "${#SCHEDULED_ACTIVE[@]}" -gt 0; then
        list=$(printf "\`%s\`, " "${SCHEDULED_ACTIVE[@]}")
        notes+=$'\n'"- Opted in with scheduled triggers: ${list%, } (they also run for PRs or pushes)"
    fi
    if test "${#SECRETS_ACTIVE[@]}" -gt 0; then
        list=$(printf "\`%s\`, " "${SECRETS_ACTIVE[@]}")
        notes+=$'\n'"- Opted in although they use upstream's secrets: ${list%, } (a failure there may just be a missing secret)"
    fi
    cat <<EOF
${META_START}
---

**Review draft in ${FORGE_ORG}, not upstream yet.** This section is removed when the PR is opened upstream.

- Upstream: \`${upstream}\`, base \`${base}\`
- Board item: \`${item}\`${notes}

To review:
- **Approve**, or comment \`${PROMOTE_COMMAND}\` on a line of its own, to open it upstream, ready for review. Either covers only the commits pushed so far.
- If upstream requires DCO, approving also signs off: promote adds \`${SIGNOFF_TRAILER}\` to the commits lacking it (the bot's and yours; anyone else's only if you ask), with you as committer.
- Add a \`${DRAFT_COMMAND}\` line (in the same comment or before) to open it upstream as a draft (\`${READY_COMMAND}\` undoes that).
- **Close** to drop it.
- Edit the title and description freely: they become the upstream PR's. Review comments are squashed into the commits they concern, with a reply here.
${META_END}
EOF
}

# jq definitions for fork PR bodies. Bodies edited in the web UI use CRLF.
# shellcheck disable=SC2016 # jq, not shell
readonly BODY_JQ='
def normalize: (. // "") | gsub("\r\n"; "\n");
def meta: normalize | [match("<!-- bot-meta -->[\\s\\S]*?<!-- /bot-meta -->").string] | first // "";
def strip_meta: normalize | gsub("\\s*<!-- bot-meta -->[\\s\\S]*?<!-- /bot-meta -->"; "") | sub("\\s+$"; "");
def excerpt($n): normalize | gsub("\\s+"; " ") | if length > $n then .[:$n] + "..." else . end;
'

# Inbox state: {version, last_check, prs: {URL: {body, seen, edits_seen,
# bot_body, base_body, reviewer_edit}}, closed: {URL: closed_at}}. Body edits
# have no REST event, so they show up as a change of 'body', the sha256 of
# the body inbox last saw; 'seen' is when a PR's activity was last
# reported, and 'edits_seen' how many body edits GitHub listed when inbox
# last asked who made them. 'bot_body' is the hash of the body fork-pr or
# set-body last wrote: a body that is the bot's own last write needs no
# GraphQL call to know it isn't the reviewer's. 'base_body' is the hash
# get-body printed, which set-body compares with. 'reviewer_edit' is
# {at, note}: an edit by the reviewer (or, with GraphQL down, possibly by
# him) that set-body replaced before inbox saw it. 'closed' holds when
# the closed fork PRs that inbox already reported were closed, for as long
# as its search can still find them.
lock_state() {
    require_cmd flock "install util-linux"
    mkdir -p "${STATE_DIR}" || fatal "cannot create ${STATE_DIR}"
    exec {STATE_LOCK_FD}>"${STATE_DIR}/lock" || fatal "cannot open ${STATE_DIR}/lock"
    flock -w 60 "${STATE_LOCK_FD}" || fatal "another $(basename "$0") run holds ${STATE_DIR}/lock"
}

# board_failed STATUS MESSAGE: after a failed bot-board call, pass a
# rate-limit exit on (bot-board said why), else fail.
board_failed() {
    if test "$1" -eq "${EX_RATELIMIT}"; then
        : >"${RATE_LIMIT_FLAG}"
        exit "${EX_RATELIMIT}"
    fi
    fatal "$2"
}

# load_state [--untracked]: prints the inbox state, tracked for save_state
# unless --untracked (for a run that won't save). Needs lock_state, unless
# --untracked. A state file from before the board kept it is merged in,
# with the board's entries taking precedence, until save_state succeeds.
load_state() {
    local track=(--track) state rc=0
    test "${1:-}" != --untracked || track=()
    state=$("${BOT_BOARD}" state-get "${track[@]}" "${STATE_NAME}") || rc=$?
    test "${rc}" -eq 0 || board_failed "${rc}" "reading the inbox state (bot-state: ${STATE_NAME}) failed"
    if test -s "${LEGACY_STATE_FILE}"; then
        state=$(jq -c --slurpfile old "${LEGACY_STATE_FILE}" '$old[0] * .' <<<"${state}") ||
            fatal "cannot parse ${LEGACY_STATE_FILE}, the old inbox state; move it away"
    fi
    jq -c --argjson v "${STATE_VERSION}" '
        if . == {} then {version: $v, prs: {}, closed: {}}
        elif .version == $v then . else error("unsupported state version \(.version)") end' <<<"${state}" ||
        fatal "cannot use the inbox state (bot-state: ${STATE_NAME}); fix it, or empty it to start over"
}

# save_state JSON: writes the inbox state that load_state read, changed,
# unless it is unchanged.
save_state() {
    local rc=0
    "${BOT_BOARD}" state-put --checked "${STATE_NAME}" "$1" || rc=$?
    test "${rc}" -eq 0 ||
        board_failed "${rc}" "writing the inbox state (bot-state: ${STATE_NAME}) failed; bot-board keeps the changes locally for the next run"
    if test -e "${LEGACY_STATE_FILE}"; then
        mv -f "${LEGACY_STATE_FILE}" "${LEGACY_STATE_FILE}.migrated" ||
            fatal "cannot move ${LEGACY_STATE_FILE} away; it is on the board now, so remove it"
        info "Moved the inbox state from ${LEGACY_STATE_FILE} to the board (bot-state: ${STATE_NAME}); the old file is ${LEGACY_STATE_FILE}.migrated"
    fi
}

# body_hash < PR_JSON
body_hash() {
    jq -r "${BODY_JQ} .body | normalize" | sha256sum | cut -d' ' -f1
}

# body_edits REPO NUMBER: prints the edits of a PR's body as JSON,
# {total, nodes: [{at, by}]} with the newest 100 nodes, newest first. The
# first edit also adds a node for the original body, by the PR's author.
# REST doesn't say who edited a body, so this is a GraphQL call; on
# failure (rate limits included) it returns nonzero rather than exiting,
# so callers can fall back.
body_edits() {
    # shellcheck disable=SC2016 # GraphQL variables, not shell
    local query='query($owner: String!, $name: String!, $number: Int!) {
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      userContentEdits(first: 100) { totalCount nodes { editedAt editor { login } } }
    }
  }
}'
    gh api graphql -f query="${query}" -f owner="${1%%/*}" -f name="${1#*/}" -F number="$2" \
        --jq '.data.repository.pullRequest.userContentEdits
              | {total: .totalCount, nodes: [.nodes[] | {at: .editedAt, by: (.editor.login // "ghost")}]}' 2>/dev/null
}

# jq over body_edits output, with $bot and $r the bot's and reviewer's
# logins. Edits are told apart by their order, not their time, which is
# GitHub's clock and may be the same second for several.
# shellcheck disable=SC2016 # jq, not shell
readonly EDITS_JQ='
def since_bot: .nodes | (map(.by == $bot) | index(true)) as $i | .[:($i // length)];
def reviewers: [.[] | select(.by == $r) | .at] | reverse | .[];
'

# recorded_item < PR_JSON: prints the board item in the PR's bot-meta
# section, if any.
recorded_item() {
    jq -r --arg re "Board item: \`(${ITEM_ID_RE})\`" "${BODY_JQ}"' .body | meta | [match($re).captures[0].string] | first // empty'
}

# check_item_free FORK ITEM SELF_URL SELF_BRANCH: fails unless no open PR
# in FORK other than SELF_URL or the one from SELF_BRANCH records ITEM in
# its bot-meta section. Two fork PRs for one item are usually a copied
# id, and promote would then move the wrong item.
check_item_free() {
    local fork=$1 item=$2 self_url=$3 self_branch=$4 prs others
    prs=$(ghapi --paginate "repos/${fork}/pulls?state=open&per_page=100" --jq '.[] | @json') ||
        fatal "cannot list the open PRs of ${fork}"
    others=$(while IFS= read -r pr; do
        test -n "${pr}" || continue
        test "$(recorded_item <<<"${pr}")" = "${item}" || continue
        jq -r --arg u "${self_url}" --arg b "${self_branch}" 'select(.html_url != $u and .head.ref != $b) | .html_url' <<<"${pr}"
    done <<<"${prs}" | paste -sd' ')
    test -z "${others}" ||
        fatal "board item ${item} is already recorded as the item of the open fork PR(s) ${others}. A PR split off another needs its own board item (bot-board add or draft). Pass --force if this PR belongs to ${item} as well, or fix the other PR's recorded item with '$(basename "$0") set-item FORK_PR_URL PVTI_...'"
}

cmd_fork_pr() {
    local upstream="" base="" branch="" item="" title="" body_file="" from=. force=false ci=()
    while test $# -gt 0; do
        case "$1" in
            --force) force=true; shift ;;
            --repo|--base|--branch|--item|--title|--body-file|--from|--ci)
                test $# -ge 2 || fatal "$1 requires an argument"
                case "$1" in
                    --repo) upstream=$2 ;;
                    --base) base=$2 ;;
                    --branch) branch=$2 ;;
                    --item) item=$2 ;;
                    --title) title=$2 ;;
                    --body-file) body_file=$2 ;;
                    --from) from=$2 ;;
                    --ci) ci+=("$2") ;;
                esac
                shift 2
                ;;
            *) fatal "unknown argument for fork-pr: $1 (see --help)" ;;
        esac
    done
    local opt var
    for opt in upstream:--repo base:--base branch:--branch item:--item title:--title body_file:--body-file; do
        var=${opt%%:*}
        test -n "${!var}" || fatal "fork-pr requires ${opt#*:}"
    done
    valid_repo "${upstream}" || fatal "--repo must be OWNER/REPO, not '${upstream}'"
    case "${upstream%%/*}" in
        "${BOT_LOGIN}"|"${FORGE_ORG}") fatal "--repo is the upstream repository, not a fork" ;;
    esac
    [[ "${branch}" == "${BRANCH_PREFIX}"?* ]] || fatal "--branch must be ${BRANCH_PREFIX}<slug>, not '${branch}'"
    [[ "${item}" =~ ^${ITEM_ID_RE}$ ]] || fatal "--item must be a board item id (PVTI_...), not '${item}'"
    test -s "${body_file}" || fatal "--body-file '${body_file}' is missing or empty"
    local body
    body=$(<"${body_file}")
    ! grep -qF "${META_START}" <<<"${body}" || fatal "${body_file} already has a bot-meta section; fork-pr adds it"
    grep -qxF "${LLMS_TRAILER}" <<<"${body}" ||
        warn "${body_file} has no '${LLMS_TRAILER}' line; add one unless the project's policy says otherwise"
    require_yaml_parser
    check_login

    local fork owner
    fork=$(ensure_fork "${upstream}")
    owner=${fork%%/*}
    ${force} || check_item_free "${fork}" "${item}" "" "${branch}"
    # Before sync_base, whose push to the fork would start its CI.
    fork_setup "${fork}" false "${ci[@]}"
    sync_base "${upstream}" "${fork}" "${base}"
    push_branch "${from}" "${fork}" "${branch}"

    local head_sha compare ahead behind
    head_sha=$(ref_sha "${fork}" "${branch}")
    test -n "${head_sha}" || fatal "${fork} has no branch ${branch}; run fork-pr in a clone that has it (or pass --from), or push it first"
    # The push, or an earlier force-push by hand, may have left the old
    # head's CI queued; and sync_base moves the base.
    prune_after_push "${fork}" "${head_sha}"
    compare=$(ghapi "repos/${upstream}/compare/${base}...${owner}:${branch}" --jq '"\(.ahead_by) \(.behind_by)"') ||
        fatal "cannot compare ${branch} with ${upstream}:${base}"
    read -r ahead behind <<<"${compare}"
    test "${ahead}" -gt 0 || fatal "${branch} has no commits on top of ${upstream}:${base}"
    test "${behind}" -eq 0 || info "note: ${branch} is ${behind} commit(s) behind ${upstream}:${base}; promote rebases it"

    local existing
    existing=$(ghapi -X GET "repos/${upstream}/pulls" -f head="${owner}:${branch}" -f state=open --jq '.[0].html_url // empty') ||
        fatal "cannot list the PRs of ${upstream}"
    test -z "${existing}" || fatal "${branch} is already open upstream as ${existing}"
    existing=$(ghapi -X GET "repos/${fork}/pulls" -f head="${owner}:${branch}" -f state=open --jq '.[0] // empty') ||
        fatal "cannot list the PRs of ${fork}"
    if test -n "${existing}"; then
        local existing_url recorded
        existing_url=$(jq -r .html_url <<<"${existing}")
        recorded=$(recorded_item <<<"${existing}")
        info "A fork PR for ${branch} is already open; not opening another"
        test "${recorded}" = "${item}" ||
            warn "${existing_url} records board item ${recorded:-(none)}, not ${item}; if --item is right, run '$(basename "$0") set-item ${existing_url} ${item}'"
        echo "${existing_url}"
        return 0
    fi

    local full_body url
    full_body="${body}"$'\n\n'"$(meta_section "${upstream}" "${base}" "${item}")"
    local created
    created=$(jq -n --arg title "${title}" --arg head "${branch}" --arg base "${base}" --arg body "${full_body}" \
        '{title: $title, head: $head, base: $base, body: $body, draft: true}' |
        ghapi -X POST "repos/${fork}/pulls" --input -) ||
        fatal "opening the draft PR in ${fork} failed"
    url=$(jq -r .html_url <<<"${created}")
    # So that inbox reports even edits made before its next run. In a
    # subshell: the PR exists now, so a failure here is only a warning.
    (
        lock_state
        state=$(load_state)
        hash=$(body_hash <<<"${created}")
        save_state "$(jq -c --arg u "${url}" --arg h "${hash}" --arg now "$(date -u +%FT%TZ)" \
            '.prs[$u] = {body: $h, seen: $now, bot_body: $h}' <<<"${state}")"
    ) || warn "recording ${url} in the inbox state failed; inbox will pick it up without its original body"

    local perm
    perm=$(ghapi "repos/${fork}/collaborators/${REVIEWER}/permission" --jq .permission 2>/dev/null) || perm=unknown
    case "${perm}" in
        admin|maintain|write) ;;
        *) warn "${REVIEWER} has '${perm}' access to ${fork}, so he can review and comment but not edit the title and body" ;;
    esac
    echo "${url}"
}

cmd_set_item() {
    local url="" item="" force=false
    while test $# -gt 0; do
        case "$1" in
            --force) force=true; shift ;;
            -*) fatal "unknown argument for set-item: $1 (see --help)" ;;
            *)
                if test -z "${url}"; then url=$1
                elif test -z "${item}"; then item=$1
                else fatal "set-item takes one fork PR URL and one item"
                fi
                shift
                ;;
        esac
    done
    if test -z "${url}" || test -z "${item}"; then
        fatal "usage: $(basename "$0") set-item FORK_PR_URL PVTI_... [--force]"
    fi
    [[ "${item}" =~ ^${ITEM_ID_RE}$ ]] || fatal "ITEM must be a board item id (PVTI_...), not '${item}'"
    local FORK NUMBER PR HIS EDITS_UNKNOWN
    parse_fork_pr_url "${url}"
    check_login
    lock_state
    local state recorded body
    state=$(load_state)
    read_fork_pr "${url}"
    recorded=$(recorded_item <<<"${PR}")
    if test "${recorded}" = "${item}"; then
        info "${url} already records board item ${item}"
        return 0
    fi
    ${force} || check_item_free "${FORK}" "${item}" "${url}" ""
    # Only the bot-meta section changes; without a Board item line (a
    # hand-edited section), one goes after the Upstream line.
    body=$(jq -r --arg item "${item}" --arg re "Board item: \`${ITEM_ID_RE}\`" "${BODY_JQ}"'
        .body | strip_meta + "\n\n" + (meta
            | if test($re) then sub($re; "Board item: `\($item)`")
              else sub("(?<u>- Upstream: [^\n]*)"; "\(.u)\n- Board item: `\($item)`") end)' <<<"${PR}")
    [[ "${body}" == *"Board item: \`${item}\`"* ]] ||
        fatal "cannot find where to record the item in ${url}'s bot-meta section; restore its '- Upstream:' line"
    reviewer_edits_since_bot "${url}"
    write_body "${url}" "${body}" "kept; then set-item changed the board item" true
    info "${url} now records board item ${item} (was ${recorded:-none}); set the items' Branch fields with bot-board if they need it"
}

cmd_fork_setup() {
    test $# -gt 0 || fatal "fork-setup requires REPO (see --help)"
    require_yaml_parser
    # Hidden, for tests: classify one workflow file offline.
    if test "$1" = --classify-file; then
        test $# -eq 2 || fatal "--classify-file requires exactly one FILE"
        classify_workflow <"$2" || fatal "cannot parse $2"
        return 0
    fi
    local fork="" clear=false ci=()
    while test $# -gt 0; do
        case "$1" in
            --no-ci) clear=true; shift ;;
            --ci)
                test $# -ge 2 || fatal "--ci requires a WORKFLOW"
                ci+=("$2")
                shift 2
                ;;
            -*) fatal "unknown argument for fork-setup: $1 (see --help)" ;;
            *)
                test -z "${fork}" || fatal "fork-setup takes a single REPO"
                fork=$1
                shift
                ;;
        esac
    done
    test -n "${fork}" || fatal "fork-setup requires REPO (see --help)"
    local arg=${fork}
    [[ "${fork}" == */* ]] || fork=${FORGE_ORG}/${fork}
    if ! valid_repo "${fork}" || test "${fork%%/*}" != "${FORGE_ORG}"; then
        fatal "fork-setup takes a fork in ${FORGE_ORG} (REPO or ${FORGE_ORG}/REPO), not '${arg}'"
    fi
    check_login
    local rc=0
    ghapi "repos/${fork}" --jq .fork >/dev/null || rc=$?
    test "${rc}" -ne "${EX_NOTFOUND}" || fatal "${fork} does not exist"
    test "${rc}" -eq 0 || fatal "cannot read ${fork}"
    fork_setup "${fork}" "${clear}" "${ci[@]}"
}

cmd_prune_runs() {
    local dry_run=false repos=() repo
    while test $# -gt 0; do
        case "$1" in
            --dry-run) dry_run=true; shift ;;
            -*) fatal "unknown argument for prune-runs: $1 (see --help)" ;;
            *)
                repo=$1
                [[ "${repo}" == */* ]] || repo=${FORGE_ORG}/${repo}
                if ! valid_repo "${repo}" || test "${repo%%/*}" != "${FORGE_ORG}"; then
                    fatal "prune-runs takes forks in ${FORGE_ORG} (REPO or ${FORGE_ORG}/REPO), not '$1'"
                fi
                repos+=("${repo}")
                shift
                ;;
        esac
    done
    check_login
    if test "${#repos[@]}" -eq 0; then
        local listed
        listed=$(ghapi --paginate "orgs/${FORGE_ORG}/repos?per_page=100" \
            --jq '.[] | select(.fork and (.archived | not)) | .full_name') ||
            fatal "cannot list the repositories of ${FORGE_ORG}"
        mapfile -t repos <<<"${listed}"
    fi
    # One fork failing doesn't keep the others' runs queued.
    local failed=()
    for repo in "${repos[@]}"; do
        test -n "${repo}" || continue
        (prune_runs "${repo}" "${dry_run}") || failed+=("${repo}")
    done
    test "${#failed[@]}" -eq 0 || fatal "pruning the runs of ${failed[*]} failed"
}

# prune_after_push FORK [KEEP_SHA...]: prune_runs for commands that push,
# where a failure must not fail the push.
prune_after_push() {
    (prune_runs "$1" false "${@:2}") || warn "cancelling superseded Actions runs in $1 failed; rerun '$(basename "$0") prune-runs ${1#*/}'"
}

# read_fork_pr URL: sets FORK, NUMBER and PR (the PR's JSON) for an open
# fork PR of the bot's that has a bot-meta section.
read_fork_pr() {
    parse_fork_pr_url "$1"
    PR=$(ghapi "repos/${FORK}/pulls/${NUMBER}") || fatal "cannot read $1"
    test "$(jq -r .user.login <<<"${PR}")" = "${BOT_LOGIN}" || fatal "$1 was not opened by ${BOT_LOGIN}"
    test "$(jq -r .state <<<"${PR}")" = open || fatal "$1 is not open"
    test -n "$(jq -r "${BODY_JQ} .body | meta" <<<"${PR}")" ||
        fatal "$1 has no complete ${META_START} ... ${META_END} section; was it opened with fork-pr? Restore it in the PR body"
}

cmd_get_body() {
    test $# -eq 1 || fatal "usage: $(basename "$0") get-body FORK_PR_URL"
    local url=$1 FORK NUMBER PR state
    check_login
    lock_state
    state=$(load_state)
    read_fork_pr "${url}"
    save_state "$(jq -c --arg u "${url}" --arg h "$(body_hash <<<"${PR}")" \
        '.prs[$u] = ((.prs[$u] // {}) + {base_body: $h})' <<<"${state}")"
    jq -r "${BODY_JQ} .body | strip_meta" <<<"${PR}"
}

cmd_set_body() {
    local url="" body_file="" force=false
    while test $# -gt 0; do
        case "$1" in
            --body-file) test $# -ge 2 || fatal "--body-file requires an argument"; body_file=$2; shift 2 ;;
            --force) force=true; shift ;;
            -*) fatal "unknown argument for set-body: $1 (see --help)" ;;
            *) test -z "${url}" || fatal "set-body takes one fork PR URL"; url=$1; shift ;;
        esac
    done
    if test -z "${url}" || test -z "${body_file}"; then
        fatal "usage: $(basename "$0") set-body FORK_PR_URL --body-file FILE [--force]"
    fi
    test -s "${body_file}" || fatal "--body-file '${body_file}' is missing or empty"
    local FORK NUMBER PR
    parse_fork_pr_url "${url}"
    check_login
    # Held from the check to the write, so that an inbox run can't
    # record the reviewer's edit as seen in between.
    lock_state
    local state meta body
    state=$(load_state)
    read_fork_pr "${url}"
    meta=$(jq -r "${BODY_JQ} .body | meta" <<<"${PR}")
    # FILE may have the section or not; the PR's current one is kept
    # either way.
    body=$(jq -Rsr "${BODY_JQ} strip_meta" <"${body_file}")
    test -n "${body}" || fatal "${body_file} has nothing besides a bot-meta section"
    ! grep -qF 'bot-meta' <<<"${body}" || fatal "${body_file} mentions bot-meta outside a complete section; fix its markers"
    grep -qxF "${LLMS_TRAILER}" <<<"${body}" ||
        warn "${body_file} has no '${LLMS_TRAILER}' line; add one unless the project's policy says otherwise"

    local hash base_body HIS EDITS_UNKNOWN
    hash=$(body_hash <<<"${PR}")
    base_body=$(jq -r --arg u "${url}" '.prs[$u].base_body // "-"' <<<"${state}")
    reviewer_edits_since_bot "${url}"
    local redo
    redo="run '$(basename "$0") get-body ${url} > ${body_file}', keep his text, and rerun set-body"
    if ! ${force}; then
        if test "${base_body}" != -; then
            test "${hash}" = "${base_body}" ||
                fatal "${url}'s body changed since get-body${HIS:+ (${REVIEWER} edited it)}; ${redo}"
        else
            ! ${EDITS_UNKNOWN} ||
                fatal "cannot tell whether ${REVIEWER} edited ${url}'s body (GraphQL failed); ${redo}"
            test -z "${HIS}" ||
                fatal "${REVIEWER} edited ${url}'s body since the bot last wrote it (at $(sort <<<"${HIS}" | paste -sd' ')); ${redo}"
        fi
    fi
    local how="then replaced with set-body"
    ! ${force} || how+=" --force"
    write_body "${url}" "${body}"$'\n\n'"${meta}" "${how}"
    info "Updated the body of ${url}"
}

# reviewer_edits_since_bot URL: for the fork PR that read_fork_pr read,
# with the inbox state in 'state', sets HIS to the times of REVIEWER's
# body edits since the bot last wrote the body (none if it still is that
# write), or EDITS_UNKNOWN to true if GraphQL couldn't say.
reviewer_edits_since_bot() {
    local url=$1 bot_body edits
    HIS="" EDITS_UNKNOWN=false
    bot_body=$(jq -r --arg u "${url}" '.prs[$u].bot_body // "-"' <<<"${state}")
    test "$(body_hash <<<"${PR}")" != "${bot_body}" || return 0
    if edits=$(body_edits "${FORK}" "${NUMBER}"); then
        HIS=$(jq -r --arg bot "${BOT_LOGIN}" --arg r "${REVIEWER}" "${EDITS_JQ} since_bot | reviewers" <<<"${edits}")
    else
        EDITS_UNKNOWN=true
    fi
}

# write_body URL BODY HOW: replaces the body of the fork PR that
# read_fork_pr read with BODY, and records it in 'state' as the bot's
# write. The reviewer's edits found by reviewer_edits_since_bot (HIS,
# EDITS_UNKNOWN) that inbox hasn't reported yet are kept for it to show,
# noting HOW they were followed up. With KEEP_BASE true (a write that
# leaves the text outside bot-meta alone), a get-body base that still
# matched carries over to the new body, and one that didn't stays, so
# that set-body keeps refusing over the edits it would lose. Needs
# lock_state.
write_body() {
    local url=$1 body=$2 how=$3 keep_base=${4:-false} seen_body updated pending=null
    seen_body=$(jq -r --arg u "${url}" '.prs[$u].body // "-"' <<<"${state}")
    updated=$(jq -n --arg body "${body}" '{body: $body}' |
        ghapi -X PATCH "repos/${FORK}/pulls/${NUMBER}" --input -) || fatal "updating the body of ${url} failed"
    if test "$(body_hash <<<"${PR}")" != "${seen_body}"; then
        if test -n "${HIS}"; then
            pending=$(jq -nc --arg at "$(sort <<<"${HIS}" | tail -n1)" --arg n " (${how})" '{at: $at, note: $n}')
        elif ${EDITS_UNKNOWN}; then
            pending=$(jq -nc --arg at "$(jq -r .updated_at <<<"${PR}")" \
                --arg n " (possibly by ${REVIEWER}: GraphQL was down; ${how})" '{at: $at, note: $n}')
        fi
    fi
    save_state "$(jq -c --arg u "${url}" --arg h "$(body_hash <<<"${updated}")" --arg old "$(body_hash <<<"${PR}")" \
        --argjson keep "${keep_base}" --argjson p "${pending}" '
        .prs[$u] = ((.prs[$u] // {}) + {bot_body: $h}
            | if $keep | not then del(.base_body) elif .base_body == $old then .base_body = $h else . end
            | if $p != null then .reviewer_edit = $p else . end)' <<<"${state}")"
}

# The reviewer's comments, reviews and inline review comments on a fork
# PR, as a JSON array of {kind, at, url, state, body, path}, plus the
# bot's sign-off records (kind "signoff"; see SIGNOFF_RECORD).
reviewer_activity() {
    local fork=$1 number=$2
    {
        ghapi --paginate "repos/${fork}/pulls/${number}/reviews?per_page=100" \
            --jq ".[] | select(.user.login == \"${REVIEWER}\")
                  | {kind: \"review\", at: .submitted_at, created: .submitted_at, url: .html_url, state, body, id, commit_id}" ||
            fatal "cannot list the reviews of ${fork}#${number}"
        ghapi --paginate "repos/${fork}/pulls/${number}/comments?per_page=100" \
            --jq ".[] | select(.user.login == \"${REVIEWER}\")
                  | {kind: \"review comment\", at: .updated_at, created: .created_at, url: .html_url, body, path}" ||
            fatal "cannot list the review comments of ${fork}#${number}"
        ghapi --paginate "repos/${fork}/issues/${number}/comments?per_page=100" \
            --jq ".[] | if .user.login == \"${REVIEWER}\" then
                      {kind: \"comment\", at: .updated_at, created: .created_at, url: .html_url, body}
                  elif .user.login == \"${BOT_LOGIN}\" then
                      (.body // \"\" | capture(\"${SIGNOFF_RECORD_RE}\"))
                      + {kind: \"signoff\", at: .created_at, created: .created_at, url: .html_url}
                  else empty end" ||
            fatal "cannot list the comments of ${fork}#${number}"
    } | jq -sc .
}

# jq over reviewer_activity output, with \$head the PR's head commit and
# \$pushed when it became the head (see push_time; empty if unknown or not
# looked up): whether the latest approval or verdict approves (a later
# dismissal or change request cancels it) and approved the current head,
# since commits pushed after it are unreviewed; except the bot's own push
# that added REVIEWER's sign-off to the head his review approved, as
# recorded in a comment (see add_signoff), which leaves it approved (and
# which promote checks in git, see verify_record: only the bot can write
# the comment, but it writes what it's told). A '${PROMOTE_COMMAND}' comment
# names no commit, so after that push he needs to comment again. A conversation comment
# with a '${PROMOTE_COMMAND}' line approves the head it was written on:
# the current one if written after \$pushed, else an older one. Also:
# whether the latest '${DRAFT_COMMAND}' or '${READY_COMMAND}' line in a comment or review
# body asks for a draft, and the URL of the latest comment since \$pushed
# that reads like a go-ahead (\$go_ahead) without a '${PROMOTE_COMMAND}' line.
readonly VERDICT_JQ="
def has_line(\$cmd): (.body // \"\") | gsub(\"\\r\"; \"\") | split(\"\\n\") | any(gsub(\"^[ \\t]+|[ \\t]+\$\"; \"\") == \$cmd);
def promotions: [.[] | select(.kind == \"comment\" and has_line(\"${PROMOTE_COMMAND}\"))
    | {kind: \"review\", state: \"APPROVED\", at: .created, url, id: null, via: \"${PROMOTE_COMMAND}\",
       commit_id: (if \$pushed != \"\" and .created > \$pushed then \$head else null end)}];
def approval: [(.[] | select(.kind == \"review\" and (.state | IN(\"APPROVED\", \"CHANGES_REQUESTED\", \"DISMISSED\")))),
        promotions[]]
    | sort_by(.at) | last;
def approved_any: approval.state == \"APPROVED\";
def signed_off(\$a): any(.[]; .kind == \"signoff\" and .signed == \$head and .approval == \$a.url
    and \$a.commit_id != null and \$a.commit_id == .approved);
def approved: approved_any and (approval.commit_id == \$head or signed_off(approval));
def wants_draft: [.[] | {at, cmd: ((.body // \"\") | gsub(\"\\r\"; \"\")
        | [scan(\"(?:^|\\n)[ \\t]*(${DRAFT_COMMAND}|${READY_COMMAND})[ \\t]*(?=\\n|\$)\")[0]] | last)}
    | select(.cmd != null)] | sort_by(.at) | last | .cmd == \"${DRAFT_COMMAND}\";
def go_aheads: [.[] | select(.kind != \"review comment\" and (.state // \"\" | IN(\"APPROVED\", \"CHANGES_REQUESTED\") | not)
        and (has_line(\"${PROMOTE_COMMAND}\") | not) and ((.body // \"\") | test(\$go_ahead; \"i\")))];
def needs_push_time: (promotions | length > 0) or (go_aheads | length > 0);
def go_ahead: [go_aheads[] | select(\$pushed == \"\" or .created > \$pushed)] | sort_by(.created) | last | .url // empty;
"

# verdict JQ: prints JQ, with VERDICT_JQ's definitions, over the caller's
# 'activity', with its 'head_sha' and 'pushed'.
verdict() {
    jq -r --arg head "${head_sha}" --arg pushed "${pushed}" --arg go_ahead "${GO_AHEAD_RE}" \
        "${VERDICT_JQ} $1" <<<"${activity}"
}

# dco_required REPO BASE: prints true if pushes to BASE in REPO need the
# DCO check, else false. Only the branch rules count, not what
# CONTRIBUTING says.
dco_required() {
    local repo=$1 base=$2 checks
    checks=$(ghapi -X GET "repos/${repo}/rules/branches/${base}" \
        --jq '.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context') || {
        warn "cannot read the branch rules of ${repo}:${base}; if it requires DCO, sign off or add a note to the PR by hand"
        echo false
        return 0
    }
    if grep -qiF "${DCO_CHECK}" <<<"${checks}"; then echo true; else echo false; fi
}

# dco_note REPO BASE: prints a line for the body of an upstream PR into a
# repository that requires DCO, telling the maintainers how to sign off
# its commits, for when promote didn't add REVIEWER's sign-off.
dco_note() {
    local repo=$1 base=$2 rc=0
    ghapi -X GET "repos/${repo}/contents/${SIGNOFF_WORKFLOW}" -f ref="${base}" --jq .path >/dev/null || rc=$?
    if test "${rc}" -eq 0; then
        # shellcheck disable=SC2016 # literal backticks
        echo 'Maintainers: this repository requires DCO; comment `/signoff` to add your `Signed-off-by` to these commits.'
    else
        test "${rc}" -eq "${EX_NOTFOUND}" || warn "cannot tell whether ${repo} has ${SIGNOFF_WORKFLOW}; describing the manual signoff"
        echo "Maintainers: this repository requires DCO, and these commits have no \`Signed-off-by\`. To add yours, run \`git rebase --signoff <upstream>/${base}\` on this branch and force-push it."
    fi
}

# signoff_note APPROVAL_URL: the line for an upstream PR's body that says
# which approval of REVIEWER's authorized his sign-off on its commits.
signoff_note() {
    echo "The \`${SIGNOFF_TRAILER}\` on these commits was added on ${REVIEWER}'s approval of the review draft: $1"
}

# with_note BODY NOTE: prints BODY with the paragraph NOTE added before
# its final '${LLMS_TRAILER}' line (or at the end), unless it's there.
with_note() {
    local body=$1 note=$2
    if test -z "${note}" || grep -qxF -- "${note}" <<<"${body}"; then
        printf '%s\n' "${body}"
    elif grep -qxF -- "${LLMS_TRAILER}" <<<"${body}"; then
        awk -v note="${note}" -v trailer="${LLMS_TRAILER}" \
            '$0 == trailer && !done { print note; print ""; done = 1 } { print }' <<<"${body}"
    else
        printf '%s\n\n%s\n' "${body}" "${note}"
    fi
}

# push_time FORK NUMBER BRANCH: sets the caller's 'pushed' to when its
# 'head_sha' became the head of the fork PR, if its 'activity' has a
# '${PROMOTE_COMMAND}' or go-ahead comment that needs it (else leaves it
# empty, saving the calls). That is the latest of: the push that made it the
# head, from the fork's activity log, which records every push with its
# time; any force-push in the PR's timeline; the committer date of any of
# its commits. Commit dates alone can't tell, since a commit made before a
# comment can be pushed after it. If the log's latest push to BRANCH isn't
# of head_sha (it lags, or no longer goes back that far), 'pushed' stays
# empty, and every '${PROMOTE_COMMAND}' is void.
push_time() {
    local fork=$1 number=$2 branch=$3 logged times
    pushed=""
    test "$(verdict needs_push_time)" = true || return 0
    logged=$(ghapi -X GET "repos/${fork}/activity" -f ref="refs/heads/${branch}" -f direction=desc -f per_page=1 \
        --jq ".[0] // {} | select(.after == \"${head_sha}\") | .timestamp") ||
        fatal "cannot read the activity log of ${fork}"
    if test -z "${logged}"; then
        test "$(verdict 'promotions | length > 0')" = false ||
            warn "the activity log of ${fork} doesn't show when ${branch} was pushed at ${head_sha:0:12}, so ${REVIEWER}'s '${PROMOTE_COMMAND}' comments there count for nothing"
        return 0
    fi
    times=$(ghapi --paginate "repos/${fork}/issues/${number}/timeline?per_page=100" \
        --jq '.[] | if .event == "head_ref_force_pushed" then .created_at elif .event == "committed" then .committer.date else empty end') ||
        fatal "cannot read the timeline of ${fork}#${number}"
    # shellcheck disable=SC2086 # one timestamp per word
    pushed=$(printf '%s\n' "${logged}" ${times} | sort | tail -n1)
}

# parse_fork_pr_url URL: sets FORK and NUMBER. Fork PRs from before the
# forge are in the bot's own forks.
parse_fork_pr_url() {
    [[ "$1" =~ ^https://github\.com/((${FORGE_ORG}|${BOT_LOGIN})/[A-Za-z0-9_.-]+)/pull/([0-9]+)/?$ ]] ||
        fatal "expected a PR URL in one of the forks in ${FORGE_ORG} (https://github.com/${FORGE_ORG}/REPO/pull/N), got '$1'"
    FORK=${BASH_REMATCH[1]}
    NUMBER=${BASH_REMATCH[3]}
}

# git_url REPO: the URL git fetches and pushes REPO (OWNER/NAME) with.
git_url() {
    printf '%s%s\n' "${GIT_URL_PREFIX}" "$1"
}

# sgit ARGS...: git on the bot-pr clones: no hooks, and no signing that
# the user's configuration may ask for.
sgit() {
    git -c core.hooksPath=/dev/null -c commit.gpgSign=false "$@"
}

# open_clone FORK BRANCH OLD_SHA UPSTREAM BASE: sets CLONE to the cached
# clone of FORK, locked until the calling (sub)shell exits, with BRANCH
# fetched as refs/bot-pr/head and UPSTREAM's BASE as refs/bot-pr/base, and
# exits unless BRANCH is still at OLD_SHA.
open_clone() {
    local fork=$1 branch=$2 old_sha=$3 upstream=$4 base=$5 clone_lock
    require_cmd git "install git"
    require_cmd flock "install util-linux"
    CLONE=${CLONE_DIR}/${fork//\//_}
    mkdir -p "${CLONE_DIR}" || fatal "cannot create ${CLONE_DIR}"
    exec {clone_lock}>"${CLONE}.lock" || fatal "cannot open ${CLONE}.lock"
    flock "${clone_lock}" || fatal "cannot lock ${CLONE}.lock"
    if ! test -d "${CLONE}/.git"; then
        rm -rf "${CLONE}"
        sgit clone -q --filter=blob:none --no-checkout "$(git_url "${fork}")" "${CLONE}" 1>&2 ||
            fatal "cloning ${fork} into ${CLONE} failed"
    fi
    sgit -C "${CLONE}" fetch -q --filter=blob:none "$(git_url "${fork}")" "+refs/heads/${branch}:refs/bot-pr/head" 1>&2 ||
        fatal "fetching ${fork}:${branch} into ${CLONE} failed"
    sgit -C "${CLONE}" fetch -q --filter=blob:none "$(git_url "${upstream}")" "+refs/heads/${base}:refs/bot-pr/base" 1>&2 ||
        fatal "fetching ${upstream}:${base} into ${CLONE} failed"
    test "$(sgit -C "${CLONE}" rev-parse refs/bot-pr/head)" = "${old_sha}" ||
        fatal "${fork}:${branch} moved while promoting; rerun promote"
}

# rebase_onto_upstream FORK BRANCH OLD_SHA UPSTREAM BASE: rebases the
# branch in a cached clone, force-pushes it and prints the new head. On
# conflicts, prints the conflicting paths and returns EX_CONFLICT. Any
# other failure exits. It runs in a '||' list, where errexit is off, so
# every step checks for itself.
rebase_onto_upstream() {
    local fork=$1 branch=$2 old_sha=$3 upstream=$4 base=$5 dir conflicts new_sha CLONE
    open_clone "$@"
    dir=${CLONE}
    sgit -C "${dir}" rebase --abort >/dev/null 2>&1 || true
    sgit -C "${dir}" checkout -q --force --detach refs/bot-pr/head 1>&2 ||
        fatal "checking out ${branch} in ${dir} failed"
    test "$(sgit -C "${dir}" rev-parse HEAD)" = "${old_sha}" || fatal "${dir} is not at ${branch} after checkout"
    if ! GIT_COMMITTER_NAME=${BOT_GIT_NAME} GIT_COMMITTER_EMAIL=${BOT_GIT_EMAIL} \
        sgit -C "${dir}" rebase -q refs/bot-pr/base >/dev/null 2>&1; then
        conflicts=$(sgit -C "${dir}" diff --name-only --diff-filter=U | paste -sd, -)
        sgit -C "${dir}" rebase --abort >/dev/null 2>&1 || true
        test -n "${conflicts}" || fatal "rebasing ${branch} onto ${upstream}:${base} in ${dir} failed without conflicts; nothing was changed"
        echo "${conflicts}"
        return "${EX_CONFLICT}"
    fi
    new_sha=$(sgit -C "${dir}" rev-parse HEAD) || fatal "cannot read the rebased head in ${dir}"
    sgit -C "${dir}" merge-base --is-ancestor refs/bot-pr/base "${new_sha}" ||
        fatal "the rebased ${branch} in ${dir} doesn't contain ${upstream}:${base}; not pushing it"
    sgit -C "${dir}" push -q --force-with-lease="refs/heads/${branch}:${old_sha}" \
        "$(git_url "${fork}")" "${new_sha}:refs/heads/${branch}" 1>&2 ||
        fatal "pushing the rebased ${branch} to ${fork} failed"
    echo "${new_sha}"
}

# has_signoff DIR COMMIT: prints how many SIGNOFF_TRAILER lines COMMIT's
# message has.
has_signoff() {
    sgit -C "$1" show -s --format=%B "$2" | sed -e 's/[[:space:]]*$//' | grep -Fxc -- "${SIGNOFF_TRAILER}" || true
}

# dco_ok DIR COMMIT: succeeds if COMMIT has SIGNOFF_TRAILER and REVIEWER
# is its author or committer, as the DCO check wants. A rebase by the bot
# keeps the trailer but makes the bot the committer, which fails it.
dco_ok() {
    test "$(has_signoff "$1" "$2")" -gt 0 || return 1
    local who
    who=$(sgit -C "$1" show -s --format='%ae%n%cn <%ce>' "$2")
    grep -qixF -e "${SIGNOFF_EMAIL}" -e "${SIGNOFF_NAME} <${SIGNOFF_EMAIL}>" <<<"${who}"
}

# message_sans_signoff DIR COMMIT: COMMIT's message without its
# SIGNOFF_TRAILER lines.
message_sans_signoff() {
    sgit -C "$1" show -s --format=%B "$2" | sed -e 's/[[:space:]]*$//' | grep -Fxv -- "${SIGNOFF_TRAILER}" || true
}

# ours DIR COMMIT FORK: succeeds if COMMIT's author is the bot or
# REVIEWER, by email or, failing that, by the GitHub login FORK's copy of
# the commit is attributed to.
ours() {
    local email login rc=0
    email=$(sgit -C "$1" show -s --format=%ae "$2")
    case "${email,,}" in
        "${BOT_GIT_EMAIL,,}"|"${SIGNOFF_EMAIL,,}") return 0 ;;
    esac
    login=$(ghapi "repos/$3/commits/$2" --jq '.author.login // empty') || rc=$?
    test "${rc}" -eq 0 || test "${rc}" -eq "${EX_NOTFOUND}" || fatal "cannot read commit $2 of $3"
    test "${login}" = "${BOT_LOGIN}" || test "${login}" = "${REVIEWER}"
}

# verify_signoff DIR BASE OLD NEW: NEW must be OLD with SIGNOFF_TRAILER
# added to every commit after BASE that lacked it, each commit passing
# the DCO check (see dco_ok), and nothing else changed: the same trees,
# authors, and messages otherwise, still on BASE. The same checks as
# bin/dco-signoff's verify.
verify_signoff() {
    local dir=$1 base=$2 old new i
    mapfile -t old < <(sgit -C "${dir}" rev-list --reverse "${base}..$3")
    mapfile -t new < <(sgit -C "${dir}" rev-list --reverse "${base}..$4")
    test "${#old[@]}" -gt 0 || { info "no commits after ${base:0:12}"; return 1; }
    test "${#old[@]}" -eq "${#new[@]}" || { info "${#old[@]} commits became ${#new[@]}"; return 1; }
    for i in "${!old[@]}"; do
        local o=${old[i]} n=${new[i]} os ns
        test "$(sgit -C "${dir}" rev-parse "${o}^{tree}")" = "$(sgit -C "${dir}" rev-parse "${n}^{tree}")" ||
            { info "${n:0:12}'s tree differs from ${o:0:12}'s"; return 1; }
        test "$(sgit -C "${dir}" show -s --format='%an <%ae> %ad' --date=raw "${o}")" = \
            "$(sgit -C "${dir}" show -s --format='%an <%ae> %ad' --date=raw "${n}")" ||
            { info "${n:0:12}'s author differs from ${o:0:12}'s"; return 1; }
        test "$(message_sans_signoff "${dir}" "${o}")" = "$(message_sans_signoff "${dir}" "${n}")" ||
            { info "${n:0:12}'s message differs from ${o:0:12}'s by more than the sign-off"; return 1; }
        os=$(has_signoff "${dir}" "${o}")
        ns=$(has_signoff "${dir}" "${n}")
        test "${ns}" -eq "$((os > 0 ? os : 1))" ||
            { info "${n:0:12} has ${ns} sign-offs by ${REVIEWER}, ${o:0:12} had ${os}"; return 1; }
        dco_ok "${dir}" "${n}" ||
            { info "${n:0:12} is neither authored nor committed by ${SIGNOFF_NAME} <${SIGNOFF_EMAIL}>"; return 1; }
    done
    test "$(sgit -C "${dir}" merge-base "${base}" "$4")" = "$(sgit -C "${dir}" rev-parse "${base}")" ||
        { info "the rewritten commits are no longer based on ${base:0:12}"; return 1; }
}

# add_signoff FORK BRANCH OLD_SHA UPSTREAM BASE INCLUDE_OTHERS: add
# REVIEWER's SIGNOFF_TRAILER to the commits from BRANCH's merge-base with
# UPSTREAM:BASE up to OLD_SHA that lack it, and force-push BRANCH with a
# lease on OLD_SHA. Only promote calls this, once REVIEWER approved
# OLD_SHA (or the clean rebase of what he approved). The DCO check wants
# the sign-off to be by the commit's author or committer, so the commits
# it signs off are committed as him, as are those that have his trailer
# but neither him as author nor as committer (after a rebase by the bot);
# each keeps its tree, author and message bytes, plus the trailer. The
# commits before the first one that needs this stay as they are, and
# those after it keep their committer where they pass already. Commits
# lacking the trailer by others than the bot and REVIEWER are refused
# (returning EX_OTHERS) unless INCLUDE_OTHERS is true. Prints "HEAD
# COUNT": the pushed head and how many commits it changed for DCO (OLD_SHA
# and 0 if none needed it). Runs in a '||' list, like
# rebase_onto_upstream.
add_signoff() {
    local fork=$1 branch=$2 old_sha=$3 upstream=$4 base=$5 include_others=$6 CLONE
    open_clone "$@"
    local dir=${CLONE} mb commits c todo=0 others=()
    mb=$(sgit -C "${dir}" merge-base refs/bot-pr/base "${old_sha}") ||
        fatal "${branch} has no merge-base with ${upstream}:${base}"
    test -z "$(sgit -C "${dir}" rev-list --merges "${mb}..${old_sha}")" ||
        fatal "${branch} has merge commits; add the sign-off by hand"
    mapfile -t commits < <(sgit -C "${dir}" rev-list --reverse "${mb}..${old_sha}")
    test "${#commits[@]}" -gt 0 || fatal "cannot list the commits of ${branch} after ${mb:0:12}"
    for c in "${commits[@]}"; do
        dco_ok "${dir}" "${c}" && continue
        todo=$((todo + 1))
        test "$(has_signoff "${dir}" "${c}")" -eq 0 || continue
        ours "${dir}" "${c}" "${fork}" || others+=("$(sgit -C "${dir}" show -s --format='%h %s (%an <%ae>)' "${c}")")
    done
    if test "${todo}" -eq 0; then
        echo "${old_sha} 0"
        return 0
    fi
    if test "${#others[@]}" -gt 0 && ! ${include_others}; then
        info "Commits by others than ${BOT_LOGIN} and ${REVIEWER} that lack his sign-off:"
        printf '  %s\n' "${others[@]}" 1>&2
        return "${EX_OTHERS}"
    fi

    local msg parent=${mb} rewriting=false new author_date committer
    msg=$(mktemp) || fatal "cannot create a temporary file"
    for c in "${commits[@]}"; do
        if dco_ok "${dir}" "${c}"; then
            if ! ${rewriting}; then
                parent=${c}
                continue
            fi
            # Only its parent changes; it keeps its committer.
            committer=(GIT_COMMITTER_NAME="$(sgit -C "${dir}" show -s --format=%cn "${c}")"
                GIT_COMMITTER_EMAIL="$(sgit -C "${dir}" show -s --format=%ce "${c}")"
                GIT_COMMITTER_DATE="$(sgit -C "${dir}" show -s --format=%cd --date=raw "${c}")")
        else
            committer=(GIT_COMMITTER_NAME="${SIGNOFF_NAME}" GIT_COMMITTER_EMAIL="${SIGNOFF_EMAIL}")
        fi
        # The header ends at the first empty line; the rest is the message,
        # byte for byte. commit-tree can't keep an encoding header.
        ! sgit -C "${dir}" cat-file commit "${c}" | sed -n '/^$/q;p' | grep -q '^encoding ' ||
            { rm -f "${msg}"; fatal "${c:0:12} has a non-UTF-8 message encoding; add the sign-off by hand"; }
        sgit -C "${dir}" cat-file commit "${c}" | sed '1,/^$/d' >"${msg}" ||
            { rm -f "${msg}"; fatal "cannot read the message of ${c:0:12}"; }
        if test "$(has_signoff "${dir}" "${c}")" -eq 0; then
            # Without the user's trailer.* configuration.
            GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
                sgit -C "${dir}" interpret-trailers --in-place --no-divider --where end --if-exists addIfDifferent \
                --trailer "${SIGNOFF_TRAILER}" "${msg}" ||
                { rm -f "${msg}"; fatal "adding the sign-off to the message of ${c:0:12} failed"; }
        fi
        author_date=$(sgit -C "${dir}" show -s --format=%ad --date=raw "${c}")
        new=$(env -u GIT_COMMITTER_DATE \
            GIT_AUTHOR_NAME="$(sgit -C "${dir}" show -s --format=%an "${c}")" \
            GIT_AUTHOR_EMAIL="$(sgit -C "${dir}" show -s --format=%ae "${c}")" \
            GIT_AUTHOR_DATE="${author_date}" "${committer[@]}" \
            git -c core.hooksPath=/dev/null -c commit.gpgSign=false -c i18n.commitEncoding=UTF-8 -C "${dir}" \
            commit-tree --no-gpg-sign "${c}^{tree}" -p "${parent}" -F "${msg}") ||
            { rm -f "${msg}"; fatal "rewriting ${c:0:12} failed"; }
        parent=${new}
        rewriting=true
    done
    rm -f "${msg}"
    verify_signoff "${dir}" "${mb}" "${old_sha}" "${new}" ||
        fatal "the signed-off ${new:0:12} is not ${old_sha:0:12} plus the sign-off; not pushing it"
    # For verify_record, should promote be rerun here.
    sgit -C "${dir}" update-ref "refs/bot-pr/signed-from/${old_sha}" "${old_sha}" ||
        fatal "cannot keep ${old_sha:0:12} in ${dir}"
    sgit -C "${dir}" push -q --force-with-lease="refs/heads/${branch}:${old_sha}" \
        "$(git_url "${fork}")" "${new}:refs/heads/${branch}" 1>&2 ||
        fatal "pushing the signed-off ${branch} to ${fork} was refused: it is no longer at the approved ${old_sha:0:12}; not promoting"
    echo "${new} ${todo}"
}

# verify_record FORK BRANCH HEAD UPSTREAM BASE APPROVED: exits unless HEAD
# is exactly what add_signoff makes of APPROVED: a sign-off record in a
# comment only claims that, and a comment by the bot can be made to say
# anything. Runs in a '||' list, like rebase_onto_upstream.
verify_record() {
    local fork=$1 branch=$2 head=$3 approved=$6 CLONE
    open_clone "$@"
    if ! sgit -C "${CLONE}" cat-file -e "${approved}^{commit}" 2>/dev/null; then
        sgit -C "${CLONE}" fetch -q "$(git_url "${fork}")" "${approved}" 1>&2 ||
            fatal "cannot fetch ${approved:0:12}, the head ${REVIEWER} approved before the sign-off, to check that ${head:0:12} only adds his sign-off; he needs to approve ${head:0:12}"
    fi
    local mb
    mb=$(sgit -C "${CLONE}" merge-base "${approved}" "${head}") ||
        fatal "${head:0:12} shares no history with ${approved:0:12}, which ${REVIEWER} approved"
    verify_signoff "${CLONE}" "${mb}" "${approved}" "${head}" ||
        fatal "${branch} (${head:0:12}) is not ${approved:0:12}, which ${REVIEWER} approved, plus his sign-off; he needs to approve it"
}

cmd_promote() {
    local url="" draft=false dry_run=false why="" have_why=false include_others=false signoff=true
    while test $# -gt 0; do
        case "$1" in
            --draft) draft=true; shift ;;
            --dry-run) dry_run=true; shift ;;
            --include-others) include_others=true; shift ;;
            --no-signoff) signoff=false; shift ;;
            --why) test $# -ge 2 || fatal "--why requires an argument"; why=$2; have_why=true; shift 2 ;;
            -*) fatal "unknown argument for promote: $1 (see --help)" ;;
            *) test -z "${url}" || fatal "promote takes one fork PR URL"; url=$1; shift ;;
        esac
    done
    test -n "${url}" || fatal "usage: $(basename "$0") promote FORK_PR_URL [--draft] [--why TEXT] [--include-others] [--no-signoff] [--dry-run]"
    local FORK NUMBER
    parse_fork_pr_url "${url}"
    check_login

    local pr
    pr=$(ghapi "repos/${FORK}/pulls/${NUMBER}") || fatal "cannot read ${url}"
    local author state head head_repo head_sha fork_base
    read -r author state head head_repo head_sha fork_base < <(jq -r \
        '"\(.user.login) \(.state) \(.head.ref) \(.head.repo.full_name) \(.head.sha) \(.base.ref)"' <<<"${pr}")
    test "${author}" = "${BOT_LOGIN}" || fatal "${url} was opened by ${author}, not ${BOT_LOGIN}"
    test "${state}" = open || fatal "${url} is ${state}; only an open fork PR can be promoted"
    test "${head_repo}" = "${FORK}" || fatal "${url}'s head is in ${head_repo}, not ${FORK}"
    [[ "${head}" == "${BRANCH_PREFIX}"?* ]] || fatal "${url}'s branch '${head}' is not a ${BRANCH_PREFIX}<slug> branch"

    # The upstream repository comes from the bot-meta section: a fork's
    # parent is not necessarily the upstream.
    local meta upstream meta_base item title body
    meta=$(jq -r "${BODY_JQ} .body | meta" <<<"${pr}")
    test -n "${meta}" || fatal "${url} has no complete ${META_START} ... ${META_END} section; was it opened with fork-pr? Restore it in the PR body"
    # shellcheck disable=SC2016 # literal backticks
    local upstream_re='Upstream: `([^`]+)`, base `([^`]+)`' item_re="Board item: \`(${ITEM_ID_RE})\`"
    [[ "${meta}" =~ ${upstream_re} ]] ||
        fatal "cannot find the 'Upstream: \`OWNER/REPO\`, base \`BRANCH\`' line in ${url}'s bot-meta section"
    upstream=${BASH_REMATCH[1]}
    meta_base=${BASH_REMATCH[2]}
    valid_repo "${upstream}" || fatal "invalid upstream '${upstream}' in ${url}'s bot-meta section"
    local network
    network=$(ghapi "repos/${FORK}" --jq '"\(.parent.full_name) \(.source.full_name)"') || fatal "cannot read ${FORK}"
    [[ " ${network} " == *" ${upstream} "* ]] ||
        fatal "bot-meta names upstream ${upstream}, but ${FORK} is a fork of ${network% *} (network root ${network#* })"
    item=
    if [[ "${meta}" =~ ${item_re} ]]; then
        item=${BASH_REMATCH[1]}
    else
        warn "no board item in ${url}'s bot-meta section; the board won't be updated"
    fi
    local base=${meta_base} owner=${FORK%%/*}
    test "${fork_base}" = "${base}" ||
        warn "the fork PR targets '${fork_base}', but bot-meta says upstream base '${base}'; using '${base}'"
    title=$(jq -r .title <<<"${pr}")
    body=$(jq -r "${BODY_JQ} .body | strip_meta" <<<"${pr}")
    ! grep -qF 'bot-meta' <<<"${body}" || fatal "${url}'s body still mentions bot-meta after stripping the section; fix its markers"
    test -n "${body}" || fatal "${url}'s body is empty without the bot-meta section"
    grep -qxF "${LLMS_TRAILER}" <<<"${body}" || warn "${url}'s body has no '${LLMS_TRAILER}' line"
    local dco
    dco=$(dco_required "${upstream}" "${base}")
    if ${dco} && grep -qF "${DCO_CHECK}" <<<"${body}"; then
        warn "${url}'s body already mentions ${DCO_CHECK}; promote adds its own line too, so drop the old note from the fork PR body before promoting"
    fi

    local activity approved wants_draft pushed
    activity=$(reviewer_activity "${FORK}" "${NUMBER}")
    push_time "${FORK}" "${NUMBER}" "${head}"
    approved=$(verdict approved)
    wants_draft=$(verdict wants_draft)
    if test "${approved}" != true; then
        local why_not="is not approved by ${REVIEWER}; only his approving review or a comment with a '${PROMOTE_COMMAND}' line promotes a fork PR"
        if test "$(verdict approved_any)" = true; then
            if test "$(verdict approval.via)" = "${PROMOTE_COMMAND}" && test -z "${pushed}"; then
                why_not="has a '${PROMOTE_COMMAND}' by ${REVIEWER}, but when its head was pushed can't be told; he needs to approve it"
            else
                why_not="has commits pushed after ${REVIEWER} approved it; he needs to approve the current head or comment '${PROMOTE_COMMAND}' again"
            fi
        fi
        local go_ahead
        go_ahead=$(verdict go_ahead)
        test -z "${go_ahead}" ||
            why_not+=". His comment ${go_ahead} reads like a go-ahead, but isn't one without a '${PROMOTE_COMMAND}' line: ask him to reply '${PROMOTE_COMMAND}' or approve"
        ${dry_run} || fatal "${url} ${why_not}"
        warn "${url} ${why_not}; a real promote would stop here"
    fi
    local approval_url approved_head
    approval_url=$(verdict 'approval.url // empty')
    approved_head=$(verdict 'approval.commit_id // empty')
    # The line about DCO that the upstream PR's body gets, if it needs one.
    local dco_line=""
    if ${dco} && ! ${signoff}; then
        dco_line=$(dco_note "${upstream}" "${base}")
    fi
    if test "${wants_draft}" = true && ! ${draft}; then
        info "${REVIEWER} asked for '${DRAFT_COMMAND}'; opening the upstream PR as a draft"
        draft=true
    fi

    # Approved through a sign-off record: check that record in git.
    local via_record=false
    if test "${approved}" = true && test "${approved_head}" != "${head_sha}"; then
        via_record=true
        info "${head_sha:0:12} is ${REVIEWER}'s approved ${approved_head:0:12} plus his sign-off, per the bot's record; checking that"
        local rc=0
        (verify_record "${FORK}" "${head}" "${head_sha}" "${upstream}" "${base}" "${approved_head}") || rc=$?
        test "${rc}" -eq 0 || exit "${rc}"
    fi

    local existing ahead behind compare
    existing=$(ghapi -X GET "repos/${upstream}/pulls" -f head="${owner}:${head}" -f state=open --jq '.[0].html_url // empty') ||
        fatal "cannot list the PRs of ${upstream}"
    compare=$(ghapi "repos/${upstream}/compare/${base}...${owner}:${head}" --jq '"\(.ahead_by) \(.behind_by)"') ||
        fatal "cannot compare ${head} with ${upstream}:${base}"
    read -r ahead behind <<<"${compare}"
    test "${ahead}" -gt 0 || fatal "${head} has no commits on top of ${upstream}:${base}; was it merged already?"

    if ${dry_run}; then
        cat <<EOF
Fork PR:   ${url} (${REVIEWER}: $(verdict 'approval | if . == null then "no verdict" elif .via then "\(.state) by \(.via) \(.url)" else .state end'))
Upstream:  ${upstream}, base ${base}, from ${owner}:${head} (${ahead} ahead, ${behind} behind)
Board:     ${item:-(none)}

Would:
EOF
        test "${behind}" -eq 0 || echo "- rebase ${head} onto ${upstream}:${base} and force-push it (on conflicts: dismiss the approval, comment, stop)"
        if ${dco} && ${signoff}; then
            echo "- add '${SIGNOFF_TRAILER}' to the commits lacking it (${upstream}:${base} requires DCO), committed as him, and force-push it$(${include_others} || echo "; stop if any of them is by someone else")"
        fi
        if test -n "${existing}"; then
            echo "- reuse the already open ${existing}"
        else
            echo "- open $(if ${draft}; then echo "a draft"; else echo "a ready-for-review"; fi) PR in ${upstream}"
        fi
        echo "- comment the upstream PR link on ${url} and close it"
        test -z "${item}" || echo "- bot-board set ${item} --status \"In Review\" --branch <upstream PR URL>$(${have_why} && echo " --why ...")"
        if ${dco} && ${signoff}; then
            dco_line=$(signoff_note "${approval_url:-<approval>}")
        fi
        printf '\nTitle: %s\n\n%s\n' "${title}" "$(with_note "${body}" "${dco_line}")"
        return 0
    fi

    # The head that goes upstream: the approved one, or its clean rebase.
    local expected_head=${head_sha}
    if test "${behind}" -gt 0 && test -z "${existing}"; then
        info "${head} is ${behind} commit(s) behind ${upstream}:${base}; rebasing"
        # The new head on success, the conflicting paths otherwise.
        local out rc=0
        out=$(rebase_onto_upstream "${FORK}" "${head}" "${head_sha}" "${upstream}" "${base}") || rc=$?
        test "${rc}" -eq 0 || test "${rc}" -eq "${EX_CONFLICT}" || exit "${rc}"
        if test "${rc}" -eq "${EX_CONFLICT}"; then
            local review_id
            review_id=$(verdict 'approval.id // empty')
            # A '/promote' comment can't be dismissed; the push that
            # resolves the conflicts voids it.
            if test -n "${review_id}"; then
                ghapi -X PUT "repos/${FORK}/pulls/${NUMBER}/reviews/${review_id}/dismissals" \
                    -f message="Upstream ${base} moved and this no longer rebases cleanly; needs another look after the conflicts are resolved." >/dev/null ||
                    warn "dismissing the approval on ${url} failed; the next inbox will still show it as approved"
            fi
            ghapi -X POST "repos/${FORK}/issues/${NUMBER}/comments" -f body="Not promoted: \`${upstream}:${base}\` moved and \`${head}\` no longer rebases cleanly (conflicts in: ${out}). Back to Draft; I'll resolve the conflicts here and ask for another review." >/dev/null ||
                warn "commenting on ${url} failed"
            if test -n "${item}"; then
                "${BOT_BOARD}" set "${item}" --status Draft >/dev/null ||
                    warn "setting ${item} back to Draft failed; do it by hand"
            fi
            fatal "${head} conflicts with ${upstream}:${base} in ${out}; resolve that on the branch, push, and wait for ${REVIEWER} to approve again"
        fi
        expected_head=${out}
        info "Rebased and pushed ${head} (${expected_head:0:12})"
    fi
    if ${dco} && ${signoff}; then
        # His approval of this head (or of what it was rebased from) is what
        # lets the bot add his sign-off.
        local out rc=0 signed count
        out=$(add_signoff "${FORK}" "${head}" "${expected_head}" "${upstream}" "${base}" "${include_others}") || rc=$?
        test "${rc}" -ne "${EX_OTHERS}" ||
            fatal "${upstream}:${base} requires DCO, and ${head} has commits by others that lack ${REVIEWER}'s sign-off; if he asks for it, rerun with --include-others to sign those off too, or with --no-signoff to leave the sign-off to the maintainers"
        test "${rc}" -eq 0 || exit "${rc}"
        read -r signed count <<<"${out}"
        if test "${count}" -gt 0; then
            info "Added ${REVIEWER}'s sign-off to ${count} commit(s) of ${head} and pushed it (${signed:0:12})"
            expected_head=${signed}
            # The record that keeps his approval of the head it replaced
            # valid for this head (see VERDICT_JQ), should promote need a
            # rerun.
            ghapi -X POST "repos/${FORK}/issues/${NUMBER}/comments" -f body="Signed off ${count} commit(s) with \`${SIGNOFF_TRAILER}\` for ${upstream}'s DCO check, on ${REVIEWER}'s approval ${approval_url} of \`${head_sha:0:12}\`. Same trees; the head is now \`${signed:0:12}\`.

${SIGNOFF_RECORD} approved=${head_sha} signed=${signed} approval=${approval_url} review=$(verdict 'approval.id // "none"') -->" >/dev/null ||
                warn "recording the sign-off on ${url} failed; should this promote not finish, ${REVIEWER} needs to approve ${signed:0:12}"
        fi
        # Name the approval only if it is what signed off; commits that
        # already passed (his own, say) need no line at all.
        if test "${count}" -gt 0 || ${via_record}; then
            dco_line=$(signoff_note "${approval_url}")
        fi
    fi
    body=$(with_note "${body}" "${dco_line}")
    # Nothing unreviewed may go upstream: fail if anything was pushed since.
    test "$(ref_sha "${FORK}" "${head}")" = "${expected_head}" ||
        fatal "${FORK}:${head} moved while promoting; not opening the upstream PR"

    local upstream_url
    if test -n "${existing}"; then
        info "Reusing the already open ${existing}"
        upstream_url=${existing}
    else
        upstream_url=$(jq -n --arg title "${title}" --arg head "${owner}:${head}" --arg base "${base}" \
            --arg body "${body}" --argjson draft "${draft}" \
            '{title: $title, head: $head, base: $base, body: $body, draft: $draft, maintainer_can_modify: true}' |
            ghapi -X POST "repos/${upstream}/pulls" --input - --jq .html_url) ||
            fatal "opening the PR in ${upstream} failed; nothing else was changed"
        info "Opened ${upstream_url}"
    fi
    ghapi -X POST "repos/${FORK}/issues/${NUMBER}/comments" \
        -f body="Opened upstream as ${upstream_url}$(${draft} && echo " (draft)"). Closing this review draft." >/dev/null ||
        warn "commenting on ${url} failed"
    ghapi -X PATCH "repos/${FORK}/pulls/${NUMBER}" -f state=closed >/dev/null ||
        warn "closing ${url} failed; close it by hand"
    # CI for the closed fork PR, and for the head the rebase replaced, is
    # now upstream's to run.
    prune_after_push "${FORK}"
    if test -n "${item}"; then
        local board_args=(set "${item}" --status "In Review" --branch "${upstream_url}")
        ${have_why} && board_args+=(--why "${why}")
        "${BOT_BOARD}" "${board_args[@]}" >/dev/null ||
            fatal "the upstream PR is open, but updating the board failed; retry: bot-board$(printf ' %q' "${board_args[@]}")"
    fi
    echo "${upstream_url}"
}

cmd_inbox() {
    local since="" dry_run=false
    while test $# -gt 0; do
        case "$1" in
            --since) test $# -ge 2 || fatal "--since requires a date"; since=$2; shift 2 ;;
            --since=*) since=${1#--since=}; shift ;;
            --dry-run) dry_run=true; shift ;;
            *) fatal "unknown argument for inbox: $1 (see --help)" ;;
        esac
    done
    if test -n "${since}"; then
        local parsed
        parsed=$(date -u -d "${since}" +%FT%TZ 2>/dev/null) || fatal "invalid --since date '${since}'"
        since=${parsed}
    fi
    check_login
    # A dry run records nothing, so it needn't wait for a real run.
    local state
    if ${dry_run}; then
        state=$(load_state --untracked)
    else
        lock_state
        state=$(load_state)
    fi
    local default_since now closed_since
    default_since=${since:-$(date -u -d "${DEFAULT_LOOKBACK_DAYS} days ago" +%FT%TZ)}
    now=$(date -u +%FT%TZ)
    # Search lags behind by minutes, so closed PRs are searched with an
    # overlap and deduplicated through the state.
    closed_since=${since:-$(jq -r '.last_check // empty' <<<"${state}")}
    closed_since=$(date -u -d "${closed_since:-${default_since}} - ${SEARCH_OVERLAP}" +%FT%TZ)

    local open closed scope
    open=$(for scope in "${SEARCH_SCOPES[@]}"; do
        ghapi -X GET search/issues --paginate -f per_page="${SEARCH_PER_PAGE}" \
            -f q="is:pr is:open author:${BOT_LOGIN} ${scope}" \
            --jq '.items[] | {url: .html_url, number, title, body, repo: (.repository_url | sub("^.*/repos/"; ""))}' ||
            fatal "searching for the bot's open fork PRs (${scope}) failed"
    done | jq -sc 'unique_by(.url)') || fatal "searching for the bot's fork PRs failed"
    closed=$(for scope in "${SEARCH_SCOPES[@]}"; do
        ghapi -X GET search/issues --paginate -f per_page="${SEARCH_PER_PAGE}" \
            -f q="is:pr is:closed is:unmerged author:${BOT_LOGIN} ${scope} closed:>=${closed_since}" \
            --jq '.items[] | {url: .html_url, number, title, body, closed_at, repo: (.repository_url | sub("^.*/repos/"; ""))}' ||
            fatal "searching for the bot's closed fork PRs (${scope}) failed"
    done | jq -sc 'unique_by(.url)') || fatal "searching for the bot's fork PRs failed"
    # Only PRs opened by fork-pr are in the review loop.
    open=$(jq -c --arg m "${META_START}" '[.[] | select((.body // "") | contains($m))]' <<<"${open}")
    closed=$(jq -c --arg m "${META_START}" '[.[] | select((.body // "") | contains($m))]' <<<"${closed}")

    local nreported=0 found url repo number pr head_sha pr_since activity events lines verdict hash old_hash
    local pushed go_ahead
    local bot_body edits_seen pending edits body_note
    while IFS= read -r found; do
        test -n "${found}" || continue
        url=$(jq -r .url <<<"${found}")
        repo=$(jq -r .repo <<<"${found}")
        number=$(jq -r .number <<<"${found}")
        # Search results can be stale; the PR itself is not.
        pr=$(ghapi "repos/${repo}/pulls/${number}") || fatal "cannot read ${url}"
        test "$(jq -r .state <<<"${pr}")" = open || continue
        head_sha=$(jq -r .head.sha <<<"${pr}")
        # Per PR, so a PR that search only found late still gets its
        # activity from before that.
        pr_since=${since:-$(jq -r --arg u "${url}" '.prs[$u].seen // empty' <<<"${state}")}
        pr_since=${pr_since:-${default_since}}
        activity=$(reviewer_activity "${repo}" "${number}")
        events=$(ghapi --paginate "repos/${repo}/issues/${number}/timeline?per_page=100" \
            --jq ".[] | select(.event == \"renamed\" and .actor.login == \"${REVIEWER}\")
                  | {kind: \"renamed\", at: .created_at, from: .rename.from, to: .rename.to}" | jq -sc .) ||
            fatal "cannot read the timeline of ${url}"
        hash=$(body_hash <<<"${pr}")
        read -r old_hash bot_body edits_seen < <(jq -r --arg u "${url}" \
            '.prs[$u] // {} | "\(.body // "-") \(.bot_body // "-") \(.edits_seen // "-")"' <<<"${state}")
        pending=$(jq -c --arg u "${url}" '.prs[$u].reviewer_edit // null' <<<"${state}")
        events=$(jq -c --argjson p "${pending}" '. + [$p // empty | {kind: "body edited", at, note}]' <<<"${events}")
        body_note=""
        # A new body that isn't the bot's own last write: ask who edited it.
        if test "${old_hash}" != - && test "${hash}" != "${old_hash}" && test "${hash}" != "${bot_body}"; then
            if edits=$(body_edits "${repo}" "${number}"); then
                # The edits since the last check: counted, since GitHub's
                # clock is not ours; by time for --since or at first.
                test -z "${since}" || edits_seen=-
                events=$(jq -c --argjson e "${edits}" --arg seen "${edits_seen}" --arg since "${pr_since}" \
                    --arg bot "${BOT_LOGIN}" --arg r "${REVIEWER}" --argjson p "${pending}" "${EDITS_JQ}"'
                    . + [$e | if $seen != "-" and .total != null and ($seen | tonumber) <= .total
                              then .nodes[:(.total - ($seen | tonumber))]
                              else [.nodes[] | select(.at >= $since)] end
                        | reviewers
                        # the one set-body replaced, listed already
                        | select(. != $p.at) | {kind: "body edited", at: ., note: ""}]' <<<"${events}")
                edits_seen=$(jq -r '.total // "-"' <<<"${edits}")
            else
                warn "cannot tell who edited the body of ${url} (GraphQL failed)"
                body_note="  body edited (since the last check; by ${REVIEWER} or the bot, GraphQL failed)"
            fi
        fi
        state=$(jq -c --arg u "${url}" --arg h "${hash}" --arg now "${now}" --arg e "${edits_seen}" '
            .prs[$u] = ((.prs[$u] // {}) + {body: $h, seen: $now} | del(.reviewer_edit)
                | if $e != "-" then .edits_seen = ($e | tonumber) else . end)' <<<"${state}")
        lines=$(jq -r --arg since "${pr_since}" --argjson n "${EXCERPT_LEN}" --argjson events "${events}" "${BODY_JQ}"'
            [(.[] | select(.at >= $since and .kind != "signoff")
                  # the container of inline comments, which are listed anyway
                  | select(.kind != "review" or .state != "COMMENTED" or (.body // "") != "")),
             # body edits are selected already, by count where possible
             ($events[] | select(.at >= $since or .kind == "body edited"))] | sort_by(.at) | .[]
            | if .kind == "renamed" then "  \(.at) title edited: \(.from | tojson) -> \(.to | tojson)"
              elif .kind == "body edited" then "  \(.at) body edited\(.note)"
              elif .kind == "review" then "  \(.at) review \(.state): \(.url)\(if (.body // "") != "" then "\n    > " + (.body | excerpt($n)) else "" end)"
              elif .kind == "review comment" then "  \(.at) review comment on \(.path): \(.url)\n    > \(.body | excerpt($n))"
              else "  \(.at) comment: \(.url)\n    > \(.body | excerpt($n))" end' <<<"${activity}")
        test -z "${body_note}" || lines+=${lines:+$'\n'}${body_note}
        push_time "${repo}" "${number}" "$(jq -r .head.ref <<<"${pr}")"
        verdict=$(verdict '
            [if approved then "APPROVED" elif approved_any then "APPROVED earlier; new commits since" else empty end,
             if wants_draft then "'"${DRAFT_COMMAND}"'" else empty end] | join(", ")')
        test -n "${lines}" || test -n "${verdict}" || continue
        echo "${url}${verdict:+  [${verdict}]}  $(jq -r .title <<<"${pr}")"
        test -z "${lines}" || echo "${lines}"
        if [[ "${verdict}" == APPROVED ]] || [[ "${verdict}" == "APPROVED, "* ]]; then
            echo "  -> approved: $(basename "$0") promote ${url}$([[ "${verdict}" == *"${DRAFT_COMMAND}"* ]] && echo " --draft")"
        else
            if [[ "${verdict}" == *"new commits since"* ]]; then
                echo "  -> needs ${REVIEWER} to approve the current head (or comment '${PROMOTE_COMMAND}' again) before promote"
            fi
            go_ahead=$(verdict go_ahead)
            test -z "${go_ahead}" ||
                echo "  -> hint: ${go_ahead} by ${REVIEWER} reads like a go-ahead, but approves nothing; ask him to reply '${PROMOTE_COMMAND}' (on a line of its own) or to approve"
        fi
        nreported=$((nreported + 1))
    done < <(jq -c '.[]' <<<"${open}")

    local closed_by
    while IFS= read -r found; do
        test -n "${found}" || continue
        url=$(jq -r .url <<<"${found}")
        jq -e --arg u "${url}" '.closed[$u]' <<<"${state}" >/dev/null && continue
        closed_by=$(ghapi "repos/$(jq -r .repo <<<"${found}")/issues/$(jq -r .number <<<"${found}")" --jq '.closed_by.login // ""') ||
            fatal "cannot read ${url}"
        state=$(jq -c --arg u "${url}" --arg at "$(jq -r .closed_at <<<"${found}")" '.closed[$u] = $at | del(.prs[$u])' <<<"${state}")
        # promote closes the fork PRs it took upstream.
        test "${closed_by}" = "${REVIEWER}" || continue
        echo "${url}  [CLOSED]  $(jq -r .title <<<"${found}")"
        echo "  -> closed by ${REVIEWER}: drop it (board item Done, Why \"dropped: ...\")"
        nreported=$((nreported + 1))
    done < <(jq -c '.[]' <<<"${closed}")

    if ! ${dry_run}; then
        # The state has to fit in a board item, so it forgets closed PRs
        # the next search can't find, and fork PRs that were neither
        # open nor recorded lately (merged, say).
        local forget_closed forget_prs
        forget_closed=$(date -u -d "${now} - ${SEARCH_OVERLAP}" +%FT%TZ)
        forget_prs=$(date -u -d "${now} - ${DEFAULT_LOOKBACK_DAYS} days" +%FT%TZ)
        save_state "$(jq -c --arg now "${now}" --arg fc "${forget_closed}" --arg fp "${forget_prs}" --argjson open "${open}" '
            ([$open[].url]) as $urls
            | .last_check = $now
            | .closed |= with_entries(select(.value | type == "string" and . >= $fc))
            | .prs |= with_entries(select(.key as $u | ($urls | index($u)) or (.value.seen // "") >= $fp))' <<<"${state}")"
    fi
    info "$(jq length <<<"${open}") open fork PR(s); ${nreported} with activity by ${REVIEWER} or awaiting promote"
}

test $# -gt 0 || { usage 1>&2; exit 1; }
command=$1
shift
case "${command}" in
    -h|--help|help) usage; exit 0 ;;
    fork-pr) command=fork_pr ;;
    fork-setup) command=fork_setup ;;
    set-body) command=set_body ;;
    get-body) command=get_body ;;
    prune-runs) command=prune_runs ;;
    set-item) command=set_item ;;
    promote|inbox) ;;
    *) fatal "unknown command '${command}' (see --help)" ;;
esac
[[ "${FORGE_ORG}" =~ ^[A-Za-z0-9-]+$ ]] || fatal "BOT_PR_FORGE must be a GitHub organization name, not '${FORGE_ORG}'"
require_cmd gh "install the GitHub CLI (https://cli.github.com) and authenticate it as ${BOT_LOGIN}"
require_cmd jq "install jq"
"cmd_${command}" "$@"
