#!/usr/bin/env bash
# Manage ephemeral devspace runners (GitHub Actions runners reachable over
# the tailnet) for building and testing the bot's work.
set -euo pipefail

# shellcheck source=bin/operator.sh disable=SC1091 # followed with shellcheck -x
source "$(dirname "$(readlink -f "$0")")/operator.sh"
# The runner repository, from the operator config.
readonly REPO=${OP_DEVSPACE_REPO}
readonly WORKFLOW=devspace.yml
readonly WORKFLOW_PATH=.github/workflows/${WORKFLOW}
# Only REST endpoints are used: the GraphQL quota is shared with the board
# tooling and easily exhausted by parallel agents.
readonly RUNS_API="repos/${REPO}/actions/workflows/${WORKFLOW}/runs?event=workflow_dispatch&per_page=100"
readonly HOST_PREFIX=${OP_DEVSPACE_HOST_PREFIX}
# SSH sessions run as the unprivileged 'runner-sandbox', without sudo: the 'runner'
# user holds the job's credentials. Devspaces from a workflow revision that
# predates it admit only 'runner'; start probes both, in this order, and
# records which one worked.
# TODO: drop 'runner' once devspace.yml on main creates 'runner-sandbox'.
readonly SSH_USER=runner-sandbox
readonly LEGACY_SSH_USER=runner
readonly SSH_USERS=("${SSH_USER}" "${LEGACY_SSH_USER}")
readonly ALIAS_PREFIX=devspace-
readonly STATE_ROOT=${XDG_STATE_HOME:-$HOME/.local/state}/bot-devspace
readonly DEFAULT_REF=${BOT_DEVSPACE_REF:-main}
readonly DEFAULT_CORES=16
readonly DEFAULT_DURATION=240
readonly VALID_CORES=(4 16 64)
# The options of the workflow's 'duration' input, a choice; start rounds
# other values up to the next of these.
readonly VALID_DURATIONS=(30 60 120 240)
# Covers queueing for a runner plus the workflow's setup steps, which
# normally take 1-3 minutes in total.
readonly SSH_TIMEOUT=${BOT_DEVSPACE_SSH_TIMEOUT:-900}
readonly CORRELATE_TIMEOUT=90
readonly STOP_TIMEOUT=180
readonly POLL_INTERVAL=5
readonly API_ATTEMPTS=3
# Returned by api() when GitHub says the resource does not exist.
readonly EX_NOTFOUND=4
# Baseline toolchain; all of these exist in RHEL 10 (+ EPEL, which the
# workflow enables). The workflow installs them (its packages.txt) for
# '${SSH_USER}', who can't; provision installs them only on legacy devspaces
# and otherwise checks they are there. This duplicates packages.txt in
# the devspace repository: keep the two in step until the legacy path
# goes, then check against packages.txt itself.
readonly PROVISION_PACKAGES=(
    podman buildah skopeo
    gcc gcc-c++ make pkgconf openssl-devel
    # Build deps shared by bootc, ostree-ext and composefs-rs
    libzstd-devel clang-devel ostree-devel glib2-devel
    rust cargo rustfmt clippy
    python3 python3-pip git
    # VM stack for bcvk-based integration tests. virt-fw-vars (from
    # python3-virt-firmware) is what bcvk enrolls Secure Boot keys with,
    # which sealed UKI tests need. bcvk itself comes from below.
    qemu-kvm libvirt virtiofsd python3-virt-firmware
)
# EPEL's bcvk and tmt are too old for bootc's tmt tests, so provision
# installs these into ~/.local/bin instead (ahead of /usr/bin in PATH),
# matching bootc CI: bcvk from bootc-dev/actions' bootc-ubuntu-setup, tmt from
# bootc's .github/actions/install-tmt. Keep them in sync with those.
readonly BCVK_VERSION=0.19.0
readonly TMT_VERSION=1.78.0
# The runner pools mix hardware (e.g. AMD EPYC 7763 and 9V45 hosts under the
# same label), and nested-KVM behavior differs between them: sealed (SMM +
# Secure Boot) VMs abort QEMU on some 7763 hosts only, see
# https://github.com/cgwalters-forge/tracker/issues/235. start records the
# CPU model so that results can be tied to the hardware they ran on.
readonly CPU_PROBE="awk -F ': *' '/^model name/ { print \$2; exit }' /proc/cpuinfo"
# Jobs ('run' and 'wait'): each lives in JOBS_DIR/JOB on the devspace, with
# its command, pid, log and, once it ended, its exit status.
readonly JOBS_DIR='.bot-devspace/jobs'
# The default fits under the 10-minute cap agents' foreground shell
# commands have; longer waits run in the background with a longer --timeout.
readonly DEFAULT_WAIT_TIMEOUT=540
readonly DEFAULT_WAIT_TAIL=20
readonly JOB_POLL_INTERVAL=${BOT_DEVSPACE_JOB_POLL:-15}
# Consecutive failed polls of a devspace whose run is still active before
# wait gives up on reaching it.
readonly JOB_POLL_ATTEMPTS=5
# wait's exit statuses besides 0 (the job succeeded); timeout(1)'s for a
# timeout.
readonly EX_JOB_FAILED=1
readonly EX_WAIT_ERROR=2
readonly EX_WAIT_TIMEOUT=124

usage() {
    cat <<EOF
Usage: $(basename "$0") COMMAND [ARGS...]

Manage ephemeral devspace runners dispatched from ${REPO}
and reachable over the tailnet as ${SSH_USER}@${HOST_PREFIX}<run id>: an
unprivileged user without sudo (use rootless podman, and a VM for anything
that needs root). Devspaces from older workflow revisions admit only
${LEGACY_SSH_USER}, which has sudo; start detects which one to use.

Commands:
  start [--ref REF] [--cores N] [--duration MIN] [--no-provision] [--keep-on-failure] NAME
                     Dispatch a devspace, wait for SSH, provision it and
                     print its host name. REF defaults to \$BOT_DEVSPACE_REF
                     or main (currently: ${DEFAULT_REF}); cores are one of
                     ${VALID_CORES[*]} (default ${DEFAULT_CORES}); the duration in minutes is
                     rounded up to one of ${VALID_DURATIONS[*]} (default ${DEFAULT_DURATION}). If start fails or is
                     interrupted after dispatching, the run is cancelled
                     unless --keep-on-failure is given.
  provision NAME     Check the baseline dev toolchain is installed (on legacy
                     ${LEGACY_SSH_USER} devspaces: install it; idempotent)
  ssh NAME [CMD...]  Run CMD on the devspace, or an interactive shell
  ssh-config NAME    Print the path of an ssh_config defining Host ${ALIAS_PREFIX}NAME,
                     for use with 'ssh -F' and GIT_SSH_COMMAND="ssh -F <path>"
  run [--cd DIR] NAME JOB CMD...
                     Start CMD (joined like ssh does, run by bash) on the
                     devspace as the detached job JOB, in DIR (relative to
                     the home directory; default: home), and print its log
                     path. It survives SSH disconnects; re-running a JOB
                     that ended replaces it.
  wait [--timeout SEC] [--tail N] NAME JOB
                     Block until JOB ends, then print the last N lines of
                     its log (default ${DEFAULT_WAIT_TAIL}). Exits 0 if the job succeeded,
                     ${EX_JOB_FAILED} if it failed, ${EX_WAIT_TIMEOUT} if it is still running after SEC
                     seconds (default ${DEFAULT_WAIT_TIMEOUT}), ${EX_WAIT_ERROR} on any other error (no such
                     job, job killed, devspace gone).
  list               List known devspaces with their live run status and the
                     CPU model each one got (runner hardware varies)
  stop NAME          Cancel the run and remove local state
  -h, --help         Show this help

State (keys, known_hosts, ssh_config) lives in ${STATE_ROOT}/NAME.
BOT_DEVSPACE_SSH_TIMEOUT (seconds, default 900) bounds the wait for SSH.
BOT_DEVSPACE_JOB_POLL (seconds, default 15) is how often wait polls a job.
Runners are billed while they run: stop them when done. Never copy
credentials (GitHub tokens etc.) to a devspace.
EOF
}

# The status fatal exits with; wait sets its own (EX_WAIT_ERROR).
fatal_status=1

fatal() {
    echo "error: $*" 1>&2
    exit "${fatal_status}"
}

info() {
    echo "$*" 1>&2
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || fatal "'$1' not found in PATH; $2"
}

# round_duration MIN: prints the shortest duration the workflow allows
# that covers MIN minutes; fails for anything else.
round_duration() {
    local want=$1 d
    [[ "${want}" =~ ^[0-9]{1,6}$ ]] || return 1
    want=$((10#${want}))
    test "${want}" -gt 0 || return 1
    for d in "${VALID_DURATIONS[@]}"; do
        if test "${d}" -ge "${want}"; then
            echo "${d}"
            return 0
        fi
    done
    return 1
}

one_of() { # one_of VALUE CHOICES...
    local value=$1 choice
    shift
    for choice in "$@"; do
        test "${value}" = "${choice}" && return 0
    done
    return 1
}

validate_name() { # validate_name NAME [KIND]
    local name=$1 kind=${2:-devspace}
    [[ "${name}" =~ ^[a-z0-9][a-z0-9_.-]{0,62}$ ]] ||
        fatal "invalid ${kind} name '${name}': use lowercase letters, digits, '-', '_' or '.' (at most 63 characters)"
}

state_dir() {
    echo "${STATE_ROOT}/$1"
}

run_url() {
    echo "https://github.com/${REPO}/actions/runs/$1"
}

# A read-only REST call, retried on transient failures. Returns EX_NOTFOUND
# without retrying on a 404. Never use this for POSTs: a retried dispatch
# could start a second runner.
api() {
    local attempt err out
    err=$(mktemp)
    for attempt in $(seq "${API_ATTEMPTS}"); do
        if out=$(gh api "$@" 2>"${err}"); then
            rm -f "${err}"
            test -z "${out}" || printf '%s\n' "${out}"
            return 0
        fi
        if grep -q 'HTTP 404' "${err}"; then
            rm -f "${err}"
            return "${EX_NOTFOUND}"
        fi
        test "${attempt}" -eq "${API_ATTEMPTS}" || sleep 3
    done
    cat "${err}" 1>&2
    rm -f "${err}"
    return 1
}

# Prints the run id of a known devspace, failing if there is none.
run_id_of() {
    local name=$1 dir
    dir=$(state_dir "${name}")
    test -d "${dir}" || fatal "no devspace named '${name}' (see '$(basename "$0") list')"
    test -s "${dir}/run_id" || fatal "devspace '${name}' never finished starting; '$(basename "$0") stop ${name}' cleans it up"
    cat "${dir}/run_id"
}

# Prints "status conclusion" for a run. The conclusion is empty while the
# run is active, and a run that no longer exists is "gone deleted".
run_state() {
    local id=$1 details rc=0 path status conclusion
    details=$(api "repos/${REPO}/actions/runs/${id}" \
        --jq '"\(.path | sub("@.*$"; "")) \(.status) \(.conclusion // "")"') || rc=$?
    if test "${rc}" -eq "${EX_NOTFOUND}"; then
        echo "gone deleted"
        return 0
    fi
    test "${rc}" -eq 0 || fatal "cannot query run ${id} with gh"
    read -r path status conclusion <<<"${details}"
    test "${path}" = "${WORKFLOW_PATH}" || fatal "run ${id} is not a ${WORKFLOW} run"
    echo "${status} ${conclusion}"
}

is_active_status() {
    case "$1" in
        requested|waiting|pending|queued|in_progress) return 0 ;;
        *) return 1 ;;
    esac
}

# Prints "id status" for the recent runs titled for NAME. devspace.yml's
# run-name is "Devspace NAME (16c, 120m)", its size and duration, and
# "Devspace NAME" in revisions from before those were added. NAME is
# validated, so it is safe in the filter; the " (" keeps it from also
# matching a longer NAME.
titled_runs() {
    api "${RUNS_API}" --jq ".workflow_runs[] | select(.display_title == \"Devspace $1\" or (.display_title | startswith(\"Devspace $1 (\"))) | \"\(.id) \(.status)\""
}

# new_runs DIR RUNS: prints the ids in RUNS ("id status" lines) that are
# not listed in DIR/prior_runs.
new_runs() {
    awk '{ print $1 }' <<<"$2" | grep -vxF -f "$1/prior_runs" || true
}

write_ssh_config() {
    local name=$1 dir=$2 id=$3 user=$4
    cat >"${dir}/ssh_config" <<EOF
# Generated by bot-devspace for run $(run_url "${id}")
Host ${ALIAS_PREFIX}${name}
    HostName ${HOST_PREFIX}${id}
    User ${user}
    IdentityFile "${dir}/id_ed25519"
    IdentitiesOnly yes
    UserKnownHostsFile "${dir}/known_hosts"
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30
    ServerAliveCountMax 4
EOF
}

# ssh_probe NAME [USER]: whether NAME accepts SSH (as USER, if given).
ssh_probe() {
    local name=$1 user=${2:-} dir
    dir=$(state_dir "${name}")
    timeout 20 ssh -F "${dir}/ssh_config" -o BatchMode=yes -o ConnectTimeout=8 \
        ${user:+-l "${user}"} "${ALIAS_PREFIX}${name}" true </dev/null >/dev/null 2>&1
}

# record_cpu NAME: stores NAME's CPU model in its state and prints it. Only
# informational, so a failure is a warning, not an error.
record_cpu() {
    local name=$1 dir cpu
    dir=$(state_dir "${name}")
    if cpu=$(timeout 20 ssh -F "${dir}/ssh_config" -o BatchMode=yes "${ALIAS_PREFIX}${name}" \
        "${CPU_PROBE}" </dev/null 2>/dev/null) && test -n "${cpu}"; then
        echo "${cpu}" >"${dir}/cpu"
        info "CPU: ${cpu}"
    else
        info "warning: could not read the CPU model of ${name}"
    fi
}

# The user a devspace's SSH sessions run as (see SSH_USERS).
ssh_user_of() {
    local file
    file="$(state_dir "$1")/ssh_user"
    if test -s "${file}"; then
        cat "${file}"
    else
        # State from before the user was recorded
        echo "${LEGACY_SSH_USER}"
    fi
}

# wait_for_ssh NAME ID: waits until one of SSH_USERS can log in, then
# records it and points the ssh_config at it.
wait_for_ssh() {
    local name=$1 id=$2 deadline state status conclusion last='' user dir
    dir=$(state_dir "${name}")
    deadline=$((SECONDS + SSH_TIMEOUT))
    while test "${SECONDS}" -lt "${deadline}"; do
        state=$(run_state "${id}")
        read -r status conclusion <<<"${state}"
        is_active_status "${status}" ||
            fatal "run ${id} finished (${conclusion:-unknown}) before SSH became ready; see $(run_url "${id}")"
        if test "${status}" != "${last}"; then
            info "Run ${id} is ${status}; waiting for SSH..."
            last=${status}
        fi
        if test "${status}" = in_progress; then
            for user in "${SSH_USERS[@]}"; do
                if ssh_probe "${name}" "${user}"; then
                    echo "${user}" >"${dir}/ssh_user"
                    write_ssh_config "${name}" "${dir}" "${id}" "${user}"
                    test "${user}" = "${SSH_USER}" ||
                        info "note: ${HOST_PREFIX}${id} only admits ${user}, which has sudo (the workflow at this ref predates the unprivileged ${SSH_USER})"
                    return 0
                fi
            done
        fi
        sleep "${POLL_INTERVAL}"
    done
    fatal "SSH to ${HOST_PREFIX}${id} was not ready within ${SSH_TIMEOUT}s; check $(run_url "${id}") (is this machine on the tailnet?)"
}

# EXIT trap for start: a runner that never became usable must not keep
# running (and billing) unnoticed.
start_cleanup() {
    local rc=$1 name=$2 keep=$3
    test "${rc}" -ne 0 || return 0
    if ${keep}; then
        info "Keeping devspace '${name}' after the failure; '$(basename "$0") stop ${name}' removes it"
        return 0
    fi
    info "Start failed; cancelling devspace '${name}'"
    (cmd_stop "${name}") ||
        info "warning: cleanup failed; run '$(basename "$0") stop ${name}' to avoid leaving a billed runner"
}

cmd_start() {
    local ref=${DEFAULT_REF} cores=${DEFAULT_CORES} duration=${DEFAULT_DURATION} provision=true keep=false name
    while test $# -gt 0; do
        case "$1" in
            --ref) test $# -ge 2 || fatal "--ref requires an argument"; ref=$2; shift 2 ;;
            --ref=*) ref=${1#--ref=}; shift ;;
            --cores) test $# -ge 2 || fatal "--cores requires an argument"; cores=$2; shift 2 ;;
            --cores=*) cores=${1#--cores=}; shift ;;
            --duration) test $# -ge 2 || fatal "--duration requires an argument"; duration=$2; shift 2 ;;
            --duration=*) duration=${1#--duration=}; shift ;;
            --no-provision) provision=false; shift ;;
            --keep-on-failure) keep=true; shift ;;
            -*) fatal "unknown option for start: $1 (see --help)" ;;
            *) break ;;
        esac
    done
    test $# -eq 1 || fatal "usage: $(basename "$0") start [--ref REF] [--cores N] [--duration MIN] [--no-provision] [--keep-on-failure] NAME"
    name=$1
    validate_name "${name}"
    one_of "${cores}" "${VALID_CORES[@]}" || fatal "--cores must be one of: ${VALID_CORES[*]} (got '${cores}'); 8 is not supported; use 4 or 16 for a limit of 16 cores"
    local wanted=${duration}
    duration=$(round_duration "${wanted}") ||
        fatal "--duration must be a number of minutes up to ${VALID_DURATIONS[-1]}; the workflow allows ${VALID_DURATIONS[*]} (got '${wanted}')"
    test "${duration}" = "${wanted}" ||
        info "note: rounding --duration ${wanted} up to ${duration} minutes, the next the workflow allows (${VALID_DURATIONS[*]})"
    test -n "${ref}" || fatal "--ref must not be empty"

    local dir existing state status conclusion runs
    dir=$(state_dir "${name}")
    if test -e "${dir}"; then
        test -s "${dir}/run_id" ||
            fatal "devspace '${name}' has leftover state from an incomplete start; run '$(basename "$0") stop ${name}' first"
        existing=$(cat "${dir}/run_id")
        state=$(run_state "${existing}")
        read -r status conclusion <<<"${state}"
        if is_active_status "${status}"; then
            fatal "devspace '${name}' is already active (run ${existing}, ${status}); reuse it or '$(basename "$0") stop ${name}' first"
        fi
        info "Removing stale state for finished run ${existing} (${conclusion:-unknown})"
        rm -rf -- "${dir}"
    fi
    # Also catch a devspace of the same name started from another machine.
    # The ids seen now are excluded when finding our run below, which avoids
    # relying on the local clock agreeing with GitHub's.
    runs=$(titled_runs "${name}") || fatal "cannot list runs of ${REPO} with gh"
    existing=$(awk '$2 ~ /^(requested|waiting|pending|queued|in_progress)$/ { print $1; exit }' <<<"${runs}")
    test -z "${existing}" ||
        fatal "an active run titled 'Devspace ${name}' already exists: $(run_url "${existing}"); pick another name"

    mkdir -p "${STATE_ROOT}"
    chmod 700 "${STATE_ROOT}"
    mkdir -m 700 "${dir}"
    ssh-keygen -q -t ed25519 -N '' -C "bot-devspace-${name}" -f "${dir}/id_ed25519"
    : >"${dir}/known_hosts"
    awk '{ print $1 }' <<<"${runs}" >"${dir}/prior_runs"

    trap 'start_cleanup $? "${name}" "${keep}"' EXIT
    trap 'exit 130' INT TERM
    local started=${SECONDS}
    gh api -X POST "repos/${REPO}/actions/workflows/${WORKFLOW}/dispatches" -f ref="${ref}" \
        -f "inputs[ssh_public_key]=$(cat "${dir}/id_ed25519.pub")" -f "inputs[session_name]=${name}" \
        -f "inputs[duration]=${duration}" -f "inputs[cores]=${cores}" >/dev/null ||
        fatal "dispatching ${WORKFLOW} on ${REPO}@${ref} failed; in the unlikely case a run titled 'Devspace ${name}' shows up anyway, cancel it at https://github.com/${REPO}/actions"
    # From here on, stop looks for the run even if we never learn its id.
    date +%s >"${dir}/dispatched"
    info "Dispatched ${WORKFLOW} (ref ${ref}, ${cores} cores, ${duration} min) as 'Devspace ${name}'"

    local deadline ids id=
    deadline=$((SECONDS + CORRELATE_TIMEOUT))
    while test "${SECONDS}" -lt "${deadline}"; do
        sleep 2
        runs=$(titled_runs "${name}") || continue
        ids=$(new_runs "${dir}" "${runs}")
        test -n "${ids}" || continue
        test "$(wc -l <<<"${ids}")" -eq 1 ||
            fatal "several new runs are titled 'Devspace ${name}' (${ids//$'\n'/ })"
        id=${ids}
        break
    done
    test -n "${id}" || fatal "no run titled 'Devspace ${name}' appeared within ${CORRELATE_TIMEOUT}s; check https://github.com/${REPO}/actions"
    echo "${id}" >"${dir}/run_id"
    write_ssh_config "${name}" "${dir}" "${id}" "${SSH_USER}"
    info "Run ${id}: $(run_url "${id}")"

    wait_for_ssh "${name}" "${id}"
    info "SSH ready on ${HOST_PREFIX}${id} $((SECONDS - started))s after dispatch"
    record_cpu "${name}"
    if ${provision}; then
        # stdout is reserved for the host name.
        cmd_provision "${name}" 1>&2
    fi
    trap - EXIT INT TERM
    echo "${HOST_PREFIX}${id}"
}

cmd_provision() {
    test $# -eq 1 || fatal "usage: $(basename "$0") provision NAME"
    local name=$1 mode=check
    validate_name "${name}"
    run_id_of "${name}" >/dev/null
    if test "$(ssh_user_of "${name}")" = "${LEGACY_SSH_USER}"; then
        mode=install
        info "Provisioning ${name}: ${PROVISION_PACKAGES[*]}"
    fi
    # Only call dnf for what is missing, so re-running is quick and quiet.
    if ! ssh -F "$(state_dir "${name}")/ssh_config" "${ALIAS_PREFIX}${name}" \
        bash -s -- "${mode}" "${BCVK_VERSION}" "${TMT_VERSION}" "${PROVISION_PACKAGES[@]}" <<'EOF'; then
set -euo pipefail
# The runner image is built with umask 000.
umask 022
mode=$1 bcvk_version=$2 tmt_version=$3
shift 3

# bcvk and tmt, per user and without sudo; this runs after the packages
# are there, since it needs python3-pip.
install_user_tools() {
    local bindir=${HOME}/.local/bin
    mkdir -p "${bindir}"
    if ! "${bindir}/bcvk" --version 2>/dev/null | grep -qFw "${bcvk_version}"; then
        local target tmp url
        target=bcvk-$(uname -m)-unknown-linux-gnu
        url=https://github.com/bootc-dev/bcvk/releases/download/v${bcvk_version}/${target}.tar.gz
        tmp=$(mktemp -d)
        curl -fsSL --retry 5 -o "${tmp}/${target}.tar.gz" "${url}"
        curl -fsSL --retry 5 -o "${tmp}/${target}.tar.gz.sha256" "${url}.sha256"
        (cd "${tmp}" && sha256sum --quiet -c "${target}.tar.gz.sha256")
        tar -C "${tmp}" -xzf "${tmp}/${target}.tar.gz"
        install -m 0755 -T "${tmp}/${target}" "${bindir}/bcvk"
        rm -rf "${tmp}"
        echo "Installed bcvk ${bcvk_version} in ${bindir}"
    fi
    # bootc's tmt runs use the connect provisioner, so the
    # provision-virtual extra (and building libvirt-python) is not needed.
    if ! "${bindir}/tmt" --version 2>/dev/null | grep -qFw "${tmt_version}"; then
        python3 -m pip install -q --user --disable-pip-version-check "tmt==${tmt_version}"
        echo "Installed tmt ${tmt_version} in ${bindir}"
    fi
}

missing=()
for pkg in "$@"; do
    rpm -q --whatprovides "${pkg}" >/dev/null 2>&1 || missing+=("${pkg}")
done
if test "${mode}" = check; then
    if test "${#missing[@]}" -ne 0; then
        echo "error: missing packages: ${missing[*]}" 1>&2
        exit 1
    fi
    echo "All packages installed"
    install_user_tools
    exit 0
fi
# Legacy devspaces, whose SSH user has sudo. The runner image is built
# with umask 000, which leaves files such as the crypto-policies OpenSSH
# config group/world-writable; ssh then refuses to run (breaking e.g.
# `bcvk libvirt ssh`). Tighten config trees.
sudo find /etc /usr/share/crypto-policies -xdev -type f -perm /022 \
    -exec chmod go-w {} + 2>/dev/null || true
if test "${#missing[@]}" -eq 0; then
    echo "All packages already installed"
else
    sudo dnf install -y -q "${missing[@]}" >/dev/null
    echo "Installed: ${missing[*]}"
fi
# Let later libvirt/KVM use work without sudo (takes effect for new
# SSH sessions); the libvirt group only exists once libvirt is installed.
for group in kvm libvirt; do
    if getent group "${group}" >/dev/null && ! id -nG | tr ' ' '\n' | grep -qx "${group}"; then
        sudo usermod -aG "${group}" "$(id -un)"
    fi
done
install_user_tools
EOF
        test "${mode}" = install ||
            fatal "devspace ${name} lacks part of the toolchain, and ${SSH_USER} has no sudo to install it: add the packages to packages.txt in ${REPO}"
        fatal "provisioning ${name} failed"
    fi
}

cmd_ssh() {
    test $# -ge 1 || fatal "usage: $(basename "$0") ssh NAME [CMD...]"
    local name=$1
    shift
    validate_name "${name}"
    run_id_of "${name}" >/dev/null
    exec ssh -F "$(state_dir "${name}")/ssh_config" "${ALIAS_PREFIX}${name}" "$@"
}

cmd_ssh_config() {
    test $# -eq 1 || fatal "usage: $(basename "$0") ssh-config NAME"
    validate_name "$1"
    run_id_of "$1" >/dev/null
    echo "$(state_dir "$1")/ssh_config"
}

# job_remote NAME OP JOB [ARG...]: runs a job operation on the devspace.
# The ARGs are quoted for the remote shell, which ssh hands the joined
# command line to.
job_remote() {
    local name=$1 op=$2 job=$3 args=() arg
    shift 3
    for arg in "$@"; do
        args+=("$(printf '%q' "${arg}")")
    done
    ssh -F "$(state_dir "${name}")/ssh_config" -o BatchMode=yes "${ALIAS_PREFIX}${name}" \
        bash -s -- job "${op}" "${job}" "${JOBS_DIR}" "${args[@]}" <<'EOF'
set -euo pipefail
op=$2 job=$3 dir=${HOME}/$4/$3
shift 4
# Prints done STATUS, running, lost (it died without recording a status)
# or unknown. The second look at exit catches a job that ended between
# the first and kill -0.
job_state() {
    if test -e "${dir}/exit"; then
        echo "done $(cat "${dir}/exit")"
    elif test -s "${dir}/pid" && kill -0 "$(cat "${dir}/pid")" 2>/dev/null; then
        echo running
    elif test -e "${dir}/exit"; then
        echo "done $(cat "${dir}/exit")"
    elif test -d "${dir}"; then
        echo lost
    else
        echo unknown
    fi
}
case "${op}" in
    start)
        cwd=$1 cmd=$2
        if test "$(job_state)" = running; then
            echo "error: job ${job} is still running" 1>&2
            exit 1
        fi
        cd -- "${cwd}"
        rm -rf -- "${dir}"
        mkdir -p -- "${dir}"
        printf '%s\n' "${cmd}" >"${dir}/cmd"
        # setsid detaches the job from this SSH session. The status is
        # renamed into place so that a poll never reads a partial one.
        setsid bash -c 'bash -c "$1" >"$2/log" 2>&1; echo $? >"$2/exit.tmp"; mv "$2/exit.tmp" "$2/exit"' \
            job "${cmd}" "${dir}" </dev/null >/dev/null 2>&1 &
        echo $! >"${dir}/pid"
        echo "${dir}/log" ;;
    state) job_state ;;
    tail) tail -n "$1" "${dir}/log" ;;
esac
EOF
}

cmd_run() {
    local cwd=.
    while test $# -gt 0; do
        case "$1" in
            --cd) test $# -ge 2 || fatal "--cd requires an argument"; cwd=$2; shift 2 ;;
            --cd=*) cwd=${1#--cd=}; shift ;;
            -*) fatal "unknown option for run: $1 (see --help)" ;;
            *) break ;;
        esac
    done
    test $# -ge 3 || fatal "usage: $(basename "$0") run [--cd DIR] NAME JOB CMD..."
    local name=$1 job=$2 log
    shift 2
    validate_name "${name}"
    validate_name "${job}" job
    run_id_of "${name}" >/dev/null
    log=$(job_remote "${name}" start "${job}" "${cwd}" "$*") ||
        fatal "could not start job ${job} on ${name}"
    info "Started job ${job} on ${name}; '$(basename "$0") wait ${name} ${job}' blocks until it ends"
    echo "${log}"
}

cmd_wait() {
    fatal_status=${EX_WAIT_ERROR}
    local timeout=${DEFAULT_WAIT_TIMEOUT} tail=${DEFAULT_WAIT_TAIL}
    while test $# -gt 0; do
        case "$1" in
            --timeout) test $# -ge 2 || fatal "--timeout requires an argument"; timeout=$2; shift 2 ;;
            --timeout=*) timeout=${1#--timeout=}; shift ;;
            --tail) test $# -ge 2 || fatal "--tail requires an argument"; tail=$2; shift 2 ;;
            --tail=*) tail=${1#--tail=}; shift ;;
            -*) fatal "unknown option for wait: $1 (see --help)" ;;
            *) break ;;
        esac
    done
    test $# -eq 2 || fatal "usage: $(basename "$0") wait [--timeout SEC] [--tail N] NAME JOB"
    local name=$1 job=$2 id
    [[ "${timeout}" =~ ^[0-9]{1,6}$ ]] || fatal "--timeout must be a number of seconds (got '${timeout}')"
    [[ "${tail}" =~ ^[0-9]{1,6}$ ]] || fatal "--tail must be a number of lines (got '${tail}')"
    validate_name "${name}"
    validate_name "${job}" job
    id=$(run_id_of "${name}")

    [[ "${JOB_POLL_INTERVAL}" =~ ^[1-9][0-9]{0,3}$ ]] || fatal "BOT_DEVSPACE_JOB_POLL must be a number of seconds (got '${JOB_POLL_INTERVAL}')"
    local deadline=$((SECONDS + 10#${timeout})) started=${SECONDS} failures=0 state status conclusion job_status remaining
    while :; do
        if state=$(job_remote "${name}" state "${job}" 2>/dev/null); then
            failures=0
            case "${state}" in
                running) ;;
                "done "*)
                    job_status=${state#done }
                    info "Job ${job} on ${name} exited with ${job_status} after waiting $((SECONDS - started))s; last lines of its log:"
                    job_remote "${name}" tail "${job}" "$((10#${tail}))" ||
                        info "warning: could not read the log of job ${job}"
                    test "${job_status}" = 0 && return 0
                    return "${EX_JOB_FAILED}" ;;
                lost) fatal "job ${job} on ${name} died without recording an exit status (killed?)" ;;
                unknown) fatal "no job named '${job}' on ${name} (start one with '$(basename "$0") run')" ;;
                *) fatal "unexpected job state from ${name}: ${state}" ;;
            esac
        else
            state=$(run_state "${id}")
            read -r status conclusion <<<"${state}"
            is_active_status "${status}" ||
                fatal "devspace ${name} is gone (run ${id} ${conclusion:-finished}), and job ${job} with it"
            failures=$((failures + 1))
            test "${failures}" -lt "${JOB_POLL_ATTEMPTS}" ||
                fatal "cannot reach ${name} over SSH (${failures} attempts in a row); its run ${id} is still ${status}"
        fi
        remaining=$((deadline - SECONDS))
        if test "${remaining}" -le 0; then
            info "Job ${job} on ${name} is still running after ${timeout}s; run wait again to keep waiting"
            return "${EX_WAIT_TIMEOUT}"
        fi
        sleep "$((remaining < 10#${JOB_POLL_INTERVAL} ? remaining : 10#${JOB_POLL_INTERVAL}))"
    done
}

cmd_list() {
    test $# -eq 0 || fatal "usage: $(basename "$0") list"
    local dirs=("${STATE_ROOT}"/*/) dir name id state cpu
    test -d "${dirs[0]}" || return 0
    {
        printf 'NAME\tRUN\tSTATUS\tHOST\tCPU\n'
        for dir in "${dirs[@]}"; do
            name=$(basename "${dir}")
            cpu=-
            test -s "${dir}/cpu" && cpu=$(cat "${dir}/cpu")
            if test -s "${dir}/run_id"; then
                id=$(cat "${dir}/run_id")
                state=$(run_state "${id}" 2>/dev/null) || state=unknown
                state=${state% }
                state=${state/ /:}
                printf '%s\t%s\t%s\t%s\t%s\n' "${name}" "${id}" "${state}" "${HOST_PREFIX}${id}" "${cpu}"
            else
                printf '%s\t-\tincomplete-start\t-\t-\n' "${name}"
            fi
        done
    } | column -t -s $'\t'
}

cmd_stop() {
    test $# -eq 1 || fatal "usage: $(basename "$0") stop NAME"
    local name=$1 dir ids id state status conclusion deadline runs dispatched
    validate_name "${name}"
    dir=$(state_dir "${name}")
    test -d "${dir}" || fatal "no devspace named '${name}' (see '$(basename "$0") list')"
    if test -s "${dir}/run_id"; then
        ids=$(cat "${dir}/run_id")
    elif test -e "${dir}/dispatched"; then
        # A start that never recorded its run id: find the active runs with
        # our title that did not exist before the dispatch.
        runs=$(titled_runs "${name}") || fatal "cannot list runs of ${REPO} with gh"
        ids=$(new_runs "${dir}" "$(awk '$2 ~ /^(requested|waiting|pending|queued|in_progress)$/' <<<"${runs}")")
        dispatched=$(cat "${dir}/dispatched")
        if test -z "${ids}" && test $(($(date +%s) - dispatched)) -lt "${CORRELATE_TIMEOUT}"; then
            fatal "the run for '${name}' may not be listed yet; retry '$(basename "$0") stop ${name}' in a minute"
        fi
    else
        ids=
    fi
    for id in ${ids}; do
        state=$(run_state "${id}")
        read -r status conclusion <<<"${state}"
        if is_active_status "${status}"; then
            gh api -X POST "repos/${REPO}/actions/runs/${id}/cancel" >/dev/null ||
                info "warning: cancelling run ${id} failed; it may be finishing on its own"
        fi
        deadline=$((SECONDS + STOP_TIMEOUT))
        while is_active_status "${status}"; do
            test "${SECONDS}" -lt "${deadline}" ||
                fatal "run ${id} is still ${status} after ${STOP_TIMEOUT}s; state kept in ${dir}, retry '$(basename "$0") stop ${name}'"
            sleep "${POLL_INTERVAL}"
            state=$(run_state "${id}")
            read -r status conclusion <<<"${state}"
        done
        info "Run ${id} finished (${conclusion:-unknown})"
    done
    rm -rf -- "${dir}"
    info "Removed state for ${name}"
}

test $# -gt 0 || { usage 1>&2; exit 1; }
command=$1
shift
case "${command}" in
    -h|--help|help) usage; exit 0 ;;
    start|provision|ssh|ssh-config|run|wait|list|stop) ;;
    *) fatal "unknown command '${command}' (see --help)" ;;
esac
require_cmd gh "install the GitHub CLI (https://cli.github.com) and authenticate it"
require_cmd ssh "install openssh-clients"
require_cmd ssh-keygen "install openssh-clients"
case "${command}" in
    start) cmd_start "$@" ;;
    provision) cmd_provision "$@" ;;
    ssh) cmd_ssh "$@" ;;
    ssh-config) cmd_ssh_config "$@" ;;
    run) cmd_run "$@" ;;
    wait) cmd_wait "$@" ;;
    list) cmd_list "$@" ;;
    stop) cmd_stop "$@" ;;
esac
