#!/usr/bin/env node
// The open PRs of the board's P0 and P1 work that need someone to look
// at them: CI failing or stuck, merge blocked by conflicts, a missing
// sign-off, or no activity for too long. bot-watch prints them as its
// "Priority health" section on every sweep. See --help.
// Node's standard library only, plus gh and bot-board.
"use strict";

const { execFile } = require("node:child_process");
const crypto = require("node:crypto");
const fs = require("node:fs");
const os = require("node:os");
const path = require("node:path");
const { promisify } = require("node:util");

const execFileP = promisify(execFile);

const PROG = path.basename(process.argv[1] || "bot-priority-health");
const BIN_DIR = path.dirname(fs.realpathSync(process.argv[1] || __filename));
const GH = process.env.BOT_PRIORITY_HEALTH_GH || "gh";
const BOT_BOARD = process.env.BOT_PRIORITY_HEALTH_BOT_BOARD || path.join(BIN_DIR, "bot-board");
const BOT_LOGIN = "cgwalters-bot";
// The bot's PRs in these owners' repositories with a bot-meta section
// are its fork PRs (as in bot-watch): cgwalters' review queue, with their
// CI off, and the sign-off added by 'bot-pr promote'.
const FORK_OWNERS = ["cgwalters-forge", "cgwalters-bot"];
const FORK_META = "<!-- bot-meta -->";
// The P0 epic's board (bot-board --project), whose PRs are swept at the
// priority they have there.
const EPIC_PROJECT = "composefs-stable";
// Swept priorities, most urgent first, and how long each may go without
// any activity on its PR.
const STALE_HOURS = { P0: 24, P1: 72 };
const PRIORITIES = Object.keys(STALE_HOURS);
const PENDING_HOURS = 4;
const SKIP_STATUSES = ["Done"];
// Check run conclusions that make CI red; a DCO check asking for action
// is missing sign-offs too.
const FAILED_CONCLUSIONS = ["failure", "timed_out", "startup_failure"];
const DCO_FAILED_CONCLUSIONS = [...FAILED_CONCLUSIONS, "action_required"];
const FAILED_STATUSES = ["failure", "error"];
// As in dco-detect.sh: the DCO apps, or a check named DCO as a word.
const DCO_APP_SLUGS = ["dco", "dco-2"];
const DCO_NAME_RE = /(^|[^a-z0-9])dco([^a-z0-9]|$)/i;
// The problems, in the order they are listed for one PR.
const REASONS = ["ci-failing", "dco", "ci-pending", "conflict", "behind", "stale"];
const CHECKS_PER_PAGE = 100;
const SHORT_SHA = 12;
const MAX_NAMES = 6;
const API_CONCURRENCY = 6;
const PR_URL_RE = /^(https:\/\/github\.com\/([^/]+)\/([^/]+)\/pull\/([0-9]+))(?:[/#?]|$)/;
// Conditional requests answered 304 cost no quota. One file per path
// holds its ETag and body, so that a copy is never paired with another's
// ETag.
const ETAG_DIR = path.join(process.env.XDG_CACHE_HOME || path.join(os.homedir(), ".cache"), "bot-priority-health", "etags");
const ETAG_KEEP_DAYS = 14;
const HOUR_MS = 3600 * 1000;
const EX_ERROR = 1;
const EX_USAGE = 2;
// An exhausted quota (EX_TEMPFAIL), as in bot-board and bot-watch.
const EX_RATELIMIT = 75;

class Exit extends Error {
  constructor(status, message) {
    super(message);
    this.status = status;
  }
}

function usage() {
  return `Usage: ${PROG} [--board-file FILE] [--epic-board-file FILE] [--now TIME] [--json]

Lists the open PRs of the Workstream board's items with Priority ${PRIORITIES.join(" or ")}
(the item's own PR, and the PRs in its Branch field; not ${SKIP_STATUSES.join(", ")}),
and those of the ${EPIC_PROJECT} board (the P0 epic's) at the priority
they have there, that need a look:

  ci-failing  a check run or commit status failed on the current head
              (the failing ones are named)
  dco         the DCO check fails: commits lack a Signed-off-by
  ci-pending  checks still pending ${PENDING_HOURS}h after they started
  conflict    the PR conflicts with its base
  behind      the PR is behind a base that must be up to date
  stale       no activity on the PR (by anyone, bots included) for over
              ${PRIORITIES.map((p) => `${STALE_HOURS[p]}h (${p})`).join(" or ")}

The bot's fork PRs (in ${FORK_OWNERS.join(", ")}, with a bot-meta section) are
cgwalters' review queue, with no CI of their own: only P0 ones are
checked, and only for conflicts and staleness.

One line per problem, P0 first:

  PRIORITY REASON URL HEAD: DETAIL

HEAD is the first ${SHORT_SHA} characters of the PR's head commit. The first
four fields identify the problem: they stay the same on every sweep
until it is fixed or the head moves, so a poll can report each once.

Each PR costs a request for the PR and one for its check runs (a page
per ${CHECKS_PER_PAGE}) and one for its commit statuses, all conditional (ETags in
${ETAG_DIR.replace(os.homedir(), "~")}): an unchanged one costs no quota.

Options:
  --board-file FILE       the Workstream board as 'bot-board list --json'
                          prints it (default: run that)
  --epic-board-file FILE  the same for the ${EPIC_PROJECT} board
  --now TIME              take TIME as now
  --json                  print a JSON array of {priority, reason, url,
                          head, detail, items, line}
  -h, --help              show this help

Exits 1 if a PR could not be read (the others are still listed), and
${EX_RATELIMIT} if GitHub is rate limiting the bot.
`;
}

function parseArgs(argv) {
  const opts = { boardFile: null, epicBoardFile: null, now: new Date(), json: false };
  const value = (i, name) => {
    if (i + 1 >= argv.length) throw new Exit(EX_USAGE, `${name} needs a value\n\n${usage()}`);
    return argv[i + 1];
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case "-h":
      case "--help":
        process.stdout.write(usage());
        process.exit(0);
      case "--board-file": opts.boardFile = value(i++, a); break;
      case "--epic-board-file": opts.epicBoardFile = value(i++, a); break;
      case "--now": {
        const s = value(i++, a);
        opts.now = new Date(s);
        if (Number.isNaN(opts.now.getTime())) throw new Exit(EX_USAGE, `--now takes a time, not '${s}'`);
        break;
      }
      case "--json": opts.json = true; break;
      default:
        throw new Exit(EX_USAGE, `unexpected argument '${a}'\n\n${usage()}`);
    }
  }
  return opts;
}

const warn = (msg) => process.stderr.write(`${PROG}: warning: ${msg}\n`);

// ghFailure(stderr, what): the Exit for a failed gh call.
function ghFailure(stderr, what) {
  const detail = (stderr || "").trim().split("\n").pop();
  if (/rate limit|abuse/i.test(stderr || "")) return new Exit(EX_RATELIMIT, `GitHub is rate limiting the bot (${detail})`);
  return new Exit(EX_ERROR, `${what} failed: ${detail}`);
}

// restGet(p): the JSON at the API path p, or null if GitHub says it
// doesn't exist; sends the ETag of the cached copy.
async function restGet(p) {
  const file = path.join(ETAG_DIR, `${crypto.createHash("sha256").update(p).digest("hex").slice(0, 32)}.json`);
  let cached = null;
  try {
    cached = JSON.parse(fs.readFileSync(file, "utf8"));
  } catch {
    // Not cached yet, or unreadable: fetched in full.
  }
  const args = ["api", "-i", p];
  if (cached && cached.etag) args.push("-H", `If-None-Match: ${cached.etag}`);
  let stdout;
  let stderr = "";
  try {
    ({ stdout } = await execFileP(GH, args, { maxBuffer: 256 << 20 }));
  } catch (e) {
    // gh fails on a 304 too, having printed it.
    stdout = e.stdout || "";
    stderr = e.stderr || e.message;
  }
  const raw = stdout.replace(/\r/g, "");
  const split = raw.indexOf("\n\n");
  const headers = split >= 0 ? raw.slice(0, split) : raw;
  const body = split >= 0 ? raw.slice(split + 2) : "";
  const status = Number((/^HTTP\/\S+ (\d+)/.exec(headers) || [])[1]);
  if (status === 304 && cached) {
    const t = new Date();
    fs.utimesSync(file, t, t);
    return cached.body;
  }
  if (status === 404 || status === 410) return null;
  if (status !== 200) throw ghFailure(stderr, `gh api ${p}`);
  const data = JSON.parse(body);
  const etag = (/^etag:\s*(.*)$/im.exec(headers) || [])[1];
  if (etag) {
    fs.mkdirSync(ETAG_DIR, { recursive: true });
    const tmp = `${file}.tmp.${process.pid}`;
    fs.writeFileSync(tmp, JSON.stringify({ etag: etag.trim(), body: data }));
    fs.renameSync(tmp, file);
  }
  return data;
}

// Copies of resources not read for a while (old heads' checks) go.
function pruneCache(now) {
  let names;
  try {
    names = fs.readdirSync(ETAG_DIR);
  } catch {
    return;
  }
  const cutoff = now.getTime() - ETAG_KEEP_DAYS * 24 * HOUR_MS;
  for (const n of names) {
    const f = path.join(ETAG_DIR, n);
    try {
      if (fs.statSync(f).mtimeMs < cutoff) fs.unlinkSync(f);
    } catch (e) {
      warn(`pruning ${f} failed: ${e.message}`);
    }
  }
}

async function loadBoard(file, project) {
  let text;
  if (file) {
    try {
      text = fs.readFileSync(file, "utf8");
    } catch (e) {
      throw new Exit(EX_ERROR, `cannot read ${file}: ${e.message}`);
    }
  } else {
    const args = [...(project ? ["--project", project] : []), "list", "--json"];
    try {
      ({ stdout: text } = await execFileP(BOT_BOARD, args, { maxBuffer: 256 << 20 }));
    } catch (e) {
      if (e.code === EX_RATELIMIT) throw new Exit(EX_RATELIMIT, "GitHub is rate limiting the bot (listing the board)");
      throw new Exit(EX_ERROR, `bot-board ${args.join(" ")} failed: ${(e.stderr || e.message).trim()}`);
    }
  }
  const board = JSON.parse(text);
  if (!Array.isArray(board)) throw new Exit(EX_ERROR, `${file || "bot-board list"} is not a 'bot-board list --json' array`);
  return board;
}

// prUrls(item): the PRs of a board item: its own, and those in Branch.
function prUrls(item) {
  const urls = [];
  const own = PR_URL_RE.exec((item.content && item.content.type === "PullRequest" && item.content.url) || "");
  if (own) urls.push(own[1]);
  for (const word of (item.branch || "").split(/\s+/)) {
    const m = PR_URL_RE.exec(word);
    if (m) urls.push(m[1]);
  }
  return urls;
}

// targets(boards): the PRs to check, as [{url, priority, items}], an item
// on several boards (or a PR of several items) at its most urgent
// priority; boards is [[boardName, items]].
function targets(boards) {
  const byUrl = new Map();
  for (const [name, items] of boards) {
    for (const item of items) {
      if (SKIP_STATUSES.includes(item.status) || !PRIORITIES.includes(item.priority)) continue;
      for (const url of new Set(prUrls(item))) {
        const t = byUrl.get(url) || { url, priority: item.priority, items: [] };
        if (PRIORITIES.indexOf(item.priority) < PRIORITIES.indexOf(t.priority)) t.priority = item.priority;
        if (!t.items.some((i) => i.title === item.title)) t.items.push({ board: name, title: item.title });
        byUrl.set(url, t);
      }
    }
  }
  return [...byUrl.values()];
}

const isDco = (run) => DCO_APP_SLUGS.includes((run.app && run.app.slug) || "") || DCO_NAME_RE.test(run.name || "");

function names(list) {
  const sorted = [...new Set(list)].sort();
  const more = sorted.length - MAX_NAMES;
  return sorted.slice(0, MAX_NAMES).join(", ") + (more > 0 ? ` (+${more} more)` : "");
}

// checkProblems(runs, statuses, now): [[reason, detail]] for a head's
// check runs (the latest of each name, as the API lists them) and commit
// statuses (the latest of each context).
function checkProblems(runs, statuses, now) {
  const failing = [];
  const dco = [];
  const pending = [];
  for (const r of runs) {
    if (r.status === "completed") {
      if (isDco(r) && DCO_FAILED_CONCLUSIONS.includes(r.conclusion)) dco.push(r.name);
      else if (FAILED_CONCLUSIONS.includes(r.conclusion)) failing.push(r.name);
    } else if (r.started_at) {
      pending.push([r.name, r.started_at]);
    }
  }
  for (const s of statuses) {
    if (FAILED_STATUSES.includes(s.state)) (DCO_NAME_RE.test(s.context) ? dco : failing).push(s.context);
    else if (s.state === "pending" && s.created_at) pending.push([s.context, s.created_at]);
  }
  const stuck = pending.filter(([, since]) => now - Date.parse(since) > PENDING_HOURS * HOUR_MS);
  const problems = [];
  if (failing.length) problems.push(["ci-failing", names(failing)]);
  if (dco.length) problems.push(["dco", `${names(dco)}: commits lack a Signed-off-by`]);
  if (stuck.length) {
    const since = stuck.map(([, s]) => s).sort()[0];
    problems.push(["ci-pending", `pending since ${since}: ${names(stuck.map(([n]) => n))}`]);
  }
  return problems;
}

async function checkRuns(repo, sha) {
  const runs = [];
  for (let page = 1; ; page++) {
    const body = await restGet(`repos/${repo}/commits/${sha}/check-runs?per_page=${CHECKS_PER_PAGE}&page=${page}`);
    if (!body) return runs;
    runs.push(...body.check_runs);
    if (page * CHECKS_PER_PAGE >= body.total_count || !body.check_runs.length) return runs;
  }
}

// checkPr(target, now): the problems of one PR, as [[reason, detail]],
// with its head: {head, problems}; null for one that isn't open.
async function checkPr(t, now) {
  const [, , owner, name, number] = PR_URL_RE.exec(t.url);
  const repo = `${owner}/${name}`;
  const pr = await restGet(`repos/${repo}/pulls/${number}`);
  if (!pr || pr.state !== "open") return null;
  const fork = pr.user.login === BOT_LOGIN && FORK_OWNERS.includes(owner) && (pr.body || "").includes(FORK_META);
  if (fork && t.priority !== PRIORITIES[0]) return null;
  const head = pr.head.sha;
  const problems = [];
  if (!fork) {
    const runs = await checkRuns(repo, head);
    const status = await restGet(`repos/${repo}/commits/${head}/status?per_page=${CHECKS_PER_PAGE}`);
    problems.push(...checkProblems(runs, (status && status.statuses) || [], now));
  }
  const base = (pr.base && pr.base.ref) || "its base";
  if (pr.mergeable_state === "dirty") problems.push(["conflict", `conflicts with ${base}`]);
  else if (pr.mergeable_state === "behind") problems.push(["behind", `behind ${base}, which must be up to date`]);
  if (now - Date.parse(pr.updated_at) > STALE_HOURS[t.priority] * HOUR_MS) {
    problems.push(["stale", `no activity since ${pr.updated_at}`]);
  }
  return { head, problems };
}

// pool(items, fn): runs fn over items, at most API_CONCURRENCY at a time.
async function pool(items, fn) {
  const out = new Array(items.length);
  let next = 0;
  const worker = async () => {
    while (next < items.length) {
      const i = next++;
      out[i] = await fn(items[i]);
    }
  };
  await Promise.all(Array.from({ length: Math.min(API_CONCURRENCY, items.length) }, worker));
  return out;
}

// sweep(boards, now): {problems, failed}: the problems of every PR, P0
// first, and the URLs that could not be read.
async function sweep(boards, now) {
  const failed = [];
  const list = targets(boards);
  const results = await pool(list, async (t) => {
    try {
      return await checkPr(t, now);
    } catch (e) {
      if (!(e instanceof Exit) || e.status === EX_RATELIMIT) throw e;
      warn(`reading ${t.url} failed: ${e.message}`);
      failed.push(t.url);
      return null;
    }
  });
  const problems = [];
  list.forEach((t, i) => {
    const r = results[i];
    if (!r) return;
    const head = r.head.slice(0, SHORT_SHA);
    for (const [reason, detail] of r.problems) {
      problems.push({
        priority: t.priority, reason, url: t.url, head: r.head, detail, items: t.items.map((it) => it.title),
        line: `${t.priority} ${reason} ${t.url} ${head}: ${detail}`,
      });
    }
  });
  const rank = (p) => [PRIORITIES.indexOf(p.priority), p.url, REASONS.indexOf(p.reason)];
  problems.sort((a, b) => {
    const [x, y] = [rank(a), rank(b)];
    return x[0] - y[0] || (x[1] < y[1] ? -1 : x[1] > y[1] ? 1 : 0) || x[2] - y[2];
  });
  return { problems, failed };
}

function render(problems) {
  if (!problems.length) return "Priority health: nothing to flag\n";
  return `Priority health:\n${problems.map((p) => `  ${p.line}\n`).join("")}`;
}

async function main() {
  const opts = parseArgs(process.argv.slice(2));
  pruneCache(opts.now);
  const boards = [
    ["workstream", await loadBoard(opts.boardFile, null)],
    [EPIC_PROJECT, await loadBoard(opts.epicBoardFile, EPIC_PROJECT)],
  ];
  const { problems, failed } = await sweep(boards, opts.now);
  process.stdout.write(opts.json ? `${JSON.stringify(problems)}\n` : render(problems));
  if (failed.length) throw new Exit(EX_ERROR, `${failed.length} PR(s) could not be read; they are not listed`);
}

if (require.main === module) {
  main().catch((e) => {
    if (!(e instanceof Exit)) throw e;
    process.stderr.write(`${PROG}: ${e.message}\n`);
    process.exit(e.status);
  });
} else {
  module.exports = { targets, checkProblems, render };
}
