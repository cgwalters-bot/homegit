#!/usr/bin/env bash
# Sweep the upstream issues and PRs of the Workstream board's items and
# report what changed since the last sweep: new comments and reviews,
# merges and closes, pushes by others, CI going red. Only board
# bookkeeping follows from it, and only with --apply.
# jq programs hold literal $variables.
# shellcheck disable=SC2016
set -euo pipefail
shopt -s inherit_errexit
# shellcheck source=bin/operator.sh disable=SC1091 # followed with shellcheck -x
source "$(dirname "$(readlink -f "$0")")/operator.sh"

readonly BOT_LOGIN=${OP_BOT_LOGIN}
# Comments by this login are flagged: they may be requests.
readonly REQUESTER=${OP_OPERATOR_LOGIN}
# The bot's PRs in repositories of these owners with a bot-meta section
# (which 'bot-pr fork-pr' writes) are its fork PRs, the ones 'bot-pr
# inbox' searches: the operator's comments and reviews on them, and
# their closing them, are for inbox; here they only get their head and CI
# watched. Anything else there (the bot's own repositories' PRs, issues,
# PRs by others) is swept in full.
readonly FORK_OWNERS="[\"${OP_FORGE_ORG}\", \"${OP_BOT_LOGIN}\"]"
readonly FORK_META='<!-- bot-meta -->'
# fork_pr(OWNER): whether a PR (REST pull or search item) in a repository
# of OWNER is one of the bot's fork PRs; takes $bot, $forks and $meta.
readonly FORK_PR_JQ='def fork_pr($owner): .user.login == $bot and ($forks | index($owner)) != null
    and ((.body // "") | contains($meta));'
# The search API returns at most 1000 results.
readonly SEARCH_MAX_PAGES=10
# A sweep of one topic lead's items keeps its own state (STATE_NAME, then
# a suffix), so that it neither drops the URLs of the other sweeps nor
# is dropped by them.
STATE_NAME=watch
# The Lead field says which topic session owns an item; the coordinator
# owns the rest, and the items it names itself.
readonly COORDINATOR_LEAD=coordinator
# --exclude-lead ANY_LEAD: every Lead but COORDINATOR_LEAD.
readonly ANY_LEAD='*'
readonly STATE_VERSION=1
# Items in these statuses or workflows are not swept.
readonly SKIP_STATUSES='["Done"]'
readonly SKIP_WORKFLOWS='["manual"]'
# --apply only moves items out of these statuses: never an untriaged item,
# one someone is working on, or one waiting for a human.
readonly APPLY_FROM='["Todo", "Draft", "In Review"]'
readonly MERGED_STATUS=Done
readonly CLOSED_STATUS='Needs human'
readonly WHY_MAX=400
readonly EXCERPT_LEN=100
readonly SHORT_SHA=10
readonly CHECKS_PER_PAGE=100
# Check run conclusions that make CI red.
readonly FAILED_CONCLUSIONS='["failure", "timed_out", "startup_failure"]'
readonly PER_PAGE=100
# Conditional requests answered 304 are free; the cache is local and only
# an HTTP cache, so it is written even in a dry run.
readonly ETAG_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/bot-watch/etags
readonly ETAG_KEEP_DAYS=14
# URLs that left the sweep are remembered this long, so that one coming
# back (an item reopened from Done, say) doesn't replay old news.
readonly DROPPED_KEEP_DAYS=30
readonly LOCK_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/bot-watch
# Exit status for an exhausted quota (EX_TEMPFAIL), as in bot-board.
readonly EX_RATELIMIT=75
# Returned by rest_get() and ghapi() when GitHub says the resource does
# not exist (any more): EX_NOINPUT, distinct from gh's own exit statuses.
readonly EX_NOTFOUND=66
BOT_BOARD=$(dirname "$(readlink -f "$0")")/bot-board
readonly BOT_BOARD
UPSTREAM_POLICY=$(dirname "$(readlink -f "$0")")/upstream-policy
readonly UPSTREAM_POLICY
PRIORITY_HEALTH=$(dirname "$(readlink -f "$0")")/bot-priority-health
readonly PRIORITY_HEALTH
SIGNOFF_DUE=$(dirname "$(readlink -f "$0")")/bot-signoff-due
readonly SIGNOFF_DUE
PRIORITY_PROPAGATE=$(dirname "$(readlink -f "$0")")/bot-priority-propagate
readonly PRIORITY_PROPAGATE
PROMOTE_DUE=$(dirname "$(readlink -f "$0")")/bot-promote-due
readonly PROMOTE_DUE
DRIVE=$(dirname "$(readlink -f "$0")")/bot-drive
readonly DRIVE
OPERATOR_ACTIVITY=$(dirname "$(readlink -f "$0")")/bot-operator-activity
readonly OPERATOR_ACTIVITY
# shellcheck source=bin/gh-http.sh disable=SC1091 # followed with shellcheck -x
source "$(dirname "$(readlink -f "$0")")/gh-http.sh" || {
    echo "error: ${0##*/} needs gh-http.sh from homegit's bin/ next to it" 1>&2
    exit 1
}
# shellcheck source=bin/review-state.sh disable=SC1091 # followed with shellcheck -x
source "$(dirname "$(readlink -f "$0")")/review-state.sh" || {
    echo "error: ${0##*/} needs review-state.sh from homegit's bin/ next to it" 1>&2
    exit 1
}

usage() {
    cat <<EOF
Usage: $(basename "$0") [--dry-run] [--apply] [--json] [--lead LEAD] [--exclude-lead LEAD]...

Sweep the upstream issues and PRs of the Workstream board's items (not
${SKIP_STATUSES}, not Workflow ${SKIP_WORKFLOWS}): each item's own issue or PR, and
the PR URLs in its Branch field. For each, compare with what the last
sweep saw and report:

  - new comments and reviews by anyone but ${BOT_LOGIN}, with their
    author and first line that isn't quoted (those by ${REQUESTER}
    flagged; for a review of line comments only, its first comment);
  - state changes: merged, closed, reopened;
  - pushes to a PR's head: force pushes by anyone but ${BOT_LOGIN}, with
    who made them; other new commits with their committer (GitHub
    doesn't say who pushed them), unless that is ${BOT_LOGIN};
  - CI turning red (or green again), flagged on the bot's own branches.
    Runs of workflows disabled since don't count, failed or still
    queued: 'bot-pr fork-setup' disables every workflow on the forks in
    ${OP_FORGE_ORG}, where devspace testing is the CI, so the runs
    cancelled then (whose summary jobs fail) aren't news.

On the bot's fork PRs (its PRs in ${FORK_OWNERS} with a
bot-meta section; not its own repositories' PRs) only pushes and CI
are reported; 'bot-pr inbox' covers ${OP_OPERATOR_POSSESSIVE} review there. Most have
no CI at all, which is expected and not reported. A URL seen for the
first time is only recorded, unless CI on the bot's branch fails, with
two exceptions (none on the very first sweep, with no state yet). On an
issue or PR the bot opened, the comments and reviews since it was opened
are new; on anything else, only those by ${REQUESTER} since the last
sweep. A URL that left the sweep and came back within ${DROPPED_KEEP_DAYS} days
counts from when it was last seen.

Every sweep starts with the "Priority health" section of
'bot-priority-health' (see its --help): the open PRs of the P0 and P1
work whose CI fails or is stuck, that conflict or are behind, lack a
sign-off, or have seen no activity for too long, P0 first. Its lines
stay the same until the problem is fixed or the PR's head moves.

Then comes "Priority propagation" ('bot-priority-propagate', see its
--help): priority follows structure, so with --apply the Branch items of
the P0 (then P1) items are raised to their priority, and those and new
sub-issues are added to the board (sub-issues already on the board keep
their priority), and each change is listed as a line. It is
bookkeeping: bot-poll doesn't wake for it.

Next comes the "P0 drive" of 'bot-drive' (see its --help): one line
per open P0 PR of the bot's, its merge blocker derived anew on every
sweep (conflict, needs-regen, behind, dco, ci-failing, ci-pending,
review or mergeable) and the step taken. With --apply, a conflicting
PR, or one only behind a base that must be up to date, gets 'bot-pr
rebase' (at most once per PR per hour); with --dry-run (or
--board-file), the command it would run.

Then the "Sign-offs" of 'bot-signoff-due' (see its --help): the
bot's upstream PRs whose DCO check fails although ${REQUESTER} approved
their head. With --apply, each gets 'bot-pr signoff' and a line
"Signed off: URL (NEW-HEAD)", or why it was refused; with --dry-run
(or --board-file), the command it would run; otherwise they are only
listed.

Then the "Promotions" of 'bot-promote-due' (see its --help): the bot's
fork PRs whose current head ${REQUESTER} approved (a review or a
'/promote' line), for a repository whose contribution policy is bot-ok.
With --apply, each gets 'bot-pr promote' (with --draft after his
'/draft') and a line "Promoted: URL -> UPSTREAM-PR-URL", or why it was
refused; with --dry-run (or --board-file), the command it would run;
otherwise they are only listed. Approved fork PRs for a human-text
repository are never promoted: they are listed under "Needs your text".

Then the "Operator activity" of 'bot-operator-activity' (see its
--help): what ${REQUESTER} did on GitHub lately that the bot should act
on, one line per event, "KIND ACTION URL: SUMMARY": their events on the
bot's work (the board's, the bot's issues and PRs, threads it commented
in), classified once each by a small model. Mentions, requests and
approvals are left to bot-notify and the sign-off and promotion steps.
With --dry-run (or --board-file), nothing new is classified.

Apart from those changes, every sweep lists the "Outstanding reviews by
${REQUESTER}" on the bot's open PRs other than fork PRs (upstream ones
and its own repositories'; board items or not: one search finds them),
until they are answered: a review requesting
changes by a push of the bot's or his own (one by anyone else, like
GitHub's "Update branch", answers nothing), or by his own later review;
his other reviews and comments by such a push or a reply of the bot's.
After his approval, only his later reviews and his comments that
mention @${BOT_LOGIN} count. So nothing the edge-triggered report
missed is lost.

Also on every sweep, "Needs rebase" lists the bot's open PRs (upstream
ones, on the board or not, and its fork PRs on the board; not its own
repositories' PRs, which 'bot-pr rebase' can't take) that need
rebasing onto their base: GitHub finds them conflicting
(mergeable_state dirty), or behind a base that must be up to date
(behind), or their CI fails while their base has moved on (by the
compare API; fork PRs run no CI), unless they have outstanding reviews
by ${REQUESTER}, which a rebase's push would seem to answer. They are
split into conflict-free
ones, for 'bot-pr rebase', and conflicting ones, for a worker. One
listed for CI is not listed again once its head moved with CI still
failing: the rebase didn't fix it.
Upstream PRs that don't conflict are left out where 'upstream-policy
rebase' says conflicts-only (a merge queue the record doesn't override
with 'rebase: any', or the maintainers asked),
as 'bot-pr rebase' refuses them.

Then suggest board bookkeeping, for an item one of whose PRs this sweep
saw merge or close (open at the last sweep), once none of the PRs it
lists (fork PRs included) is open: with one of its other PRs (upstream
ones, or the bot's own repositories') merged it is ${MERGED_STATUS}; with all of them closed unmerged it needs a human.
Only --apply makes these changes, through bot-board (on a fresh board
listing), and only for items in ${APPLY_FROM}. Each change is suggested
once: the next sweep sees no transition any more.

A topic session owns the items whose Lead field names it (see the
topic-lead skill). The coordinator leaves those to it with
--exclude-lead '${ANY_LEAD}' (any Lead but ${COORDINATOR_LEAD}); a topic session sweeps only
its own with --lead TOPIC, keeping its own last-seen state. The filters
apply to the item news, rebase and bookkeeping sections (--lead $COORDINATOR_LEAD
includes the items with no Lead); --lead also skips the search for the
bot's PRs on no item. The priority health and P0 drive sections are
deterministic and shared: they cover every item (with --lead, only that
lead's). The priority propagation, sign-offs and promotions always cover every item.

Options:
  --dry-run   Report only: apply nothing and keep the last-seen state
  --apply     Make the suggested status changes (a run without --apply
              or --dry-run only reports them, and the next doesn't)
  --lead LEAD
              Sweep only the items whose Lead is LEAD
  --exclude-lead LEAD
              Skip the items whose Lead is LEAD ('${ANY_LEAD}': any but
              ${COORDINATOR_LEAD}); repeatable
  --json      Print one JSON object for agents instead of the report
  -h, --help  Show this help

The last-seen state (url -> updated_at, state, head_sha, checks, and
edge_ids: the comments seen at updated_at; when the last sweep that
wrote it started; and when dropped URLs were last seen) lives in
${LOCK_DIR}/${STATE_NAME}.json on this machine,
written (to a temporary file, then renamed) only when something
changed. It used to live in the archived 'bot-state: ${STATE_NAME}' draft
item on the board, which a few hundred URLs outgrew (a draft body holds
64KB): without the file, the sweep starts from that item's last state.
It advances per URL: one that could not be read keeps its last-seen
state, so a later sweep reports its changes, and the sweep exits
nonzero. The board listing comes from bot-board (revalidated for
--apply); everything else is REST, with ETags.
EOF
}

fatal() {
    echo "error: $*" 1>&2
    exit 1
}

warn() {
    echo "warning: $*" 1>&2
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || fatal "'$1' not found in PATH; $2"
}

rate_limited() {
    echo "error: GitHub is rate limiting the bot ($1); retry after $(gh api rate_limit --jq '.resources.core.reset | todate' 2>/dev/null || echo "the reset")" 1>&2
    exit "${EX_RATELIMIT}"
}

# check_rate_limit ERRFILE: exits if ERRFILE reports rate limiting.
check_rate_limit() {
    local reason
    if reason=$(grep -iE -m1 'rate limit|abuse' "$1"); then
        rate_limited "${reason}"
    fi
}

# board_failed STATUS MESSAGE: after a failed bot-board call, pass a
# rate-limit exit through (bot-board printed why), else fail.
board_failed() {
    test "$1" -ne "${EX_RATELIMIT}" || exit "${EX_RATELIMIT}"
    fatal "$2"
}

dry_run=false
apply=false
json=false
# Hidden test hooks: sweep the items of a 'bot-board list --json' array in
# a file instead of the board (--apply then only prints the bot-board
# calls), keep the state in a file instead of on the board, and take
# another time for now. With --board-file, the P0 epic's board is empty
# unless --epic-board-file gives one.
board_file=
epic_board_file=
state_file=
now=
lead=
exclude_leads=()
while test $# -gt 0; do
    case "$1" in
        --dry-run) dry_run=true; shift ;;
        --apply) apply=true; shift ;;
        --json) json=true; shift ;;
        --lead) test $# -ge 2 || fatal "--lead requires a value"; lead=$2; shift 2 ;;
        --exclude-lead) test $# -ge 2 || fatal "--exclude-lead requires a value"; exclude_leads+=("$2"); shift 2 ;;
        --board-file) test $# -ge 2 || fatal "--board-file requires a file"; board_file=$2; shift 2 ;;
        --state-file) test $# -ge 2 || fatal "--state-file requires a file"; state_file=$2; shift 2 ;;
        --epic-board-file) test $# -ge 2 || fatal "--epic-board-file requires a file"; epic_board_file=$2; shift 2 ;;
        --now) test $# -ge 2 || fatal "--now requires a time"; now=$(date -u -d "$2" +%FT%TZ) || fatal "bad --now: $2"; shift 2 ;;
        -h|--help) usage; exit 0 ;;
        *) fatal "unknown argument: $1 (see --help)" ;;
    esac
done

require_cmd gh "install the GitHub CLI (https://cli.github.com) and authenticate it as ${BOT_LOGIN}"
require_cmd jq "install jq"
require_cmd flock "install util-linux"

scratch=$(mktemp -d)
# The steps run in the background (see run_pool and step_start) die
# with the sweep, rather than run on unseen.
trap 'kill_background; rm -rf "${scratch}"' EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
# kill_background: stops the background jobs and their children.
kill_background() {
    local pid
    for pid in $(jobs -p); do
        pkill -TERM -P "${pid}" 2>/dev/null || true
        kill -TERM "${pid}" 2>/dev/null || true
    done
}

# BOT_WATCH_TIMING=1: how long each section took, on stderr, to find
# what makes a sweep slow.
readonly TIMING=${BOT_WATCH_TIMING:-}
readonly STARTED=${EPOCHREALTIME}
# timing NAME START [DETAIL]: prints how long NAME took since START (an
# EPOCHREALTIME), with BOT_WATCH_TIMING set.
timing() {
    test -n "${TIMING}" || return 0
    local end=${EPOCHREALTIME}
    LC_ALL=C awk -v n="$1" -v s="$2" -v e="${end}" -v d="${3:-}" \
        'BEGIN { printf "timing: %s %.1fs%s\n", n, e - s, (d == "" ? "" : " (" d ")") }' 1>&2
}

# ghapi ARGS...: 'gh api', turning rate limiting into a clear exit and a
# 404 or 410 into EX_NOTFOUND.
ghapi() {
    local rc=0
    gh api "$@" 2>"${scratch}/err" || rc=$?
    if test "${rc}" -ne 0; then
        check_rate_limit "${scratch}/err"
        grep -qE 'HTTP (404|410)' "${scratch}/err" && return "${EX_NOTFOUND}"
        cat "${scratch}/err" 1>&2
    fi
    return "${rc}"
}

# rest_get PATH: prints the JSON at PATH, sending the ETag of the cached
# copy so that an unchanged resource costs no quota.
rest_get() {
    local path=$1 key etag_file body_file args rc=0 status etag
    key=$(printf '%s' "${path}" | sha256sum | cut -c1-32)
    etag_file=${ETAG_DIR}/${key}.etag
    body_file=${ETAG_DIR}/${key}.json
    args=(-i "${path}")
    if test -s "${etag_file}" && test -s "${body_file}"; then
        args+=(-H "If-None-Match: $(<"${etag_file}")")
    fi
    gh api "${args[@]}" >"${scratch}/raw" 2>"${scratch}/err" || rc=$?
    split_http_response "${scratch}/raw" "${scratch}/headers" "${scratch}/body"
    status=$(awk 'NR == 1 { print $2 }' "${scratch}/headers")
    case "${status}" in
        304)
            # Still in use: see the pruning below.
            touch "${body_file}" "${etag_file}"
            cat "${body_file}"
            ;;
        200)
            etag=$(awk 'tolower($0) ~ /^etag:/ { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }' "${scratch}/headers")
            if test -n "${etag}"; then
                mkdir -p "${ETAG_DIR}"
                # Jobs share $$ (and may read one resource at once).
                cp "${scratch}/body" "${body_file}.tmp.${BASHPID}"
                mv -f "${body_file}.tmp.${BASHPID}" "${body_file}"
                printf '%s\n' "${etag}" >"${etag_file}.tmp.${BASHPID}"
                mv -f "${etag_file}.tmp.${BASHPID}" "${etag_file}"
            fi
            cat "${scratch}/body"
            ;;
        404|410) return "${EX_NOTFOUND}" ;;
        *)
            check_rate_limit "${scratch}/err"
            cat "${scratch}/err" 1>&2
            test "${rc}" -ne 0 || rc=1
            return "${rc}"
            ;;
    esac
}

# rest_pages PATH: prints the elements of the JSON array at PATH, one per
# line, from all its pages. For lists that only grow at the end (events,
# comments), whose full pages then answer 304.
rest_pages() {
    local sep='?' page=1 body
    [[ "$1" != *\?* ]] || sep='&'
    while :; do
        body=$(rest_get "$1${sep}per_page=${PER_PAGE}&page=${page}") || return
        jq -c '.[]' <<<"${body}" || return
        test "$(jq length <<<"${body}")" -ge "${PER_PAGE}" || return 0
        page=$((page + 1))
    done
}

# How many issues and PRs are read at once (BOT_WATCH_JOBS): each read
# is a few REST calls in a row, so a sweep of a few hundred took over ten
# minutes one at a time. Not many more: with the steps that run
# meanwhile, 8 made about 1400 requests a minute, over GitHub's
# secondary rate limit of 900 (most of them answered 304, which may
# still count).
readonly JOBS=${BOT_WATCH_JOBS:-3}

# run_pool DIR FUNC: runs 'FUNC LINE' for each line on stdin, JOBS at a
# time, each in the background (so that errexit holds in FUNC) with its
# own scratch dir. Job I (from 0, in input order) has its stdout in
# DIR/I.out and its exit status in DIR/I.rc. Once a job exits with
# EX_RATELIMIT no more start, and DIR/ratelimited exists. Run it in the
# background too, so that it waits only for its own jobs.
run_pool() {
    local dir=$1 fn=$2 i=0 running=0 line
    mkdir -p "${dir}"
    while IFS= read -r line; do
        if test "${running}" -ge "${JOBS}"; then
            wait -n || true
            running=$((running - 1))
        fi
        test ! -e "${dir}/ratelimited" || break
        pool_job "${dir}/${i}" "${fn}" "${line}" &
        running=$((running + 1))
        i=$((i + 1))
    done
    wait
}

# pool_job JOB FUNC LINE: one job of run_pool, JOB being DIR/I.
pool_job() {
    local rc=0
    scratch=$1
    mkdir -p "${scratch}"
    "$2" "$3" >"$1.out" &
    wait "$!" || rc=$?
    test "${rc}" -ne "${EX_RATELIMIT}" || : >"${1%/*}/ratelimited"
    echo "${rc}" >"$1.rc"
}

# step_start NAME CMD [ARGS...]: runs CMD in the background while the
# sweep goes on, its stdout to ${scratch}/NAME.out, its stderr to
# NAME.err and its exit status to NAME.rc; wait for it with
# step_pids[NAME] in the shell that started it (not in a command
# substitution).
declare -A step_pids=()
step_start() {
    local name=$1
    shift
    {
        local rc=0 t=${EPOCHREALTIME}
        "$@" >"${scratch}/${name}.out" 2>"${scratch}/${name}.err" || rc=$?
        timing "${name}" "${t}" 2>>"${scratch}/${name}.err"
        echo "${rc}" >"${scratch}/${name}.rc"
    } &
    step_pids[${name}]=$!
}


# Copies of resources not read for a while (such as the comments since
# an old updated_at) are dropped.
if test -d "${ETAG_DIR}"; then
    find "${ETAG_DIR}" -type f -mtime "+${ETAG_KEEP_DAYS}" -delete || warn "pruning ${ETAG_DIR} failed"
fi

if test -n "${lead}"; then
    test "${lead}" != "${ANY_LEAD}" || fatal "--lead takes a topic name, not '${ANY_LEAD}'"
    # Free-text, case-sensitive: the same as the board shows.
    STATE_NAME=watch-lead-${lead//[^A-Za-z0-9._-]/_}
fi

login=$(ghapi user --jq .login) || fatal "'gh api user' failed; authenticate gh as ${BOT_LOGIN}"
test "${login}" = "${BOT_LOGIN}" || fatal "gh is authenticated as '${login}', not ${BOT_LOGIN}"

# Two sweeps on one machine must not race on the state (or both apply).
mkdir -p "${LOCK_DIR}"
exec {lock_fd}>"${LOCK_DIR}/lock" || fatal "cannot open ${LOCK_DIR}/lock"
flock -n "${lock_fd}" || fatal "another $(basename "$0") run holds ${LOCK_DIR}/lock"

# --- Board and state -------------------------------------------------------

t0=${EPOCHREALTIME}

if test -n "${board_file}"; then
    board=$(jq -ce 'if type == "array" then . else error("not an array") end' "${board_file}") ||
        fatal "--board-file ${board_file} is not a 'bot-board list --json' array"
    warn "testing: sweeping the items in ${board_file}; board changes are only printed"
else
    # Changing statuses by a stale listing could undo a recent move.
    refresh=()
    ! ${apply} || ${dry_run} || refresh=(--refresh)
    board=$("${BOT_BOARD}" "${refresh[@]}" list --json) || board_failed $? "listing the board failed"
fi
migrate=false
if test -n "${state_file}"; then
    warn "testing: keeping the state in ${state_file}"
else
    state_file=${LOCK_DIR}/${STATE_NAME}.json
    test -e "${state_file}" || test -n "${board_file}" || migrate=true
fi
if ! ${migrate}; then
    state=$(if test -s "${state_file}"; then cat "${state_file}"; else echo '{}'; fi) ||
        fatal "cannot read the last-seen state in ${state_file}"
else
    # Once: the state from before it moved here (see --help).
    state=$("${BOT_BOARD}" state-get "${STATE_NAME}") || board_failed $? "reading the last-seen state (bot-state: ${STATE_NAME}) to start ${state_file} with failed"
    warn "starting ${state_file} from the board's 'bot-state: ${STATE_NAME}'; it is kept in that file from now on"
fi
seen=$(jq -ce --argjson v "${STATE_VERSION}" '
    if (.version // $v) != $v then error("unsupported version \(.version)") else .items // {} end' <<<"${state}") ||
    fatal "cannot use the last-seen state in ${state_file}; fix it, or empty it to start over"

# The items this sweep owns, by Lead (see --help).
exclude_json=$(printf '%s\n' "${exclude_leads[@]}" | jq -Rsc 'split("\n")[:-1]')
test "${#exclude_leads[@]}" -gt 0 || exclude_json='[]'
LEAD_FILTER_JQ='def led_by($want): (.lead // "") as $l | $l == $want or ($l == "" and $want == $coord);
    def excluded($ex): (.lead // "") as $l | $l != "" and any($ex[]; . == $l or (. == $any and $l != $coord));'
filter_leads() { # filter_leads BOARD_JSON: the items --lead and --exclude-lead leave
    jq -c --arg lead "${lead}" --argjson ex "${exclude_json}" --arg any "${ANY_LEAD}" --arg coord "${COORDINATOR_LEAD}" \
        "${LEAD_FILTER_JQ}"' [.[] | select($lead == "" or led_by($lead)) | select(excluded($ex) | not)]' <<<"$1"
}
swept_board=$(filter_leads "${board}")

# watch_records BOARD_JSON: one record per swept URL, with the board
# items it belongs to.
watch_records() {
    jq -c --argjson skip_status "${SKIP_STATUSES}" --argjson skip_workflow "${SKIP_WORKFLOWS}" '
    [.[] | select((.status // "") as $s | $skip_status | index($s) | not)
         | select((.workflow // "") as $w | $skip_workflow | index($w) | not)
         | {id, title, status, workflow, why} as $item
         | ((if .content.type == "Issue" or .content.type == "PullRequest" then .content.url else empty end),
            ((.branch // "") | split(" ")[]
             | capture("^(?<u>https://github\\.com/[^/]+/[^/]+/pull/[0-9]+)(?:[/#?]|$)").u))
         | {url: ., item: $item}]
    | group_by(.url) | map({url: .[0].url, items: [.[].item] | unique_by(.id)})' <<<"$1"
}
watch=$(watch_records "${swept_board}")
# The PRs of every item, led or not: not "off the board" for the search
# that finds the bot's PRs on no item.
board_urls=$(watch_records "${board}" | jq -c '[.[].url]')
nurls=$(jq length <<<"${watch}")
# When the last sweep that wrote the state started (older states only
# have when they were written). Without either, this is the first sweep,
# which has no news: everything is history. Sweeps that change nothing
# don't write, so it can be older than the last sweep, which only makes
# a first sight report more.
last_swept=$(jq -r '.swept_at // .updated_at // empty' <<<"${state}")
bootstrap=true
test -z "${last_swept}" || bootstrap=false
dropped=$(jq -c '.dropped // {}' <<<"${state}")
swept_at=${now:-$(date -u +%FT%TZ)}
nitems=$(jq '[.[].items[].id] | unique | length' <<<"${watch}")
timing "board and state" "${t0}" "${nitems} items"

# --- Sweep -----------------------------------------------------------------

# OWNER/REPO#N for an issue or PR URL.
readonly REPO_REF_JQ='def repo_ref:
    capture("github\\.com/(?<r>[^/]+/[^/]+)/(issues|pull)/(?<n>[0-9]+)") | "\(.r)#\(.n)";'
# repo: the OWNER/REPO of a PR entry's url.
readonly REBASE_REPO_JQ='def repo: .url | capture("github\\.com/(?<r>[^/]+/[^/]+)/pull/").r;'

# disabled_suites REPO SHA: prints the ids of the check suites of SHA's
# Actions runs whose workflow is disabled now, as a JSON array. Their
# results are not news: 'bot-pr fork-setup' disables every workflow on a
# forge fork (devspace testing is the CI of fork PRs), cancelling runs
# whose summary jobs then fail, and leaving others to finish.
disabled_suites() {
    local runs workflows
    runs=$(rest_get "repos/$1/actions/runs?head_sha=$2&per_page=${PER_PAGE}") || return
    workflows=$(rest_get "repos/$1/actions/workflows?per_page=${PER_PAGE}") || return
    printf '%s\n%s\n' "${runs}" "${workflows}" | jq -sc '
        [.[1].workflows[] | select(.state | startswith("disabled")) | .id] as $disabled
        | [.[0].workflow_runs[] | select(.workflow_id | IN($disabled[])) | .check_suite_id]'
}

# checks_state REPO SHA: prints failure, pending, success or none for the
# check runs and commit statuses of SHA, plus the failing names:
# {checks, failing}. Check runs of disabled workflows (see
# disabled_suites) don't count, so a fork PR whose CI is off is "none".
# A workflow opted in on a fork that fails only for want of upstream's
# secrets does count: telling that apart would take its logs, but 'bot-pr
# fork-setup' names such workflows in the fork PR.
checks_state() {
    local runs='' page=1 body total status ignored='[]'
    while :; do
        body=$(rest_get "repos/$1/commits/$2/check-runs?per_page=${CHECKS_PER_PAGE}&page=${page}") || return
        runs+=$(jq -c '.check_runs[]' <<<"${body}")$'\n'
        total=$(jq .total_count <<<"${body}")
        test $((page * CHECKS_PER_PAGE)) -lt "${total}" || break
        page=$((page + 1))
    done
    # Only worth two more requests when something failed or is pending.
    if jq -se --argjson failed "${FAILED_CONCLUSIONS}" 'any(.[]; (.conclusion | IN($failed[])) or .status != "completed")' >/dev/null <<<"${runs}"; then
        ignored=$(disabled_suites "$1" "$2") ||
            { warn "cannot list the Actions runs of $1@$2; counting failures of disabled workflows too"; ignored='[]'; }
    fi
    status=$(rest_get "repos/$1/commits/$2/status?per_page=${CHECKS_PER_PAGE}") || return
    # Its state covers every status; only the names can be cut short.
    if test "$(jq .total_count <<<"${status}")" -gt "${CHECKS_PER_PAGE}"; then
        warn "$1@$2 has over ${CHECKS_PER_PAGE} commit statuses; only the first ${CHECKS_PER_PAGE} are named"
    fi
    # Too big for jq's argument list.
    printf '%s\n%s\n%s\n' "$(jq -sc . <<<"${runs}")" "${status}" "${ignored}" | jq -sc --argjson failed "${FAILED_CONCLUSIONS}" '
        .[0] as $all | .[1] as $status | .[2] as $ignored
        | [$all[] | select(.check_suite.id | IN($ignored[]) | not)] as $runs
        | ([$runs[] | select(.conclusion | IN($failed[])) | .name]
         + [$status.statuses[] | select(.state | IN("failure", "error")) | .context]) as $failing
        | {failing: $failing,
           checks: (if ($failing | length) > 0 or ($status.total_count > 0 and $status.state == "failure") then "failure"
                    elif any($runs[]; .status != "completed")
                         or ($status.total_count > 0 and $status.state == "pending") then "pending"
                    elif ($runs | length) + $status.total_count > 0 then "success"
                    else "none" end)}'
}

# outstanding_review REPO NUMBER HEAD REVIEWS: on the bot's own open
# upstream PR, prints what REQUESTER asked that has no answer yet (see
# OUTSTANDING_REVIEW_JQ); else null. It's reported on every sweep until
# answered, so that news the edge-triggered report missed (or that was
# read and dropped) can't lose the work. REVIEWS is the PR's reviews, one
# per line.
outstanding_review() {
    local repo=$1 number=$2 head=$3 reviews=$4 commit push comments
    commit=$(rest_get "repos/${repo}/commits/${head}") || return
    push=$(jq -r --arg bot "${BOT_LOGIN}" --arg req "${REQUESTER}" "${REVIEW_PUSH_JQ}" <<<"${commit}") || return
    comments=$(rest_pages "repos/${repo}/issues/${number}/comments") || return
    printf '%s\n' "${reviews}" "${comments}" | jq -sc --arg push "${push}" --arg bot "${BOT_LOGIN}" \
        --arg req "${REQUESTER}" --argjson len "${EXCERPT_LEN}" "${OUTSTANDING_REVIEW_JQ}"
}

# pr_off_board URL: for a PR the sweep doesn't probe, prints
# {outstanding, rebase}: its outstanding_review and rebase_candidate;
# both null for one that isn't open or isn't the bot's.
pr_off_board() {
    local repo number data reviews head outstanding ci rebase
    [[ "$1" =~ ^https://github\.com/([^/]+/[^/]+)/pull/([0-9]+)$ ]] || return 1
    repo=${BASH_REMATCH[1]}
    number=${BASH_REMATCH[2]}
    data=$(rest_get "repos/${repo}/pulls/${number}") || return
    if ! jq -e --arg bot "${BOT_LOGIN}" '.state == "open" and .user.login == $bot' <<<"${data}" >/dev/null; then
        echo '{"outstanding": null, "rebase": null}'
        return 0
    fi
    head=$(jq -r .head.sha <<<"${data}")
    reviews=$(rest_pages "repos/${repo}/pulls/${number}/reviews") || return
    outstanding=$(outstanding_review "${repo}" "${number}" "${head}" "${reviews}") || return
    ci=$(checks_state "${repo}" "${head}") || return
    rebase=$(rebase_candidate "${repo}" "${data}" "${ci}" false) || return
    jq -nc --argjson o "${outstanding}" --argjson r "${rebase}" '{outstanding: $o, rebase: $r}'
}

# rebase_candidate REPO DATA CI FORK: for the bot's open PR REPO with the
# JSON DATA and checks_state CI, prints what makes it need a rebase onto
# its base, if anything, as {reason, conflicts, behind_by, failing, head,
# base, checks}: reason "conflict" (GitHub's mergeable_state is dirty),
# "behind" (it is behind, and the base requires an up-to-date branch), or
# "ci" (CI fails and the base moved on since, which may have fixed it;
# not for fork PRs, FORK true, which run no CI); conflicts is true, false
# or null (GitHub hasn't computed it yet). A PR whose CI fails or is
# still running that needs none of this prints reason null, so that the
# sweep keeps remembering it (a rebase's CI runs at first); any other
# prints null. So does a PR of the bot's own repositories (in
# FORK_OWNERS, but not a fork PR), which 'bot-pr rebase' can't take:
# 'bot-land' rebases those. Only a failing CI costs a request, the compare.
rebase_candidate() {
    local repo=$1 data=$2 ci=$3 fork=$4 mstate checks reason="" behind=null head_repo
    if ! ${fork} && jq -en --arg o "${repo%%/*}" --argjson forks "${FORK_OWNERS}" '$forks | index($o) != null' >/dev/null; then
        echo null
        return 0
    fi
    mstate=$(jq -r '.mergeable_state // "unknown"' <<<"${data}")
    checks=$(jq -r .checks <<<"${ci}")
    case "${mstate}" in
        dirty) reason=conflict ;;
        behind) reason=behind ;;
    esac
    head_repo=$(jq -r '.head.repo.full_name // empty' <<<"${data}")
    if test -z "${reason}" && ! ${fork} && test "${checks}" = failure && test -n "${head_repo}"; then
        behind=$(rest_get "repos/${repo}/compare/$(jq -r .base.ref <<<"${data}")...${head_repo%%/*}:$(jq -r .head.ref <<<"${data}")" |
            jq -e '.behind_by | numbers') || return
        test "${behind}" -eq 0 || reason=ci
    fi
    if test -z "${reason}" && test "${checks}" != failure && test "${checks}" != pending; then
        echo null
        return 0
    fi
    jq -c --arg reason "${reason}" --argjson behind "${behind}" --argjson ci "${ci}" '
        {reason: (if $reason == "" then null else $reason end),
         conflicts: (if .mergeable_state == "dirty" or .mergeable == false then true
                     elif .mergeable == true then false else null end),
         behind_by: $behind, failing: $ci.failing, checks: $ci.checks, head: .head.sha, base: .base.ref}' <<<"${data}"
}

# sub_status STATUS: the status for probe to return after a failed
# secondary fetch: only its main resource missing means it is gone.
sub_status() {
    if test "$1" -eq "${EX_NOTFOUND}"; then echo 1; else echo "$1"; fi
}

# probe URL PREV DROPPED_AT: prints {cur, changes, info} for one issue
# or PR, where cur is what the state keeps, PREV what the last sweep kept
# (null the first time), and DROPPED_AT when it was last seen, if it left
# the sweep since.
probe() {
    local url=$1 prev=$2 dropped_at=$3 repo kind number data cur changes='[]' info outstanding=null rebase=null
    [[ "${url}" =~ ^https://github\.com/([^/]+/[^/]+)/(issues|pull)/([0-9]+)$ ]] || return 1
    repo=${BASH_REMATCH[1]}
    kind=${BASH_REMATCH[2]}
    number=${BASH_REMATCH[3]}
    local fork=false
    if test "${kind}" = pull; then
        data=$(rest_get "repos/${repo}/pulls/${number}") || return
        fork=$(jq --arg bot "${BOT_LOGIN}" --argjson forks "${FORK_OWNERS}" --arg meta "${FORK_META}" \
            --arg owner "${repo%%/*}" "${FORK_PR_JQ}"' fork_pr($owner)' <<<"${data}") || return
        cur=$(jq -c '{updated_at, state: (if .merged then "merged" else .state end), head_sha: .head.sha}' <<<"${data}")
        info=$(jq -c --arg bot "${BOT_LOGIN}" --argjson fork "${fork}" --argjson forks "${FORK_OWNERS}" '
            {kind: "pr", fork: $fork, title, author: .user.login, created_at,
             bot_branch: (.user.login == $bot or ((.head.repo.owner.login // "") as $o | $forks | index($o)) != null)}' <<<"${data}")
    else
        data=$(rest_get "repos/${repo}/issues/${number}") || return
        cur=$(jq -c '{updated_at, state}' <<<"${data}")
        info=$(jq -c '{kind: "issue", fork: false, title, author: .user.login, created_at}' <<<"${data}")
    fi
    local prev_updated prev_state state
    prev_updated=$(jq -r '.updated_at // empty' <<<"${prev}")
    prev_state=$(jq -r '.state // empty' <<<"${prev}")
    state=$(jq -r .state <<<"${cur}")

    # New comments and reviews; on fork PRs they're 'bot-pr inbox'
    # business. Timestamps have whole seconds, so those at the last
    # sweep's updated_at are new too, except the ones it had seen then:
    # their keys are kept as edge_ids. For the same reason they are read
    # even if updated_at didn't move (unchanged, that costs a free 304),
    # and the first time a URL is seen, to record those. Also to report
    # them if the bot opened it: everything since then happened while it
    # was the bot's work, even before it reached the board or the board
    # cache (a review on a just-promoted PR, say). Anyone else's issue or
    # PR comes with history that is not news, except what REQUESTER wrote
    # since the last sweep (likely why it's on the board now). Nothing is
    # news on the very first sweep, nor from before a URL that comes back
    # was last seen.
    local updated reviews='' reviews_read=false
    updated=$(jq -r .updated_at <<<"${cur}")
    if ! ${fork}; then
        local edge report_since=${prev_updated} only_author=''
        edge=$(jq -c '.edge_ids // []' <<<"${prev}")
        if test -z "${prev_updated}" && ! ${bootstrap}; then
            if jq -e --arg bot "${BOT_LOGIN}" '.author == $bot' <<<"${info}" >/dev/null; then
                report_since=$(jq -r .created_at <<<"${info}")
            else
                report_since=${last_swept}
                only_author=${REQUESTER}
            fi
            [[ ! "${dropped_at}" > "${report_since}" ]] || report_since=${dropped_at}
        fi
        if test -z "${prev_updated}" || [[ ! "${updated}" < "${prev_updated}" ]]; then
            local since=${report_since:-${updated}} notes found
            notes=$(rest_pages "repos/${repo}/issues/${number}/comments?since=${since}") || return "$(sub_status $?)"
            if test "${kind}" = pull; then
                reviews=$(rest_pages "repos/${repo}/pulls/${number}/reviews") || return "$(sub_status $?)"
                reviews_read=true
            fi
            printf '%s\n' "${notes}" | jq -c '{type: "comment", key: "c\(.id)", author: .user.login,
                at: .created_at, link: .html_url, body}' >"${scratch}/notes"
            printf '%s\n' "${reviews}" | jq -c 'select(.submitted_at != null) | {type: "review", key: "r\(.id)", id,
                author: .user.login, at: .submitted_at, link: .html_url, body, review_state: .state}' >>"${scratch}/notes"
            if test -n "${report_since}"; then
                found=$(jq -sc --arg since "${report_since}" --argjson edge "${edge}" --arg bot "${BOT_LOGIN}" \
                    --arg only "${only_author}" --arg req "${REQUESTER}" --argjson len "${EXCERPT_LEN}" "${EXCERPT_JQ}"'
                    [.[] | select(.author != $bot and .at >= $since and (.key | IN($edge[]) | not))
                         | select($only == "" or .author == $only)
                         | .excerpt = (.body | excerpt) | del(.body, .key)
                         | .from_requester = (.author == $req)] | sort_by(.at)' "${scratch}/notes")
                # A review of line comments only has an empty body: show
                # its first comment instead.
                if jq -e 'any(.[]; .type == "review" and .excerpt == "")' <<<"${found}" >/dev/null; then
                    local line_comments
                    line_comments=$(rest_pages "repos/${repo}/pulls/${number}/comments?since=${report_since}") ||
                        return "$(sub_status $?)"
                    found=$(printf '%s\n' "${line_comments}" | jq -sc --slurpfile found <(printf '%s\n' "${found}") \
                        --argjson len "${EXCERPT_LEN}" "${EXCERPT_JQ}"'
                        sort_by(.id) as $lc
                        | $found[0] | map(if .type == "review" and .excerpt == "" then
                              .id as $id | .excerpt = ([$lc[] | select(.pull_request_review_id == $id) | .body | excerpt
                                                        | select(. != "")] | first // "")
                          else . end)')
                fi
                changes=$(jq -c --slurpfile f <(printf '%s\n' "${found}") '. + ($f[0] | map(del(.id)))' <<<"${changes}")
            fi
            edge=$(jq -sc --arg updated "${updated}" '[.[] | select(.at >= $updated) | .key]' "${scratch}/notes")
        fi
        cur=$(jq -c --argjson edge "${edge}" '.edge_ids = $edge' <<<"${cur}")
    fi

    if test -n "${prev_state}" && test "${prev_state}" != "${state}" && ! ${fork}; then
        changes=$(jq -c --arg from "${prev_state}" --arg to "${state}" '. + [{type: "state", from: $from, to: $to}]' <<<"${changes}")
    fi

    if test "${kind}" = pull && test "${state}" = open; then
        local head prev_head
        head=$(jq -r .head_sha <<<"${cur}")
        prev_head=$(jq -r '.head_sha // empty' <<<"${prev}")
        if test -n "${prev_head}" && test "${prev_head}" != "${head}"; then
            local events pusher push
            # A force push has an event naming who made it; the bot's own
            # aren't news.
            events=$(rest_pages "repos/${repo}/issues/${number}/events") || return "$(sub_status $?)"
            pusher=$(jq -rs --arg head "${head}" \
                'map(select(.event == "head_ref_force_pushed" and .commit_id == $head)) | last | .actor.login // empty' <<<"${events}")
            if test -n "${pusher}"; then
                test "${pusher}" = "${BOT_LOGIN}" ||
                    push=$(jq -nc --arg by "${pusher}" '{forced: true, by: $by}')
            else
                # A plain push has no such record: all there is to go by
                # is the committer of the new head, who may not be the
                # pusher. Only a login is compared, never a display name.
                local commit committer
                commit=$(rest_get "repos/${repo}/commits/${head}") || return "$(sub_status $?)"
                committer=$(jq -r '.committer.login // ""' <<<"${commit}")
                if test "${committer}" != "${BOT_LOGIN}"; then
                    push=$(jq -c '{forced: false, committer: (.committer.login // .commit.committer.name // "unknown"),
                                   committer_is_login: (.committer.login != null)}' <<<"${commit}")
                fi
            fi
            if test -n "${push:-}"; then
                changes=$(jq -c --arg from "${prev_head}" --arg to "${head}" --argjson push "${push}" \
                    '. + [{type: "push", from: $from, to: $to} + $push]' <<<"${changes}")
            fi
        fi
        if ! ${fork} && jq -e --arg bot "${BOT_LOGIN}" '.author == $bot' <<<"${info}" >/dev/null; then
            ${reviews_read} || reviews=$(rest_pages "repos/${repo}/pulls/${number}/reviews") || return "$(sub_status $?)"
            outstanding=$(outstanding_review "${repo}" "${number}" "${head}" "${reviews}") || return "$(sub_status $?)"
        fi
        local ci prev_checks checks
        ci=$(checks_state "${repo}" "${head}") || return "$(sub_status $?)"
        checks=$(jq -r .checks <<<"${ci}")
        cur=$(jq -c --arg c "${checks}" '.checks = $c' <<<"${cur}")
        if jq -e --arg bot "${BOT_LOGIN}" '.author == $bot' <<<"${info}" >/dev/null; then
            rebase=$(rebase_candidate "${repo}" "${data}" "${ci}" "${fork}") || return "$(sub_status $?)"
        fi
        prev_checks=$(jq -r '.checks // empty' <<<"${prev}")
        # A URL seen for the first time: only the bot's own red CI is news.
        if test "${checks}" = failure && test "${prev_checks}" != failure &&
            { test "${prev}" != null || jq -e .bot_branch <<<"${info}" >/dev/null; }; then
            changes=$(jq -c --argjson ci "${ci}" --arg head "${head}" --argjson info "${info}" \
                '. + [{type: "ci_red", head: $head, failing: $ci.failing, bot_branch: $info.bot_branch}]' <<<"${changes}")
        elif test "${checks}" = success && test "${prev_checks}" = failure; then
            changes=$(jq -c --arg head "${head}" '. + [{type: "ci_green", head: $head}]' <<<"${changes}")
        fi
    elif test "${kind}" = pull; then
        # Closed: nothing runs any more; keep what was last seen.
        cur=$(jq -c --arg c "$(jq -r '.checks // empty' <<<"${prev}")" '.checks = (if $c == "" then null else $c end)' <<<"${cur}")
    fi
    jq -c --argjson cur "${cur}" --argjson info "${info}" --arg prev_state "${prev_state}" \
        --argjson outstanding "${outstanding}" --argjson rebase "${rebase}" \
        '{cur: $cur, changes: ., info: $info, prev_state: $prev_state, outstanding: $outstanding, rebase: $rebase}' <<<"${changes}"
}

# The P0 and P1 PRs that need a look, whatever changed or not: like the
# sections below, a to-do on every sweep. It and the other steps the
# sweep runs (bot-drive after it, bot-signoff-due, bot-promote-due,
# bot-priority-propagate, bot-operator-activity) don't depend on what
# the probes find, so they run in the background meanwhile; their
# sections come where they did when they ran one by one, with their
# warnings.
# With --lead, only that lead's items; --exclude-lead leaves it every one.
health_board=${board}
test -z "${lead}" || health_board=${swept_board}
printf '%s\n' "${health_board}" >"${scratch}/board.json"
health_args=(--json --board-file "${scratch}/board.json")
test -z "${now}" || health_args+=(--now "${now}")
if test -n "${epic_board_file}"; then
    health_args+=(--epic-board-file "${epic_board_file}")
elif test -n "${board_file}"; then
    echo '[]' >"${scratch}/epic-board.json"
    health_args+=(--epic-board-file "${scratch}/epic-board.json")
else
    # Read once, for bot-drive too.
    health_args+=(--write-epic-board "${scratch}/epic-board.json")
fi
# The sign-offs and promotions the operator's approvals allow: only
# --apply runs them.
due_args=(--json)
if ${dry_run} || test -n "${board_file}"; then
    due_args+=(--dry-run)
elif ${apply}; then
    due_args+=(--apply)
fi
# health_then_drive: bot-priority-health, then bot-drive with the P0
# epic's board it read. The P0 PRs' blockers are level-triggered: the
# board the health step read.
health_then_drive() {
    local rc=0 t=${EPOCHREALTIME}
    "${PRIORITY_HEALTH}" "${health_args[@]}" >"${scratch}/health.json" 2>"${scratch}/health.err" || rc=$?
    timing "bot-priority-health" "${t}" 2>>"${scratch}/health.err"
    echo "${rc}" >"${scratch}/health.rc"
    local drive_args=(--board-file "${scratch}/board.json")
    test -z "${now}" || drive_args+=(--now "${now}")
    if test -n "${epic_board_file}"; then
        drive_args+=(--epic-board-file "${epic_board_file}")
    elif test -s "${scratch}/epic-board.json"; then
        drive_args+=(--epic-board-file "${scratch}/epic-board.json")
    fi
    "${DRIVE}" "${due_args[@]}" "${drive_args[@]}"
}
step_start drive health_then_drive
step_start signoff "${SIGNOFF_DUE}" "${due_args[@]}"
step_start promote "${PROMOTE_DUE}" "${due_args[@]}"
# Priority follows structure: with --apply, the Branch items of the
# P0 and P1 items are raised to their priority (sub-issues on the board
# keep theirs; new ones are added). Over the
# whole board, whatever --lead says. Only listed, never woken for (see
# bot-poll, which ignores the section).
printf '%s\n' "${board}" >"${scratch}/full-board.json"
step_start propagate "${PRIORITY_PROPAGATE}" "${due_args[@]}" --board-file "${scratch}/full-board.json"
# What the operator did that the bot should act on (by event, so
# bot-poll wakes once per event however often a sweep lists it).
step_start activity "${OPERATOR_ACTIVITY}" "${due_args[@]}" --board-file "${scratch}/board.json" ${now:+--now "${now}"}

# off_board: prints the outstanding reviews and rebase candidates (see
# pr_off_board) of the bot's open PRs other than fork PRs that the sweep
# doesn't probe (not on the board, or not any more), as JSON lines {url,
# items, outstanding, rebase}: one search (a page per ${PER_PAGE} PRs, fork
# PRs included, as it can't tell them apart), which has no ETags, then
# their reviews and CI. Fails if the search does; a PR that can't be read
# is skipped with a warning.
off_board() {
    # The PRs on no item are the coordinator's safety net, not a topic's.
    test -z "${lead}" || return 0
    local search_q search found='' page=1 total extra url o rc
    # Oldest first: a PR opened during the paging lands on the last page
    # rather than shifting the others (duplicates are dropped below).
    search_q="is:pr+is:open+author:${BOT_LOGIN}&sort=created&order=asc"
    while :; do
        search=$(rest_get "search/issues?q=${search_q}&per_page=${PER_PAGE}&page=${page}") ||
            { rc=$?; warn "the search for the bot's open PRs failed (status ${rc})"; return "${rc}"; }
        found+=$(jq -c '.items[]' <<<"${search}")$'\n'
        total=$(jq -e '.total_count | numbers' <<<"${search}") ||
            { warn "the search for the bot's open PRs answered without a total_count"; return 1; }
        test $((page * PER_PAGE)) -lt "${total}" || break
        if test "${page}" -ge "${SEARCH_MAX_PAGES}"; then
            warn "the bot has over $((page * PER_PAGE)) open PRs; only the first $((page * PER_PAGE)) found have their reviews checked"
            break
        fi
        page=$((page + 1))
    done
    extra=$(jq -rs --argjson swept "${board_urls}" --arg bot "${BOT_LOGIN}" --argjson forks "${FORK_OWNERS}" \
        --arg meta "${FORK_META}" "${FORK_PR_JQ}"'
        [.[] | select(fork_pr(.html_url | capture("^https://github\\.com/(?<o>[^/]+)/").o) | not) | .html_url
           | select(IN($swept[]) | not)] | unique[]' <<<"${found}")
    test -n "${extra}" || return 0
    run_pool "${scratch}/off-board" pr_off_board <<<"${extra}" &
    wait "$!"
    test ! -e "${scratch}/off-board/ratelimited" || return "${EX_RATELIMIT}"
    local i=0
    while IFS= read -r url; do
        rc=$(<"${scratch}/off-board/${i}.rc")
        o=${scratch}/off-board/${i}.out
        i=$((i + 1))
        if test "${rc}" -ne 0; then
            warn "reading ${url} (off the board) for outstanding reviews failed (status ${rc}); skipped"
            continue
        fi
        jq -c --arg u "${url}" 'select(.outstanding != null or .rebase != null) | {url: $u, items: []} + .' "${o}"
    done <<<"${extra}"
}
# off_board_job DIR: off_board, with DIR as its scratch dir.
off_board_job() {
    scratch=$1
    mkdir -p "${scratch}"
    off_board
}
# Also meanwhile.
off_board_job "${scratch}/off-board-search" >"${scratch}/extra.json" 2>"${scratch}/extra.err" &
off_board_pid=$!

t0=${EPOCHREALTIME}
# probe_job URL: a run_pool job, probing URL with what the state has.
probe_job() {
    local prev dropped_at
    prev=$(jq -c --arg u "$1" '.[$u]' <<<"${seen}")
    dropped_at=$(jq -r --arg u "$1" '.[$u] // empty' <<<"${dropped}")
    probe "$1" "${prev}" "${dropped_at}"
}
run_pool "${scratch}/probe" probe_job < <(jq -r '.[].url' <<<"${watch}") &
wait "$!"
test ! -e "${scratch}/probe/ratelimited" || exit "${EX_RATELIMIT}"
# Each URL's exit status, in the order of the watch records, and the
# probes that succeeded, in the same order.
rcs=()
ok_files=()
for ((i = 0; i < nurls; i++)); do
    rcs+=("$(<"${scratch}/probe/${i}.rc")")
    test "${rcs[i]}" -ne 0 || ok_files+=("${scratch}/probe/${i}.out")
    if test "${rcs[i]}" -ne 0 && test "${rcs[i]}" -ne "${EX_NOTFOUND}"; then
        warn "reading $(jq -r --argjson i "${i}" '.[$i].url' <<<"${watch}") failed; will retry next sweep"
    fi
done
# Deleted, or the repository went private (EX_NOTFOUND): reported once
# as gone. A URL that failed otherwise keeps its last-seen state, so that
# nothing is skipped.
{ read -r results; read -r new_seen; read -r failed; read -r gone; read -r new_urls; } < <(
    printf '%s\n' "${rcs[@]}" | jq -sc . >"${scratch}/rcs.json"
    cat "${ok_files[@]}" /dev/null | jq -nr --slurpfile rcs "${scratch}/rcs.json" \
        --slurpfile watch <(printf '%s\n' "${watch}") --slurpfile seen <(printf '%s\n' "${seen}") \
        --argjson notfound "${EX_NOTFOUND}" '
        [inputs] as $probes | $rcs[0] as $rcs | $seen[0] as $seen | [$watch[0][].url] as $urls
        | [range(0; $urls | length) | select($rcs[.] == 0)] as $ok
        | (reduce range(0; $ok | length) as $k ({}; .[$urls[$ok[$k]]] = $probes[$k])) as $results
        | (reduce range(0; $urls | length) as $i ({}; $urls[$i] as $u
            | if $rcs[$i] == 0 then .[$u] = $results[$u].cur
              elif $rcs[$i] == $notfound then .[$u] = {state: "gone"}
              elif $seen[$u] != null then .[$u] = $seen[$u]
              else . end)) as $new_seen
        | ($results | tojson), ($new_seen | tojson),
          ([range(0; $urls | length) | select($rcs[.] != 0 and $rcs[.] != $notfound) | $urls[.]] | tojson),
          ([range(0; $urls | length) | select($rcs[.] == $notfound and ($seen[$urls[.]].state // "") != "gone")
            | $urls[.]] | tojson),
          ([$ok[] | $urls[.] | select($seen[.] == null)] | tojson)')
test -n "${new_urls}" || fatal "internal error: collecting what the probes found failed"
timing probe "${t0}" "${nurls} URLs"

# --- Per item: changes and bookkeeping --------------------------------------

# Through a file: it can outgrow an argument.
printf '%s\n' "${results}" >"${scratch}/results.json"
report=$(jq -c --slurpfile results "${scratch}/results.json" --argjson gone "${gone}" --argjson failed "${failed}" \
    --argjson apply_from "${APPLY_FROM}" --arg merged_status "${MERGED_STATUS}" --arg closed_status "${CLOSED_STATUS}" '
    $results[0] as $results
    | [.[] | . as $w | .items[] | {item: ., url: $w.url}]
    | group_by(.item.id)
    | map(.[0].item as $item | [.[].url] as $urls
        | [$urls[] | select($results[.] != null) | {url: ., r: $results[.]}] as $probed
        | ([$probed[] | .url as $u | .r.changes[] | {url: $u} + .]
           + [$urls[] | select(. as $u | $gone | index($u)) | {url: ., type: "gone"}]) as $changes
        | [$probed[] | select(.r.info.kind == "pr")] as $prs
        | [$prs[] | select(.r.info.fork | not)] as $upstream
        # Only what this sweep saw happen: the current state alone would
        # redo (or undo) a human'"'"'s triage on every sweep. The last of its
        # PRs to end may be the bot'"'"'s fork PR of a redo.
        | [$prs[] | select(.r.prev_state == "open" and .r.cur.state != "open")] as $ended
        # Unknown because a URL failed: decided by a later sweep.
        | (($ended | length) > 0 and any($urls[]; . as $u | $failed | index($u))) as $retry
        | [if ($ended | length) == 0 or $retry or any($prs[]; .r.cur.state == "open") then empty
           elif any($upstream[]; .r.cur.state == "merged") then
               {status: $merged_status, reason: "merged",
                url: ([$upstream[] | select(.r.cur.state == "merged") | .url] | first)}
           elif ($upstream | length) > 0 then
               {status: $closed_status, reason: "closed",
                url: ([$ended[] | select(.r.info.fork | not) | .url] + [$upstream[0].url] | first)}
           else empty end] as $actions
        | {id: $item.id, title: $item.title, status: $item.status, workflow: $item.workflow, why: $item.why,
           changes: $changes, retry: $retry,
           actions: [$actions[] | . + {allowed: (($item.status // "") as $s | $apply_from | index($s) != null)}]})' <<<"${watch}")
retry_ids=$(jq -r '.[] | select(.retry) | .id' <<<"${report}")
# Not news but a to-do, listed on every sweep, apart from the items.
outstanding=$(jq -c --slurpfile results "${scratch}/results.json" '
    $results[0] as $results
    | [.[] | select($results[.url].outstanding != null)
       | {url, items: [.items[] | {id, title}]} + $results[.url].outstanding]' <<<"${watch}")

# The safety net doesn't depend on the board, but a failure there (even
# the search quota running out) mustn't cost the sweep its report or
# state: only a warning, and a nonzero exit.
search_failed=false
t0=${EPOCHREALTIME}
rc=0
wait "${off_board_pid}" || rc=$?
case "${rc}" in
    0)
        cat "${scratch}/extra.err" 1>&2
        outstanding=$(jq -sc --slurpfile o <(printf '%s\n' "${outstanding}") '$o[0] + [.[] | select(.outstanding != null) | {url, items} + .outstanding]' "${scratch}/extra.json")
        ;;
    "${EX_RATELIMIT}")
        warn "GitHub is rate limiting the bot's search (or its reads of PRs off the board); only the board's PRs were checked for outstanding reviews"
        search_failed=true
        ;;
    *)
        cat "${scratch}/extra.err" 1>&2
        warn "checking the bot's open PRs off the board failed (status ${rc}); only the board's PRs were checked for outstanding reviews"
        search_failed=true
        ;;
esac
timing "off-board PRs (after the probes)" "${t0}"
report=$(jq -c 'map(select((.changes | length) > 0 or (.actions | length) > 0) | del(.retry))' <<<"${report}")

# The bot's open PRs that need a rebase: also a to-do, listed on every
# sweep until done. One listed for failing CI while behind its base
# (reason "ci") is remembered with its head then, in the state's
# 'rebase', for as long as its CI fails: once its head moved (rebased)
# with CI still failing, the failure is not the base's, and it isn't
# listed again. URLs that could not be read keep what was remembered.
# PRs with an outstanding review by REQUESTER are left out: they are a
# worker's, and a rebase's push would look like an answer.
t0=${EPOCHREALTIME}
prev_rebase=$(jq -c '.rebase // {}' <<<"${state}")
candidates=$(jq -c --slurpfile results "${scratch}/results.json" --slurpfile extra "${scratch}/extra.json" \
    --argjson search_failed "${search_failed}" '
    $results[0] as $results
    | [(.[] | select($results[.url].rebase != null)
        | {url, items: [.items[] | {id, title}]} + $results[.url].rebase),
       (if $search_failed then empty else $extra[] | select(.rebase != null) | {url, items} + .rebase end)]' <<<"${watch}")
{ read -r needs_rebase; read -r new_rebase; } < <(jq -r --argjson prev "${prev_rebase}" \
    --slurpfile failed <(printf '%s\n' "${failed}") --argjson search_failed "${search_failed}" \
    --slurpfile watch <(printf '%s\n' "${watch}") --slurpfile outstanding <(printf '%s\n' "${outstanding}") '
    $failed[0] as $failed | $watch[0] as $watch | $outstanding[0] as $outstanding
    | reduce .[] as $c ({list: [], keep: {}};
        $prev[$c.url] as $p
        | if $c.reason == "ci" then
              if $p != null and $p != $c.head then .keep[$c.url] = $p
              else .keep[$c.url] = $c.head | .list += [$c] end
          elif $c.reason == null then (if $p != null then .keep[$c.url] = $p else . end)
          else .list += [$c] end)
    | ([$watch[].url]) as $swept
    | .keep += ($prev | with_entries(select(.key as $u
          | ($failed | index($u)) or ($search_failed and ($swept | index($u) | not)))))
    # A rebase is a push that would look like it answered his review.
    | .list |= map(select(.url as $u | [$outstanding[].url] | index($u) | not))
    | (.list | tojson), (.keep | tojson)' <<<"${candidates}")
test -n "${new_rebase}" || fatal "internal error: selecting the PRs that need a rebase failed"
# Where a merge queue tests against the new base anyway, or the
# maintainers asked, a conflict-free rebase only reruns CI they approve
# again. Undecided (upstream-policy failed) means listed: bot-pr decides.
conflicts_only='[]'
while IFS=$'\t' read -r repo base; do
    mode=$("${UPSTREAM_POLICY}" rebase "${repo}" "${base}") ||
        { warn "cannot tell whether ${repo} takes conflict-free rebases; listing them"; continue; }
    test "${mode%%:*}" = any || conflicts_only=$(jq -c --arg r "${repo}" --arg b "${base}" '. + [[$r, $b]]' <<<"${conflicts_only}")
done < <(jq -r --argjson forks "${FORK_OWNERS}" "${REBASE_REPO_JQ}"'
    [.[] | select(.conflicts != true) | [repo, .base] | select(.[0] | split("/")[0] | IN($forks[]) | not)] | unique[] | @tsv' <<<"${needs_rebase}")
needs_rebase=$(jq -c --argjson co "${conflicts_only}" "${REBASE_REPO_JQ}"'
    map(select(.conflicts == true or ([repo, .base] | IN($co[]) | not)))' <<<"${needs_rebase}")

timing "needs rebase" "${t0}"

# The P0 and P1 health lines. Its failing costs only the section, with a
# warning and a nonzero exit.
health_failed=false
for step in "${!step_pids[@]}"; do
    wait "${step_pids[${step}]}" || true
done
cat "${scratch}/health.err" 1>&2
rc=$(<"${scratch}/health.rc")
# An exhausted quota is the whole sweep's problem, not just this section's.
test "${rc}" -ne "${EX_RATELIMIT}" || exit "${EX_RATELIMIT}"
# With PRs that could not be read (status 1), it still lists the others.
if ! health=$(jq -ce 'arrays' "${scratch}/health.json" 2>/dev/null); then
    health='[]'
    health_failed=true
fi
if test "${rc}" -ne 0; then
    warn "the priority health sweep failed (status ${rc}); its section is incomplete"
    health_failed=true
fi

# due_step NAME WHAT: prints the JSON array of the step NAME started
# (bot-drive, bot-signoff-due, bot-promote-due, ...), run in the sweep's
# mode; an empty one, with a warning naming WHAT, and fails, if it
# failed. Like the health section, a step's failing costs only its
# sections, with a warning and a nonzero exit; so does a rate limit,
# which is the search's (as for the PRs off the board above).
# (bot-poll recognizes an incomplete section by that warning, as for
# the health and outstanding-review sections: keep the wording.)
due_step() {
    local out rc
    # Waited for above.
    cat "${scratch}/$1.err" 1>&2
    rc=$(<"${scratch}/$1.rc")
    out=$(<"${scratch}/$1.out")
    if ! jq -ce 'arrays' <<<"${out}" 2>/dev/null; then
        echo '[]'
        test "${rc}" -ne 0 || rc="invalid output"
    fi
    test "${rc}" = 0 && return 0
    warn "looking for $2 failed (status ${rc}); its section is incomplete"
    return 1
}
drive_failed=false
drive=$(due_step drive "P0 drive steps") || drive_failed=true
signoff_failed=false
signoffs=$(due_step signoff "sign-offs due") || signoff_failed=true
# Fork PRs approved for a human-text repository only get listed, under
# "Needs your text".
promotion_failed=false
promotions=$(due_step promote "promotions due") || promotion_failed=true
propagation_failed=false
propagation=$(due_step propagate "priority propagation") || propagation_failed=true
activity_failed=false
activity=$(due_step activity "operator activity") || activity_failed=true
needs_text=$(jq -c '[.[] | select(.result == "needs-text")]' <<<"${promotions}")
promotions=$(jq -c '[.[] | select(.result != "needs-text")]' <<<"${promotions}")

# keep_last_seen ITEM: puts the URLs of ITEM back to their last-seen
# state, so that the next sweep sees their transitions again (and
# reports their other changes again, also for other items sharing them).
keep_last_seen() {
    new_seen=$(jq -c --arg id "$1" --slurpfile seen <(printf '%s\n' "${seen}") --slurpfile watch <(printf '%s\n' "${watch}") \
        '$seen[0] as $seen | $watch[0] as $watch | reduce ($watch[] | select(any(.items[]; .id == $id)) | .url) as $u (.;
            if $seen | has($u) then .[$u] = $seen[$u] else del(.[$u]) end)' <<<"${new_seen}")
}
while IFS= read -r id; do
    test -z "${id}" || keep_last_seen "${id}"
done <<<"${retry_ids}"

# why_for ITEM ACTION: the Why of an item moved to CLOSED_STATUS: the
# question first, then as much of the old Why as fits, without an
# earlier question.
why_for() {
    jq -r --argjson max "${WHY_MAX}" '.[1] as $a | .[0] as $i
        | "Q: \($a.url) was closed without merging; drop this (Done) or redo it?" as $q
        | " | was: " as $sep
        | ($i.why // "") as $old
        | (if $old | startswith("Q: ") then $old | split($sep) | .[1:] | join($sep) else $old end) as $old
        | if $old == "" then $q else "\($q)\($sep)\($old)" end
        | if length > $max then .[:$max - 3] + "..." else . end' <<<"[$1, $2]"
}

t0=${EPOCHREALTIME}
napplied=0
napply_failed=0
while IFS= read -r entry; do
    test -n "${entry}" || continue
    item=$(jq -c .item <<<"${entry}")
    action=$(jq -c .action <<<"${entry}")
    id=$(jq -r .id <<<"${item}")
    status=$(jq -r .status <<<"${action}")
    args=(set "${id}" --status "${status}")
    test "${status}" != "${CLOSED_STATUS}" || args+=(--why "$(why_for "${item}" "${action}")")
    result=applied
    if test -n "${board_file}" || ${dry_run}; then
        result=would-apply
        test -z "${board_file}" || echo "testing: would run: bot-board $(printf "%q " "${args[@]}")" 1>&2
    elif SKIP_ASK_CHECK=1 "${BOT_BOARD}" "${args[@]}" >/dev/null; then
        napplied=$((napplied + 1))
    else
        rc=$?
        test "${rc}" -ne "${EX_RATELIMIT}" || exit "${EX_RATELIMIT}"
        warn "setting ${id} to ${status} failed; the next sweep retries it"
        result=failed
        napply_failed=$((napply_failed + 1))
        keep_last_seen "${id}"
    fi
    report=$(jq -c --arg id "${id}" --arg r "${result}" \
        'map(if .id == $id then .actions |= map(if .allowed then .result = $r else . end) else . end)' <<<"${report}")
done < <(${apply} && jq -c '.[] | {item: {id, why}, action: (.actions[] | select(.allowed))}' <<<"${report}")

timing "board changes" "${t0}"

# --- Report ----------------------------------------------------------------

t0=${EPOCHREALTIME}

nfailed=$(jq length <<<"${failed}")
# URLs that left the sweep, with when they were last seen (by the last
# sweep that wrote the state: nothing changed on them since). Back in
# the sweep, or older than DROPPED_KEEP_DAYS, they are forgotten.
new_dropped=$(jq -c --slurpfile seen <(printf '%s\n' "${seen}") --slurpfile new <(printf '%s\n' "${new_seen}") \
    --arg last "${last_swept:-${swept_at}}" --arg cutoff "$(date -u -d "${swept_at} -${DROPPED_KEEP_DAYS} days" +%FT%TZ)" '
    $seen[0] as $seen | $new[0] as $new
    | . + ($seen | with_entries(select((.key as $u | $new | has($u)) | not) | .value = $last))
    | with_entries(select(.value >= $cutoff and ((.key as $u | $new | has($u)) | not)))' <<<"${dropped}")
# Written unless it's a dry run or nothing changed: a board write costs
# GraphQL quota, and the state's timestamp alone isn't worth it.
advance=true
if ${dry_run}; then
    advance=false
    why_kept="dry run"
elif jq -e --slurpfile new <(printf '%s\n' "${new_seen}") '. == $new[0]' <<<"${seen}" >/dev/null &&
    test "$(jq -S . <<<"${dropped}")" = "$(jq -S . <<<"${new_dropped}")" &&
    test "$(jq -S . <<<"${prev_rebase}")" = "$(jq -S . <<<"${new_rebase}")"; then
    advance=false
    why_kept="nothing new"
fi

if ${json}; then
    jq --slurpfile new <(printf '%s\n' "${new_urls}") --slurpfile failed <(printf '%s\n' "${failed}") \
        --slurpfile gone <(printf '%s\n' "${gone}") --argjson nurls "${nurls}" --argjson nitems "${nitems}" \
        --argjson advance "${advance}" \
        --slurpfile outstanding <(printf '%s\n' "${outstanding}") --slurpfile needs_rebase <(printf '%s\n' "${needs_rebase}") \
        --argjson search_failed "${search_failed}" --slurpfile health <(printf '%s\n' "${health}") \
        --argjson health_failed "${health_failed}" --slurpfile drive <(printf '%s\n' "${drive}") \
        --argjson drive_failed "${drive_failed}" --slurpfile signoffs <(printf '%s\n' "${signoffs}") \
        --argjson signoff_failed "${signoff_failed}" --slurpfile promotions <(printf '%s\n' "${promotions}") \
        --slurpfile needs_text <(printf '%s\n' "${needs_text}") --argjson promotion_failed "${promotion_failed}" \
        --slurpfile activity <(printf '%s\n' "${activity}") --argjson activity_failed "${activity_failed}" \
        --slurpfile propagation <(printf '%s\n' "${propagation}") --argjson propagation_failed "${propagation_failed}" \
        '$new[0] as $new | $failed[0] as $failed | $gone[0] as $gone
         | $outstanding[0] as $outstanding | $needs_rebase[0] as $needs_rebase
         | {swept: {urls: $nurls, items: $nitems}, priority_health: $health[0], p0_drive: $drive[0], signoffs: $signoffs[0], promotions: $promotions[0], priority_propagation: $propagation[0],
          operator_activity: $activity[0], needs_text: $needs_text[0], items: ., outstanding_reviews: $outstanding,
          needs_rebase: $needs_rebase, new_urls: $new, failed_urls: $failed, gone_urls: $gone, search_failed: $search_failed,
          priority_health_failed: $health_failed, p0_drive_failed: $drive_failed, signoffs_failed: $signoff_failed, promotions_failed: $promotion_failed, operator_activity_failed: $activity_failed, priority_propagation_failed: $propagation_failed, state_advanced: $advance}' <<<"${report}"
else
    # First: these are to-dos, the items below only news. The P0 and P1
    # health lines come first of all.
    jq -r 'if length == 0 then empty else "Priority health:", (.[] | "  \(.line)"), "" end' <<<"${health}"
    jq -r 'if length == 0 then empty else "P0 drive:", (.[] | "  \(.line)"), "" end' <<<"${drive}"
    jq -r 'if length == 0 then empty else "Sign-offs:", (.[] | "  \(.line)"), "" end' <<<"${signoffs}"
    jq -r 'if length == 0 then empty else "Promotions:", (.[] | "  \(.line)"), "" end' <<<"${promotions}"
    jq -r 'if length == 0 then empty else "Needs your text:", (.[] | "  \(.line)"), "" end' <<<"${needs_text}"
    jq -r 'if length == 0 then empty else "Priority propagation:", (.[] | "  \(.line)"), "" end' <<<"${propagation}"
    jq -r 'if length == 0 then empty else "Operator activity:", (.[] | "  \(.line)"), "" end' <<<"${activity}"
    jq -r --arg req "${REQUESTER}" "${REPO_REF_JQ}"'
        if length == 0 then empty else
            "Outstanding reviews by \($req):",
            (.[] | "  \(.url | repo_ref)  \(if .items == [] then "(not on the board)" else .items | map(.title) | join("; ") end)",
                "    \(if .type == "review" then "review \(.review_state)" else "comment" end) at \(.at)"
                + "\(if .count > 1 then " (+\(.count - 1) more)" else "" end)"
                + ": \(if .excerpt != "" then .excerpt else "(line comments)" end)",
                "      \(.link)"),
            "" end' <<<"${outstanding}"
    jq -r --argjson sha "${SHORT_SHA}" "${REPO_REF_JQ}"'
        def entry: "    \(.url | repo_ref)  \(if .items == [] then "(not on the board)" else .items | map(.title) | join("; ") end)",
            "      " + (if .reason == "conflict" then "conflicts with \(.base)"
                        elif .reason == "behind" then "behind \(.base), which must be up to date"
                        else "CI failing (\(.failing | join(", "))), \(.behind_by) behind \(.base)" end)
            + " at \(.head[:$sha])";
        if length == 0 then empty else
            "Needs rebase (bot-pr rebase URL):",
            ([.[] | select(.conflicts != true)] | if length > 0 then "  conflict-free:", (.[] | entry) else empty end),
            ([.[] | select(.conflicts == true)] | if length > 0 then "  conflicting (a worker resolves):", (.[] | entry) else empty end),
            "" end' <<<"${needs_rebase}"
    jq -r --argjson sha "${SHORT_SHA}" "${REPO_REF_JQ}"'
        def short: .[:$sha];
        .[] | .status as $status | "\(.title)  [\($status // "no status")]  \(.id)",
        (.changes | group_by(.url)[] | "  \(.[0].url | repo_ref)",
            (.[] | "    " + (
                if .type == "comment" then "comment by @\(.author)\(if .from_requester then " (operator)" else "" end): \(.excerpt)\n      \(.link)"
                elif .type == "review" then "review \(.review_state) by @\(.author)\(if .from_requester then " (operator)" else "" end)\(if .excerpt != "" then ": " + .excerpt else "" end)\n      \(.link)"
                elif .type == "state" then "\(.from) -> \(.to)"
                elif .type == "push" and .forced then "force-pushed by @\(.by): \(.from | short) -> \(.to | short)"
                elif .type == "push" then "new commits (committer \(if .committer_is_login then "@" else "" end)\(.committer)): \(.from | short) -> \(.to | short)"
                elif .type == "ci_red" then "CI failing\(if .bot_branch then " on the bot'"'"'s branch" else "" end) at \(.head | short): \(.failing | join(", "))"
                elif .type == "ci_green" then "CI passing again at \(.head | short)"
                elif .type == "gone" then "gone (404 or 410): deleted, or no longer public"
                else tojson end))),
        (.actions[] | "  -> \(.url | repo_ref) was \(.reason): set \(.status)"
            + if .result == "applied" then " (done)"
              elif .result == "would-apply" then " (--apply would do it)"
              elif .result == "failed" then " (FAILED)"
              elif .allowed then " (with --apply)"
              else " (not applied from \($status // "no status"); a human decides)" end),
        ""' <<<"${report}"
    echo "Swept ${nurls} URLs of ${nitems} board items: $(jq length <<<"${health}") priority health problems, $(jq length <<<"${drive}") P0 PRs driven, $(jq length <<<"${signoffs}") sign-offs, $(jq length <<<"${promotions}") promotions, $(jq length <<<"${activity}") operator activity lines, $(jq length <<<"${needs_text}") needing your text, $(jq length <<<"${report}") items with news, $(jq length <<<"${outstanding}") outstanding reviews, $(jq length <<<"${needs_rebase}") needing a rebase, $(jq length <<<"${new_urls}") URLs newly tracked, $(jq length <<<"${failed}") failed."
fi

# Failed URLs kept their last-seen state in new_seen, so their changes
# are reported by a later sweep; the others advance.
if ! ${advance}; then
    echo "State unchanged (${why_kept})." 1>&2
else
    new_state=$(jq -nc --argjson v "${STATE_VERSION}" --slurpfile items <(printf '%s\n' "${new_seen}") \
        --slurpfile dropped <(printf '%s\n' "${new_dropped}") --arg now "$(date -u +%FT%TZ)" --arg swept "${swept_at}" \
        --arg host "$(hostname)" --argjson rebase "${new_rebase}" \
        '{version: $v, updated_at: $now, swept_at: $swept, host: $host, items: $items[0], dropped: $dropped[0]}
         + if $rebase == {} then {} else {rebase: $rebase} end')
    # A sweep killed while writing must not leave half a state.
    { printf '%s\n' "${new_state}" >"${state_file}.tmp.$$" && mv -f "${state_file}.tmp.$$" "${state_file}"; } ||
        fatal "recording the last-seen state in ${state_file} failed; the next sweep reports these changes again"
    echo "State advanced; ${napplied} item(s) updated on the board." 1>&2
fi
timing "report and state" "${t0}"
timing total "${STARTED}"
if test "${nfailed}" -gt 0; then
    echo "${nfailed} URL(s) could not be read; they keep their last-seen state until a sweep reads them." 1>&2
    exit 1
fi
test "${napply_failed}" -eq 0 || exit 1
! ${search_failed} || exit 1
! ${health_failed} || exit 1
! ${drive_failed} || exit 1
! ${activity_failed} || exit 1
! ${propagation_failed} || exit 1
! ${signoff_failed} || exit 1
! ${promotion_failed} || exit 1
