#!/usr/bin/env bash
# Thin CLI over 'gh project' for the cgwalters-bot Workstream board (and
# the bot's other boards, with --project).
# GraphQL queries hold literal $variables.
# shellcheck disable=SC2016
set -euo pipefail

readonly OWNER=cgwalters-bot
# The boards this tool can target, by --project name. The Workstream
# board is the bot's work queue and holds the state items; the others are
# milestone views, often over the same issues and PRs. There is
# deliberately no environment variable for this: the other bot scripts
# call bot-board and must always reach the Workstream board.
readonly -A PROJECTS=([workstream]=1 [composefs-stable]=2)
readonly WORKSTREAM=workstream
# Set by select_project.
NUMBER=
BOARD_URL=
BOARD_CACHE=
readonly ITEM_LIMIT=1000
readonly TITLE_WIDTH=70
# Board fields that 'set' can change, and the option that sets each.
readonly SET_OPTIONS=(--status --priority --workflow --org --why --branch --gist)
# Free-text fields; the rest of SET_OPTIONS are single-selects.
readonly TEXT_FIELDS=(Why Branch Gist)
# The Org field says which organization an item's work targets, so the
# board can be filtered to the bot's own infrastructure (the
# cgwalters-forge and cgwalters-bot options) or to work going outbound.
# A fork owned by one of FORK_OWNERS counts as its upstream's: fork PRs
# in cgwalters-forge target their upstream, as do branches in cgwalters'
# and the bot's personal forks. Their other repositories are their own:
# cgwalters-forge/review is cgwalters-forge.
readonly FORK_OWNERS=(cgwalters-forge cgwalters-bot cgwalters)
# Owners with an Org other than their name.
readonly -A OWNER_ORGS=([cgwalters]=cgwalters-bot)
# Repositories with an Org other than their owner's, lowercase.
readonly -A REPO_ORGS=(
    # The bot's runner setup; it lives in bootc-dev for its runners.
    [bootc-dev/cgwalters-devspace-sandbox]=cgwalters-bot
)
# First path components of github.com URLs that aren't repositories.
readonly NON_REPO_PATHS=(users orgs settings notifications sponsors marketplace apps)
# Fork lookups are REST calls (outside the GraphQL quota), cached this long.
readonly REPO_TTL=86400
# Org for owners with no Org option of their own.
readonly ORG_OTHER=other
# Org by the first word of a title, for tracker issues (and old drafts)
# link; the word is lowercased, with a trailing ':' removed.
readonly -A TITLE_ORGS=(
    [bootc]=bootc-dev [bcvk]=bootc-dev [infra]=bootc-dev
    [composefs]=composefs [composefs-rs]=composefs
    [ostree]=ostreedev [bootupd]=coreos [rpm-ostree]=coreos
    [cargo-vendor-filterer]=coreos [zlink]=z-galaxy [podman]=containers
    [image-builder]=osbuild [bootc-image-builder]=osbuild [osbuild]=osbuild
    [rhel-bootc-examples]=redhat-cop
    [review]=cgwalters-forge
    [bot-board]=cgwalters-bot [bot-notify]=cgwalters-bot [bot-pr]=cgwalters-bot
    [bot-watch]=cgwalters-bot [bot-work]=cgwalters-bot [bot-runs]=cgwalters-bot
    [homegit]=cgwalters-bot [devspace]=cgwalters-bot [coordinator]=cgwalters-bot
    [board]=cgwalters-bot
)
# Org edits sent per GraphQL request by fill-org.
readonly ORG_BATCH=20
# Everything on the board that isn't an upstream issue or PR is an issue
# here: work items, parents of larger efforts, and questions for
# OPERATOR. Its issues say nothing about which organization their work
# targets, so the Org of an item there comes from its title and body.
readonly TRACKER_REPO=cgwalters-forge/tracker
# The only login whose answers count; questions are assigned to him.
readonly OPERATOR=cgwalters
readonly QUESTION_LABEL=question
readonly QUESTION_STATUS='Needs human'
readonly DONE_STATUS=Done
# The first line of a question's body: the board item it blocks.
readonly BLOCKS_PREFIX='Blocks: '
# Board text fields are kept short (see the workstream skill).
readonly WHY_MAX=400
readonly QUESTION_TITLE_MAX=100
# Option letters; the recommendation, if any, is always the first.
readonly OPTION_LETTERS=ABCDEFGHIJ
# Every gh project call spends the bot's GraphQL quota (5000 points/hour),
# which all agents share, so reads are cached on disk.
readonly CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/bot-board
readonly FIELDS_TTL=3600
readonly ITEMS_TTL=60
# Headroom to keep when checking the quota before a batch of edits.
readonly QUOTA_MARGIN=20
# Exit status for an exhausted quota (EX_TEMPFAIL), so callers can retry later.
readonly EX_RATELIMIT=75
# Scripts keep state shared across machines in archived draft items titled
# STATE_PREFIX + NAME, holding a fenced JSON block. GitHub's API doesn't
# list archived items (it ignores archivedStates), so they can't be found
# by title: their ids are recorded here once state-put has created them,
# as "ITEM_ID DRAFT_ID" so that state-put can write the draft directly.
readonly STATE_PREFIX='bot-state: '
readonly -A STATE_ITEMS=(
    [notifications]='PVTI_lAHOAQ_SPs4Bj2Gizg8Znwk DI_lAHOAQ_SPs4Bj2GizgLL1Nk'
    [watch]='PVTI_lAHOAQ_SPs4Bj2Gizg8bu2Q DI_lAHOAQ_SPs4Bj2GizgLL6AY'
    [pr-inbox]='PVTI_lAHOAQ_SPs4Bj2Gizg8evC8 DI_lAHOAQ_SPs4Bj2GizgLMD8k'
    [lease]='PVTI_lAHOAQ_SPs4Bj2Gizg8evDc DI_lAHOAQ_SPs4Bj2GizgLMD8s'
    [tmt-numbers]='PVTI_lAHOAQ_SPs4Bj2Gizg84Ipc DI_lAHOAQ_SPs4Bj2GizgLNEX0'
)
# GitHub's limit on the body of a draft item, in characters.
readonly STATE_BODY_MAX=65536
# Per state item, the last state this machine read from or wrote to the
# project ('base') and the state it last meant to write ('state'), for
# 'state-put --checked'. They differ only after a checked write failed,
# and then state-get merges the unwritten changes back in. A strict write
# (a lease, say) never leaves changes behind: its caller decides anew.
readonly STATE_MIRROR_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/bot-board
# Exit status of 'state-put --checked --strict' when the state changed
# since state-get.
readonly EX_CONFLICT=3
# merge3(BASE; OURS; THEIRS): THEIRS with the changes from BASE to OURS
# applied, recursively through objects: a key OURS left as it was in BASE
# takes THEIRS' value (or absence), one OURS changed or added takes OURS'
# (THEIRS changing or removing it too loses, so an entry one machine
# removed comes back if another changed it meanwhile), and one OURS
# removed is removed.
readonly MERGE3_JQ='
def merge3($b; $o; $t):
  if [$b, $o, $t] | all(type == "object") then
    reduce ([$b, $o, $t] | map(keys[]) | unique[]) as $k ({};
      if ($o | has($k)) == ($b | has($k)) and $o[$k] == $b[$k] then
        if $t | has($k) then .[$k] = $t[$k] else . end
      elif $o | has($k) | not then .
      elif ($b | has($k)) and ($t | has($k)) then .[$k] = merge3($b[$k]; $o[$k]; $t[$k])
      else .[$k] = $o[$k] end)
  elif $o == $b then $t
  else $o end;
'

usage() {
    cat <<EOF
Usage: $(basename "$0") [--refresh] [--project NAME] COMMAND [ARGS...]

Read and update the Workstream board, or another of the bot's boards
(${BOARD_URL} here).

Commands:
  list [--status S] [--org O] [--json]
                              List items by priority (P0 first): item id,
                              priority, status, workflow, org, title, url.
                              '--status none' lists untriaged items,
                              '--org none' items without an Org.
  show ITEM                   Show all fields of one item
  add URL                     Add an issue or PR and set its Org from the
                              URL's repository (a fork's upstream, for
                              forks in cgwalters-forge); prints the new
                              item id
  issue [--parent ITEM] [--org O] TITLE BODY
                              Open an issue in ${TRACKER_REPO} and add it
                              to the board (no Status: triage); prints
                              the new item id. --parent makes it a
                              sub-issue of that ${TRACKER_REPO} issue.
                              Org comes from the title and body links
                              unless given. Board items are never drafts
  question BLOCKED QUESTION [--option TEXT]... [--recommend WHY]
           [--context TEXT] [--title TEXT] [--priority P]
                              Ask ${OPERATOR} something: open an issue in
                              ${TRACKER_REPO} labelled '${QUESTION_LABEL}' and
                              assigned to him, whose first line is
                              '${BLOCKS_PREFIX}URL' and whose options are
                              lettered in the order given (--recommend:
                              A is the recommendation, for WHY). A
                              BLOCKED item that is a ${TRACKER_REPO} issue
                              gets it as a sub-issue. Both go to Status
                              '${QUESTION_STATUS}' on the board (the question
                              with BLOCKED's Org, and its Priority unless
                              given); prints the question's URL. He
                              answers with a comment on it. An upstream
                              BLOCKED is linked in a code span, which
                              adds nothing to its timeline
  resolve QUESTION TEXT       After acting on an answer: comment TEXT (one
                              line saying what was done) on the question
                              (an issue in ${TRACKER_REPO} labelled
                              '${QUESTION_LABEL}'), close it and set its item
                              ${DONE_STATUS}
  set ITEM [--status S] [--priority P] [--workflow W] [--org O] [--why TEXT]
           [--branch URL...] [--gist URL...] [--field NAME VALUE]...
                              Update fields of an item. Branch holds the
                              fork or upstream PR URL (or compare URLs of
                              pushed branches), Gist the write-up URL(s);
                              separate several with spaces. --field sets
                              any other text or single-select field, such
                              as another board's (--field Area docs).
                              An empty value clears a text field.
  fill-org [--all] [--dry-run]
                              Set Org on items that have none (--all:
                              also correct every other item), from the
                              Branch URLs, else the content URL, else the
                              title's first word, else the body
                              links; '${ORG_OTHER}' when nothing matches
                              and the item has no Org yet
  state-get [--track] NAME    Print the JSON state kept in the archived
                              draft item '${STATE_PREFIX}NAME' ({} if it
                              doesn't exist yet). --track records it as
                              the base for 'state-put --checked'
  state-put [--checked [--strict]] NAME JSON
                              Replace that state, creating (and archiving)
                              the item if needed; the compact JSON must
                              stay under ~64KB (a draft body's limit).
                              --checked writes nothing if JSON is the
                              tracked base, and otherwise rereads the
                              item first: if another machine changed it
                              since, applies the changes from the base
                              to JSON on top of theirs (--strict: fails
                              with status ${EX_CONFLICT} instead)
  -h, --help                  Show this help

Options:
  --refresh                   Ignore cached board data and refetch it
  --project NAME              The board to use: $(project_names) (default
                              ${WORKSTREAM}), or a project number of
                              ${OWNER}. state-get, state-put and fill-org
                              work on ${WORKSTREAM} only

ITEM is a project item id (PVTI_...), an issue/PR URL, or OWNER/REPO#N.
BLOCKED and QUESTION are issue/PR URLs or OWNER/REPO#N.
Valid values for Status, Priority, Workflow and Org are read from the board.

Board calls use the bot's GraphQL quota, shared by all agents, so field
definitions are cached for ${FIELDS_TTL}s and the item list for ${ITEMS_TTL}s in
${BOARD_CACHE}; changes made through this tool invalidate the item cache.
state-get is one GraphQL call, and so is state-put on an existing item
(creating one takes a few); --checked adds a read, unless there is
nothing to write.

State writes are last-writer-wins unless checked. A checked write is an
optimistic one: GitHub can't make the write conditional, so a write by
another machine in the moment between the reread and the write is still
lost. A tracked state is mirrored in ${STATE_MIRROR_DIR}; when a
checked write fails (say, rate limited or over the size limit), the
mirror keeps the changes and the next state-get merges them back in.
Runs on one machine must not state-get --track the same NAME at once.
EOF
}

fatal() {
    echo "error: $*" 1>&2
    exit 1
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || fatal "'$1' not found in PATH; $2"
}

# rate_limited REASON: fails with the quota state and reset time. rate_limit
# is a REST endpoint and does not count against the quota.
rate_limited() {
    local quota
    quota=$(gh api rate_limit --jq '.resources.graphql
        | "\(.remaining)/\(.limit) points left, resets at \(.reset | todate)"' 2>/dev/null) ||
        quota="quota unknown"
    echo "error: GitHub is rate limiting the bot (${1}; GraphQL: ${quota}); the quota is shared by all agents, so back off and retry later" 1>&2
    exit "${EX_RATELIMIT}"
}

# fail_after STATUS MESSAGE: after a failed command substitution, pass a
# rate-limit exit through (its error was already printed), else fail.
fail_after() {
    test "$1" -ne "${EX_RATELIMIT}" || exit "${EX_RATELIMIT}"
    fatal "$2"
}

# Runs a GraphQL-backed gh command, turning rate limiting into a clear error.
ghq() {
    local out err rc=0
    err=$(mktemp)
    out=$(gh "$@" 2>"${err}") || rc=$?
    if test "${rc}" -ne 0; then
        if grep -qi 'rate limit' "${err}"; then
            local reason
            reason=$(grep -i -m1 'rate limit' "${err}")
            rm -f "${err}"
            rate_limited "${reason}"
        fi
        cat "${err}" 1>&2
        rm -f "${err}"
        return "${rc}"
    fi
    rm -f "${err}"
    printf '%s\n' "${out}"
}

refresh=false
project=${WORKSTREAM}

project_names() {
    printf '%s\n' "${!PROJECTS[@]}" | sort | paste -sd, - | sed 's/,/, /g'
}

# select_project NAME|NUMBER: sets NUMBER, BOARD_URL and BOARD_CACHE. The
# Workstream board keeps the cache directory's top level, where the ids
# of state items created since the last release of this script live too.
select_project() {
    if [[ "$1" =~ ^[1-9][0-9]*$ ]]; then
        NUMBER=$1
    else
        NUMBER=${PROJECTS[$1]:-}
        test -n "${NUMBER}" || fatal "unknown project '$1'; valid: $(project_names), or a project number of ${OWNER}"
    fi
    BOARD_URL=https://github.com/users/${OWNER}/projects/${NUMBER}
    if test "${NUMBER}" = "${PROJECTS[${WORKSTREAM}]}"; then
        BOARD_CACHE=${CACHE_DIR}
    else
        BOARD_CACHE=${CACHE_DIR}/project-${NUMBER}
    fi
}

# workstream_only COMMAND: the state items and the Org field exist only
# on the Workstream board.
workstream_only() {
    test "${NUMBER}" = "${PROJECTS[${WORKSTREAM}]}" ||
        fatal "'$1' works on the ${WORKSTREAM} board only, not on ${BOARD_URL}"
}

# cached FILE TTL CMD...: prints FILE if younger than TTL seconds, otherwise
# runs CMD and stores its output there.
cached() {
    local file=${BOARD_CACHE}/$1 ttl=$2 out mtime
    shift 2
    if ! ${refresh} && mtime=$(stat -c %Y "${file}" 2>/dev/null) &&
        test $(($(date +%s) - mtime)) -lt "${ttl}"; then
        cat "${file}"
        return 0
    fi
    out=$("$@") || return
    mkdir -p "${BOARD_CACHE}"
    printf '%s\n' "${out}" >"${file}.tmp.$$"
    mv -f "${file}.tmp.$$" "${file}"
    printf '%s\n' "${out}"
}

invalidate_items() {
    rm -f "${BOARD_CACHE}/items.json"
}

# Per-invocation copies of the caches. Loaded by calling the load_* functions
# directly (not in a command substitution, which would discard the assignment).
FIELDS_JSON=
ITEMS_JSON=

load_fields() {
    test -n "${FIELDS_JSON}" && return 0
    FIELDS_JSON=$(cached fields.json "${FIELDS_TTL}" \
        ghq project field-list "${NUMBER}" --owner "${OWNER}" --format json) ||
        fail_after $? "reading the board fields failed (gh needs the project scope)"
}

load_items() {
    test -n "${ITEMS_JSON}" && return 0
    ITEMS_JSON=$(cached items.json "${ITEMS_TTL}" \
        ghq project item-list "${NUMBER}" --owner "${OWNER}" --format json --limit "${ITEM_LIMIT}") ||
        fail_after $? "listing board items failed (gh needs the project scope)"
}

project_id() {
    cached project_id "${FIELDS_TTL}" \
        ghq project view "${NUMBER}" --owner "${OWNER}" --format json --jq .id
}

field_json() { # field_json NAME; requires load_fields
    local field
    field=$(jq -c --arg name "$1" '.fields[] | select(.name == $name)' <<<"${FIELDS_JSON}")
    test -n "${field}" || fatal "the board has no '$1' field; its layout changed (try --refresh), or update $(basename "$0")"
    echo "${field}"
}

has_field() { # has_field NAME; requires load_fields
    jq -e --arg name "$1" 'any(.fields[]; .name == $name)' <<<"${FIELDS_JSON}" >/dev/null
}

option_names() { # option_names FIELD; requires load_fields
    field_json "$1" | jq -r '[.options[].name] | join(", ")'
}

option_id() { # option_id FIELD VALUE; requires load_fields
    local field id
    field=$(field_json "$1")
    id=$(jq -r --arg v "$2" '.options[] | select(.name == $v) | .id' <<<"${field}")
    test -n "${id}" || fatal "invalid $1 '$2'; valid values: $(option_names "$1") (cached; --refresh rereads the board)"
    echo "${id}"
}

# Prints the project item id for ITEM; requires load_items.
resolve_item() {
    local item=$1 id url
    if [[ "${item}" == PVTI_* ]]; then
        id=$(jq -r --arg id "${item}" '.items[] | select(.id == $id) | .id' <<<"${ITEMS_JSON}")
    elif [[ "${item}" =~ ^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)$ ]]; then
        url="https://github.com/${BASH_REMATCH[1]}/"
        id=$(jq -r --arg prefix "${url,,}" --arg num "${BASH_REMATCH[2]}" \
            '.items[] | select((.content.url // "" | ascii_downcase) as $u
                                | $u == $prefix + "issues/" + $num or $u == $prefix + "pull/" + $num) | .id' \
            <<<"${ITEMS_JSON}")
    elif [[ "${item}" == https://* ]]; then
        url=${item%%#*}
        url=${url%/}
        id=$(jq -r --arg url "${url}" '.items[] | select(.content.url == $url) | .id' <<<"${ITEMS_JSON}")
    else
        fatal "cannot parse item '${item}'; expected PVTI_..., an issue/PR URL or OWNER/REPO#N"
    fi
    test -n "${id}" || fatal "'${item}' is not on the board (${BOARD_URL}); if it was just added, retry with --refresh"
    test "$(wc -l <<<"${id}")" -eq 1 || fatal "'${item}' matches several board items"
    echo "${id}"
}

cmd_list() {
    local status="" org="" json=false
    while test $# -gt 0; do
        case "$1" in
            --status) test $# -ge 2 || fatal "--status requires an argument"; status=$2; shift 2 ;;
            --status=*) status=${1#--status=}; shift ;;
            --org) test $# -ge 2 || fatal "--org requires an argument"; org=$2; shift 2 ;;
            --org=*) org=${1#--org=}; shift ;;
            --json) json=true; shift ;;
            *) fatal "unknown argument for list: $1 (see --help)" ;;
        esac
    done
    if test -n "${status}" && test "${status}" != none; then
        load_fields
        option_id Status "${status}" >/dev/null
    fi
    if test -n "${org}" && test "${org}" != none; then
        load_fields
        option_id Org "${org}" >/dev/null
    fi
    load_items
    # Unset priorities sort last; sort_by is stable, so board order is kept
    # within a priority.
    local sorted
    sorted=$(jq --arg status "${status}" --arg org "${org}" '
        def matches($want; $have): $want == "" or ($want == "none" and $have == null) or $have == $want;
        [.items[] | select(matches($status; .status) and matches($org; .org))]
        | sort_by(.priority // "P9")' <<<"${ITEMS_JSON}")
    if ${json}; then
        echo "${sorted}"
        return 0
    fi
    jq -r --argjson width "${TITLE_WIDTH}" '
        ["ITEM", "PRI", "STATUS", "WORKFLOW", "ORG", "TITLE", "URL"],
        (.[] | [.id, .priority // "-", .status // "-", .workflow // "-", .org // "-",
                (.title | if length > $width then .[:$width - 3] + "..." else . end),
                .content.url // "(draft)"])
        | @tsv' <<<"${sorted}" | column -t -s $'\t'
}

cmd_show() {
    test $# -eq 1 || fatal "usage: $(basename "$0") show ITEM"
    load_items
    local id
    id=$(resolve_item "$1")
    jq -r --arg id "${id}" '
        .items[] | select(.id == $id) | . as $item
        | ([["item", .id], ["title", .title], ["type", .content.type],
           ["url", .content.url // "-"],
           ["draft id", (if .content.type == "DraftIssue" then .content.id else null end)],
           ["status", .status // "-"], ["priority", .priority // "-"],
           ["workflow", .workflow // "-"], ["org", .org // "-"],
           ["assignees", ((.assignees // []) | join(", "))],
           ["linked PRs", ((."linked pull requests" // []) | join(" "))],
           ["branch", .branch], ["gist", .gist],
           ["why", .why // "-"]]
          + [to_entries[] | select((.value | type) == "string")
             | select(.key | IN("id", "title", "status", "priority", "workflow", "org",
                                "branch", "gist", "why") | not) | [.key, .value]]
          | .[] | select(.[1] != null and .[1] != "") | "\(.[0]):\t\(.[1])"),
          (if $item.content.type == "DraftIssue" and ($item.content.body // "") != ""
           then "\n\($item.content.body)" else empty end)' <<<"${ITEMS_JSON}"
}

# add_item URL [ORG]: adds an issue or PR to the board and prints its
# item id; sets Org to ORG, else to the URL's (on boards with an Org).
add_item() {
    local url=$1 org=${2:-} id
    load_fields
    # Other boards have no Org field.
    local want_org=false
    ! has_field Org || want_org=true
    # A failed fork lookup shouldn't keep the item off the board.
    test -n "${org}" || ! ${want_org} || org=$(org_of_url "${url}") || org=
    invalidate_items
    id=$(ghq project item-add "${NUMBER}" --owner "${OWNER}" --url "${url}" --format json --jq .id) ||
        fail_after $? "adding ${url} to the board failed"
    echo "${id}"
    ${want_org} || return 0
    if test -z "${org}" || ! set_org "${id}" "${org}"; then
        echo "warning: Org is not set on ${id}; run: $(basename "$0") fill-org" 1>&2
    fi
}

cmd_add() {
    test $# -eq 1 || fatal "usage: $(basename "$0") add URL"
    [[ "$1" == https://github.com/* ]] || fatal "expected an issue or PR URL on github.com, got '$1'"
    add_item "$1"
}

cmd_draft() {
    fatal "board items are no longer drafts: use '$(basename "$0") issue TITLE BODY' (an issue in ${TRACKER_REPO}), or 'question' to ask ${OPERATOR} something"
}

# --- Tracker issues and questions -------------------------------------------

# issue_ref REF: prints "OWNER/REPO NUMBER" for an issue or PR URL or
# OWNER/REPO#N.
issue_ref() {
    if [[ "$1" =~ ^https://github\.com/([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)/(issues|pull)/([0-9]+)([#?].*)?$ ]]; then
        echo "${BASH_REMATCH[1]} ${BASH_REMATCH[3]}"
    elif [[ "$1" =~ ^([A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+)#([0-9]+)$ ]]; then
        echo "${BASH_REMATCH[1]} ${BASH_REMATCH[2]}"
    else
        fatal "expected an issue or PR URL or OWNER/REPO#N, got '$1'"
    fi
}

is_tracker() { # is_tracker OWNER/REPO
    test "${1,,}" = "${TRACKER_REPO,,}"
}

# open_issue TITLE BODY [JQ_EXTRA]: opens an issue in TRACKER_REPO (with
# the fields of the JSON object JQ_EXTRA added) and prints its REST JSON.
open_issue() {
    local payload
    payload=$(jq -nc --arg title "$1" --arg body "$2" --argjson extra "${3:-{\}}" \
        '{title: $title, body: $body} + $extra')
    ghq api -X POST "repos/${TRACKER_REPO}/issues" --input - <<<"${payload}" ||
        fail_after $? "opening an issue in ${TRACKER_REPO} failed"
}

# add_sub_issue PARENT_REPO PARENT_NUMBER CHILD_ID: makes the issue with
# REST id CHILD_ID a sub-issue of the parent. Call it in a subshell once
# the child exists: a rate limit exits.
add_sub_issue() {
    ghq api -X POST "repos/$1/issues/$2/sub_issues" -F sub_issue_id="$3" >/dev/null
}

# text_org TITLE BODY: the Org for an item with this title and body (its
# first word, else its body's links), or nothing; requires load_fields.
text_org() {
    item_org "$(jq -nc --arg title "$1" --arg body "$2" '{title: $title, content: {body: $body}}')"
}

cmd_issue() {
    local parent="" org="" args=()
    while test $# -gt 0; do
        case "$1" in
            --parent) test $# -ge 2 || fatal "--parent requires an issue"; parent=$2; shift 2 ;;
            --org) test $# -ge 2 || fatal "--org requires an argument"; org=$2; shift 2 ;;
            -*) fatal "unknown option for issue: '$1' (see --help)" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    test "${#args[@]}" -eq 2 || fatal "usage: $(basename "$0") issue [--parent ITEM] [--org O] TITLE BODY"
    test -n "${args[0]}" || fatal "the issue title must not be empty"
    local parent_repo="" parent_number="" ref
    if test -n "${parent}"; then
        ref=$(issue_ref "${parent}") || exit
        read -r parent_repo parent_number <<<"${ref}"
        is_tracker "${parent_repo}" || fatal "--parent must be an issue in ${TRACKER_REPO}, not '${parent}'"
    fi
    load_fields
    if test -n "${org}"; then
        option_id Org "${org}" >/dev/null
    elif has_field Org; then
        org=$(text_org "${args[0]}" "${args[1]}")
    fi
    local issue url id
    issue=$(open_issue "${args[0]}" "${args[1]}")
    url=$(jq -r .html_url <<<"${issue}")
    echo "opened ${url}" 1>&2
    # On the board before it is a sub-issue: the board's "Auto-add
    # sub-issues" workflow would add it first, and then item-add fails.
    id=$(add_item "${url}" "${org}") ||
        fail_after $? "opened ${url}, but adding it to the board failed; add it with '$(basename "$0") add'"
    if test -n "${parent}"; then
        (add_sub_issue "${parent_repo}" "${parent_number}" "$(jq -r .id <<<"${issue}")") ||
            echo "warning: making ${url} a sub-issue of ${parent} failed; do it on GitHub" 1>&2
    fi
    echo "${id}"
}

# question_body BLOCKED_URL QUESTION CONTEXT RECOMMEND OPTION...: the
# body of a question issue. A bare link to an issue or PR elsewhere would
# put "mentioned this" on its timeline, upstream noise; one in a code
# span doesn't.
question_body() {
    local blocked=$1 question=$2 context=$3 recommend=$4 i
    shift 4
    if [[ "${blocked,,}" == "https://github.com/${TRACKER_REPO,,}/"* ]]; then
        printf '%s%s\n\n' "${BLOCKS_PREFIX}" "${blocked}"
    else
        printf '%s`%s`\n\n' "${BLOCKS_PREFIX}" "${blocked}"
    fi
    test -z "${context}" || printf '%s\n\n' "${context}"
    printf 'Q: %s\n' "${question}"
    if test $# -gt 0; then
        printf '\nOptions:\n'
        for ((i = 1; i <= $#; i++)); do
            printf '%s) %s\n' "${OPTION_LETTERS:i-1:1}" "${!i}"
        done
    fi
    test -z "${recommend}" || printf '\nRecommended: A, because %s\n' "${recommend}"
    printf '\n%s\n' "Answer with a comment on this issue: $(test $# -eq 0 || echo "an option's letter alone on the first line (e.g. \`B\`), optionally followed by your own text, or ")just text. Only comments by the ${OPERATOR} login count."
}

# one_line TEXT MAX: TEXT on one line, cut to MAX characters.
one_line() {
    local text=${1//$'\n'/ }
    test "${#text}" -le "$2" || text="${text:0:$(($2 - 3))}..."
    printf '%s' "${text}"
}

cmd_question() {
    local blocked="" question="" context="" recommend="" title="" priority="" options=() have_question=false
    while test $# -gt 0; do
        case "$1" in
            --option) test $# -ge 2 || fatal "--option requires a text"; test -n "$2" || fatal "an option must not be empty"
                options+=("$2"); shift 2 ;;
            --recommend) test $# -ge 2 || fatal "--recommend requires a reason"; recommend=$2; shift 2 ;;
            --context) test $# -ge 2 || fatal "--context requires a text"; context=$2; shift 2 ;;
            --title) test $# -ge 2 || fatal "--title requires a text"; title=$2; shift 2 ;;
            --priority) test $# -ge 2 || fatal "--priority requires an argument"; priority=$2; shift 2 ;;
            -*) fatal "unknown option for question: '$1' (see --help)" ;;
            *)
                if test -z "${blocked}"; then blocked=$1
                elif ! ${have_question}; then question=$1; have_question=true
                else fatal "unexpected argument '$1'; options go in --option"
                fi
                shift ;;
        esac
    done
    { test -n "${blocked}" && test -n "${question}"; } ||
        fatal "usage: $(basename "$0") question BLOCKED QUESTION [--option TEXT]... [--recommend WHY] [--context TEXT] [--title TEXT] [--priority P]"
    test "${#options[@]}" -ne 1 || fatal "give at least two options, or none"
    test "${#options[@]}" -le "${#OPTION_LETTERS}" || fatal "at most ${#OPTION_LETTERS} options"
    test -z "${recommend}" || test "${#options[@]}" -gt 0 ||
        fatal "--recommend recommends option A, so it needs options (the recommended one first)"
    local blocked_repo blocked_number blocked_url ref
    ref=$(issue_ref "${blocked}") || exit
    read -r blocked_repo blocked_number <<<"${ref}"
    blocked_url=https://github.com/${blocked_repo}/issues/${blocked_number}
    [[ "${blocked}" != */pull/* ]] || blocked_url=https://github.com/${blocked_repo}/pull/${blocked_number}
    # Settle everything the board decides before anything is created.
    load_fields
    test -z "${priority}" || option_id Priority "${priority}" >/dev/null
    load_items
    local blocked_item org
    blocked_item=$(jq -c --arg url "${blocked_url,,}" \
        'first(.items[] | select((.content.url // "" | ascii_downcase) == $url)) // empty' <<<"${ITEMS_JSON}")
    test -n "${blocked_item}" ||
        echo "warning: ${blocked_url} is not on the board (or the listing lags); only the question goes on it" 1>&2
    test -n "${priority}" || priority=$(jq -r '.priority // empty' <<<"${blocked_item:-{\}}")
    org=$(jq -r '.org // empty' <<<"${blocked_item:-{\}}")
    test -n "${org}" || org=$(item_org "${blocked_item:-$(jq -nc --arg url "${blocked_url}" '{content: {url: $url}}')}")
    test -n "${title}" || title=$(one_line "${question}" "${QUESTION_TITLE_MAX}")
    local body issue url
    body=$(question_body "${blocked_url}" "${question}" "${context}" "${recommend}" "${options[@]}")
    issue=$(open_issue "${title}" "${body}" "$(jq -nc --arg label "${QUESTION_LABEL}" --arg op "${OPERATOR}" \
        '{labels: [$label], assignees: [$op]}')")
    url=$(jq -r .html_url <<<"${issue}")
    echo "opened ${url}" 1>&2
    local id why fields=(--status "${QUESTION_STATUS}")
    id=$(add_item "${url}" "${org}") ||
        fail_after $? "opened ${url}, but adding it to the board failed; add it with '$(basename "$0") add' and set Status '${QUESTION_STATUS}'"
    # Only now a sub-issue (see cmd_issue).
    if is_tracker "${blocked_repo}" && [[ "${blocked_url}" == */issues/* ]]; then
        (add_sub_issue "${blocked_repo}" "${blocked_number}" "$(jq -r .id <<<"${issue}")") ||
            echo "warning: making ${url} a sub-issue of ${blocked_url} failed; its ${BLOCKS_PREFIX% } line still links them" 1>&2
    fi
    why="Q: $(one_line "${question}" $((WHY_MAX - 20)))"
    test -z "${recommend}" || why+=" (rec A)"
    fields+=(--why "${why}")
    test -z "${priority}" || fields+=(--priority "${priority}")
    # In subshells, so that a failed edit still prints the question's id.
    (cmd_set "${id}" "${fields[@]}" >/dev/null) ||
        echo "warning: setting up the question's item ${id} failed; set: ${fields[*]}" 1>&2
    if test -n "${blocked_item}"; then
        local blocked_id
        blocked_id=$(jq -r .id <<<"${blocked_item}")
        (cmd_set "${blocked_id}" --status "${QUESTION_STATUS}" >/dev/null) ||
            echo "warning: setting ${blocked_id} (${blocked_url}) to ${QUESTION_STATUS} failed; do it by hand" 1>&2
    fi
    echo "on the board as ${id}" 1>&2
    echo "${url}"
}

cmd_resolve() {
    test $# -eq 2 || fatal "usage: $(basename "$0") resolve QUESTION TEXT"
    [[ "$2" =~ [^[:space:]] ]] || fatal "say in TEXT what was done"
    local repo number url ref
    ref=$(issue_ref "$1") || exit
    read -r repo number <<<"${ref}"
    url=https://github.com/${repo}/issues/${number}
    is_tracker "${repo}" || fatal "resolve closes questions in ${TRACKER_REPO}, not '$1'; close anything else yourself"
    local labels
    labels=$(ghq api "repos/${repo}/issues/${number}" --jq '[.labels[].name] | join(" ")') ||
        fail_after $? "reading ${url} failed"
    [[ " ${labels} " == *" ${QUESTION_LABEL} "* ]] ||
        fatal "${url} isn't labelled '${QUESTION_LABEL}': resolve only closes questions"
    ghq api -X POST "repos/${repo}/issues/${number}/comments" -f body="$2" >/dev/null ||
        fail_after $? "commenting on ${url} failed"
    ghq api -X PATCH "repos/${repo}/issues/${number}" -f state=closed -f state_reason=completed >/dev/null ||
        fail_after $? "closing ${url} failed"
    echo "closed ${url}"
    load_items
    local id
    id=$(jq -r --arg url "${url,,}" 'first(.items[] | select((.content.url // "" | ascii_downcase) == $url) | .id) // empty' <<<"${ITEMS_JSON}")
    if test -z "${id}"; then
        echo "warning: ${url} is not on the board (or the listing lags); set its item ${DONE_STATUS} by id" 1>&2
        return 0
    fi
    cmd_set "${id}" --status "${DONE_STATUS}"
}

one_of() { # one_of VALUE CHOICES...
    local value=$1 choice
    shift
    for choice in "$@"; do
        test "${value}" = "${choice}" && return 0
    done
    return 1
}

# Branch and Gist hold space-separated URLs, so tooling (and people) can
# follow them without parsing prose.
validate_links() {
    local field=$1 value=$2 prefix url
    case "${field}" in
        Branch) prefix=https://github.com/ ;;
        Gist) prefix=https://gist.github.com/ ;;
        *) return 0 ;;
    esac
    for url in ${value}; do
        [[ "${url}" == "${prefix}"* ]] ||
            fatal "${field} expects space-separated URLs starting with ${prefix}, got '${url}'"
    done
}

cmd_set() {
    test $# -ge 1 || fatal "usage: $(basename "$0") set ITEM [--status S] [--priority P] [--workflow W] [--org O] [--why TEXT] [--branch URL] [--gist URL] [--field NAME VALUE]..."
    local item=$1
    shift
    test $# -gt 0 || fatal "nothing to set; valid options: ${SET_OPTIONS[*]}"
    # Resolve and validate everything before changing anything.
    local field_ids=() args=() names=() field field_id option
    load_fields
    while test $# -gt 0; do
        case "$1" in
            --status|--priority|--workflow|--org|--why|--branch|--gist)
                test $# -ge 2 || fatal "$1 requires an argument"
                field=${1#--}
                field=${field^}
                # Plain assignments, so that a failed lookup stops the script.
                field_id=$(field_json "${field}")
                field_ids+=("$(jq -r .id <<<"${field_id}")")
                if one_of "${field}" "${TEXT_FIELDS[@]}"; then
                    validate_links "${field}" "$2"
                    if test -n "$2"; then args+=("--text=$2"); else args+=(--clear); fi
                else
                    option=$(option_id "${field}" "$2")
                    args+=("--single-select-option-id=${option}")
                fi
                names+=("${field} = $2")
                shift 2
                ;;
            --field)
                test $# -ge 3 || fatal "--field requires a field name and a value"
                field_id=$(field_json "$2")
                field_ids+=("$(jq -r .id <<<"${field_id}")")
                if jq -e '.options' <<<"${field_id}" >/dev/null; then
                    option=$(option_id "$2" "$3")
                    args+=("--single-select-option-id=${option}")
                else
                    validate_links "$2" "$3"
                    if test -n "$3"; then args+=("--text=$3"); else args+=(--clear); fi
                fi
                names+=("$2 = $3")
                shift 3
                ;;
            *) fatal "unknown option for set: '$1'; valid options: ${SET_OPTIONS[*]} --field" ;;
        esac
    done
    local id project remaining i
    # A project item id needs no lookup; anything else resolves via the list.
    if [[ "${item}" == PVTI_* ]]; then
        id=${item}
    else
        load_items
        id=$(resolve_item "${item}")
    fi
    project=$(project_id) || fail_after $? "cannot look up the project id"
    # Don't start a batch of edits that the quota can't finish.
    remaining=$(gh api rate_limit --jq .resources.graphql.remaining 2>/dev/null) || remaining=
    if test -n "${remaining}" && test "${remaining}" -lt $((${#field_ids[@]} + QUOTA_MARGIN)); then
        rate_limited "only ${remaining} GraphQL points left, not starting ${#field_ids[@]} edit(s)"
    fi
    # Before and after the edits, so a concurrent listing can't cache the
    # old values for long.
    invalidate_items
    for i in "${!field_ids[@]}"; do
        ghq project item-edit --project-id "${project}" --id "${id}" \
            --field-id "${field_ids[i]}" "${args[i]}" >/dev/null ||
            fatal "setting ${names[i]} on ${id} failed"
        echo "${id}: ${names[i]}"
    done
    invalidate_items
}

# --- Org -------------------------------------------------------------------

# org_option OWNER: the Org option named OWNER (ignoring case), else
# ORG_OTHER; requires load_fields.
org_option() {
    field_json Org | jq -r --arg owner "${1,,}" --arg other "${ORG_OTHER}" '
        first(.options[].name | select(ascii_downcase == $owner)) // $other'
}

# org_of_url URL: the Org of a github.com repository URL (issue, PR,
# compare, blob, ...), or nothing for other URLs; fails if looking up
# whether it is a fork failed. Requires load_fields.
org_of_url() {
    [[ "$1" =~ ^https://github\.com/([A-Za-z0-9_.-]+)/([A-Za-z0-9_.-]+) ]] || return 0
    local owner=${BASH_REMATCH[1],,} repo=${BASH_REMATCH[2],,} source
    ! one_of "${owner}" "${NON_REPO_PATHS[@]}" || return 0
    repo=${owner}/${repo%.git}
    ! is_tracker "${repo}" || return 0
    if one_of "${owner}" "${FORK_OWNERS[@]}"; then
        source=$(cached "source-${owner}_${repo#*/}" "${REPO_TTL}" \
            gh api "repos/${repo}" --jq '.source.full_name // empty') || {
            echo "error: cannot tell whether ${repo} is a fork: looking it up failed" 1>&2
            return 1
        }
        test -z "${source}" || repo=${source,,}
    fi
    owner=${repo%%/*}
    if test -n "${REPO_ORGS[${repo}]:-}"; then
        echo "${REPO_ORGS[${repo}]}"
    else
        org_option "${OWNER_ORGS[${owner}]:-${owner}}"
    fi
}

# item_org ITEM_JSON: the Org derived from an item's Branch URLs (where
# its work lands), else its content URL, else its title's first word,
# else the links in its body, else nothing (an issue in TRACKER_REPO says
# nothing by its URL); requires load_fields.
item_org() {
    local urls=() body_urls=() url title word org
    mapfile -t urls < <(jq -r '((.branch // "") | split(" ") | map(select(. != ""))[]), (.content.url // empty)' <<<"$1")
    mapfile -t body_urls < <(jq -r '.content.body // "" | scan("https://github\\.com/[A-Za-z0-9_./-]+")' <<<"$1")
    title=$(jq -r '.title // "" | gsub("[\n\t]"; " ")' <<<"$1")
    for url in "${urls[@]}"; do
        # Command substitutions don't inherit set -e, so pass failures on.
        org=$(org_of_url "${url}") || exit
        test -z "${org}" || { echo "${org}"; return 0; }
    done
    read -r word _ <<<"${title,,}"
    word=${word%:}
    if test -n "${word}" && test -n "${TITLE_ORGS[${word}]:-}"; then
        echo "${TITLE_ORGS[${word}]}"
        return 0
    fi
    # Body text is loose, so a link that can't be resolved is skipped.
    for url in "${body_urls[@]}"; do
        org=$(org_of_url "${url}") || continue
        test -z "${org}" || { echo "${org}"; return 0; }
    done
}

# set_org ITEM ORG: sets one item's Org; requires load_fields.
set_org() {
    local field option project
    field=$(field_json Org | jq -r .id)
    option=$(option_id Org "$2")
    project=$(project_id) || return
    invalidate_items
    ghq project item-edit --project-id "${project}" --id "$1" --field-id "${field}" \
        --single-select-option-id "${option}" >/dev/null
}

cmd_fill_org() {
    local all=false dry_run=false
    while test $# -gt 0; do
        case "$1" in
            --all) all=true; shift ;;
            --dry-run) dry_run=true; shift ;;
            *) fatal "unknown argument for fill-org: $1 (see --help)" ;;
        esac
    done
    load_fields
    load_items
    local field item id org current title updates=() leftovers=()
    field=$(field_json Org | jq -r .id)
    while IFS= read -r item; do
        id=$(jq -r .id <<<"${item}")
        [[ "${id}" =~ ^PVTI_[A-Za-z0-9_-]+$ ]] || fatal "unexpected item id '${id}'"
        title=$(jq -r .title <<<"${item}")
        org=$(item_org "${item}")
        current=$(jq -r '.org // ""' <<<"${item}")
        if test -z "${org}"; then
            # Keep an Org someone chose for an item nothing links anywhere.
            test -z "${current}" || continue
            org=${ORG_OTHER}
            leftovers+=("${id}  ${title}")
        fi
        test "${current}" = "${org}" && continue
        printf '%s\t%s\t%s\n' "${id}" "${org}" "${title:0:${TITLE_WIDTH}}"
        updates+=("${id} $(option_id Org "${org}")")
    done < <(jq -c --argjson all "${all}" '.items[] | select($all or .org == null)' <<<"${ITEMS_JSON}")
    if test "${#leftovers[@]}" -gt 0; then
        echo "No org derivable for these, so they get '${ORG_OTHER}':" 1>&2
        printf '  %s\n' "${leftovers[@]}" 1>&2
    fi
    echo "${#updates[@]} item(s) to update" 1>&2
    if ${dry_run} || test "${#updates[@]}" -eq 0; then
        return 0
    fi
    local project requests remaining start i query option
    project=$(project_id) || fail_after $? "cannot look up the project id"
    # Each request is one mutation of ORG_BATCH aliased edits.
    requests=$(( (${#updates[@]} + ORG_BATCH - 1) / ORG_BATCH ))
    remaining=$(gh api rate_limit --jq .resources.graphql.remaining 2>/dev/null) || remaining=
    if test -n "${remaining}" && test "${remaining}" -lt $((requests * ORG_BATCH + QUOTA_MARGIN)); then
        rate_limited "only ${remaining} GraphQL points left, not starting ${#updates[@]} edit(s)"
    fi
    invalidate_items
    for ((start = 0; start < ${#updates[@]}; start += ORG_BATCH)); do
        query='mutation($project: ID!, $field: ID!) {'
        for ((i = start; i < start + ORG_BATCH && i < ${#updates[@]}; i++)); do
            read -r id option <<<"${updates[i]}"
            query+=" m${i}: updateProjectV2ItemFieldValue(input: {projectId: \$project, itemId: \"${id}\",
                fieldId: \$field, value: {singleSelectOptionId: \"${option}\"}}) { projectV2Item { id } }"
        done
        query+=' }'
        gqlq "${query}" -f project="${project}" -f field="${field}" >/dev/null ||
            fail_after $? "setting Org on items $((start + 1))-${i} of ${#updates[@]} failed; rerun fill-org to retry the rest"
        echo "set Org on items $((start + 1))-${i} of ${#updates[@]}" 1>&2
    done
    invalidate_items
}

# --- State items -----------------------------------------------------------

# gqlq QUERY [ARGS...]: a GraphQL call through ghq; prints .data.
gqlq() {
    local query=$1
    shift
    ghq api graphql -f query="${query}" "$@" --jq .data
}

state_name_ok() {
    [[ "$1" =~ ^[a-z0-9][a-z0-9-]*$ ]] || fatal "invalid state name '$1'; use lowercase letters, digits and dashes"
}

# state_body JSON: the draft body holding JSON, compact since the body
# is limited in size.
state_body() {
    printf '%s\n\n```json\n%s\n```\n' \
        "State of a script in bin/ of cgwalters-bot/homegit, shared by every machine it runs on. Archived on purpose; only the script edits it." \
        "$(jq -c . <<<"$1")"
}

# parse_state ITEM BODY: prints the JSON of the body's first fenced json
# block, or {}.
parse_state() {
    local json
    json=$(awk '/^```json[[:space:]]*$/ { inblock = 1; next }
                inblock && /^```[[:space:]]*$/ { exit }
                inblock { print }' <<<"$2")
    test -n "${json}" || json='{}'
    jq -ce 'if type == "object" then . else error("not an object") end' <<<"${json}" ||
        fatal "the state item $1 has no valid JSON block; fix or delete it"
}

readonly STATE_NODE_QUERY='query($id: ID!) { node(id: $id) { ... on ProjectV2Item {
    id isArchived content { ... on DraftIssue { id title body } } } } }'

# Set by state_ids and find_state.
STATE_ITEM=
STATE_DRAFT=
STATE_BODY=

# state_ids NAME: sets STATE_ITEM and STATE_DRAFT to the ids of the state
# item NAME, from STATE_ITEMS or, for one created since, the cache, or
# returns 1 if it doesn't exist yet.
state_ids() {
    local ids=${STATE_ITEMS[$1]:-}
    test -n "${ids}" || read -r ids 2>/dev/null <"${CACHE_DIR}/state-$1" || true
    test -n "${ids}" || return 1
    read -r STATE_ITEM STATE_DRAFT <<<"${ids}"
    [[ "${STATE_ITEM}" == PVTI_* && "${STATE_DRAFT}" == DI_* ]] ||
        fatal "the ids of the state item '$1' are not 'PVTI_... DI_...': '${ids}'; fix STATE_ITEMS in $(basename "$0") or ${CACHE_DIR}/state-$1"
}

# find_state NAME: sets STATE_ITEM, STATE_DRAFT and STATE_BODY to the
# state item, or returns 1 if there is none yet.
find_state() {
    local data
    state_ids "$1" || return 1
    data=$(gqlq "${STATE_NODE_QUERY}" -f id="${STATE_ITEM}") || fail_after $? "reading the state item ${STATE_ITEM} failed"
    jq -e --arg t "${STATE_PREFIX}$1" --arg draft "${STATE_DRAFT}" \
        '.node.content.title == $t and .node.content.id == $draft' <<<"${data}" >/dev/null ||
        fatal "${STATE_ITEM} is not the '${STATE_PREFIX}$1' draft item ${STATE_DRAFT} (deleted?); fix STATE_ITEMS in $(basename "$0"), or remove ${CACHE_DIR}/state-$1 to create a new one"
    STATE_BODY=$(jq -r .node.content.body <<<"${data}")
    jq -e .node.isArchived <<<"${data}" >/dev/null ||
        echo "warning: the state item ${STATE_ITEM} is not archived; it shows on the board" 1>&2
}

# read_state NAME: prints the state on the project, {} if its item
# doesn't exist yet. One GraphQL call.
read_state() {
    if find_state "$1"; then
        parse_state "${STATE_ITEM}" "${STATE_BODY}"
    else
        echo '{}'
    fi
}

mirror_file() {
    echo "${STATE_MIRROR_DIR}/state-$1.json"
}

# read_mirror NAME: prints the mirror {base, state} of NAME, or nothing.
read_mirror() {
    local file
    file=$(mirror_file "$1")
    test -s "${file}" || return 0
    jq -ce 'if type == "object" and has("base") and has("state") then . else error("not {base, state}") end' "${file}" ||
        fatal "cannot parse ${file}; if it holds changes to the state '$1' that are still wanted, write them with state-put, then remove it"
}

# write_mirror NAME BASE STATE
write_mirror() {
    local file
    file=$(mirror_file "$1")
    mkdir -p "${STATE_MIRROR_DIR}" || fatal "cannot create ${STATE_MIRROR_DIR}"
    jq -nc --argjson b "$2" --argjson s "$3" '{base: $b, state: $s}' >"${file}.tmp.$$" ||
        fatal "cannot write ${file}.tmp.$$"
    mv -f "${file}.tmp.$$" "${file}" || fatal "cannot replace ${file}"
}

# merge3 BASE OURS THEIRS: prints the three-way merge (see MERGE3_JQ).
merge3() {
    jq -nc --argjson b "$1" --argjson o "$2" --argjson t "$3" "${MERGE3_JQ} merge3(\$b; \$o; \$t)"
}

same_json() {
    jq -ne --argjson a "$1" --argjson b "$2" '$a == $b' >/dev/null
}

cmd_state_get() {
    local name="" track=false
    while test $# -gt 0; do
        case "$1" in
            --track) track=true; shift ;;
            -*) fatal "unknown argument for state-get: $1 (see --help)" ;;
            *) test -z "${name}" || fatal "usage: $(basename "$0") state-get [--track] NAME"; name=$1; shift ;;
        esac
    done
    test -n "${name}" || fatal "usage: $(basename "$0") state-get [--track] NAME"
    state_name_ok "${name}"
    local theirs mirror result
    theirs=$(read_state "${name}")
    test "${theirs}" != '{}' || state_ids "${name}" ||
        echo "warning: no '${STATE_PREFIX}${name}' state item yet; state-put creates it" 1>&2
    result=${theirs}
    mirror=$(read_mirror "${name}")
    if test -n "${mirror}" && ! jq -e '.base == .state' <<<"${mirror}" >/dev/null; then
        echo "note: merging in the changes to the state '${name}' that a previous run on this machine could not write" 1>&2
        result=$(merge3 "$(jq -c .base <<<"${mirror}")" "$(jq -c .state <<<"${mirror}")" "${theirs}")
    fi
    ! ${track} || write_mirror "${name}" "${theirs}" "${result}"
    printf '%s\n' "${result}"
}

readonly DRAFT_UPDATE_MUTATION='mutation($id: ID!, $body: String!) {
    updateProjectV2DraftIssue(input: {draftIssueId: $id, body: $body}) { draftIssue { id title } } }'

# check_state_size NAME JSON: fails unless JSON fits in a draft body.
check_state_size() {
    local body
    body=$(state_body "$2")
    test "${#body}" -le "${STATE_BODY_MAX}" ||
        fatal "the state '$1' is ${#body} characters, over the ${STATE_BODY_MAX} a draft body holds; keep less in it"
}

# write_state NAME JSON: replaces the state on the project, creating (and
# archiving) its item if needed.
write_state() {
    local name=$1 json=$2 body id project
    body=$(state_body "${json}")
    # The known draft is written directly, without reading it first; the
    # scripts all state-get (which checks the item) before they state-put.
    if state_ids "${name}"; then
        local data title
        data=$(gqlq "${DRAFT_UPDATE_MUTATION}" -f id="${STATE_DRAFT}" -f body="${body}") ||
            fail_after $? "writing the state item ${STATE_ITEM} (${STATE_DRAFT}) failed"
        title=$(jq -r .updateProjectV2DraftIssue.draftIssue.title <<<"${data}")
        test "${title}" = "${STATE_PREFIX}${name}" ||
            fatal "wrote the state '${name}' into the draft ${STATE_DRAFT} titled '${title}'; fix STATE_ITEMS in $(basename "$0") and restore that draft"
        return 0
    fi
    # Workflow manual, so that nothing ever claims it, even unarchived.
    load_fields
    local workflow_field manual
    workflow_field=$(field_json Workflow | jq -r .id)
    manual=$(option_id Workflow manual)
    id=$(ghq project item-create "${NUMBER}" --owner "${OWNER}" --title "${STATE_PREFIX}${name}" \
        --body "${body}" --format json --jq .id) || fail_after $? "creating the state item failed"
    project=$(project_id) || fail_after $? "cannot look up the project id; archive ${id} by hand"
    ghq project item-edit --project-id "${project}" --id "${id}" --field-id "${workflow_field}" \
        --single-select-option-id "${manual}" >/dev/null ||
        fail_after $? "setting Workflow manual on the state item ${id} failed; set it and archive it by hand"
    gqlq 'mutation($project: ID!, $item: ID!) { archiveProjectV2Item(input: {projectId: $project, itemId: $item}) { item { id } } }' \
        -f project="${project}" -f item="${id}" >/dev/null ||
        fail_after $? "archiving the state item ${id} failed; archive it by hand"
    local draft
    draft=$(gqlq "${STATE_NODE_QUERY}" -f id="${id}") ||
        fail_after $? "looking up the draft of the new state item ${id} failed; add it to STATE_ITEMS by hand"
    draft=$(jq -r .node.content.id <<<"${draft}")
    mkdir -p "${CACHE_DIR}"
    echo "${id} ${draft}" >"${CACHE_DIR}/state-${name}"
    echo "Created and archived the state item ${id} ('${STATE_PREFIX}${name}'); add [${name}]='${id} ${draft}' to STATE_ITEMS in $(basename "$0")" 1>&2
}

# checked_put NAME JSON STRICT: state-put --checked (see usage).
checked_put() {
    local name=$1 json=$2 strict=$3 mirror base current
    mirror=$(read_mirror "${name}")
    test -n "${mirror}" || fatal "state-put --checked needs a 'state-get --track ${name}' first"
    base=$(jq -c .base <<<"${mirror}")
    if same_json "${json}" "${base}"; then
        write_mirror "${name}" "${base}" "${base}"
        return 0
    fi
    # Until the write succeeds, the mirror holds the changes, so that the
    # next state-get merges them in.
    ${strict} || write_mirror "${name}" "${base}" "${json}"
    current=$(read_state "${name}")
    # Already written, by a write that gh reported as failed (a timeout).
    if same_json "${current}" "${json}"; then
        write_mirror "${name}" "${current}" "${current}"
        return 0
    fi
    if ! same_json "${current}" "${base}"; then
        if ${strict}; then
            # The caller decides again from the new state; nothing to merge.
            write_mirror "${name}" "${current}" "${current}"
            echo "error: the state '${name}' changed since it was read (another machine wrote it); not writing" 1>&2
            exit "${EX_CONFLICT}"
        fi
        echo "note: the state '${name}' changed since it was read (another machine wrote it); merging" 1>&2
        json=$(merge3 "${base}" "${json}" "${current}")
        if same_json "${json}" "${current}"; then
            write_mirror "${name}" "${current}" "${current}"
            return 0
        fi
    fi
    if ${strict}; then
        write_mirror "${name}" "${current}" "${current}"
    else
        write_mirror "${name}" "${current}" "${json}"
    fi
    check_state_size "${name}" "${json}"
    write_state "${name}" "${json}"
    write_mirror "${name}" "${json}" "${json}"
}

cmd_state_put() {
    local args=() checked=false strict=false
    while test $# -gt 0; do
        case "$1" in
            --checked) checked=true; shift ;;
            --strict) strict=true; shift ;;
            -*) fatal "unknown argument for state-put: $1 (see --help)" ;;
            *) args+=("$1"); shift ;;
        esac
    done
    test "${#args[@]}" -eq 2 || fatal "usage: $(basename "$0") state-put [--checked [--strict]] NAME JSON"
    ! ${strict} || ${checked} || fatal "--strict needs --checked"
    local name=${args[0]} json
    state_name_ok "${name}"
    json=$(jq -ce 'if type == "object" then . else error("not an object") end' <<<"${args[1]}" 2>/dev/null) ||
        fatal "state-put expects a JSON object"
    if ${checked}; then
        checked_put "${name}" "${json}" "${strict}"
    else
        check_state_size "${name}" "${json}"
        write_state "${name}" "${json}"
    fi
}

while test $# -gt 0; do
    case "$1" in
        --refresh) refresh=true; shift ;;
        --project) test $# -ge 2 || fatal "--project requires a board name or number"; project=$2; shift 2 ;;
        --project=*) project=${1#--project=}; shift ;;
        *) break ;;
    esac
done
select_project "${project}"
test $# -gt 0 || { usage 1>&2; exit 1; }
command=$1
shift
case "${command}" in
    -h|--help|help) usage; exit 0 ;;
    list|show|add|draft|set|issue|resolve) ;;
    question) workstream_only "${command}" ;;
    fill-org) workstream_only "${command}"; command=fill_org ;;
    state-get) workstream_only "${command}"; command=state_get ;;
    state-put) workstream_only "${command}"; command=state_put ;;
    *) fatal "unknown command '${command}' (see --help)" ;;
esac
require_cmd gh "install the GitHub CLI (https://cli.github.com) and authenticate it as ${OWNER}"
require_cmd jq "install jq"
"cmd_${command}" "$@"
