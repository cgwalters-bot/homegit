#!/usr/bin/env bash
# Dispatch and analyze devspace agent runs: runs of the agent.yml
# workflow, which write the artifacts and summary.json that
# docs/devspace-agent-runs.md describes. Modeled on 'gh aw logs' and
# 'gh aw audit'. REST only, so it spends no GraphQL quota.
# jq programs hold literal $variables.
# shellcheck disable=SC2016
set -euo pipefail
shopt -s inherit_errexit
# shellcheck source=bin/gh-http.sh disable=SC1091 # followed with shellcheck -x
source "$(dirname "$(readlink -f "$0")")/gh-http.sh" || {
    echo "error: ${0##*/} needs gh-http.sh from homegit's bin/ next to it" 1>&2
    exit 1
}
# shellcheck source=bin/operator.sh disable=SC1091 # followed with shellcheck -x
source "$(dirname "$(readlink -f "$0")")/operator.sh"

readonly SUMMARY_SCHEMA=agent-run-summary/v1
readonly RUNS_REPO=${BOT_RUNS_REPO:-${OP_DEVSPACE_REPO}}
readonly RUNS_WORKFLOW=${BOT_RUNS_WORKFLOW:-agent.yml}
# agent.yml is on this branch until it lands on main.
readonly RUNS_REF=${BOT_RUNS_REF:-bot/agent-run-praxis}
readonly SUMMARY_ARTIFACT=agent-run
readonly TRANSCRIPT_ARTIFACT=agent-transcript
# What a run hands back, as gh-aw's safe outputs: outputs.jsonl, a patch and
# base.json (see the agent runs contract).
readonly OUT_ARTIFACT=safe-outputs
# The job of agent.yml that runs the agent as runner-sandbox and uploads
# OUT_ARTIFACT; apply takes a change only from it, and only from a run in
# which every job succeeded: Restrictions (the dispatch inputs against the
# workflow's allowlist), Agent, and Safe outputs (gh-aw's validation).
readonly AGENT_JOB=Agent
readonly WORKFLOW_JOBS='["Agent", "Restrictions", "Safe outputs"]'
# The zip of OUT_ARTIFACT: at most the patch cap and a little more.
readonly MAX_ARTIFACT_BYTES=$(((8 << 20) + (1 << 20) + 8192))
readonly REPO_RE='^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$'
readonly BASE_RE='^[A-Za-z0-9_][A-Za-z0-9_./-]*$'
# Every output type apply accepts unless --outputs narrows it (the
# workflow's allowlist, safe-outputs/allowlist.json, has the final say).
readonly ALL_OUTPUTS=all
# The code that checks a run's outputs is the run's own: the safe-outputs/
# and vendor/gh-aw/ directories of the commit of RUNS_REPO that ran. It is
# kept here by commit, and BOT_RUNS_SAFE_OUTPUTS_DIR names a checkout to use
# instead.
readonly CHECKER=safe-outputs/safe-outputs.mjs
readonly CHECKER_PATHS=(safe-outputs vendor/gh-aw agent/redact.mjs)
# The trailer naming the run an applied change came from.
readonly RUN_TRAILER=Agent-run
# The push URL of an applied clone's origin when the repository is not the
# bot's own: upstream is reached only through bot-pr, never by a plain push.
readonly NO_PUSH_URL=no-push://bot-runs-apply-never-pushes
# The AI trailer of the bot's commits (shared AGENTS.md).
readonly AI_TRAILER='Generated-by: AI'
# The files of the summary artifact that are kept; anything else in it is
# ignored.
readonly SUMMARY_FILES=(summary.json summary.md condensed.log outcome.json)
readonly TRANSCRIPT_NAME=transcript.tar.zst
# The job log group holding the condensed transcript.
readonly LOG_GROUP='agent (condensed)'
# Run footers are in the bot's PRs in this organization.
readonly FOOTER_OWNER=${OP_FORGE_ORG}
readonly BOT_LOGIN=${OP_BOT_LOGIN}
# A run whose summary could not be found at all is looked up again after
# this many minutes (its footer may be written after the run).
readonly NONE_RETRY_MINUTES=1440
# agent.yml's choices: opencode and claude (Claude Code) both get inference
# from the praxis broker; fake is the scripted agent, which needs no inference.
readonly AGENTS='["opencode", "fake", "claude"]'
readonly DEFAULT_AGENT=opencode
# opencode's model for a run, in its provider/model form: GPT-6.1 Sol
# through the praxis broker (the Codex subscription), so runs that don't
# need Claude don't spend its usage. For claude the runner chooses Opus
# unless --model names a Claude Code model name or alias.
readonly DEFAULT_OPENCODE_MODEL=${BOT_RUNS_MODEL:-praxis/gpt-6.1-sol}
readonly CORES='["4", "16", "64"]'
readonly WORKFLOWS='["branch", "analysis"]'
readonly MAX_TIMEOUT=330
readonly DEFAULT_TIMEOUT=120
readonly DEFAULT_BUDGET=500
# The output types a run may hand back (agent.yml's outputs input, checked
# against its static allowlist) and how many: a branch run proposes a pull
# request, an analysis run has no change to propose.
declare -rA DEFAULT_OUTPUTS=([branch]="create_pull_request,noop,missing_tool" [analysis]="noop,missing_tool,missing_data")
readonly DEFAULT_MAX_OUTPUTS=3
readonly MAX_INPUTS_LEN=65535
# The runner-side worker brief, put before every dispatched brief: the
# agent runs without credentials, and its only outputs are the working
# tree and ~/out/outcome.json.
readonly RUNNER_PREAMBLE=${BOT_RUNS_PREAMBLE:-$(dirname "$(readlink -f "$0")")/../dotfiles/.agents/skills/coordinator/runner-preamble.md}
readonly DEFAULT_LIST_LIMIT=20
readonly DEFAULT_STATS_LIMIT=200
readonly DEFAULT_STATS_SINCE=30d
readonly PER_PAGE=100
# Summaries of finished runs don't change: they are kept for good.
readonly STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/bot-runs
readonly CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/bot-runs
readonly ETAG_DIR=${CACHE_DIR}/etags
readonly ETAG_KEEP_DAYS=14
readonly TRANSCRIPT_DIR=${CACHE_DIR}/transcripts
readonly CHECKER_DIR=${CACHE_DIR}/safe-outputs
readonly TRANSCRIPT_KEEP_DAYS=30
# list --item reads at most this many runs to find LIMIT of the item's.
readonly ITEM_SCAN_MAX=500
# Exit status for an exhausted quota (EX_TEMPFAIL), as in bot-board.
readonly EX_RATELIMIT=75
# The board's text field holding the run that works an item: dispatch
# sets it, reconcile clears it once the run is over.
readonly RUN_FIELD=Run
readonly RUN_STATUS='In Progress'
readonly PATCH_STATUS=Draft
readonly RETRY_STATUS=Todo
# reconcile only reports a successful run's patch as ready; applying it is
# bot-reconcile's patch-ready action (an Opus apply worker), which never merges.
readonly WHY_MAX=300
BOT_BOARD=${BOT_RUNS_BOT_BOARD:-$(dirname "$(readlink -f "$0")")/bot-board}
readonly BOT_BOARD
BOT_PACE=${BOT_RUNS_BOT_PACE:-$(dirname "$(readlink -f "$0")")/bot-pace}
readonly BOT_PACE
# Returned when GitHub says a resource doesn't exist (any more): EX_NOINPUT.
readonly EX_NOTFOUND=66

usage() {
    cat <<EOF
Usage: $(basename "$0") COMMAND [OPTIONS]

Dispatch and analyze devspace agent runs: runs of ${RUNS_WORKFLOW} in
${RUNS_REPO}. Their artifacts and summary.json follow
docs/devspace-agent-runs.md in homegit.

Commands:
  dispatch --item ITEM --repo OWNER/REPO [--base REF] [--agent AGENT]
           [--model MODEL] [--cores N] [--timeout MIN] [--budget AIC]
           [--workflow branch|analysis] [--outputs TYPES] [--max-outputs N]
           [--no-preamble] [--dry-run] BRIEF
      Start a run on BRIEF (a file, or - for stdin) and print its id and
      URL, then put the run URL in the item's ${RUN_FIELD} field (added to the
      board if missing), with Status ${RUN_STATUS} and a News line, and give the
      item a token budget ('bot-pace budget ITEM', unless it has one).
      Defaults: base main, agent ${DEFAULT_AGENT} (model ${DEFAULT_OPENCODE_MODEL}, as
      provider/model; BOT_RUNS_MODEL or --model changes it), 4 cores, ${DEFAULT_TIMEOUT} minutes,
      budget ${DEFAULT_BUDGET} AIC, workflow branch, outputs create_pull_request,noop,missing_tool
      (an analysis run: noop,missing_tool,missing_data), at most ${DEFAULT_MAX_OUTPUTS} of them: the
      run refuses types and numbers its static allowlist doesn't have,
      before it starts. The task sent is the
      runner-side worker brief (runner-preamble.md in the coordinator
      skill), the run's target, then BRIEF; --no-preamble sends BRIEF
      alone. --dry-run prints the request.
  reconcile [--apply | --dry-run] [--board-file FILE]
      Move the board items with a ${RUN_FIELD} whose run is over (bot-watch
      runs it on every sweep): from ${RUN_STATUS}, a success with a patch
      to ${PATCH_STATUS} (patch ready for 'apply'), anything else to ${RETRY_STATUS}, with Why
      and News linking the run; ${RUN_FIELD} is then cleared. A run still
      going leaves its item alone, and so does a finished run whose item
      left ${RUN_STATUS} (only ${RUN_FIELD} is cleared). Only --apply changes the
      board; --dry-run prints the bot-board calls. FILE is a 'bot-board
      list --json' array (default: the board). Prints one line per item
      with a ${RUN_FIELD} (--json: an array of {item, run, line, ...}).
  watch [--apply | --dry-run] [--board-file FILE] [--json]
        [--observations-file FILE | --read-url URL] [--state-file FILE]
        [--stall-minutes N] [--grace-minutes N] [--execution-step NAME]
      Evaluate active Agent execution steps using sanitized attempt telemetry.
      Defaults: stall 10 minutes, suspicion grace 5 minutes, step 'Run agent'
      (BOT_RUNS_EXECUTION_STEP overrides it). Unknown telemetry never cancels.
      --apply freshly revalidates ownership, attempt, step and telemetry,
      requests cancellation once, then sets Todo/Why and clears Run only
      after GitHub confirms cancellation. Failed board updates retry.
      Read URL: BOT_RUNS_WATCH_URL; offline telemetry array:
      BOT_RUNS_WATCH_OBSERVATIONS. Contract: lib/run-health.js.
      --runs-file FILE and --now TIME support deterministic offline reports.
      Dry runs keep suspicion state unchanged; reports advance it.
  list [--item ITEM] [--since AGE] [--status STATUS] [--limit N]
      Recent runs, newest first (at most ${DEFAULT_LIST_LIMIT} by default): item, target
      repository, agent, result, duration, tokens (in/out), estimated AIC
      and outcome. STATUS is an Actions status or conclusion
      (in_progress, completed, success, failure, ...).
  show RUN
      A run's metadata and its step summary.
  log RUN
      A run's condensed transcript.
  transcript RUN [--dir DIR] [--force]
      Download and unpack a run's full transcript (default directory:
      ${TRANSCRIPT_DIR}/RUN-ATTEMPT, removed after ${TRANSCRIPT_KEEP_DAYS} days) and
      list its files. An existing DIR must be empty or hold a transcript.
  diff RUN1 RUN2
      Compare two runs: result, duration, turns, tokens, AIC, tool
      calls, failures, files touched, tests and outcome.
  apply RUN --repo OWNER/REPO --slug SLUG --message FILE [--base REF]
        [--outputs TYPES] [--dir DIR] [--source GIT_URL]
      Take what a successful run handed back (its ${OUT_ARTIFACT} artifact: gh-aw
      safe outputs, see docs/devspace-agent-runs.md). Everything from the
      runner is checked again first, with the code of the run's own commit
      (safe-outputs/safe-outputs.mjs, gh-aw's validation vendored): the run
      is a dispatch of ${RUNS_WORKFLOW} from bot/agent-run-* (nonempty suffix)
      in the configured devspace for OWNER/REPO (and REF), in which all of
      its jobs succeeded, the artifact is the one its ${AGENT_JOB} job
      uploaded, and the outputs pass the allowlist (TYPES, comma separated,
      narrows it), gh-aw's validation and file protection, and the checks
      for secrets, symlinks, submodules, binaries and mode changes; the
      base commit must be on the base branch. A create_pull_request becomes
      a local commit on bot/SLUG, as the bot, with FILE as the message (the
      AI trailer and an ${RUN_TRAILER} trailer naming the run are added).
      DIR (default the bot-work worktree for SLUG) is a managed worktree
      backed by a fresh isolated clone of GIT_URL (default: OWNER/REPO on
      GitHub), with hooks off; refusals remove it. The other outputs (noop,
      missing_tool, add_comment, missing_data) are only listed: nothing is
      posted. Nothing is pushed. For the bot's own repositories origin stays
      pushable, so bot-land works; for any other origin has no push URL:
      after review, bot-pr fork-pr --from DIR opens it on the forge.
  stats [--since AGE] [--limit N] [--by agent|model|repo|item|result]
      Aggregate the finished runs (the last ${DEFAULT_STATS_SINCE}, at most ${DEFAULT_STATS_LIMIT} by
      default): success rate, failures by kind, duration, tokens and
      AIC, and whether failed runs used more tokens than successful ones.

Every command takes --json, to print JSON for agents instead. AGE is like 12h, 7d or 2w, or a date. RUN is a run id or URL.

A finished run's summary comes from its ${SUMMARY_ARTIFACT} artifact, kept 90 days.
Once that expired, from the run footer in its forge PR (partial: no
tools, failures, files or tests), else only the run's own metadata is
left (duration then is the whole run's). What was found is kept in
${STATE_DIR}; run listings are fetched with ETags, so an unchanged
listing costs no quota. A rerun of a run is its latest attempt.
Transcript artifacts expire after 30 days.

Environment: BOT_RUNS_REPO, BOT_RUNS_WORKFLOW and BOT_RUNS_REF choose
the workflow; BOT_RUNS_AGE_IDENTITY is the age identity file that
decrypts transcripts.
EOF
}

fatal() {
    echo "error: $*" 1>&2
    exit 1
}

warn() {
    echo "warning: $*" 1>&2
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || fatal "'$1' not found in PATH; $2"
}

rate_limited() {
    echo "error: GitHub is rate limiting the bot ($1); retry after $(gh api rate_limit --jq '.resources.core.reset | todate' 2>/dev/null || echo "the reset")" 1>&2
    exit "${EX_RATELIMIT}"
}

# check_rate_limit ERRFILE: exits if ERRFILE reports rate limiting.
check_rate_limit() {
    local reason
    if reason=$(grep -iE -m1 'rate limit|abuse' "$1"); then
        rate_limited "${reason}"
    fi
}

# Formatting and derived fields, shared by the jq programs below. A
# record is {run: {id, url, title, status, conclusion, created_at,
# started_at, updated_at}, summary: SUMMARY or null, source}; 'flat'
# gives the fields every command shows.
readonly JQ_LIB='
def pad2: tostring | if length < 2 then "0" + . else . end;
def fmt_dur: if type != "number" then "-"
    else round as $s
    | if $s < 60 then "\($s)s"
      elif $s < 3600 then "\($s / 60 | floor)m"
      else "\($s / 3600 | floor)h\(($s % 3600) / 60 | floor | pad2)m" end end;
def fmt_num: if type != "number" then "-"
    elif . >= 1000000 then "\((. / 100000 | round) / 10)M"
    elif . >= 10000 then "\(. / 1000 | round)k"
    elif . >= 1000 then "\((. / 100 | round) / 10)k"
    else "\(round)" end;
def fmt_aic: if type != "number" then "-"
    elif . >= 100 then "\(round)" else "\((. * 10 | round) / 10)" end;
# signed(f): a delta with its sign, the magnitude formatted by f.
def signed(f): if type != "number" then "-"
    elif . < 0 then "-" + (-. | f) elif . > 0 then "+" + (. | f) else "0" end;
def fmt_pct: if type != "number" then "" else " (\(signed(tostring))%)" end;
def orblank: if . == null or . == "" then "-" else tostring end;
def title_parts: (.run.title // "") | (capture("^agent (?<item>\\S+) (?<repo>\\S+)") // {});
def run_duration: if .run.status == "completed" and .run.started_at and .run.updated_at
    then (.run.updated_at | fromdate) - (.run.started_at | fromdate) else null end;
def conclusion_result: {success: "success", failure: "failure", timed_out: "timeout",
    cancelled: "cancelled"}[.run.conclusion // ""] // .run.conclusion;
def flat: (.summary // {}) as $s | title_parts as $t | {
    run_id: .run.id, url: .run.url, status: .run.status, conclusion: .run.conclusion,
    created_at: .run.created_at,
    item: ($s.item // $t.item), repo: ($s.repo // $t.repo), base: $s.base,
    workflow: $s.workflow, agent: $s.agent, model: $s.model, cores: $s.cores,
    result: ($s.result // (if .run.status == "completed" then conclusion_result else null end)),
    duration_s: ($s.duration_s // run_duration), turns: $s.turns, tokens: $s.tokens,
    aic: $s.aic, aic_budget: $s.aic_budget, aic_pricing: $s.aic_pricing,
    outcome: $s.outcome, source: .source};
def io_tokens: if .tokens then (.tokens.input // 0) + (.tokens.output // 0) else null end;
def fmt_tokens: if .tokens then "\(.tokens.input | fmt_num)/\(.tokens.output | fmt_num)" else "-" end;
def fmt_outcome: if .outcome == null then (if .status != "completed" then .status else "-" end)
    else .outcome as $o
    | [$o.status, $o.url] | map(select(. != null and . != "")) | join(" ")
    | if . == "" then ($o.why | orblank) else . end end;
# Keep every attempt and its evidence; only a later success of the exact
# same command supersedes a known failure (unknown exits are not failures).
def fmt_tests: (.tests // []) as $tests | range(0; $tests | length) as $i
    | $tests[$i] as $t
    | "Test: \($t.command): exit \($t.exit_code), \($t.duration_s | fmt_dur)"
      + (if $t.exit_code != null and $t.exit_code != 0
          and any($tests[$i + 1:][]; .command == $t.command and .exit_code == 0)
         then " (superseded by later success)" else "" end);
def agent_model: [.agent, .model] | map(select(. != null)) | join("/") | orblank;
def source_note: {artifact: "", footer: " (from the PR footer; partial)",
    none: " (no summary: artifact expired, no footer)", pending: ""}[.source] // "";
'

# jqlib ARGS... PROGRAM: jq with JQ_LIB before PROGRAM (the last argument).
jqlib() {
    local prog=${*: -1}
    jq "${@:1:$#-1}" "${JQ_LIB} ${prog}"
}

scratch=$(mktemp -d)
trap 'rm -rf "${scratch}"' EXIT

# ghapi ARGS...: 'gh api', turning rate limiting into a clear exit and a
# 404 or 410 into EX_NOTFOUND.
ghapi() {
    local rc=0
    gh api "$@" 2>"${scratch}/err" || rc=$?
    if test "${rc}" -ne 0; then
        check_rate_limit "${scratch}/err"
        grep -qE 'HTTP (404|410)' "${scratch}/err" && return "${EX_NOTFOUND}"
        cat "${scratch}/err" 1>&2
    fi
    return "${rc}"
}

# rest_get PATH: prints the JSON at PATH, sending the ETag of the cached
# copy so that an unchanged resource costs no quota. The ETag and the body
# are kept in one file (the ETag on its first line), replaced atomically,
# so concurrent runs can't pair one's ETag with another's body.
rest_get() {
    local path=$1 key cache_file args rc=0 status etag
    key=$(printf '%s' "${path}" | sha256sum | cut -c1-32)
    cache_file=${ETAG_DIR}/${key}
    args=(-i "${path}")
    if test -s "${cache_file}"; then
        args+=(-H "If-None-Match: $(head -n1 "${cache_file}")")
    fi
    gh api "${args[@]}" >"${scratch}/raw" 2>"${scratch}/err" || rc=$?
    split_http_response "${scratch}/raw" "${scratch}/headers" "${scratch}/body"
    status=$(awk 'NR == 1 { print $2 }' "${scratch}/headers")
    case "${status}" in
        304)
            # Still in use: see prune_caches.
            touch "${cache_file}"
            tail -n +2 "${cache_file}"
            ;;
        200)
            etag=$(awk 'tolower($0) ~ /^etag:/ { sub(/^[^:]*:[[:space:]]*/, ""); print; exit }' "${scratch}/headers")
            if test -n "${etag}"; then
                mkdir -p "${ETAG_DIR}"
                { printf '%s\n' "${etag}"; cat "${scratch}/body"; } >"${cache_file}.tmp.$$"
                mv -f "${cache_file}.tmp.$$" "${cache_file}"
            fi
            cat "${scratch}/body"
            ;;
        404|410) return "${EX_NOTFOUND}" ;;
        *)
            check_rate_limit "${scratch}/err"
            cat "${scratch}/err" 1>&2
            test "${rc}" -ne 0 || rc=1
            return "${rc}"
            ;;
    esac
}

# prune_caches: drops HTTP cache entries not used for a while, and
# decrypted transcripts once their artifact would have expired too.
prune_caches() {
    if test -d "${ETAG_DIR}"; then
        find "${ETAG_DIR}" -type f -mtime "+${ETAG_KEEP_DAYS}" -delete || warn "pruning ${ETAG_DIR} failed"
    fi
    if test -d "${TRANSCRIPT_DIR}"; then
        find "${TRANSCRIPT_DIR}" -mindepth 1 -maxdepth 1 -type d -mtime "+${TRANSCRIPT_KEEP_DAYS}" \
            -exec rm -rf {} + || warn "pruning ${TRANSCRIPT_DIR} failed"
    fi
}

# pass_ratelimit STATUS: exits with STATUS if it is EX_RATELIMIT, which a
# rate-limited call in a command substitution returns.
pass_ratelimit() {
    test "$1" -ne "${EX_RATELIMIT}" || exit "${EX_RATELIMIT}"
}

# parse_run RUN: the run id of RUN, an id or a run URL.
parse_run() {
    local id
    id=$(sed -E 's,^https://github\.com/[^/]+/[^/]+/actions/runs/([0-9]+)(/.*)?$,\1,' <<<"$1")
    [[ "${id}" =~ ^[0-9]+$ ]] || fatal "not a run id or run URL: $1"
    echo "${id}"
}

# since_date AGE: AGE (12h, 7d, 2w or a date) as an ISO 8601 UTC time.
since_date() {
    local n unit
    if [[ "$1" =~ ^([0-9]+)([hdw])$ ]]; then
        n=${BASH_REMATCH[1]}
        case "${BASH_REMATCH[2]}" in
            h) unit=hours ;;
            d) unit=days ;;
            w) unit=weeks ;;
        esac
        date -u -d "-${n} ${unit}" +%Y-%m-%dT%H:%M:%SZ
    else
        date -u -d "$1" +%Y-%m-%dT%H:%M:%SZ 2>/dev/null ||
            fatal "not an age (like 12h, 7d, 2w) or a date: $1"
    fi
}

# run_meta: the fields a record keeps of a workflow run object, on stdin.
# started_at is the start of the latest attempt.
readonly RUN_META='{id, attempt: (.run_attempt // 1), url: .html_url, title: .display_title,
    status, conclusion, created_at, started_at: .run_started_at, updated_at}'

# fetch_runs LIMIT QUERY: prints up to LIMIT runs of the workflow (the
# record's run part), newest first, one per line. QUERY is extra query
# parameters, like '&status=completed'.
fetch_runs() {
    local limit=$1 query=$2 page=1 n=0 body count rc per=${PER_PAGE}
    test "${limit}" -ge "${per}" || per=${limit}
    while test "${n}" -lt "${limit}"; do
        rc=0
        body=$(rest_get "repos/${RUNS_REPO}/actions/workflows/${RUNS_WORKFLOW}/runs?per_page=${per}&page=${page}${query}") || rc=$?
        pass_ratelimit "${rc}"
        test "${rc}" -ne "${EX_NOTFOUND}" ||
            fatal "workflow ${RUNS_WORKFLOW} not found in ${RUNS_REPO} (set BOT_RUNS_REPO or BOT_RUNS_WORKFLOW)"
        test "${rc}" -eq 0 || fatal "listing the runs of ${RUNS_WORKFLOW} failed"
        jq -c --argjson max "$((limit - n))" ".workflow_runs[:\$max][] | ${RUN_META}" <<<"${body}"
        count=$(jq '.workflow_runs | length' <<<"${body}")
        n=$((n + count))
        test "${count}" -ge "${per}" || break
        page=$((page + 1))
    done
}

# fetch_run ID: the record's run part of run ID.
fetch_run() {
    local body rc=0
    body=$(rest_get "repos/${RUNS_REPO}/actions/runs/$1") || rc=$?
    pass_ratelimit "${rc}"
    test "${rc}" -ne "${EX_NOTFOUND}" || fatal "run $1 not found in ${RUNS_REPO}"
    test "${rc}" -eq 0 || fatal "reading run $1 failed"
    jq -c "${RUN_META}" <<<"${body}"
}

# run_dir RUN_META: where a finished run attempt's files are kept. A
# rerun is a new attempt of the same run id, with its own summary.
run_dir() {
    jq -r --arg d "${STATE_DIR}/runs" '"\($d)/\(.id)/\(.attempt)"' <<<"$1"
}

# latest_artifact RUN_META NAME: the newest artifact NAME of the run's
# latest attempt (created after it started), as JSON ({id, expired,
# expires_at}), or nothing.
latest_artifact() {
    local body id started
    read -r id started < <(jq -r '"\(.id) \(.started_at // "")"' <<<"$1")
    body=$(rest_get "repos/${RUNS_REPO}/actions/runs/${id}/artifacts?per_page=${PER_PAGE}") || return
    jq -c --arg n "$2" --arg t "${started}" '[.artifacts[] | select(.name == $n and (.created_at // "") >= $t)]
        | sort_by(.created_at) | last | select(. != null) | {id, expired, expires_at}' <<<"${body}"
}

# download_artifact ID DIR: unpacks artifact ID into the empty DIR;
# returns EX_NOTFOUND if it expired meanwhile.
download_artifact() {
    local rc=0
    ghapi "repos/${RUNS_REPO}/actions/artifacts/$1/zip" >"${scratch}/artifact.zip" || rc=$?
    test "${rc}" -eq 0 || return "${rc}"
    # unzip drops absolute paths and ../ components; callers take only
    # the regular files they expect from DIR.
    unzip -q -o "${scratch}/artifact.zip" -d "$2" 2>"${scratch}/unzip-err" || {
        cat "${scratch}/unzip-err" 1>&2
        return 1
    }
}

# Checks the types of a summary's fields, so that one malformed summary
# can't break every listing: gives {summary, bad}, the summary with the
# fields of the wrong type (listed in bad) set to null.
readonly SANITIZE_JQ='
def want: {run_id: "number", run_attempt: "number", cores: "number", duration_s: "number",
    turns: "number", aic: "number", aic_budget: "number", redactions: "number",
    run_url: "string", item: "string", repo: "string", base: "string", workflow: "string",
    agent: "string", model: "string", result: "string", aic_pricing: "string",
    started_at: "string", finished_at: "string",
    tokens: "object", tools: "object", outcome: "object",
    slowest: "array", failures: "array", tests: "array", files: "array", egress_denied: "array"};
def str_or_null: type == "string" or type == "null";
def num_or_null: type == "number" or type == "null";
def deep_ok($f): if $f == "tokens" then all(.[]; num_or_null)
    elif $f == "tools" then all(.[]; type == "object" and all(.[]; num_or_null))
    elif $f == "outcome" then all(.[]; str_or_null)
    elif $f == "failures" then all(.[]; type == "object" and (.kind | type) == "string" and (.message | str_or_null))
    elif $f == "tests" then all(.[]; type == "object" and (.command | type) == "string" and (.exit_code | num_or_null) and (.duration_s | num_or_null))
    elif $f == "files" then all(.[]; type == "string")
    else true end;
. as $s
| [want | to_entries[] | .key as $f | .value as $t
   | select($s[$f] != null and (($s[$f] | type) != $t or ($s[$f] | deep_ok($f) | not))) | $f] as $bad
| {summary: (reduce $bad[] as $f ($s; .[$f] = null)), bad: $bad}'

# sanitize_summary RUN FILE: rewrites FILE with SANITIZE_JQ, warning
# about the fields it dropped.
sanitize_summary() {
    local out
    out=$(jq -c "${SANITIZE_JQ}" "$2")
    if test "$(jq '.bad | length' <<<"${out}")" -gt 0; then
        warn "run $1: ignoring fields of the wrong type in its summary: $(jq -r '.bad | join(", ")' <<<"${out}")"
    fi
    jq -c .summary <<<"${out}" >"$2"
}

# find_footer RUN_META: the footer JSON of the run attempt from the bot's
# forge PRs, or nothing; fails if the search did. Only the bot-meta
# section counts: the agent writes the rest of a PR body.
find_footer() {
    local body id attempt
    read -r id attempt < <(jq -r '"\(.id) \(.attempt)"' <<<"$1")
    body=$(ghapi -X GET search/issues -f q="${id} in:body is:pr org:${FOOTER_OWNER} author:${BOT_LOGIN}" -f per_page=10) || return
    jq -c --argjson id "${id}" --argjson att "${attempt}" --arg s "${SUMMARY_SCHEMA}" --arg bot "${BOT_LOGIN}" '
        [.items[] | select(.user.login == $bot) | .body // ""
         | match("<!-- bot-meta -->[\\s\\S]*?<!-- /bot-meta -->").string
         | scan("<!-- " + $s + " (\\{.*?\\}) -->") | .[0] | fromjson?
         | select(type == "object" and .run_id == $id and (.run_attempt // $att) == $att)]
        | last // empty' <<<"${body}"
}

# Set once a footer search was rate limited: the search API allows 30
# calls a minute, and the other runs can wait for a later listing.
footer_search_limited=false

# ensure_run_files RUN_META: makes sure run_dir holds what can be had of
# a finished run attempt: the summary artifact's files (then a file
# 'artifact'), else footer.json, else a file 'none' (retried after
# NONE_RETRY_MINUTES).
ensure_run_files() {
    local meta=$1 id status dir tmp art rc=0 f footer
    read -r id status < <(jq -r '"\(.id) \(.status)"' <<<"${meta}")
    test "${status}" = completed || return 0
    dir=$(run_dir "${meta}")
    if test -e "${dir}/artifact" || test -e "${dir}/footer.json"; then
        return 0
    fi
    if test -e "${dir}/none" && test -z "$(find "${dir}/none" -mmin "+${NONE_RETRY_MINUTES}")"; then
        return 0
    fi
    mkdir -p "$(dirname "${dir}")"
    tmp=$(mktemp -d "${dir}.tmp.XXXXXX")
    art=$(latest_artifact "${meta}" "${SUMMARY_ARTIFACT}") || rc=$?
    test "${rc}" -eq 0 || rm -rf "${tmp}"
    pass_ratelimit "${rc}"
    test "${rc}" -eq 0 || { warn "listing the artifacts of run ${id} failed"; return 0; }
    if test -n "${art}" && test "$(jq -r .expired <<<"${art}")" = false; then
        mkdir "${tmp}/zip"
        download_artifact "$(jq -r .id <<<"${art}")" "${tmp}/zip" || rc=$?
        if test "${rc}" -eq 0; then
            for f in "${SUMMARY_FILES[@]}"; do
                if test -f "${tmp}/zip/${f}" && ! test -L "${tmp}/zip/${f}"; then
                    cp "${tmp}/zip/${f}" "${tmp}/${f}"
                fi
            done
            if test -e "${tmp}/summary.json" &&
                ! jq -e --arg s "${SUMMARY_SCHEMA}" 'type == "object" and .schema == $s' "${tmp}/summary.json" >/dev/null 2>&1; then
                warn "run ${id}: summary.json is not ${SUMMARY_SCHEMA} (schema: $(jq -r '.schema? // "none"' "${tmp}/summary.json" 2>/dev/null || echo "invalid JSON")); ignoring it"
                rm "${tmp}/summary.json"
            fi
            test ! -e "${tmp}/summary.json" || sanitize_summary "${id}" "${tmp}/summary.json"
            touch "${tmp}/artifact"
        elif test "${rc}" -ne "${EX_NOTFOUND}"; then
            rm -rf "${tmp}"
            warn "downloading the ${SUMMARY_ARTIFACT} artifact of run ${id} failed"
            return 0
        fi
        rm -rf "${tmp}/zip"
    fi
    if ! test -e "${tmp}/artifact"; then
        ! ${footer_search_limited} || { rm -rf "${tmp}"; return 0; }
        rc=0
        footer=$(find_footer "${meta}") || rc=$?
        if test "${rc}" -ne 0; then
            rm -rf "${tmp}"
            if test "${rc}" -eq "${EX_RATELIMIT}"; then
                footer_search_limited=true
                warn "the footer search is rate limited; runs with expired artifacts show no summary until a later run of $(basename "$0")"
            else
                warn "searching for the footer of run ${id} failed"
            fi
            return 0
        fi
        if test -n "${footer}"; then
            printf '%s\n' "${footer}" >"${tmp}/footer.json"
            sanitize_summary "${id}" "${tmp}/footer.json"
        else
            touch "${tmp}/none"
        fi
    fi
    # Another bot-runs may have got there first; either copy is good.
    rm -rf "${dir}"
    mv -T "${tmp}" "${dir}" 2>/dev/null || rm -rf "${tmp}"
}

# record RUN_META: prints the record of a run (see JQ_LIB). Only a
# finished run's kept files count: a rerun in progress has none yet.
record() {
    local meta=$1 dir summary=null source=pending
    if test "$(jq -r .status <<<"${meta}")" = completed; then
        dir=$(run_dir "${meta}")
        source=none
        if test -e "${dir}/artifact"; then
            source=artifact
            test ! -e "${dir}/summary.json" || summary=$(jq -c . "${dir}/summary.json")
        elif test -e "${dir}/footer.json"; then
            source=footer
            summary=$(jq -c . "${dir}/footer.json")
        fi
    fi
    jq -c --argjson s "${summary}" --arg src "${source}" '{run: ., summary: $s, source: $src}' <<<"${meta}"
}

# load_record RUN_META: ensure_run_files, then record.
load_record() {
    ensure_run_files "$1"
    record "$1"
}

# --- dispatch ----------------------------------------------------------------

# require_public_repo OWNER/REPO: fails unless GitHub confirms the
# repository is public. Agent runs' logs and transcripts are public, so
# they're for public repositories only; any doubt (an error, a 404, an
# internal repository) refuses.
require_public_repo() {
    local visibility rc=0
    visibility=$(ghapi "repos/$1" --jq 'if .private == false then .visibility else "private" end') || rc=$?
    pass_ratelimit "${rc}"
    test "${rc}" -eq 0 ||
        fatal "cannot confirm that $1 is public; agent runs are for public repositories only"
    test "${visibility}" = public ||
        fatal "$1 is not public (${visibility}); agent runs are for public repositories only"
}

cmd_dispatch() {
    local item="" repo="" base=main agent=${DEFAULT_AGENT} model="" cores=4 timeout=${DEFAULT_TIMEOUT}
    local budget=${DEFAULT_BUDGET} workflow=branch brief_file="" dry_run=false json=false preamble=true
    local outputs="" max_outputs=${DEFAULT_MAX_OUTPUTS}
    local inputs body len resp rc=0
    while test $# -gt 0; do
        case "$1" in
            --item|--repo|--base|--agent|--model|--cores|--timeout|--budget|--workflow|--outputs|--max-outputs)
                test $# -ge 2 || fatal "$1 requires a value"
                local opt=${1#--}
                printf -v "${opt//-/_}" '%s' "$2"
                shift 2
                ;;
            --dry-run) dry_run=true; shift ;;
            --no-preamble) preamble=false; shift ;;
            --json) json=true; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) test "$1" = - || fatal "unknown dispatch option: $1 (see --help)"; brief_file=-; shift ;;
            *) test -z "${brief_file}" || fatal "only one BRIEF file"; brief_file=$1; shift ;;
        esac
    done
    [[ "${item}" == PVTI_* ]] || fatal "--item must be a board item id (PVTI_...)"
    [[ "${repo}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fatal "--repo must be OWNER/REPO"
    test -n "${base}" || fatal "--base must not be empty"
    jq -e --arg v "${agent}" 'index($v)' <<<"${AGENTS}" >/dev/null || fatal "--agent must be one of ${AGENTS}"
    jq -e --arg v "${cores}" 'index($v)' <<<"${CORES}" >/dev/null || fatal "--cores must be one of ${CORES}"
    if test -z "${model}" && test "${agent}" = opencode; then
        model=${DEFAULT_OPENCODE_MODEL}
    fi
    jq -e --arg v "${workflow}" 'index($v)' <<<"${WORKFLOWS}" >/dev/null || fatal "--workflow must be one of ${WORKFLOWS}"
    test -n "${outputs}" || outputs=${DEFAULT_OUTPUTS[${workflow}]}
    [[ "${outputs}" =~ ^[a-z_]+(,[a-z_]+)*$ ]] || fatal "--outputs must be output types separated by commas, not ${outputs}"
    [[ "${max_outputs}" =~ ^[1-9][0-9]?$ ]] || fatal "--max-outputs must be a number, not ${max_outputs}"
    if ! [[ "${timeout}" =~ ^[0-9]+$ ]] || test "${timeout}" -lt 1 || test "${timeout}" -gt "${MAX_TIMEOUT}"; then
        fatal "--timeout must be 1 to ${MAX_TIMEOUT} minutes (the job's cap is 360)"
    fi
    if ! [[ "${budget}" =~ ^[0-9]+(\.[0-9]+)?$ ]] || ! jq -e --argjson b "${budget}" -n '$b > 0' >/dev/null; then
        fatal "--budget must be a positive number of AIC"
    fi
    test -n "${brief_file}" || fatal "missing BRIEF (a file, or - for stdin)"
    # A file, not an argument: a long brief could pass the argument size limit.
    if test "${brief_file}" = -; then
        cat >"${scratch}/brief"
    else
        test -r "${brief_file}" || fatal "cannot read ${brief_file}"
        cp "${brief_file}" "${scratch}/brief"
    fi
    grep -q '[^[:space:]]' "${scratch}/brief" || fatal "the brief is empty"
    if ${preamble}; then
        test -r "${RUNNER_PREAMBLE}" || fatal "cannot read the runner brief ${RUNNER_PREAMBLE} (or pass --no-preamble)"
        mv "${scratch}/brief" "${scratch}/task"
        {
            cat "${RUNNER_PREAMBLE}"
            printf '\n---\n\nThis run: a `%s` run on %s at `%s`.\n\nThe task:\n\n' "${workflow}" "${repo}" "${base}"
            cat "${scratch}/task"
        } >"${scratch}/brief"
    fi
    inputs=$(jq -nc --arg item "${item}" --arg repo "${repo}" --arg base "${base}" --arg agent "${agent}" \
        --arg model "${model}" --arg cores "${cores}" --arg timeout "${timeout}" --arg budget "${budget}" \
        --arg workflow "${workflow}" --arg outputs "${outputs}" --arg max_outputs "${max_outputs}" --rawfile brief "${scratch}/brief" \
        '{item: $item, repo: $repo, base: $base, agent: $agent, model: $model, cores: $cores,
          timeout: $timeout, budget: $budget, workflow: $workflow, outputs: $outputs, max_outputs: $max_outputs,
          brief: ($brief | rtrimstr("\n"))}')
    len=$(jq 'tojson | length' <<<"${inputs}")
    test "${len}" -le "${MAX_INPUTS_LEN}" ||
        fatal "the dispatch inputs are ${len} characters, over GitHub's ${MAX_INPUTS_LEN}; shorten the brief"
    body=$(jq -c --arg ref "${RUNS_REF}" '{ref: $ref, inputs: ., return_run_details: true}' <<<"${inputs}")
    if ${dry_run}; then
        echo "POST repos/${RUNS_REPO}/actions/workflows/${RUNS_WORKFLOW}/dispatches"
        jq . <<<"${body}"
        return 0
    fi
    # After the dry run, which makes no API calls; the workflow checks too.
    require_public_repo "${repo}"
    resp=$(ghapi -X POST "repos/${RUNS_REPO}/actions/workflows/${RUNS_WORKFLOW}/dispatches" --input - <<<"${body}") || rc=$?
    pass_ratelimit "${rc}"
    test "${rc}" -eq 0 || fatal "dispatching ${RUNS_WORKFLOW} in ${RUNS_REPO} failed"
    # Without return_run_details support the answer is an empty 204: the
    # run exists, but its id is unknown, so don't dispatch again.
    jq -e '.workflow_run_id? | type == "number"' <<<"${resp:-null}" >/dev/null 2>&1 ||
        fatal "the run was dispatched, but GitHub returned no run id; find it with '$(basename "$0") list --item ${item}' instead of dispatching again"
    if ${json}; then
        jq '{run_id: .workflow_run_id, url: .html_url, api_url: .run_url}' <<<"${resp}"
    else
        jq -r '"Dispatched run \(.workflow_run_id): \(.html_url)"' <<<"${resp}"
    fi
    local url
    url=$(jq -r .html_url <<<"${resp}")
    # The run is the source of truth for the item from now on: reconcile
    # follows it from this field.
    rc=0
    "${BOT_BOARD}" field-ensure "${RUN_FIELD}" || rc=$?
    test "${rc}" -ne 0 ||
        "${BOT_BOARD}" set "${item}" --status "${RUN_STATUS}" --field "${RUN_FIELD}" "${url}" \
            --news "Dispatched devspace agent run ${url} (${agent}, ${cores} cores)" >/dev/null || rc=$?
    pass_ratelimit "${rc}"
    test "${rc}" -eq 0 ||
        fatal "the run was dispatched, but recording it on the board failed; run: bot-board set ${item} --status '${RUN_STATUS}' --field ${RUN_FIELD} ${url}"
    # Its budget, for pacing (the run's own spend cap is --budget AIC).
    "${BOT_PACE}" budget "${item}" >/dev/null ||
        warn "setting the token budget of ${item} failed; run: bot-pace budget ${item}"
    node "$(dirname "$(readlink -f "$0")")/../lib/heartbeat-register.js" \
        "${BOT_BOARD}" "${item}" "run-$(jq -r '.workflow_run_id // "unknown"' <<<"${resp}")" \
        "${BOT_RUNS_HEARTBEAT:-$(dirname "$(readlink -f "$0")")/bot-heartbeat}" \
        "$(jq -nc --arg e "${agent}" --arg m "${model}" '{location: "remote", engine: $e} + (if $m == "" then {} else {model: $m} end)')" ||
        warn "the run was dispatched, but registering its heartbeat failed; publish the workers with bot-heartbeat publish"
}

# --- watch -------------------------------------------------------------------

cmd_watch() {
    require_cmd node "install Node.js 22 or newer"
    require_cmd flock "install util-linux"
    local state=${BOT_RUNS_WATCH_STATE:-${STATE_DIR}/watch.json} arg previous=""
    for arg in "$@"; do
        test "${previous}" != --state-file || state=${arg}
        previous=${arg}
    done
    mkdir -p "$(dirname "${state}")"
    local fd
    # Keep the inode: unlinking a lock file could let simultaneous callers
    # acquire different locks. flock is released by the kernel on exit/crash.
    exec {fd}>"${state}.lock"
    flock -n "${fd}" || fatal "another bot-runs watch holds ${state}.lock"
    BOT_RUNS_REPO=${RUNS_REPO} BOT_RUNS_WORKFLOW=${RUNS_WORKFLOW} \
        BOT_RUNS_BOT_BOARD=${BOT_BOARD} BOT_RUNS_WATCH_STATE=${state} \
        node "$(dirname "$(readlink -f "$0")")/../lib/run-watch.js" --locked-watch "$@"
}

# --- reconcile ---------------------------------------------------------------

heartbeat_done() {
    "${BOT_RUNS_HEARTBEAT:-$(dirname "$(readlink -f "$0")")/bot-heartbeat}" "done" "run-$1" ||
        warn "heartbeat cleanup for run-$1 failed; retry bot-heartbeat done run-$1"
}

# reconcile_one ITEM_JSON: prints the reconcile entry of a board item
# with a Run, {item, title, status, run, result, set: [bot-board set
# arguments] or null, line}. Fails only when the run can't be read.
reconcile_one() {
    local item=$1 id title status run run_id meta rec flat result patch url why news set=null recovery_board fresh_meta attempt
    read -r id status < <(jq -r '"\(.id) \(.status // "")"' <<<"${item}")
    title=$(jq -r '.title // ""' <<<"${item}")
    run=$(jq -r .run <<<"${item}")
    entry() { # entry RESULT LINE
        jq -nc --arg item "${id}" --arg title "${title}" --arg status "${status}" --arg run "${run}" \
            --arg result "$1" --argjson set "${set}" --arg line "$2" \
            '{item: $item, title: $title, status: $status, run: $run, result: (if $result == "" then null else $result end),
              set: $set, line: "\($title) [\($status)] \($item): \($line)"}'
    }
    # Only a run of RUNS_REPO: parse_run takes any repository's run URL.
    if [[ "${run}" != "https://github.com/${RUNS_REPO}/actions/runs/"* ]] ||
        ! run_id=$(parse_run "${run}" 2>/dev/null); then
        entry "" "${RUN_FIELD} is not a run URL of ${RUNS_REPO}: ${run}"
        return 0
    fi
    meta=$(fetch_run "${run_id}") || return
    # Keep the watch's diagnostic if cancellation completed between sweeps or
    # its board update failed. Cancellation needs no summary artifact.
    if test "$(jq -r '.status + "/" + (.conclusion // "")' <<<"${meta}")" = completed/cancelled; then
        why=$(node "$(dirname "$(readlink -f "$0")")/../lib/run-watch.js" reason \
            "${BOT_RUNS_WATCH_STATE:-${STATE_DIR}/watch.json}" "${RUNS_REPO}" "${run_id}" \
            "$(jq -r .attempt <<<"${meta}")" "${id}")
        if test -n "${why}"; then
            attempt=$(jq -r .attempt <<<"${meta}")
            recovery_board=$3
            fresh_meta=${meta}
            if test "${2:-report}" = apply; then
                recovery_board=$("${BOT_BOARD}" --refresh list --json) || return
                fresh_meta=$(fetch_run "${run_id}") || return
            fi
            if ! jq -nc --argjson board "${recovery_board}" --argjson item "${item}" --argjson run "${fresh_meta}" \
                '{board: $board, item: $item, run: $run}' | node "$(dirname "$(readlink -f "$0")")/../lib/run-watch.js" recovery-check "${RUNS_REPO}" "${attempt}"; then
                entry cancelled "watch recovery refused: ownership or run attempt changed"
                return 0
            fi
            test "${2:-report}" != apply || heartbeat_done "${run_id}"
            set=$(jq -nc --arg why "${why}" '["--status", "Todo", "--field", "Run", "", "--why", $why]')
            entry cancelled "${why}"
            return 0
        fi
    fi
    # Completion ends activity even while artifacts or operator review wait.
    if test "${2:-report}" = apply && test "$(jq -r .status <<<"${meta}")" = completed; then
        heartbeat_done "${run_id}"
    fi
    rec=$(load_record "${meta}") || return
    flat=$(jqlib -c flat <<<"${rec}")
    url=$(jq -r .url <<<"${flat}")
    if test "$(jq -r .status <<<"${flat}")" != completed; then
        entry "" "run ${run_id} is $(jq -r .status <<<"${flat}")"
        return 0
    fi
    # ensure_run_files keeps nothing when reading the run's files failed
    # (it warned): without its summary a patch would look like no change.
    if ! test -e "$(run_dir "${meta}")"; then
        warn "the files of run ${run_id} could not be read"
        return 1
    fi
    result=$(jq -r '.result // "unknown"' <<<"${flat}")
    patch=$(jq -r '.summary.patch.bytes // 0 | numbers | select(. > 0)' <<<"${rec}")
    if test "${status}" != "${RUN_STATUS}"; then
        set=$(jq -nc --arg f "${RUN_FIELD}" '["--field", $f, ""]')
        entry "${result}" "run ${run_id} ended (${result}) after the item left ${RUN_STATUS}: clear ${RUN_FIELD}"
        return 0
    fi
    if test "${result}" = success && test -n "${patch}"; then
        why="Agent run ${url} succeeded with a patch (${patch} bytes): ready for bot-runs apply ${run_id} --slug SLUG --message FILE, then bot-pr fork-pr"
        news="Devspace agent run ${run_id} succeeded; patch ready"
        set=$(jq -nc --arg s "${PATCH_STATUS}" --arg f "${RUN_FIELD}" --arg why "${why}" --arg news "${news}" \
            '["--status", $s, "--field", $f, "", "--why", $why, "--news", $news]')
        entry "${result}" "run ${run_id} succeeded, patch ready: set ${PATCH_STATUS}"
        return 0
    fi
    if test "${result}" = success; then
        why="Agent run ${url} succeeded without a change"
    else
        why="Agent run ${url} ended: ${result}"
    fi
    # The run's own account of why, if it gave one.
    why+=$(jq -r '(.summary.outcome.why // .summary.failures[0]?.message // .summary.patch.error? // "") | select(. != "") | "; " + .' <<<"${rec}")
    why=${why:0:${WHY_MAX}}
    news="Devspace agent run ${run_id} ended (${result}): ${url}"
    set=$(jq -nc --arg s "${RETRY_STATUS}" --arg f "${RUN_FIELD}" --arg why "${why}" --arg news "${news}" \
        '["--status", $s, "--field", $f, "", "--why", $why, "--news", $news]')
    entry "${result}" "run ${run_id} ended (${result}): set ${RETRY_STATUS}"
}

cmd_reconcile() {
    local mode=report board_file="" json=false board items item rc entry entries args applied
    while test $# -gt 0; do
        case "$1" in
            --apply) mode=apply; shift ;;
            --dry-run) mode=dry-run; shift ;;
            --board-file) test $# -ge 2 || fatal "--board-file requires a file"; board_file=$2; shift 2 ;;
            --json) json=true; shift ;;
            -h|--help) usage; exit 0 ;;
            *) fatal "unknown reconcile argument: $1 (see --help)" ;;
        esac
    done
    if test -n "${board_file}"; then
        board=$(jq -ce 'arrays' "${board_file}") || fatal "--board-file ${board_file} is not a 'bot-board list --json' array"
    else
        rc=0
        # A stale listing could move an item back.
        board=$("${BOT_BOARD}" --refresh list --json) || rc=$?
        pass_ratelimit "${rc}"
        test "${rc}" -eq 0 || fatal "listing the board failed"
    fi
    items=$(jq -c --arg f "${RUN_FIELD,,}" '.[] | select((.[$f] // "") != "") | .run = .[$f]' <<<"${board}")
    entries=${scratch}/reconcile
    : >"${entries}"
    rc=0
    while IFS= read -r item; do
        test -n "${item}" || continue
        local one=0
        entry=$(reconcile_one "${item}" "${mode}" "${board}") || one=$?
        pass_ratelimit "${one}"
        if test "${one}" -ne 0; then
            warn "reading the run of item $(jq -r .id <<<"${item}") failed; a later reconcile retries"
            rc=1
            continue
        fi
        if test "${mode}" != report && jq -e '.set != null' <<<"${entry}" >/dev/null; then
            mapfile -t args < <(jq -r '.set[]' <<<"${entry}")
            if test "${mode}" = dry-run; then
                applied=would-apply
                printf 'bot-board set %s%s\n' "$(jq -r .item <<<"${entry}")" "$(printf ' %q' "${args[@]}")" 1>&2
            elif "${BOT_BOARD}" set "$(jq -r .item <<<"${entry}")" "${args[@]}" >/dev/null; then
                applied=applied
            else
                one=$?
                pass_ratelimit "${one}"
                applied=failed
                rc=1
            fi
            entry=$(jq -c --arg a "${applied}" '.applied = $a | .line += {applied: " (done)", "would-apply": " (--apply would do it)", failed: " (FAILED)"}[$a]' <<<"${entry}")
        elif jq -e '.set != null' <<<"${entry}" >/dev/null; then
            entry=$(jq -c '.line += " (with --apply)"' <<<"${entry}")
        fi
        printf '%s\n' "${entry}" >>"${entries}"
    done <<<"${items}"
    if ${json}; then
        jq -s . "${entries}"
    else
        jq -r '.line' "${entries}"
    fi
    return "${rc}"
}

# --- list --------------------------------------------------------------------

cmd_list() {
    local item="" since="" status="" limit=${DEFAULT_LIST_LIMIT} json=false query="" records meta
    while test $# -gt 0; do
        case "$1" in
            --item) test $# -ge 2 || fatal "--item requires a value"; item=$2; shift 2 ;;
            --since) test $# -ge 2 || fatal "--since requires a value"; since=$2; shift 2 ;;
            --status) test $# -ge 2 || fatal "--status requires a value"; status=$2; shift 2 ;;
            --limit) test $# -ge 2 || fatal "--limit requires a value"; limit=$2; shift 2 ;;
            --json) json=true; shift ;;
            -h|--help) usage; exit 0 ;;
            *) fatal "unknown list argument: $1 (see --help)" ;;
        esac
    done
    [[ "${limit}" =~ ^[1-9][0-9]*$ ]] || fatal "--limit must be a positive number"
    [[ -z "${status}" || "${status}" =~ ^[a-z_]+$ ]] || fatal "not an Actions status or conclusion: ${status}"
    test -z "${status}" || query+="&status=${status}"
    test -z "${since}" || query+="&created=%3E%3D$(since_date "${since}")"
    # Not a process substitution: its failure must end the command. With
    # --item, older runs are read until LIMIT of that item's are found.
    fetch_runs "$(test -z "${item}" && echo "${limit}" || echo "${ITEM_SCAN_MAX}")" "${query}" >"${scratch}/runs"
    records=${scratch}/records
    : >"${records}"
    local found=0
    while IFS= read -r meta && test "${found}" -lt "${limit}"; do
        # The run name has the item: skip other items' runs unread.
        if test -n "${item}" &&
            ! jqlib -e --arg i "${item}" '{run: .} | title_parts | .item == null or .item == $i' <<<"${meta}" >/dev/null; then
            continue
        fi
        load_record "${meta}" >>"${records}"
        if test -z "${item}" || tail -n1 "${records}" | jqlib -e --arg i "${item}" 'flat | .item == $i' >/dev/null; then
            found=$((found + 1))
        fi
    done <"${scratch}/runs"
    if ${json}; then
        jqlib -s --arg i "${item}" 'map(flat) | map(select($i == "" or .item == $i))' <"${records}"
        return 0
    fi
    jqlib -rs --arg i "${item}" '(["RUN", "ITEM", "REPO", "AGENT", "RESULT", "DURATION", "TOKENS", "AIC", "OUTCOME"] | @tsv),
        (map(flat) | map(select($i == "" or .item == $i))[]
         | [.run_id, (.item | orblank), (.repo | orblank), agent_model,
            (.result // .status | orblank) + ({footer: "*", none: "?"}[.source] // ""),
            (.duration_s | fmt_dur), fmt_tokens, (.aic | fmt_aic), fmt_outcome] | @tsv)' <"${records}" |
        column -t -s $'\t'
    if jq -se 'any(.source == "footer")' "${records}" >/dev/null; then
        echo "* from the PR footer: the ${SUMMARY_ARTIFACT} artifact expired"
    fi
    if jq -se 'any(.source == "none")' "${records}" >/dev/null; then
        echo "? no summary (artifact expired or never uploaded, no footer): from the run itself"
    fi
}

# --- show, log, transcript ---------------------------------------------------

# one_run_args NAME ARGS...: parses 'RUN [--json]' into run_id and json.
one_run_args() {
    local name=$1
    shift
    run_id="" json=false
    while test $# -gt 0; do
        case "$1" in
            --json) json=true; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) fatal "unknown ${name} option: $1 (see --help)" ;;
            *) test -z "${run_id}" || fatal "${name} takes one RUN"; run_id=$(parse_run "$1"); shift ;;
        esac
    done
    test -n "${run_id}" || fatal "${name} requires a RUN"
}

cmd_show() {
    local run_id json meta rec dir step_summary=""
    one_run_args show "$@"
    meta=$(fetch_run "${run_id}")
    rec=$(load_record "${meta}")
    dir=$(run_dir "${meta}")
    test ! -f "${dir}/summary.md" || step_summary=$(<"${dir}/summary.md")
    if ${json}; then
        jqlib --arg md "${step_summary}" '. + {flat: flat, step_summary: (if $md == "" then null else $md end)}' <<<"${rec}"
        return 0
    fi
    jqlib -r 'flat as $f | .summary as $s | "Run \($f.run_id): \($f.url)",
        "Status:   \($f.status)\(if $f.conclusion then " (\($f.conclusion))" else "" end), created \($f.created_at)",
        "Item:     \($f.item | orblank)",
        "Repo:     \($f.repo | orblank)\(if $f.base then " (base \($f.base))" else "" end)\(if $f.workflow then ", workflow \($f.workflow)" else "" end)",
        "Agent:    \($f | agent_model)\(if $f.cores then ", \($f.cores) cores" else "" end)",
        "Result:   \($f.result | orblank), \($f.duration_s | fmt_dur)\(if $f.turns then ", \($f.turns) turns" else "" end)",
        "Tokens:   \($f | fmt_tokens) in/out\(if ($f.tokens.cache_read // 0) > 0 then ", \($f.tokens.cache_read | fmt_num) cache read" else "" end)",
        "AIC:      \($f.aic | fmt_aic)\(if $f.aic_budget then " of \($f.aic_budget | fmt_aic)" else "" end)\(if $f.aic_pricing then " (\($f.aic_pricing))" else "" end)",
        "Outcome:  \($f | fmt_outcome)",
        "Summary:  \($f.source)\(source_note)"' <<<"${rec}"
    if test -n "${step_summary}"; then
        printf '\n%s\n' "${step_summary}"
    elif test "$(jq -r .source <<<"${rec}")" = artifact && test "$(jq -r '.summary != null' <<<"${rec}")" = true; then
        # No summary.md: the essentials from summary.json.
        jqlib -r '.summary | "",
            "Tools: \(.tools // {} | to_entries | map("\(.key) \(.value.calls)\(if (.value.errors // 0) > 0 then " (\(.value.errors) errors)" else "" end)") | join(", ") | orblank)",
            (.failures // [] | .[] | "Failure: \(.kind): \(.message)")' <<<"${rec}"
    fi
    jqlib -r '.summary | fmt_tests' <<<"${rec}"
}

# condensed_from_job_log RUN: the condensed transcript from the jobs'
# logs, or nothing.
condensed_from_job_log() {
    local job jobs rc=0
    jobs=$(ghapi "repos/${RUNS_REPO}/actions/runs/$1/jobs?per_page=${PER_PAGE}" --jq '.jobs[].id') || rc=$?
    pass_ratelimit "${rc}"
    test "${rc}" -ne "${EX_NOTFOUND}" || return 0
    test "${rc}" -eq 0 || fatal "listing the jobs of run $1 failed"
    for job in ${jobs}; do
        rc=0
        ghapi "repos/${RUNS_REPO}/actions/jobs/${job}/logs" >"${scratch}/job.log" || rc=$?
        # A job's log can be gone while the run's is not.
        test "${rc}" -ne "${EX_NOTFOUND}" || continue
        test "${rc}" -eq 0 || fatal "reading the log of job ${job} failed"
        awk -v group="##[group]${LOG_GROUP}" '
            { sub(/^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z /, "") }
            $0 == group { inside = 1; next }
            inside && $0 == "##[endgroup]" { inside = 0; next }
            inside { print }' "${scratch}/job.log"
    done
}

cmd_log() {
    local run_id json meta dir source=artifact
    one_run_args log "$@"
    meta=$(fetch_run "${run_id}")
    ensure_run_files "${meta}"
    dir=$(run_dir "${meta}")
    if ! test -f "${dir}/condensed.log"; then
        condensed_from_job_log "${run_id}" >"${scratch}/condensed.log"
        test -s "${scratch}/condensed.log" ||
            fatal "no condensed log for run ${run_id}: its ${SUMMARY_ARTIFACT} artifact and job logs are gone (or it has not started yet)"
        source="job-log"
        # A finished run's log doesn't change: keep it.
        if test "$(jq -r .status <<<"${meta}")" = completed && test -d "${dir}"; then
            cp "${scratch}/condensed.log" "${dir}/condensed.log"
        fi
        dir=${scratch}
    fi
    if ${json}; then
        jq -Rn --argjson id "${run_id}" --arg src "${source}" '{run_id: $id, source: $src, lines: [inputs]}' <"${dir}/condensed.log"
    else
        cat "${dir}/condensed.log"
    fi
}

# decrypt_transcript IN OUT: decrypts the age-encrypted IN into OUT.
# TODO: who the recipients are and where the identity lives is still
# open (plan question 3); until that's settled, it takes the identity
# file from BOT_RUNS_AGE_IDENTITY.
decrypt_transcript() {
    test -n "${BOT_RUNS_AGE_IDENTITY:-}" ||
        fatal "the transcript is encrypted; set BOT_RUNS_AGE_IDENTITY to your age identity file (see docs/devspace-agent-runs.md)"
    require_cmd age "install age to decrypt transcripts"
    age --decrypt -i "${BOT_RUNS_AGE_IDENTITY}" -o "$2" "$1" || fatal "decrypting the transcript failed"
}

cmd_transcript() {
    local run_id="" json=false dir="" force=false art rc=0 tarball bad meta tmp
    while test $# -gt 0; do
        case "$1" in
            --json) json=true; shift ;;
            --force) force=true; shift ;;
            --dir) test $# -ge 2 || fatal "--dir requires a directory"; dir=$2; shift 2 ;;
            -h|--help) usage; exit 0 ;;
            -*) fatal "unknown transcript option: $1 (see --help)" ;;
            *) test -z "${run_id}" || fatal "transcript takes one RUN"; run_id=$(parse_run "$1"); shift ;;
        esac
    done
    test -n "${run_id}" || fatal "transcript requires a RUN"
    meta=$(fetch_run "${run_id}")
    test -n "${dir}" || dir=$(jq -r --arg d "${TRANSCRIPT_DIR}" '"\($d)/\(.id)-\(.attempt)"' <<<"${meta}")
    dir=${dir%/}
    # Only ever replace a transcript unpacked here, or an empty directory.
    if test -e "${dir}" && ! test -e "${dir}/.complete" && test -n "$(ls -A "${dir}" 2>/dev/null || echo x)"; then
        fatal "${dir} exists and doesn't hold an unpacked transcript; choose another --dir"
    fi
    if ${force} || ! test -e "${dir}/.complete"; then
        art=$(latest_artifact "${meta}" "${TRANSCRIPT_ARTIFACT}") || rc=$?
        pass_ratelimit "${rc}"
        test "${rc}" -eq 0 || fatal "listing the artifacts of run ${run_id} failed"
        test -n "${art}" || fatal "run ${run_id} has no ${TRANSCRIPT_ARTIFACT} artifact (still running, or it failed before uploading)"
        test "$(jq -r .expired <<<"${art}")" = false ||
            fatal "the transcript of run ${run_id} expired on $(jq -r '.expires_at // "?"' <<<"${art}") (transcripts are kept 30 days); '$(basename "$0") show ${run_id}' has what's left"
        mkdir "${scratch}/transcript"
        download_artifact "$(jq -r .id <<<"${art}")" "${scratch}/transcript" || rc=$?
        test "${rc}" -ne "${EX_NOTFOUND}" || fatal "the transcript of run ${run_id} expired just now"
        test "${rc}" -eq 0 || fatal "downloading the transcript of run ${run_id} failed"
        tarball=${scratch}/transcript/${TRANSCRIPT_NAME}
        if test -f "${tarball}.age" && ! test -L "${tarball}.age"; then
            decrypt_transcript "${tarball}.age" "${scratch}/${TRANSCRIPT_NAME}"
            tarball=${scratch}/${TRANSCRIPT_NAME}
        elif ! test -f "${tarball}" || test -L "${tarball}"; then
            fatal "the ${TRANSCRIPT_ARTIFACT} artifact of run ${run_id} has neither ${TRANSCRIPT_NAME}.age nor ${TRANSCRIPT_NAME}"
        fi
        # Only plain files and directories: a link could point outside DIR.
        # awk reads to the end: exiting early would kill tar, and make a
        # bad entry look like a bad archive.
        bad=$(tar --zstd -tvf "${tarball}" |
            awk 'substr($1, 1, 1) != "-" && substr($1, 1, 1) != "d" && n++ < 3') ||
            fatal "the transcript of run ${run_id} is not a zstd tar"
        test -z "${bad}" || fatal "the transcript of run ${run_id} holds entries other than files and directories: ${bad}"
        mkdir -p "$(dirname "${dir}")"
        tmp=$(mktemp -d "${dir}.tmp.XXXXXX")
        chmod 0700 "${tmp}"
        # --no-overwrite-dir: the archive's root entry keeps the mode.
        tar --zstd -xf "${tarball}" -C "${tmp}" --no-same-owner --no-same-permissions --no-overwrite-dir ||
            { rm -rf "${tmp}"; fatal "unpacking the transcript of run ${run_id} failed"; }
        touch "${tmp}/.complete"
        rm -rf "${dir}"
        mv -T "${tmp}" "${dir}"
    fi
    if ${json}; then
        (cd "${dir}" && find . -type f ! -name .complete -printf '%P\n' | sort) |
            jq -Rn --argjson id "${run_id}" --arg d "${dir}" '{run_id: $id, dir: $d, files: [inputs]}'
    else
        echo "Transcript of run ${run_id} in ${dir}:"
        (cd "${dir}" && find . -type f ! -name .complete -printf '  %P\n' | sort)
    fi
}

# --- diff ---------------------------------------------------------------------

# Compares records A and B ($a, $b).
readonly DIFF_JQ='
def delta($x; $y): {a: $x, b: $y}
    + if ($x | type) == "number" and ($y | type) == "number"
      then {delta: ($y - $x), pct: (if $x != 0 then (($y - $x) / $x * 1000 | round) / 10 else null end)}
      else {delta: null, pct: null} end;
def fkey: "\(.kind): \(.message)";
($a | flat) as $fa | ($b | flat) as $fb | ($a.summary // {}) as $sa | ($b.summary // {}) as $sb | {
    a: $fa, b: $fb,
    result: {a: $fa.result, b: $fb.result, changed: ($fa.result != $fb.result)},
    metrics: {
        duration_s: delta($fa.duration_s; $fb.duration_s),
        turns: delta($fa.turns; $fb.turns),
        tokens_input: delta($fa.tokens.input; $fb.tokens.input),
        tokens_output: delta($fa.tokens.output; $fb.tokens.output),
        tokens_cache_read: delta($fa.tokens.cache_read; $fb.tokens.cache_read),
        tokens_cache_write: delta($fa.tokens.cache_write; $fb.tokens.cache_write),
        aic: delta($fa.aic; $fb.aic)},
    tools: (if $sa.tools and $sb.tools then
        [($sa.tools | keys[]), ($sb.tools | keys[])] | unique
        | map(. as $k | {tool: $k,
            a_calls: ($sa.tools[$k].calls // 0), b_calls: ($sb.tools[$k].calls // 0),
            a_errors: ($sa.tools[$k].errors // 0), b_errors: ($sb.tools[$k].errors // 0)}
          | .delta_calls = .b_calls - .a_calls | .delta_errors = .b_errors - .a_errors)
        else null end),
    failures: (if $sa.failures and $sb.failures then
        ($sa.failures | map(fkey)) as $x | ($sb.failures | map(fkey)) as $y
        | {only_a: ($x - $y), only_b: ($y - $x)} else null end),
    files: (if $sa.files and $sb.files then
        {only_a: ($sa.files - $sb.files), only_b: ($sb.files - $sa.files),
         common: ($sa.files - ($sa.files - $sb.files) | length)} else null end),
    tests: (if $sa.tests and $sb.tests then
        ($sa.tests | map({key: .command, value: .exit_code}) | from_entries) as $x
        | ($sb.tests | map({key: .command, value: .exit_code}) | from_entries) as $y
        | [($x | keys[]), ($y | keys[])] | unique
        | map({command: ., a_exit: $x[.], b_exit: $y[.]}) | map(select(.a_exit != .b_exit))
        else null end),
    outcome: {a: $fa.outcome, b: $fb.outcome}}'

readonly DIFF_TEXT_JQ='
def row($label; $name; f): .metrics[$name] as $m
    | [$label, ($m.a | f), ($m.b | f), (($m.delta | signed(f)) + ($m.pct | fmt_pct))] | @tsv;
def missing($what): "\($what): not known for both runs (a summary is missing or partial)";
"Run A \(.a.run_id): \(.a | agent_model), \(.a.result | orblank)\(.a | source_note)",
"Run B \(.b.run_id): \(.b | agent_model), \(.b.result | orblank)\(.b | source_note)",
"",
(["", "A", "B", "DELTA"] | @tsv),
row("duration"; "duration_s"; fmt_dur), row("turns"; "turns"; fmt_num),
row("tokens in"; "tokens_input"; fmt_num), row("tokens out"; "tokens_output"; fmt_num),
row("cache read"; "tokens_cache_read"; fmt_num), row("cache write"; "tokens_cache_write"; fmt_num),
row("AIC"; "aic"; fmt_aic),
"",
(if .tools == null then missing("Tools")
 else (.tools | map(select(.delta_calls != 0 or .delta_errors != 0))) as $t
  | if $t == [] then "Tools: the same calls"
    else "Tools (calls/errors, A -> B):",
      ($t[] | "  \(.tool)\t\(.a_calls)/\(.a_errors) -> \(.b_calls)/\(.b_errors)\t\(.delta_calls | signed(tostring)) calls")
    end end),
(if .failures == null then missing("Failures")
 else (.failures.only_a[] | "Failure only in A: \(.)"), (.failures.only_b[] | "Failure only in B: \(.)") end),
(if .files == null then missing("Files")
 else "Files: \(.files.common) in both, \(.files.only_a | length) only in A, \(.files.only_b | length) only in B",
   (.files.only_a[] | "  A only: \(.)"), (.files.only_b[] | "  B only: \(.)") end),
(if .tests == null then missing("Tests")
 else (.tests[] | "Test \(.command): exit \(.a_exit // "-") -> \(.b_exit // "-")") end),
"Outcome: \(.a | fmt_outcome) -> \(.b | fmt_outcome)"'

cmd_diff() {
    local runs=() json=false a b out
    while test $# -gt 0; do
        case "$1" in
            --json) json=true; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) fatal "unknown diff option: $1 (see --help)" ;;
            *) runs+=("$(parse_run "$1")"); shift ;;
        esac
    done
    test "${#runs[@]}" -eq 2 || fatal "diff takes two RUNs"
    a=$(fetch_run "${runs[0]}")
    a=$(load_record "${a}")
    b=$(fetch_run "${runs[1]}")
    b=$(load_record "${b}")
    out=$(jqlib -n --argjson a "${a}" --argjson b "${b}" "${DIFF_JQ}")
    if ${json}; then
        jq . <<<"${out}"
    else
        # The metrics table is aligned; the rest is prose.
        jqlib -r "${DIFF_TEXT_JQ}" <<<"${out}" | awk -F'\t' '
            NF == 4 { printf "%-20s %-10s %-10s %s\n", $1, $2, $3, $4; next }
            { gsub(/\t/, "  "); print }'
    fi
}

# --- stats --------------------------------------------------------------------

# Aggregates an array of records; $by is a flat field, or "".
readonly STATS_JQ='
def mean: map(select(type == "number")) as $v | if $v == [] then null else ($v | add) / ($v | length) end;
def total: map(select(type == "number")) as $v | if $v == [] then null else $v | add end;
def failed: IN("failure", "timeout", "budget");
def group_stats: map(. as $r | flat + {failures: ($r.summary.failures // null)}) as $f
    | ($f | map(select(.result == "success"))) as $ok
    | ($f | map(select(.result | failed))) as $bad
    | {runs: ($f | length),
       with_summary: ($f | map(select(.source == "artifact" or .source == "footer")) | length),
       success: ($ok | length), failed: ($bad | length),
       other: (($f | length) - ($ok | length) - ($bad | length)),
       success_rate: (if ($ok | length) + ($bad | length) > 0
           then (($ok | length) / (($ok | length) + ($bad | length)) * 1000 | round) / 10 else null end),
       failure_kinds: ([$f[].failures // [] | .[].kind] | group_by(.) | map({key: .[0], value: length}) | from_entries),
       duration_s: {total: ($f | map(.duration_s) | total), mean: ($f | map(.duration_s) | mean)},
       tokens: {input: ($f | map(.tokens.input) | total), output: ($f | map(.tokens.output) | total),
           cache_read: ($f | map(.tokens.cache_read) | total), cache_write: ($f | map(.tokens.cache_write) | total)},
       aic: {total: ($f | map(.aic) | total), mean: ($f | map(.aic) | mean),
           known: ($f | map(select(.aic | type == "number")) | length)},
       divergence: (($bad | map(io_tokens) | mean) as $x | ($ok | map(io_tokens) | mean) as $y
           | {failed_mean_tokens: $x, success_mean_tokens: $y,
              flagged: ($x != null and $y != null and $x > $y)})};
{total: group_stats,
 groups: (if $by == "" then null
     else group_by(flat | .[$by] // "-" | tostring) | map({key: (.[0] | flat | .[$by] // "-" | tostring)} + group_stats) end)}'

readonly STATS_TABLE_JQ='
def line($k): [$k, .runs, .success, .failed, .other, (if .success_rate then "\(.success_rate)%" else "-" end),
    (.duration_s.mean | fmt_dur), "\(.tokens.input | fmt_num)/\(.tokens.output | fmt_num)",
    (.aic.total | fmt_aic), (.aic.mean | fmt_aic)] | @tsv;
(["", "RUNS", "OK", "FAILED", "OTHER", "SUCCESS", "MEAN TIME", "TOKENS IN/OUT", "AIC", "AIC/RUN"] | @tsv),
(.total | line("all")),
(.groups // [] | .[] | line(.key))'

readonly STATS_NOTES_JQ='
(.total.failure_kinds | if . == {} then "Failures by kind: none recorded"
  else "Failures by kind: \(to_entries | sort_by(-.value) | map("\(.key) \(.value)") | join(", "))" end),
(.total.divergence | if .flagged then "Resource divergence: failed runs used \(.failed_mean_tokens | fmt_num) tokens on average, successful ones \(.success_mean_tokens | fmt_num)" else empty end),
"AIC known for \(.total.aic.known) of \(.total.runs) runs"'

cmd_stats() {
    local since=${DEFAULT_STATS_SINCE} limit=${DEFAULT_STATS_LIMIT} by="" json=false since_iso records meta out
    while test $# -gt 0; do
        case "$1" in
            --since) test $# -ge 2 || fatal "--since requires a value"; since=$2; shift 2 ;;
            --limit) test $# -ge 2 || fatal "--limit requires a value"; limit=$2; shift 2 ;;
            --by) test $# -ge 2 || fatal "--by requires a field"; by=$2; shift 2 ;;
            --json) json=true; shift ;;
            -h|--help) usage; exit 0 ;;
            *) fatal "unknown stats argument: $1 (see --help)" ;;
        esac
    done
    [[ "${limit}" =~ ^[1-9][0-9]*$ ]] || fatal "--limit must be a positive number"
    case "${by}" in
        ""|agent|model|repo|item|result) ;;
        *) fatal "--by must be agent, model, repo, item or result" ;;
    esac
    since_iso=$(since_date "${since}")
    fetch_runs "${limit}" "&status=completed&created=%3E%3D${since_iso}" >"${scratch}/runs"
    records=${scratch}/records
    : >"${records}"
    while IFS= read -r meta; do
        load_record "${meta}" >>"${records}"
    done <"${scratch}/runs"
    out=$(jqlib -s --arg by "${by}" "${STATS_JQ}" <"${records}")
    if ${json}; then
        jq --arg since "${since_iso}" --arg by "${by}" '{since: $since, by: (if $by == "" then null else $by end)} + .' <<<"${out}"
    else
        jq -r --arg repo "${RUNS_REPO}" --arg wf "${RUNS_WORKFLOW}" --arg since "${since_iso}" \
            '"Agent runs of \($repo) \($wf) since \($since): \(.total.runs) finished, \(.total.with_summary) with a summary\n"' <<<"${out}"
        jqlib -r "${STATS_TABLE_JQ}" <<<"${out}" | column -t -s $'\t'
        echo
        jqlib -r "${STATS_NOTES_JQ}" <<<"${out}"
    fi
}

# --- apply -------------------------------------------------------------------

# fetch_run_json ID: run ID as GitHub gives it.
fetch_run_json() {
    local rc=0
    rest_get "repos/${RUNS_REPO}/actions/runs/$1" || rc=$?
    pass_ratelimit "${rc}"
    test "${rc}" -ne "${EX_NOTFOUND}" || fatal "run $1 not found in ${RUNS_REPO}"
    test "${rc}" -eq 0 || fatal "reading run $1 failed"
}

# Checks that a run object (input) is a dispatch of the agent workflow
# from a trusted workflow branch in the configured devspace; prints why
# not, or nothing. RUNS_REF selects dispatches, never apply's trust policy.
readonly RUN_ORIGIN_JQ='
    if (.repository.full_name // "") != $repo then "is in \(.repository.full_name // "?"), not \($repo)"
    elif (.head_repository.id // null) != (.repository.id // "") then "ran code from another repository than \($repo)"
    elif .path != $path then "ran \(.path // "?"), not \($path)"
    elif .event != "workflow_dispatch" then "was triggered by \(.event // "?"), not a dispatch"
    elif (.actor.login | type) != "string" or (.actor.login == "")
        or (.actor.login != $bot and .actor.login != $operator)
        then "was dispatched by \(.actor.login // "?"), not the configured bot or operator"
    elif $repo != $devspace then "is not in the configured devspace repository \($devspace)"
    elif ((.head_branch // "") | test("^bot/agent-run-.+$") | not)
        then "ran the workflow from \(.head_branch // "?"), not a trusted agent branch"
    elif ((.head_sha // "") | test("^[0-9a-f]{40}$") | not) then "has no valid head_sha"
    else empty end'

# Checks the jobs of a run attempt (input): exactly the workflow's, of that
# run and head, all successful; prints why not, or nothing.
readonly RUN_JOBS_JQ='
    (.jobs | map(.name)) as $got
    | if ($got | sort) != ($names | sort) then "has the jobs \($got | join(", ")), not \($names | join(", "))"
      elif any(.jobs[]; .run_id != $run or .head_sha != $sha) then "has a job of another run or head"
      elif any(.jobs[]; .conclusion != "success") then
          "has jobs that did not succeed: \(.jobs | map(select(.conclusion != "success") | "\(.name) (\(.conclusion // .status))") | join(", "))"
      else empty end'

# fetch_checker SHA: prints the directory holding the code that checks a
# run's outputs, as of commit SHA of the runs repository (the one that ran):
# safe-outputs/, vendor/gh-aw/ and agent/redact.mjs, kept by commit.
fetch_checker() {
    local sha=$1 dir=${CHECKER_DIR}/$1 rc=0
    if test -n "${BOT_RUNS_SAFE_OUTPUTS_DIR:-}"; then
        echo "${BOT_RUNS_SAFE_OUTPUTS_DIR}"
        return
    fi
    if ! test -f "${dir}/${CHECKER}"; then
        mkdir -p "${CHECKER_DIR}" "${scratch}/checker"
        ghapi "repos/${RUNS_REPO}/tarball/${sha}" >"${scratch}/checker.tar.gz" || rc=$?
        pass_ratelimit "${rc}"
        test "${rc}" -eq 0 || fatal "downloading the code of ${sha} from ${RUNS_REPO} failed"
        tar -xzf "${scratch}/checker.tar.gz" -C "${scratch}/checker" --strip-components=1 --no-same-owner \
            --wildcards "${CHECKER_PATHS[@]/#/*/}" || fatal "unpacking the code of ${sha} failed"
        test -f "${scratch}/checker/${CHECKER}" || fatal "${sha} of ${RUNS_REPO} has no ${CHECKER}"
        # Node's permission model follows links out of the directory it allows.
        test -z "$(find "${scratch}/checker" -type l -print -quit)" || fatal "the code of ${sha} holds a symbolic link"
        rm -rf "${dir}"
        mv "${scratch}/checker" "${dir}"
    fi
    echo "${dir}"
}

# checker CHECKER_DIR ARGS...: the safe-outputs checker. It is code of the
# runs repository (the commit that ran, or BOT_RUNS_SAFE_OUTPUTS_DIR, which is
# for tests and local development), so it runs with no environment but the
# PATH and under node's permission model: it may read its own directory
# and the scratch directory, write the scratch directory, and start no
# process. Anyone who can push to RUNS_REF can change it, as they can
# change the workflow itself.
checker() {
    local dir=$1
    shift
    env -i PATH="${PATH}" HOME="${scratch}" TMPDIR="${scratch}" node --permission \
        --allow-fs-read="${dir}" --allow-fs-read="${scratch}" --allow-fs-write="${scratch}" \
        "${dir}/${CHECKER}" "$@"
}

# staged_view DIR: git's own view of the change staged in DIR, in
# scratch/view-*, for the checker's post-apply.
staged_view() {
    agit "$1" diff --cached --raw -z --no-renames --no-abbrev HEAD >"${scratch}/view-raw"
    agit "$1" diff --cached --numstat -z --no-renames HEAD >"${scratch}/view-numstat"
    agit "$1" diff --cached --no-renames HEAD >"${scratch}/view-diff"
}

# apply_artifact RUN_JSON ATTEMPT DIR CHECKER_DIR POLICY: finds and
# unpacks the safe-outputs artifact of the run's attempt into DIR,
# refusing one that isn't exactly what the agent job of that run uploaded
# (the checker unpacks it: names, types and sizes).
apply_artifact() {
    local run=$1 attempt=$2 dir=$3 chk=$4 policy=$5 id sha body jobs art why rc=0
    read -r id sha < <(jq -r '"\(.id) \(.head_sha)"' <<<"${run}")
    jobs=$(rest_get "repos/${RUNS_REPO}/actions/runs/${id}/attempts/${attempt}/jobs?per_page=${PER_PAGE}") || rc=$?
    pass_ratelimit "${rc}"
    test "${rc}" -eq 0 || fatal "listing the jobs of run ${id} failed"
    why=$(jq -r --argjson names "${WORKFLOW_JOBS}" --argjson run "${id}" --arg sha "${sha}" "${RUN_JOBS_JQ}" <<<"${jobs}")
    test -z "${why}" || fatal "run ${id} ${why}; its outputs are taken only from a run whose jobs all succeeded"

    body=$(rest_get "repos/${RUNS_REPO}/actions/runs/${id}/artifacts?per_page=${PER_PAGE}") || rc=$?
    pass_ratelimit "${rc}"
    test "${rc}" -eq 0 || fatal "listing the artifacts of run ${id} failed"
    # The agent job's window: an artifact made outside it came from
    # elsewhere (another attempt, or a later upload).
    art=$(jq -c --arg n "${OUT_ARTIFACT}" --argjson job "$(jq -c --arg n "${AGENT_JOB}" '.jobs[] | select(.name == $n) | {started_at, completed_at}' <<<"${jobs}")" \
        '[.artifacts[] | select(.name == $n)] as $a
        | if ($a | length) == 0 then null
          elif ($a | length) > 1 then {error: "has \($a | length) \($n) artifacts"}
          else $a[0] | . + {in_job: ((.created_at // "") >= $job.started_at and (.created_at // "") <= $job.completed_at)} end' <<<"${body}")
    test "${art}" != null ||
        fatal "run ${id} has no ${OUT_ARTIFACT} artifact: it handed nothing back, or its outputs were dropped ('$(basename "$0") show ${id}' says why)"
    why=$(jq -r --argjson run "${run}" --argjson max "${MAX_ARTIFACT_BYTES}" '
        if .error then .error
        elif .expired != false then "has an expired artifact (since \(.expires_at // "?"), kept 30 days)"
        elif .workflow_run.id != $run.id or .workflow_run.head_sha != $run.head_sha
            or .workflow_run.repository_id != $run.repository.id then "has an artifact of another run or head"
        elif (.in_job | not) then "has an artifact made outside its agent job"
        elif (.size_in_bytes // ($max + 1)) > $max then "has an artifact of \(.size_in_bytes // "?") bytes, over \($max)"
        else empty end' <<<"${art}")
    test -z "${why}" || fatal "run ${id} ${why}"

    ghapi "repos/${RUNS_REPO}/actions/artifacts/$(jq -r .id <<<"${art}")/zip" >"${scratch}/out.zip" || rc=$?
    test "${rc}" -eq 0 || fatal "downloading the ${OUT_ARTIFACT} artifact of run ${id} failed"
    checker "${chk}" unpack --zip "${scratch}/out.zip" --dir "${dir}" --policy "${policy}" ||
        fatal "the ${OUT_ARTIFACT} artifact of run ${id} is refused"
}

# Run apply's Git operations and worktree helper without caller Git
# configuration or repository redirects, and with hooks and fsmonitor off.
apply_env() {
    env -u GIT_CONFIG_PARAMETERS -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE \
        -u GIT_COMMON_DIR -u GIT_OBJECT_DIRECTORY -u GIT_ALTERNATE_OBJECT_DIRECTORIES \
        GIT_CONFIG_NOSYSTEM=1 GIT_CONFIG_GLOBAL=/dev/null GIT_TERMINAL_PROMPT=0 \
        GIT_CONFIG_COUNT=2 GIT_CONFIG_KEY_0=core.hooksPath GIT_CONFIG_VALUE_0=/dev/null \
        GIT_CONFIG_KEY_1=core.fsmonitor GIT_CONFIG_VALUE_1=false "$@"
}

agit() {
    local dir=$1
    shift
    apply_env git -C "${dir}" -c core.hooksPath=/dev/null -c core.fsmonitor=false "$@"
}

# The helper spawns Git itself: keep checkout hooks and fsmonitor disabled
# there too, regardless of the caller's global configuration.
apply_worktree() {
    apply_env \
        "$(dirname "$(readlink -f "$0")")/bot-work" worktree "$@" | tail -n1
}

cmd_apply() {
    local run_id="" slug="" dir="" source="" message_file="" json=false want_repo="" want_base="" outputs=${ALL_OUTPUTS}
    local run meta attempt run_url why rec item repo base workflow result summary_run commit branch files head backing managed chk verdict pr others
    while test $# -gt 0; do
        case "$1" in
            --slug|--dir|--source|--message|--repo|--base|--outputs)
                test $# -ge 2 || fatal "$1 requires a value"
                case "$1" in
                    --slug) slug=$2 ;;
                    --dir) dir=${2%/} ;;
                    --source) source=$2 ;;
                    --message) message_file=$2 ;;
                    --repo) want_repo=$2 ;;
                    --base) want_base=$2 ;;
                    --outputs) outputs=$2 ;;
                esac
                shift 2
                ;;
            --json) json=true; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) fatal "unknown apply option: $1 (see --help)" ;;
            *) test -z "${run_id}" || fatal "apply takes one RUN"; run_id=$(parse_run "$1"); shift ;;
        esac
    done
    test -n "${run_id}" || fatal "apply requires a RUN"
    [[ "${want_repo}" =~ ${REPO_RE} ]] || fatal "--repo OWNER/REPO is required: the repository the run's change must be for"
    test -z "${want_base}" || [[ "${want_base}" =~ ${BASE_RE} ]] || fatal "--base must be a branch name, not ${want_base}"
    [[ "${slug}" =~ ^[a-z0-9][a-z0-9._-]*$ ]] || fatal "--slug must be a branch slug like fix-typo (the branch is bot/SLUG)"
    test -n "${message_file}" || fatal "--message FILE is required: the commit message, why first (see upstream-pr/SKILL.md)"
    test -r "${message_file}" || fatal "cannot read ${message_file}"
    grep -q '[^[:space:]]' "${message_file}" || fatal "the commit message in ${message_file} is empty"
    ! grep -qi '^Signed-off-by:' "${message_file}" ||
        fatal "the commit message has a Signed-off-by; only the operator's own approval adds one (bot-pr promote)"
    ! grep -qi "^${RUN_TRAILER}:" "${message_file}" ||
        fatal "the commit message has an ${RUN_TRAILER} trailer; apply adds the run's own"
    branch=bot/${slug}

    # The run: a successful dispatch of the agent workflow, for the
    # declared repository.
    run=$(fetch_run_json "${run_id}")
    meta=$(jq -c "${RUN_META}" <<<"${run}")
    test "$(jq -r '.conclusion // .status' <<<"${meta}")" = success ||
        fatal "run ${run_id} is $(jq -r '.conclusion // .status' <<<"${meta}"), not success; only a successful run's change is applied"
    why=$(jq -r --arg repo "${RUNS_REPO}" --arg path ".github/workflows/${RUNS_WORKFLOW}" --arg devspace "${OP_DEVSPACE_REPO}" \
        --arg bot "${OP_BOT_LOGIN}" --arg operator "${OP_OPERATOR_LOGIN}" \
        "${RUN_ORIGIN_JQ}" <<<"${run}")
    test -z "${why}" || fatal "run ${run_id} ${why}; only dispatches of ${RUNS_WORKFLOW} from trusted agent branches are applied"
    test "$(jqlib -r '{run: .} | title_parts | .repo // ""' <<<"${meta}")" = "${want_repo}" ||
        fatal "run ${run_id} was dispatched for $(jqlib -r '{run: .} | title_parts | .repo // "?"' <<<"${meta}"), not ${want_repo}"
    attempt=$(jq -r .attempt <<<"${meta}")
    run_url=$(jq -r '"\(.url)/attempts/\(.attempt)"' <<<"${meta}")

    # Its summary: one field at a time, so that an empty one can't shift
    # the others.
    rec=$(load_record "${meta}")
    test "$(jq -r '.source == "artifact" and .summary != null' <<<"${rec}")" = true ||
        fatal "run ${run_id} has no summary.json (its ${SUMMARY_ARTIFACT} artifact expired or is missing)"
    summary_field() { jq -r --arg f "$1" '.summary[$f] // "" | tostring' <<<"${rec}"; }
    item=$(summary_field item) repo=$(summary_field repo) base=$(summary_field base)
    workflow=$(summary_field workflow) result=$(summary_field result) summary_run=$(summary_field run_id)
    test "${summary_run}" = "${run_id}" || fatal "run ${run_id}'s summary is of run ${summary_run:-?}"
    test "${result}" = success || fatal "run ${run_id}'s agent result is ${result:-unknown}, not success"
    test "${repo}" = "${want_repo}" || fatal "run ${run_id}'s summary names ${repo:-no repository}, not ${want_repo}"
    [[ "${base}" =~ ${BASE_RE} ]] || fatal "run ${run_id}'s summary has no valid base"
    test -z "${want_base}" || test "${base}" = "${want_base}" ||
        fatal "run ${run_id}'s base is ${base}, not ${want_base}"

    # Its outputs, as uploaded by its agent job and checked in the run by
    # gh-aw's validation, checked again here by the same code: the
    # allowlist and the policy for this repository and base, then gh-aw's
    # validation of every request, the patch's protection and the checks
    # gh-aw doesn't make (safe-outputs/safe-outputs.mjs).
    chk=$(fetch_checker "$(jq -r .head_sha <<<"${run}")")
    checker "${chk}" compile --repo "${want_repo}" --base "${base}" --workflow "${workflow:-branch}" --outputs "${outputs}" \
        --max-outputs max --out "${scratch}/policy.json" >/dev/null || fatal "the allowlist refuses ${want_repo} at ${base} with outputs ${outputs}"
    apply_artifact "${run}" "${attempt}" "${scratch}/out" "${chk}" "${scratch}/policy.json"
    checker "${chk}" check --dir "${scratch}/out" --policy "${scratch}/policy.json" --json "${scratch}/verdict.json" >/dev/null ||
        fatal "run ${run_id}'s outputs are refused:
$(jq -r '.errors[] | "  \(.)"' "${scratch}/verdict.json" 2>/dev/null)"
    verdict=$(<"${scratch}/verdict.json")
    pr=$(jq -c '[.items[] | select(.type == "create_pull_request")] | first // null' <<<"${verdict}")
    others=$(jq -c '[.items[] | select(.type != "create_pull_request") | {type, text: (.message // .body // .reason // "")}]' <<<"${verdict}")
    if test "${pr}" = null; then
        # Nothing to apply: say what the run did hand back.
        if ${json}; then
            jq -n --argjson run "${run_id}" --arg url "${run_url}" --arg item "${item}" --argjson outputs "${others}" \
                '{run_id: $run, run_url: $url, item: $item, applied: false, outputs: $outputs}'
        else
            printf 'Run %s handed back no create_pull_request, so nothing was applied.\n' "${run_id}"
            jq -r '.[] | "  \(.type): \(.text)"' <<<"${others}"
        fi
        return 0
    fi

    read -r commit < <(jq -r .commit "${scratch}/out/base.json")
    # A fresh clone, its base commit on the declared base branch (never
    # fetched by id: GitHub serves forks' commits that way too).
    if test -n "${dir}"; then
        dir=$(realpath -m -- "${dir}")
        if test -e "${dir}" || test -L "${dir}"; then
            fatal "${dir} already exists; remove it or pass --dir"
        fi
    fi
    test -n "${source}" || source=https://github.com/${want_repo}
    # Never share Git configuration or refs with a worker's existing clone.
    # Keep this backing clone for as long as the linked worktree exists.
    backing=${CACHE_DIR}/apply/sources/${run_id}-${slug}/${want_repo##*/}
    if test -e "${backing}" || test -L "${backing}"; then
        fatal "${backing} already exists; choose another slug"
    fi
    mkdir -p "$(dirname "${backing}")"
    apply_env git -c core.hooksPath=/dev/null clone -q --no-checkout --template= --single-branch --branch "${base}" -- "${source}" "${backing}" || {
        rm -rf "${backing}"
        fatal "cloning ${base} of ${source} failed"
    }
    # Kept in the clone for whatever runs git there next. Apply itself never
    # pushes. Origin stays pushable (for bot-land) only for the bot's own
    # repositories; for any other, bot-pr fork-pr pushes to an explicit URL.
    agit "${backing}" config core.hooksPath /dev/null
    agit "${backing}" config core.fsmonitor false
    # Keep the initial clone narrow, but track topic pushes for bot-land's
    # implicit --force-with-lease when an amended branch is re-pushed.
    agit "${backing}" config --replace-all remote.origin.fetch '+refs/heads/*:refs/remotes/origin/*'
    case "${want_repo%%/*}" in
        "${OP_BOT_LOGIN}" | "${OP_FORGE_ORG}") ;;
        *) agit "${backing}" config remote.origin.pushurl "${NO_PUSH_URL}" ;;
    esac
    refuse() {
        if test -n "${managed:-}"; then
            apply_worktree rm "${slug}" --dir "${managed}" --force || {
                warn "removing worktree ${managed} failed; preserving its backing clone ${backing}"
                fatal "$@"
            }
        fi
        rm -rf "${backing}"
        fatal "$@"
    }
    agit "${backing}" merge-base --is-ancestor "${commit}" "refs/remotes/origin/${base}" 2>/dev/null ||
        refuse "run ${run_id}'s base commit ${commit} is not on ${base} of ${source}"
    local destination_args=()
    test -z "${dir}" || destination_args=(--dir "${dir}")
    managed=$(apply_worktree add "${backing}" "${slug}" --base "${commit}" "${destination_args[@]}") || refuse "creating apply worktree failed"
    dir=${managed}
    agit "${dir}" apply --index --whitespace=nowarn "${scratch}/out/$(jq -r .patch.file <<<"${verdict}")" ||
        refuse "run ${run_id}'s change doesn't apply to ${commit}"
    # The change as git sees it, which can differ from what the patch's
    # text says (gh-aw's post-apply check, and the checks of the text again).
    staged_view "${dir}"
    why=$(checker "${chk}" post-apply --raw "${scratch}/view-raw" --numstat "${scratch}/view-numstat" --diff "${scratch}/view-diff" \
        --policy "${scratch}/policy.json" 2>&1) ||
        refuse "run ${run_id}'s change touches what a run may not change:
${why}"

    cp "${message_file}" "${scratch}/message"
    grep -q '^Generated-by: ' "${scratch}/message" || printf '\n%s\n' "${AI_TRAILER}" >>"${scratch}/message"
    GIT_AUTHOR_NAME=${OP_BOT_GIT_NAME} GIT_AUTHOR_EMAIL=${OP_BOT_GIT_EMAIL} \
        GIT_COMMITTER_NAME=${OP_BOT_GIT_NAME} GIT_COMMITTER_EMAIL=${OP_BOT_GIT_EMAIL} \
        agit "${dir}" commit -q --no-verify -F "${scratch}/message" \
        --trailer "${RUN_TRAILER}: ${run_url}" || refuse "committing the change failed"
    head=$(agit "${dir}" rev-parse HEAD)
    files=$(agit "${dir}" diff --name-only -z HEAD^ HEAD | jq -Rsc 'split("\u0000") | map(select(. != ""))')
    heartbeat_done "${run_id}"
    if ${json}; then
        jq -n --argjson run "${run_id}" --arg url "${run_url}" --arg sha "$(jq -r .head_sha <<<"${run}")" \
            --arg repo "${want_repo}" --arg base "${base}" --arg commit "${commit}" --arg branch "${branch}" \
            --arg dir "${dir}" --arg head "${head}" --arg item "${item}" --argjson files "${files}" \
            --argjson pr "$(jq -c '{title, body}' <<<"${pr}")" --argjson outputs "${others}" \
            '{run_id: $run, run_url: $url, workflow_sha: $sha, repo: $repo, base: $base, base_commit: $commit,
              branch: $branch, dir: $dir, head: $head, item: $item, files: $files, pull_request: $pr, outputs: $outputs}'
        return 0
    fi
    printf 'Applied run %s to %s@%s as %s in %s (%s file(s)), commit %s. Nothing was pushed.\n' \
        "${run_id}" "${want_repo}" "${commit:0:12}" "${branch}" "${dir}" "$(jq length <<<"${files}")" "${head:0:12}"
    printf 'The agent proposed the title %s.\n' "$(jq -r '.title | @json' <<<"${pr}")"
    jq -r '.[] | "  also handed back, not acted on: \(.type): \(.text)"' <<<"${others}"
    printf 'Review it (commit-review), then open it on the forge:\n  bot-pr fork-pr --repo %s --base %s --branch %s --item %s --from %s --title TITLE --body-file FILE\n' \
        "${want_repo}" "${base}" "${branch}" "${item:-ITEM}" "${dir}"
}

# --- main ---------------------------------------------------------------------

test $# -gt 0 || { usage 1>&2; exit 1; }
cmd=$1
shift
case "${cmd}" in
    -h|--help|help) usage; exit 0 ;;
    dispatch|reconcile|watch|list|show|log|transcript|diff|stats|apply) ;;
    *) fatal "unknown command: ${cmd} (see --help)" ;;
esac

require_cmd gh "install the GitHub CLI (https://cli.github.com) and authenticate it"
require_cmd jq "install jq"
case "${cmd}" in
    list|show|log|diff|stats|reconcile) require_cmd unzip "install unzip" ;;
    apply)
        require_cmd git "install git"
        require_cmd node "install Node.js 22.2 or newer (it runs gh-aw's safe-outputs validation, and bot-work worktree)"
        require_cmd tar "install tar"
        ;;
    transcript)
        require_cmd unzip "install unzip"
        require_cmd zstd "install zstd"
        ;;
esac
prune_caches
"cmd_${cmd}" "$@"
