#!/usr/bin/env bash
# Surface emoji reactions on content authored by cgwalters-bot, so that
# feedback on the bot (especially 👎 and 😕) is never missed.
set -euo pipefail
shopt -s inherit_errexit

readonly BOT_LOGIN=cgwalters-bot
readonly DEFAULT_LOOKBACK_DAYS=14
readonly API=https://api.github.com
readonly STATE_DIR=${XDG_STATE_HOME:-$HOME/.local/state}/bot-feedback
readonly STATE_FILE=${STATE_DIR}/seen.json
readonly STATE_VERSION=1
# Reactions that ask for a human to look; the others are just reported.
readonly NEGATIVE_JQ='["-1", "confused"]'
# Reactors that are never reported: the bot itself, and cgwalters, who
# already knows what he reacted to. Overridable, e.g. to test with a
# reaction added by the bot.
readonly IGNORE_LOGINS=${BOT_FEEDBACK_IGNORE-${BOT_LOGIN} cgwalters}
# One search per query below, each paginated 100 at a time; the search
# API allows only 30 requests a minute.
readonly SEARCH_QUALIFIERS=(commenter author reviewed-by)
readonly SEARCH_PER_PAGE=100
readonly EXCERPT_LEN=160
# Exit status for an exhausted quota (EX_TEMPFAIL), as in bot-board.
readonly EX_RATELIMIT=75
# Where --file-issues files feedback, and who it notifies there.
readonly DEFAULT_ISSUE_REPO=cgwalters-bot/cgwalters-bot
readonly MENTION_LOGIN=cgwalters
# Hidden marker in each filed issue's body, so a reaction is never filed
# twice even if the state file is lost.
readonly MARKER_PREFIX='bot-feedback-reaction:'
# jq def that keeps "@login" in text from notifying anyone.
readonly UNMENTION_JQ='def unmention: gsub("@(?=[A-Za-z0-9])"; "@\u200b");'

usage() {
    cat <<EOF
Usage: $(basename "$0") [--since DATE] [--dry-run]
       $(basename "$0") [--since DATE] --file-issues [--repo OWNER/REPO]
                    [--assessment-dir DIR] [--no-mention]

Report new emoji reactions on content authored by ${BOT_LOGIN}: the bodies
of issues and PRs it opened, its issue and PR comments, and its inline PR
review comments, in threads updated since the lookback window started.
Then list the negative reactions (👎, 😕) not filed yet, with their ids.

Options:
  --since DATE          Look at threads updated since DATE (default: ${DEFAULT_LOOKBACK_DAYS} days ago)
  --dry-run             Report, but don't record anything in the state file
  --file-issues         Open one issue per unfiled negative reaction, in
                        ${DEFAULT_ISSUE_REPO} unless --repo is given
  --repo OWNER/REPO     Repository to file issues in
  --assessment-dir DIR  Include the text of DIR/REACTION_ID.md in the issue
                        for that reaction; reactions without such a file
                        are left unfiled for a later run
  --no-mention          Don't mention @${MENTION_LOGIN} in filed issues (for testing)
  -h, --help            Show this help

Only reactions not seen before are reported; what was seen and filed is
kept in ${STATE_FILE}.
Reactions by these logins are never reported: ${IGNORE_LOGINS:-(none)}
(set BOT_FEEDBACK_IGNORE to a space-separated list to change that).

When the source repository isn't public, a filed issue has links only: no
excerpt of the bot's text and no assessment.

Limitations: only REST is used, since the GraphQL quota is shared by all
agents, and REST exposes no reactions on the summary body of a PR review.
A reaction does not bump a thread's update time, so a reaction on an old
thread is only found while the thread is within the window; widen it with
--since if needed.
EOF
}

fatal() {
    echo "error: $*" 1>&2
    exit 1
}

warn() {
    echo "warning: $*" 1>&2
}

require_cmd() {
    command -v "$1" >/dev/null 2>&1 || fatal "'$1' not found in PATH; $2"
}

rate_limited() {
    echo "error: GitHub is rate limiting the bot ($1); retry after $(gh api rate_limit --jq ".resources.$2.reset | todate" 2>/dev/null || echo "the reset")" 1>&2
    exit "${EX_RATELIMIT}"
}

# ghapi ARGS...: 'gh api', turning rate limiting into a clear exit.
ghapi() {
    local out err rc=0
    err=$(mktemp)
    out=$(gh api "$@" 2>"${err}") || rc=$?
    if test "${rc}" -ne 0; then
        if grep -qiE 'rate limit|abuse' "${err}"; then
            local reason
            reason=$(grep -iE -m1 'rate limit|abuse' "${err}")
            rm -f "${err}"
            rate_limited "${reason}" core
        fi
        cat "${err}" 1>&2
        rm -f "${err}"
        return "${rc}"
    fi
    rm -f "${err}"
    printf '%s\n' "${out}"
}

since=
file_issues=false
issue_repo=${DEFAULT_ISSUE_REPO}
assessment_dir=
mention=true
dry_run=false
while test $# -gt 0; do
    case "$1" in
        --since) test $# -ge 2 || fatal "--since requires a date"; since=$2; shift 2 ;;
        --since=*) since=${1#--since=}; shift ;;
        --file-issues) file_issues=true; shift ;;
        --repo) test $# -ge 2 || fatal "--repo requires OWNER/REPO"; issue_repo=$2; shift 2 ;;
        --repo=*) issue_repo=${1#--repo=}; shift ;;
        --assessment-dir) test $# -ge 2 || fatal "--assessment-dir requires a directory"; assessment_dir=$2; shift 2 ;;
        --assessment-dir=*) assessment_dir=${1#--assessment-dir=}; shift ;;
        --no-mention) mention=false; shift ;;
        --dry-run) dry_run=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) fatal "unknown argument: $1 (see --help)" ;;
    esac
done
if ${file_issues} && ${dry_run}; then
    fatal "--file-issues and --dry-run can't be combined: filed issues would not be recorded"
fi
if ! ${file_issues} && { test "${issue_repo}" != "${DEFAULT_ISSUE_REPO}" || test -n "${assessment_dir}" || ! ${mention}; }; then
    fatal "--repo, --assessment-dir and --no-mention only apply with --file-issues"
fi
[[ "${issue_repo}" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || fatal "--repo must be OWNER/REPO, not '${issue_repo}'"
if test -n "${assessment_dir}"; then
    test -d "${assessment_dir}" || fatal "--assessment-dir ${assessment_dir} is not a directory"
fi
if test -z "${since}"; then
    since=$(date -u -d "${DEFAULT_LOOKBACK_DAYS} days ago" +%F)
else
    since=$(date -u -d "${since}" +%F 2>/dev/null) || fatal "invalid --since date (expected YYYY-MM-DD)"
fi

require_cmd gh "install the GitHub CLI (https://cli.github.com) and authenticate it as ${BOT_LOGIN}"
require_cmd jq "install jq"
require_cmd flock "install util-linux"

login=$(ghapi user --jq .login) || fatal "'gh api user' failed; authenticate gh as ${BOT_LOGIN}"
test "${login}" = "${BOT_LOGIN}" ||
    fatal "gh is authenticated as '${login}', not ${BOT_LOGIN}; searches would miss private repositories only the bot can see"

# Two runs (say, by two agents) must not both update the state or file.
mkdir -p "${STATE_DIR}"
exec {lock_fd}>"${STATE_DIR}/lock" || fatal "cannot open ${STATE_DIR}/lock"
flock -n "${lock_fd}" || fatal "another $(basename "$0") run holds ${STATE_DIR}/lock"

# State: {version, items: {URL: {counts: {REACTION: N}, reactions: {ID:
# {content, user, filed}}}}}. Reactions are keyed by id, so a new one is
# one whose id was never seen; 'filed' records that the reaction needs no
# issue or --file-issues opened one (then its URL is in 'issue').
if test -s "${STATE_FILE}"; then
    STATE=$(jq -c --argjson v "${STATE_VERSION}" 'if .version == $v then . else error("unsupported state version \(.version)") end' "${STATE_FILE}") ||
        fatal "cannot parse ${STATE_FILE}; move it away to start over (all current reactions will then be reported as new)"
else
    STATE=$(jq -nc --argjson v "${STATE_VERSION}" '{version: $v, items: {}}')
fi

save_state() {
    ${dry_run} && return 0
    printf '%s\n' "${STATE}" >"${STATE_FILE}.tmp.$$"
    mv -f "${STATE_FILE}.tmp.$$" "${STATE_FILE}"
}

# 1. Find the threads with bot content. Each query is one search request
# per 100 results; check the quota up front rather than failing halfway.
search_left=$(gh api rate_limit --jq .resources.search.remaining 2>/dev/null) || search_left=
if test -n "${search_left}" && test "${search_left}" -lt "${#SEARCH_QUALIFIERS[@]}"; then
    rate_limited "only ${search_left} search requests left" search
fi
threads=$(for qualifier in "${SEARCH_QUALIFIERS[@]}"; do
    ghapi -X GET search/issues --paginate -f q="${qualifier}:${BOT_LOGIN} updated:>=${since}" \
        -f per_page="${SEARCH_PER_PAGE}" \
        --jq '.items[] | {url: .html_url, number, title, author: .user.login,
                          repo: (.repository_url | ltrimstr("'"${API}"'/repos/")),
                          is_pr: (.pull_request != null), body, reactions}' ||
        fatal "searching for ${qualifier}:${BOT_LOGIN} failed"
done | jq -sc 'unique_by(.url) | .[]')

# 2. Collect every piece of bot-authored content in those threads, as
# {url, thread, repo, number, title, kind, excerpt, reactions}.
excerpt_jq="(.body // \"\" | gsub(\"\\\\s+\"; \" \") | if length > ${EXCERPT_LEN} then .[:${EXCERPT_LEN}] + \"...\" else . end)"
content=$(while IFS= read -r thread; do
    test -n "${thread}" || continue
    repo=$(jq -r .repo <<<"${thread}")
    number=$(jq -r .number <<<"${thread}")
    meta=$(jq -c '{thread: .url, repo, number, title}' <<<"${thread}")
    endpoints=("issues/${number}/comments")
    if test "$(jq -r .is_pr <<<"${thread}")" = true; then
        endpoints+=("pulls/${number}/comments")
    fi
    {
        jq -c --arg bot "${BOT_LOGIN}" "select(.author == \$bot)
            | {url, kind: (if .is_pr then \"PR description\" else \"issue description\" end),
               excerpt: ${excerpt_jq}, reactions}" <<<"${thread}"
        for ep in "${endpoints[@]}"; do
            kind=comment
            test "${ep}" = "${endpoints[0]}" || kind="review comment"
            if ! ghapi --paginate "repos/${repo}/${ep}?per_page=100" \
                --jq ".[] | select(.user.login == \"${BOT_LOGIN}\")
                      | {url: .html_url, kind: \"${kind}\", excerpt: ${excerpt_jq}, reactions}"; then
                warn "cannot list the ${kind}s in ${repo}#${number}; skipping them"
            fi
        done
    } | jq -c --argjson meta "${meta}" '$meta + .'
done <<<"${threads}")
nthreads=$(grep -c . <<<"${threads}" || true)
nitems=$(grep -c . <<<"${content}" || true)

# 3. For content whose reaction counts changed since the last run (or that
# is new to us and has any), fetch who reacted and pick out unseen ids.
counts_jq='.reactions | del(.url, .total_count)'
new_reactions=()
while IFS= read -r item; do
    test -n "${item}" || continue
    url=$(jq -r .url <<<"${item}")
    counts=$(jq -c "${counts_jq}" <<<"${item}")
    if jq -e --arg url "${url}" --argjson counts "${counts}" \
        '(.items[$url].counts // {}) as $old
         | $old == $counts or ($old == {} and ($counts | add) == 0)' <<<"${STATE}" >/dev/null; then
        continue
    fi
    reactions_url=$(jq -r .reactions.url <<<"${item}")
    if ! current=$(ghapi --paginate "${reactions_url#"${API}"/}?per_page=100" \
        --jq '.[] | {id: (.id | tostring), content, user: .user.login}' | jq -sc .); then
        warn "cannot list the reactions on ${url}; will retry next run"
        continue
    fi
    # Keep what we knew about reactions still present, add the new ones,
    # and drop the ones that were removed.
    prev=$(jq -c --arg url "${url}" '.items[$url].reactions // {}' <<<"${STATE}")
    while IFS= read -r r; do
        test -n "${r}" || continue
        new_reactions+=("$(jq -c --argjson item "${item}" '. + {item: $item}' <<<"${r}")")
    done < <(jq -c --argjson prev "${prev}" --arg ignore "${IGNORE_LOGINS}" \
        '.[] | select($prev[.id] == null) | select(.user as $u | $ignore | split(" ") | index($u) | not)' <<<"${current}")
    STATE=$(jq -c --arg url "${url}" --argjson counts "${counts}" --argjson current "${current}" \
        --argjson prev "${prev}" --argjson item "${item}" --arg ignore "${IGNORE_LOGINS}" --argjson neg "${NEGATIVE_JQ}" '
        .items[$url] = {counts: $counts, thread: $item.thread, repo: $item.repo,
                        number: $item.number, title: $item.title, kind: $item.kind,
                        excerpt: $item.excerpt,
                        reactions: ($current | map({key: .id, value: ({content, user,
                            # Only negative reactions by others need filing;
                            # everything else counts as already filed.
                            filed: ($prev[.id].filed
                                    // ((.content as $c | $neg | index($c)) == null
                                        or (.user as $u | $ignore | split(" ") | index($u)) != null))}
                            + ($prev[.id] | if .issue then {issue} else {} end))})
                            | from_entries)}' <<<"${STATE}")
done <<<"${content}"
save_state

# 4. Report.
emoji() {
    case "$1" in
        +1) echo "👍" ;; -1) echo "👎" ;; laugh) echo "😄" ;; confused) echo "😕" ;;
        heart) echo "❤️" ;; hooray) echo "🎉" ;; rocket) echo "🚀" ;; eyes) echo "👀" ;;
        *) echo "$1" ;;
    esac
}

echo "Checked ${nitems} bot comments and descriptions in ${nthreads} threads updated since ${since}."
if test "${#new_reactions[@]}" -eq 0; then
    echo "No new reactions."
else
    # Negative first.
    printf '%s\n' "${new_reactions[@]}" | jq -sc --argjson neg "${NEGATIVE_JQ}" \
        'sort_by(.content as $c | $neg | index($c) | not) | .[]' |
        while IFS= read -r r; do
            content_=$(jq -r .content <<<"${r}")
            jq -r --arg e "$(emoji "${content_}")" --argjson neg "${NEGATIVE_JQ}" '
                "\(if (.content as $c | $neg | index($c)) then "NEGATIVE " else "" end)\($e) \(.content) from @\(.user) on the \(.item.kind) in \(.item.repo)#\(.item.number)",
                "  \(.item.url)",
                "  > \(.item.excerpt)"' <<<"${r}"
        done
fi


# 5. List the negative reactions not filed yet, including ones seen by an
# earlier run, with the ids that name their assessment files.
pending=$(jq -c '.items | to_entries[] | .key as $url | .value as $item
    | $item.reactions | to_entries[] | select(.value.filed == false)
    | {id: .key, content: .value.content, user: .value.user, url: $url,
       item: ($item | del(.reactions, .counts))}' <<<"${STATE}")
if test -z "${pending}"; then
    echo "No negative reactions left to file."
    exit 0
fi
echo
echo "Negative reactions not filed yet:"
while IFS= read -r p; do
    jq -r --arg e "$(emoji "$(jq -r .content <<<"${p}")")" \
        '"  reaction \(.id): \($e) from @\(.user) on the \(.item.kind) in \(.item.repo)#\(.item.number)\n    \(.url)"' <<<"${p}"
done <<<"${pending}"

# 6. File them as issues.
${file_issues} || exit 0
declare -A private_repo=()
is_private() {
    local repo=$1
    if test -z "${private_repo[${repo}]:-}"; then
        # Unknown visibility is treated as private.
        private_repo[${repo}]=$(ghapi "repos/${repo}" --jq '.visibility != "public"' 2>/dev/null || echo true)
    fi
    test "${private_repo[${repo}]}" = true
}
is_private "${issue_repo}" && warn "${issue_repo} is not public; filing there anyway"
# Reactions already filed in the target repository, per the markers in
# issue bodies. Listing is exact where search would lag, and the repo is
# small.
filed_markers=$(ghapi --paginate "repos/${issue_repo}/issues?state=all&per_page=100" \
    --jq ".[] | .html_url as \$u | .body // \"\" | scan(\"${MARKER_PREFIX}([0-9]+)\") | \"\(.[0]) \(\$u)\"") ||
    fatal "cannot list the issues in ${issue_repo}; does it exist, with issues enabled?"
# record_filed ID URL ISSUE_URL: mark a reaction as filed, right away, so
# a later failure can't lead to a duplicate.
record_filed() {
    STATE=$(jq -c --arg url "$2" --arg id "$1" --arg issue "$3" \
        '.items[$url].reactions[$id] += {filed: true, issue: $issue}' <<<"${STATE}")
    save_state
}
nfiled=0
nskipped=0
while IFS= read -r p; do
    id=$(jq -r .id <<<"${p}")
    url=$(jq -r .url <<<"${p}")
    repo=$(jq -r .item.repo <<<"${p}")
    existing=$(awk -v id="${id}" '$1 == id { print $2; exit }' <<<"${filed_markers}")
    if test -n "${existing}"; then
        echo "Reaction ${id} is already filed as ${existing}; recording that"
        record_filed "${id}" "${url}" "${existing}"
        continue
    fi
    assessment="_Not assessed._"
    if test -n "${assessment_dir}"; then
        if ! test -s "${assessment_dir}/${id}.md"; then
            warn "no ${assessment_dir}/${id}.md; leaving reaction ${id} (${url}) for a later run"
            nskipped=$((nskipped + 1))
            continue
        fi
        assessment=$(<"${assessment_dir}/${id}.md")
    fi
    e=$(emoji "$(jq -r .content <<<"${p}")")
    title=$(jq -r --arg e "${e}" '"Feedback: \($e) from @\(.user) on \(.item.repo)#\(.item.number)"' <<<"${p}")
    # The target repository is public: for any other source, links only.
    # Only MENTION_LOGIN is to be notified, so '@' in the reactor's login,
    # the quoted text and the assessment gets a zero-width space.
    if is_private "${repo}"; then
        body=$(jq -r --arg e "${e}" "${UNMENTION_JQ}"'
            "\($e) from \("@" + .user | unmention) on the bot'"'"'s \(.item.kind): \(.url)\n\nThread: \(.item.thread)\n\nThe source repository is not public, so there is no excerpt or assessment here; read the thread."' <<<"${p}")
    else
        body=$(jq -r --arg e "${e}" --arg assessment "${assessment}" "${UNMENTION_JQ}"'
            "\($e) from \("@" + .user | unmention) on the bot'"'"'s \(.item.kind): \(.url)\n\nThread: \(.item.thread) (\(.item.title))\n\n> \(.item.excerpt | unmention)\n\n## Assessment\n\n\($assessment | unmention)"' <<<"${p}")
    fi
    if ${mention}; then
        body+=$'\n\n'"@${MENTION_LOGIN}, please take a look."
    fi
    body+=$'\n\n'"<!-- ${MARKER_PREFIX}${id} -->"
    issue_url=$(ghapi -X POST "repos/${issue_repo}/issues" -f title="${title}" -f body="${body}" --jq .html_url) ||
        fatal "creating an issue in ${issue_repo} for ${url} failed"
    record_filed "${id}" "${url}" "${issue_url}"
    echo "Filed ${issue_url}: ${title}"
    nfiled=$((nfiled + 1))
done <<<"${pending}"
summary="Filed ${nfiled} issues in ${issue_repo}"
test "${nskipped}" -eq 0 || summary+="; ${nskipped} left without an assessment"
echo "${summary}."
