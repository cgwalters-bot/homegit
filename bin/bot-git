#!/usr/bin/env bash
# git as the bot: the one place that defines the git identity of the
# bot's commits (from the operator config, bin/operator.sh), a git
# wrapper that commits and rebases with it, and a pre-push check of a
# branch's commits; see --help. bot-pr and dco-signoff source this file
# for the identity constants.

# shellcheck source=bin/operator.sh disable=SC1091 # followed with shellcheck -x
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/operator.sh"

# The git identity of the bot's commits. The email is what marks a commit
# as the bot's rather than the operator's own; the bot's commits from
# before it was named after the operator have BOT_GIT_LEGACY_NAME (its
# login).
readonly BOT_GIT_NAME=${OP_BOT_GIT_NAME}
readonly BOT_GIT_EMAIL=${OP_BOT_GIT_EMAIL}
readonly BOT_GIT_LEGACY_NAME=${OP_BOT_LOGIN}
# The operator's own identity: 'bot-pr promote' and 'bot-pr signoff' add
# their sign-off, as them, on their approval.
readonly HUMAN_LOGIN=${OP_OPERATOR_LOGIN}
readonly HUMAN_POSSESSIVE=${OP_OPERATOR_POSSESSIVE}
readonly HUMAN_GIT_NAME=${OP_OPERATOR_NAME}
readonly HUMAN_GIT_EMAIL=${OP_OPERATOR_EMAIL}

# Sourced: only the constants.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

set -euo pipefail
shopt -s inherit_errexit

readonly PROG=${0##*/}
readonly AI_TRAILER_KEYS=(Generated-by Assisted-by)
# Subjects of commits meant to be squashed before pushing.
readonly SQUASH_SUBJECT_RE='^(fixup|squash|amend)! '
# The git commands for which -s means --signoff (for rebase and merge it
# picks a strategy), each with its short options that take a value, as
# "SEPARATE ATTACHED": the letters after one of those in a cluster are
# its value; if there are none, the next argument is, except for the
# ATTACHED ones, whose value is optional and only ever attached ('-' for
# none).
declare -rA SIGNOFF_SHORT_VALUE_OPTS=(
    [am]="- CpS"
    [cherry-pick]="m S"
    [commit]="CcFmt Su"
    [format-patch]="ov -"
    [revert]="m S"
)
readonly SIGNOFF_REFUSAL="the bot never adds a Signed-off-by; only 'bot-pr promote' and 'bot-pr signoff' add ${HUMAN_POSSESSIVE} own on their approval"
# The operator's sign-off, as promote and signoff add it.
readonly HUMAN_SIGNOFF="Signed-off-by: ${HUMAN_GIT_NAME} <${HUMAN_GIT_EMAIL}>"
# The clones other agents use too, where the bot never commits: its
# homegit clone, and those listed in SHARED_CLONES_CONFIG, one path or
# glob per line ('~/' for the home directory, '#' for comments).
readonly DEFAULT_SHARED_CLONE=${HOME}/src/github/${OP_BOT_LOGIN}/homegit
readonly SHARED_CLONES_CONFIG=${BOT_GIT_SHARED_CLONES:-${XDG_CONFIG_HOME:-${HOME}/.config}/bot-git/shared-clones}
# Set to 1 to commit in a shared clone anyway.
readonly ALLOW_SHARED_ENV=BOT_GIT_ALLOW_SHARED_CLONE
# The git commands that create or rewrite commits (or the checked-out
# branch), which the bot must not run in a shared clone.
readonly COMMIT_COMMANDS=" am cherry-pick commit merge pull rebase revert stash "
# bot-git's own commands that rewrite the checked-out branch.
readonly REWRITE_COMMANDS=" rework carry-signoff drop-signoff "
# The classes of change that an attestation for carry-signoff gives each
# commit paired with one he signed off, and the one of them that drops his
# sign-off: unchanged or rebase-only, a mechanical conflict resolution,
# implementing his review asks, a small fix that keeps the intent, and
# substantively different. See the coordinator's carry-attest.md.
readonly CARRY_CLASSES=(unchanged conflict-resolution review-ask small-fix substantive)
readonly CARRY_DROP_CLASS=substantive
readonly ATTESTATION_VERSION=1

usage() {
    cat <<EOF
Usage: ${PROG} GIT-ARGS...
       ${PROG} rework [--was OLD-HEAD] [--pair OLD=NEW]... [--patch-id]
                     [--drop-signoff COMMIT]... [UPSTREAM]
       ${PROG} carry-signoff --was H0 --attestation FILE [--record FILE]
                     [--pair OLD=NEW]... [--patch-id] [UPSTREAM]
       ${PROG} drop-signoff UPSTREAM [COMMIT]...
       ${PROG} check [--no-ai-trailer] [--promoted] [--was OLD-HEAD]
                     [--pair OLD=NEW]... [--patch-id] [RANGE]

The git identity of ${OP_BOT_LOGIN}'s commits is
'${BOT_GIT_NAME} <${BOT_GIT_EMAIL}>'. The email is what marks a commit as the
bot's; the bot's older commits are named '${BOT_GIT_LEGACY_NAME}'.

${PROG} GIT-ARGS... runs git with that identity as author and committer,
for every git command that creates or rewrites commits: commit, rebase,
cherry-pick, am, merge. Rebases and amends keep each commit's original
author. It refuses to add a Signed-off-by (-s/--signoff, or a
Signed-off-by --trailer): the bot never signs off; only 'bot-pr promote'
and 'bot-pr signoff' add ${HUMAN_POSSESSIVE} own on their approval.

It also refuses those, revert, pull, stash and 'rework' in a shared clone that
other agents use: ${DEFAULT_SHARED_CLONE},
and any clone whose top directory matches a line of
${SHARED_CLONES_CONFIG}
(a path or glob per line; '~/' for the home directory, '#' for
comments; \$BOT_GIT_SHARED_CLONES names another file). Work in your own
worktree instead ('git worktree add'). For a rare one-line fix that has
to be made there, set ${ALLOW_SHARED_ENV}=1.

${PROG} rework keeps ${HUMAN_POSSESSIVE} sign-off on the commits reworked to act on
his review, after they were rewritten (e.g. with '${PROG} rebase'): it pairs
each commit of UPSTREAM..HEAD with the one of UPSTREAM..OLD-HEAD, the
published branch (default: @{upstream}; UPSTREAM defaults to their
merge-base), with the same subject. Commits new in HEAD are left as they
are; it refuses if a subject appears twice on either side, a commit of
OLD-HEAD is gone (dropped, squashed into another, or retitled), or the
pairs changed order. Each bot commit whose pair on OLD-HEAD carried his
sign-off with him as committer, as 'bot-pr promote' and 'bot-pr signoff'
make them, gets both back: the '${HUMAN_SIGNOFF}'
trailer (added if the rework dropped it) and him as committer, with a
fresh date. Trees, authors and messages stay otherwise as they are. It
never adds his sign-off to any other commit, and refuses a bot commit
that has his trailer where its pair had none, or another sign-off next
to his. After a rebase onto a newer base, pass that base as UPSTREAM.
Use it only when the change is what he asked for; see AGENTS.md.

--drop-signoff COMMIT (repeatable) removes his sign-off from the bot's
commit COMMIT of HEAD instead, and makes the bot its committer: for a
commit whose change goes beyond his asks, like one where a rebase
resolved conflicts (unless an attestation says otherwise; see
carry-signoff).

For a commit he asked to retitle, --pair OLD=NEW (repeatable) pairs the
commit OLD of OLD-HEAD with the one of HEAD that has NEW's subject, and
--patch-id pairs the commits left over whose patch-id is the same and
unique on both sides (a retitle with no other change). Both pair only a
bot commit of OLD-HEAD with his sign-off and him as committer with a bot
commit of HEAD; --pair refuses anything else, and a pair that the
subjects would contradict. Pass 'check' the same --pair and --patch-id.

${PROG} carry-signoff keeps ${HUMAN_POSSESSIVE} sign-off on commits changed beyond his
review asks (a conflict resolution, a small fix), on an independent
review's word that they are not substantively different. H0 is the head
whose commits he signed off and committed on his approval (as 'bot-pr
promote' or 'signoff' pushed it, or 'rework' kept it from that), never
a head that carry-signoff made: each carry compares with what he
approved ('bot-pr carry-note' refuses a chained one). HEAD (H1) is the
change. FILE
is that review's attestation, made by an agent other than the one that
made the change from 'git range-diff H0...H1', the PR and his review
(see the coordinator skill's carry-attest.md), as JSON:
  {"version": ${ATTESTATION_VERSION}, "pr": "https://github.com/OWNER/REPO/pull/N",
   "reviewer": "who attested, one line", "was": "H0", "head": "H1",
   "commits": [{"old": "COMMIT OF H0", "new": "COMMIT OF H1",
                "class": "CLASS", "reason": "one line"}, ...]}
with full commit ids, and CLASS one of: ${CARRY_CLASSES[*]}.
It pairs the commits as 'rework' does (UPSTREAM, --pair and --patch-id
the same), and refuses unless "was" is H0 and "head" is HEAD, and the
attestation classes exactly the bot commits of HEAD whose pair on H0 he
signed off and committed, with those pairs. Each of those gets his
sign-off and him as committer, as 'rework' gives them, except the
'${CARRY_DROP_CLASS}' ones, which lose both. A commit new since H0 never gets it:
an attestation that classes one is refused, and it stays as it is (one
with his sign-off is refused, as in 'rework'); it needs his approval
and 'bot-pr signoff'. It writes the record of what it did to --record's
FILE (default: FILE with .carried.json for .json), which 'bot-pr
carry-note' posts on the PR after the push, and prints the 'check' to run.

${PROG} drop-signoff UPSTREAM [COMMIT]... removes ${HUMAN_POSSESSIVE} sign-off from
the bot's commits COMMIT of UPSTREAM..HEAD (default: all of them), and
makes the bot their committer; others' commits are never touched. 'bot-pr
no-carry' runs it when he revokes a carried sign-off.

${PROG} check [RANGE] checks the commits in RANGE (default:
@{upstream}..HEAD, else origin/HEAD..HEAD, which must not be empty) before
pushing, and lists what's wrong with them:
  - fixup!/squash!/amend! commits, which belong squashed, and merges;
  - bot commits (by the email) whose author or committer isn't the bot
    (by either name), and others' commits committed by the bot's email
    under another name;
  - bot commits with a Signed-off-by (with --promoted, for a head that
    'bot-pr promote' signed off, those committed by ${HUMAN_LOGIN} with his;
    and those that '${PROG} rework' kept his on, committed by him, whose
    pair on the published branch had the same: @{upstream} for the
    default range, else --was OLD-HEAD, paired as 'rework' does, with
    --pair and --patch-id, with RANGE's start as UPSTREAM);
  - commits made as ${HUMAN_LOGIN} with a Generated-by trailer, which is the
    bot's work done with plain git; it warns about those he authored with
    an AI trailer, and others' commits he committed (except, with a
    published head to pair with as above, others' commits that only a
    rebase changed: the same author, message and patch-id as their pair,
    e.g. one he rewrote and pushed himself);
  - bot commits without a ${AI_TRAILER_KEYS[0]} or ${AI_TRAILER_KEYS[1]} trailer
    (--no-ai-trailer skips this, for projects that say not to add one).
It exits 1 if it found any errors; warnings don't fail it.
EOF
}

die() {
    echo "${PROG}: error: $*" 1>&2
    exit 1
}

# message_has_signoff TEXT: succeeds if TEXT has a Signed-off-by line,
# with any blanks git would ignore.
message_has_signoff() {
    grep -qiE '^[[:space:]]*signed-off-by[[:space:]]*:' <<<"$1"
}

# refuse_signoff GIT-ARGS...: exits if the git command would add a
# Signed-off-by: -s/--signoff (or a prefix of it), a Signed-off-by
# --trailer, or one in a -m message or -F file. This is best effort,
# since git has more ways (configured trailer aliases, hooks, editing the
# message); 'check' is the gate before pushing.
refuse_signoff() {
    local cmd a
    parse_git_command "$@"
    cmd=${GIT_CMD}
    shift "${#GIT_GLOBALS[@]}"
    test -z "${cmd}" || shift
    local opts=${SIGNOFF_SHORT_VALUE_OPTS[${cmd}]:-}
    local separate=${opts% *} attached=${opts#* }
    while test $# -gt 0; do
        a=$1
        shift
        case "${a}" in
            --) break ;;
            # git takes unambiguous prefixes of long options too.
            --si*)
                [[ "--signoff" == "${a%%=*}"* ]] || continue
                die "refusing '${a}': ${SIGNOFF_REFUSAL}" ;;
            --tr*|--me*|--fi*)
                local opt=${a%%=*} v=${1:-}
                [[ "--trailer" == "${opt}"* || "--message" == "${opt}"* || "--file" == "${opt}"* ]] || continue
                if test "${a}" = "${opt}"; then
                    shift || true
                else
                    v=${a#*=}
                fi
                if [[ "--trailer" == "${opt}"* ]]; then
                    ! message_has_signoff "${v}" || die "refusing a Signed-off-by trailer: ${SIGNOFF_REFUSAL}"
                elif test "${cmd}" = commit; then
                    check_message "${opt}" "${v}"
                fi ;;
            --*) ;;
            -?*)
                test -n "${opts}" || continue
                # A cluster like -as or -sm MSG: its letters up to the
                # first that takes a value.
                local i ch v
                for ((i = 1; i < ${#a}; i++)); do
                    ch=${a:i:1}
                    test "${ch}" != s || die "refusing '-s' (--signoff) for 'git ${cmd}': ${SIGNOFF_REFUSAL}"
                    [[ "${separate}${attached}" == *"${ch}"* ]] || continue
                    v=${a:i+1}
                    if test -z "${v}" && [[ "${separate}" == *"${ch}"* ]]; then
                        v=${1:-}
                        shift || true
                    fi
                    test "${cmd}" != commit || check_message "-${ch}" "${v}"
                    break
                done ;;
        esac
    done
}

# parse_git_command GIT-ARGS...: sets GIT_GLOBALS to the global options
# before the command (some with a separate value) and GIT_CMD to the
# command, empty if there is none.
parse_git_command() {
    GIT_GLOBALS=() GIT_CMD=""
    while test $# -gt 0; do
        case "$1" in
            -C|-c|--git-dir|--work-tree|--namespace|--config-env)
                test $# -ge 2 || break
                GIT_GLOBALS+=("$1" "$2")
                shift 2 ;;
            -*) GIT_GLOBALS+=("$1"); shift ;;
            *) GIT_CMD=$1; break ;;
        esac
    done
}

# shared_clone_patterns: prints the shared clones' paths and globs, one
# per line, with '~/' expanded and plain paths resolved.
shared_clone_patterns() {
    local line
    {
        echo "${DEFAULT_SHARED_CLONE}"
        test ! -e "${SHARED_CLONES_CONFIG}" || cat "${SHARED_CLONES_CONFIG}" ||
            die "cannot read ${SHARED_CLONES_CONFIG}"
    } | while IFS= read -r line || test -n "${line}"; do
        line=${line%%#*}
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        test -n "${line}" || continue
        [[ "${line}" != \~/* ]] || line=${HOME}/${line#\~/}
        if [[ "${line}" == *[*?[]* ]]; then
            echo "${line%/}"
        else
            realpath -m "${line}"
        fi
    done
}

# refuse_shared_clone COMMAND GIT-GLOBALS...: exits if COMMAND creates or
# rewrites commits and the repository that git with GIT-GLOBALS works on
# is a shared clone, unless ALLOW_SHARED_ENV is 1.
refuse_shared_clone() {
    local cmd=$1 top pattern
    shift
    [[ "${COMMIT_COMMANDS}${REWRITE_COMMANDS}" == *" ${cmd} "* ]] || return 0
    test "${!ALLOW_SHARED_ENV:-}" != 1 || return 0
    # Not in a work tree (a bare repository, or none): git says so itself.
    top=$(git "$@" rev-parse --show-toplevel 2>/dev/null) || return 0
    top=$(realpath -e "${top}") || return 0
    while IFS= read -r pattern; do
        # shellcheck disable=SC2053 # a glob, on purpose
        [[ "${top}" == ${pattern} ]] || continue
        die "refusing '${cmd}' in ${top}: it is a shared clone other agents use. Work in your own worktree:
    git -C ${top} worktree add -b bot/<slug> ~/.cache/bot-work/<task>/${top##*/} origin/HEAD
For a rare one-line fix that has to be made there, set ${ALLOW_SHARED_ENV}=1."
    done < <(shared_clone_patterns)
}

# check_message OPTION VALUE: for git commit's -m/--message and
# -F/--file, exits if the message has a Signed-off-by.
check_message() {
    local text
    case "$1" in
        -m|--me*) text=$2 ;;
        -F|--fi*) test "$2" != - && test -r "$2" || return 0; text=$(<"$2") ;;
        *) return 0 ;;
    esac
    ! message_has_signoff "${text}" || die "refusing a message with a Signed-off-by: ${SIGNOFF_REFUSAL}"
}

# default_base: prints the default base: @{upstream}, else origin/HEAD.
default_base() {
    local base
    for base in '@{upstream}' origin/HEAD; do
        if git rev-parse -q --verify "${base}^{commit}" >/dev/null 2>&1; then
            echo "${base}"
            return 0
        fi
    done
    die "HEAD has no upstream and there is no origin/HEAD; pass the RANGE to check, e.g. origin/main..HEAD"
}

# is_bot_name NAME: succeeds for the bot's name, current or old.
is_bot_name() {
    test "$1" = "${BOT_GIT_NAME}" || test "$1" = "${BOT_GIT_LEGACY_NAME}"
}

# has_human_signoff COMMIT: succeeds if COMMIT has the operator's sign-off
# trailer.
has_human_signoff() {
    local sobs
    sobs=$(git show -s --format='%(trailers:key=Signed-off-by,valueonly)' "$1")
    grep -qxF "${HUMAN_GIT_NAME} <${HUMAN_GIT_EMAIL}>" <<<"${sobs}"
}

# only_human_signoff COMMIT: succeeds if COMMIT's Signed-off-by trailers
# are all the operator's own, if any.
only_human_signoff() {
    local sobs
    sobs=$(git show -s --format='%(trailers:key=Signed-off-by,valueonly)' "$1")
    ! grep -vxF -e "${HUMAN_GIT_NAME} <${HUMAN_GIT_EMAIL}>" -e "" <<<"${sobs}" >/dev/null
}

# human_committed COMMIT: succeeds if the operator committed COMMIT, under
# his name.
human_committed() {
    local c
    c=$(git show -s --format='%cn <%ce>' "$1")
    test "${c,,}" = "${HUMAN_GIT_NAME,,} <${HUMAN_GIT_EMAIL,,}>"
}

# bot_authored COMMIT: succeeds if COMMIT's author email is the bot's.
bot_authored() {
    local ae
    ae=$(git show -s --format=%ae "$1")
    test "${ae,,}" = "${BOT_GIT_EMAIL,,}"
}

# signed_bot_commit COMMIT: succeeds for a bot commit with the operator's
# sign-off and him as committer, as 'bot-pr promote' makes them.
signed_bot_commit() {
    bot_authored "$1" && human_committed "$1" && has_human_signoff "$1" && only_human_signoff "$1"
}

# Explicit pairs for pair_commits, as OLD=NEW revisions (--pair of
# 'rework' and 'check'), and whether it pairs the commits left over by
# patch-id (--patch-id).
PAIR_EXPLICIT=()
PAIR_BY_PATCH_ID=false

# patch_id COMMIT: COMMIT's stable patch-id, empty for an empty change.
patch_id() {
    git diff-tree -p --no-color "$1" | git patch-id --stable | cut -d' ' -f1
}

# pair_commits OLD NEW UPSTREAM: pairs each commit of UPSTREAM..NEW with
# one of UPSTREAM..OLD into PAIR_NEW and PAIR_OLD (oldest first, PAIR_OLD
# empty for a commit new in NEW): first the PAIR_EXPLICIT pairs, then by
# subject, then (with PAIR_BY_PATCH_ID) by patch-id. Explicit and
# patch-id pairs are only for a signed_bot_commit on OLD and a bot commit
# on NEW. Fails with the reason in PAIR_ERROR where a pair is ambiguous or
# a commit was restructured: a subject twice on either side, an explicit
# pair that is not one of those or that the subjects contradict, a commit
# of OLD gone from NEW (dropped, squashed into another, or retitled
# without a pair), pairs in another order, merges, or no commits on OLD.
pair_commits() {
    local old=$1 new=$2 upstream=$3 i j k o n spec subject last=-1
    # Keyed by "s" and the subject, which may be empty.
    local -A old_by_subject=() new_by_subject=() old_index=() old_used=()
    local -a olds old_subjects new_subjects pair_of
    PAIR_OLD=() PAIR_NEW=() PAIR_ERROR=""
    mapfile -t olds < <(git rev-list --reverse "${upstream}..${old}")
    mapfile -t PAIR_NEW < <(git rev-list --reverse "${upstream}..${new}")
    if test "${#olds[@]}" -eq 0; then
        PAIR_ERROR="no commits in ${upstream}..${old} to pair with"
        return 1
    fi
    if test -n "$(git rev-list --merges "${upstream}..${old}" "${upstream}..${new}")"; then
        PAIR_ERROR="there are merge commits"
        return 1
    fi
    for i in "${!olds[@]}"; do
        subject=$(git show -s --format=%s "${olds[i]}")
        if test -n "${old_by_subject[s${subject}]:-}"; then
            PAIR_ERROR="'${subject}' is the subject of two commits of ${upstream}..${old}"
            return 1
        fi
        old_by_subject[s${subject}]=${i}
        old_subjects[i]=${subject}
        old_index[${olds[i]}]=${i}
    done
    for j in "${!PAIR_NEW[@]}"; do
        subject=$(git show -s --format=%s "${PAIR_NEW[j]}")
        if test -n "${new_by_subject[s${subject}]:-}"; then
            PAIR_ERROR="'${subject}' is the subject of two commits of ${upstream}..${new}"
            return 1
        fi
        new_by_subject[s${subject}]=${j}
        new_subjects[j]=${subject}
        pair_of[j]=""
    done
    for spec in "${PAIR_EXPLICIT[@]}"; do
        if [[ "${spec}" != ?*=?* ]]; then
            PAIR_ERROR="--pair takes OLD=NEW, not '${spec}'"
            return 1
        fi
        o=$(git rev-parse -q --verify "${spec%%=*}^{commit}") || { PAIR_ERROR="cannot resolve OLD of --pair ${spec}"; return 1; }
        n=$(git rev-parse -q --verify "${spec#*=}^{commit}") || { PAIR_ERROR="cannot resolve NEW of --pair ${spec}"; return 1; }
        i=${old_index[${o}]:-}
        if test -z "${i}"; then
            PAIR_ERROR="OLD of --pair ${spec} is not a commit of ${upstream}..${old}"
            return 1
        fi
        # NEW by its subject, which a rewrite by 'rework' keeps, so that
        # 'check' takes the same --pair afterwards.
        subject=$(git show -s --format=%s "${n}")
        j=${new_by_subject[s${subject}]:-}
        if test -z "${j}"; then
            PAIR_ERROR="no commit of ${upstream}..${new} has the subject '${subject}' of NEW of --pair ${spec}"
            return 1
        fi
        if test -n "${old_used[${i}]:-}" || test -n "${pair_of[j]}"; then
            PAIR_ERROR="--pair ${spec} pairs a commit that is already paired"
            return 1
        fi
        if ! signed_bot_commit "${olds[i]}"; then
            PAIR_ERROR="OLD of --pair ${spec} is not a bot commit that ${HUMAN_LOGIN} signed off and committed; only those take an explicit pair"
            return 1
        fi
        if ! bot_authored "${PAIR_NEW[j]}"; then
            PAIR_ERROR="'${subject}' of --pair ${spec} is not the bot's commit"
            return 1
        fi
        # The subjects must not pair either side with another commit.
        k=${new_by_subject[s${old_subjects[i]}]:-}
        if test -n "${k}" && test "${k}" != "${j}"; then
            PAIR_ERROR="--pair ${spec} is ambiguous: '${old_subjects[i]}' of OLD is still the subject of a commit of ${upstream}..${new}"
            return 1
        fi
        k=${old_by_subject[s${subject}]:-}
        if test -n "${k}" && test "${k}" != "${i}"; then
            PAIR_ERROR="--pair ${spec} is ambiguous: '${subject}' is the subject of another commit of ${upstream}..${old}"
            return 1
        fi
        pair_of[j]=${i}
        old_used[${i}]=1
    done
    for j in "${!PAIR_NEW[@]}"; do
        test -z "${pair_of[j]}" || continue
        i=${old_by_subject[s${new_subjects[j]}]:-}
        { test -n "${i}" && test -z "${old_used[${i}]:-}"; } || continue
        pair_of[j]=${i}
        old_used[${i}]=1
    done
    if ${PAIR_BY_PATCH_ID}; then
        # Only a patch-id that is unique among the commits left on both
        # sides; the counts are keyed by "o" or "n" and the patch-id.
        local -A pid_count=() old_by_pid=()
        local -a new_pids=()
        local pid
        for i in "${!olds[@]}"; do
            test -z "${old_used[${i}]:-}" || continue
            pid=$(patch_id "${olds[i]}")
            test -n "${pid}" || continue
            pid_count[o${pid}]=$((${pid_count[o${pid}]:-0} + 1))
            old_by_pid[${pid}]=${i}
        done
        for j in "${!PAIR_NEW[@]}"; do
            test -z "${pair_of[j]}" || continue
            pid=$(patch_id "${PAIR_NEW[j]}")
            new_pids[j]=${pid}
            test -n "${pid}" || continue
            pid_count[n${pid}]=$((${pid_count[n${pid}]:-0} + 1))
        done
        for j in "${!new_pids[@]}"; do
            pid=${new_pids[j]}
            { test -n "${pid}" && test "${pid_count[o${pid}]:-0}" -eq 1 && test "${pid_count[n${pid}]}" -eq 1; } || continue
            i=${old_by_pid[${pid}]}
            { signed_bot_commit "${olds[i]}" && bot_authored "${PAIR_NEW[j]}"; } || continue
            pair_of[j]=${i}
            old_used[${i}]=1
        done
    fi
    for j in "${!PAIR_NEW[@]}"; do
        i=${pair_of[j]}
        if test -z "${i}"; then
            PAIR_OLD+=("")
            continue
        fi
        if test "${i}" -lt "${last}"; then
            PAIR_ERROR="'${new_subjects[j]}' moved before an earlier commit"
            return 1
        fi
        last=${i}
        PAIR_OLD+=("${olds[i]}")
    done
    for i in "${!olds[@]}"; do
        test -z "${old_used[${i}]:-}" || continue
        PAIR_ERROR="'${old_subjects[i]}' of ${upstream}..${old} is gone from ${upstream}..${new} (if ${HUMAN_LOGIN} asked to retitle it, pair it with --pair $(git rev-parse --short "${olds[i]}")=NEW)"
        return 1
    done
}

# kept_note NEW OLD: the line naming a sign-off kept from OLD on NEW.
kept_note() {
    echo "kept ${HUMAN_POSSESSIVE} sign-off on $(git rev-parse --short "$1") (was on $(git rev-parse --short "$2")); name it in your reply"
}

# unchanged_note NEW OLD: the line naming someone else's commit rebased
# unchanged from the published OLD.
unchanged_note() {
    echo "not the bot's: $(git rev-parse --short "$2") of the published head, rebased unchanged"
}

# rebased_unchanged NEW OLD: succeeds if NEW is OLD with only its parent
# and committer changed: the same author, message and patch-id.
rebased_unchanged() {
    local fmt='%an <%ae> %ad%n%B'
    test "$(git show -s --format="${fmt}" --date=raw "$1")" = "$(git show -s --format="${fmt}" --date=raw "$2")" &&
        test "$(patch_id "$1")" = "$(patch_id "$2")"
}

# problems COMMIT CHECK_TRAILER PROMOTED: prints one line per problem
# with COMMIT, as 'error: ...' or 'warning: ...', or a 'note: ...' for a
# sign-off kept as its pair in PAIRED had it, or for someone else's
# commit rebased unchanged from its pair (see cmd_check).
problems() {
    local c=$1 check_trailer=$2 promoted=$3 an ae cn ce parents subject sobs ai key
    local -a f
    mapfile -t f < <(git show -s --format='%an%n%ae%n%cn%n%ce%n%p%n%s' "${c}")
    an=${f[0]} ae=${f[1],,} cn=${f[2]} ce=${f[3],,} parents=${f[4]} subject=${f[5]}
    sobs=$(git show -s --format='%(trailers:key=Signed-off-by,valueonly)' "${c}")
    ai=""
    for key in "${AI_TRAILER_KEYS[@]}"; do
        ai+=$(git show -s --format="%(trailers:key=${key})" "${c}")
    done
    if [[ "${subject}" =~ ${SQUASH_SUBJECT_RE} ]]; then
        echo "error: a '${subject%% *}' commit: squash it into the commit it fixes"
    fi
    if [[ "${parents}" == *" "* ]]; then
        echo "error: a merge commit: rebase instead ('bot-pr promote' refuses merges)"
    fi
    local human=${HUMAN_GIT_EMAIL,,} bot=${BOT_GIT_EMAIL,,}
    if test "${ae}" != "${bot}"; then
        if test "${ce}" = "${bot}" && ! is_bot_name "${cn}"; then
            echo "error: committed as '${cn} <${f[3]}>', not '${BOT_GIT_NAME} <${BOT_GIT_EMAIL}>': rebase with ${PROG}"
        fi
        # A commit as the published branch has it, only rebased (e.g. one
        # the operator rewrote and pushed themselves): what it is was decided
        # when it was published, not by this rebase.
        local was=${PAIRED[${c}]:-}
        if test -n "${was}" && rebased_unchanged "${c}" "${was}"; then
            echo "note: $(unchanged_note "${c}" "${was}")"
            return 0
        fi
        # The bot's work, done with plain git on this machine, whose own
        # identity is the operator's.
        if { test "${ae}" = "${human}" || test "${ce}" = "${human}"; } &&
            git show -s --format="%(trailers:key=${AI_TRAILER_KEYS[0]})" "${c}" | grep -q .; then
            echo "error: has a ${AI_TRAILER_KEYS[0]} trailer but was made as ${HUMAN_LOGIN} (${an} <${f[1]}> / ${cn} <${f[3]}>): commit with ${PROG}"
        elif test "${ae}" = "${human}" && test -n "${ai}"; then
            echo "warning: authored by ${HUMAN_LOGIN} with an AI trailer: if the bot wrote it with plain git, recommit it with ${PROG}"
        elif test "${ae}" != "${human}" && test "${ce}" = "${human}"; then
            echo "warning: someone else's commit, committed by ${HUMAN_LOGIN}: if the bot rebased it with plain git, redo that with ${PROG}"
        fi
        return 0
    fi
    is_bot_name "${an}" || echo "error: authored as '${an} <${f[1]}>', not '${BOT_GIT_NAME} <${BOT_GIT_EMAIL}>'"
    # What 'bot-pr promote' makes of a bot commit on the operator's approval:
    # committed by him, with his sign-off. Only with --promoted, since a
    # plain 'git commit --amend -s' here makes the same.
    local as_promoted=false was=${PAIRED[${c}]:-}
    if test "${cn} <${ce}>" = "${HUMAN_GIT_NAME} <${human}>" &&
        grep -qxF "${HUMAN_GIT_NAME} <${HUMAN_GIT_EMAIL}>" <<<"${sobs}"; then
        if ${promoted}; then
            as_promoted=true
        # What 'rework' makes of such a commit: only where its pair on the
        # published branch had the same.
        elif test -n "${was}" && signed_bot_commit "${was}" && only_human_signoff "${c}"; then
            as_promoted=true
            echo "note: $(kept_note "${c}" "${was}")"
        fi
    fi
    if ! ${as_promoted} && ! { test "${ce}" = "${bot}" && is_bot_name "${cn}"; }; then
        echo "error: committed as '${cn} <${f[3]}>', not '${BOT_GIT_NAME} <${BOT_GIT_EMAIL}>': commit and rebase with ${PROG}"
    fi
    if test -n "${sobs}" && ! ${as_promoted}; then
        echo "error: has Signed-off-by: $(paste -sd, - <<<"${sobs}" | sed 's/,/, /g'); ${SIGNOFF_REFUSAL} (for a head promote signed off, use --promoted; 'rework' keeps his only where the published branch had it${PAIR_ERROR:+, but ${PAIR_ERROR}})"
    fi
    if ${check_trailer} && test -z "${ai}"; then
        echo "error: no ${AI_TRAILER_KEYS[0]}: AI (or ${AI_TRAILER_KEYS[1]}) trailer"
    fi
}

cmd_check() {
    local range="" check_trailer=true promoted=false was=""
    while test $# -gt 0; do
        case "$1" in
            --no-ai-trailer) check_trailer=false; shift ;;
            --promoted) promoted=true; shift ;;
            --was) test $# -ge 2 || die "--was takes the published head"; was=$2; shift 2 ;;
            --was=*) was=${1#*=}; shift ;;
            --pair) test $# -ge 2 || die "--pair takes OLD=NEW"; PAIR_EXPLICIT+=("$2"); shift 2 ;;
            --pair=*) PAIR_EXPLICIT+=("${1#*=}"); shift ;;
            --patch-id) PAIR_BY_PATCH_ID=true; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) die "unknown option for check: $1 (see --help)" ;;
            *) test -z "${range}" || die "check takes one RANGE"; range=$1; shift ;;
        esac
    done
    local default=false base
    if test -z "${range}"; then
        default=true
        base=$(default_base)
        range="${base}..HEAD"
        echo "checking ${range}"
        test -n "${was}" || test "${base}" != '@{upstream}' || was=${base}
    fi
    pair_published "${range}" "${was}"
    local commits c n=0 bad=0 warned=0 kept=0 unchanged=0 p=()
    commits=$(git rev-list --reverse "${range}") || die "cannot list the commits in '${range}'"
    for c in ${commits}; do
        n=$((n + 1))
        mapfile -t p < <(problems "${c}" "${check_trailer}" "${promoted}")
        test "${#p[@]}" -gt 0 || continue
        if printf '%s\n' "${p[@]}" | grep -q '^error:'; then
            bad=$((bad + 1))
        elif printf '%s\n' "${p[@]}" | grep -q '^warning:'; then
            warned=$((warned + 1))
        elif printf '%s\n' "${p[@]}" | grep -q "^note: not the bot's"; then
            unchanged=$((unchanged + 1))
        else
            kept=$((kept + 1))
        fi
        git show -s --format='%h %s (%an <%ae> / %cn <%ce>)' "${c}"
        printf '    %s\n' "${p[@]}"
    done
    ! ${default} || test "${n}" -gt 0 ||
        die "no commits in ${range}; pass the RANGE to check, e.g. origin/main..HEAD"
    if test "${bad}" -gt 0; then
        echo "${PROG}: ${bad} of ${n} commits in ${range} need fixing before pushing" 1>&2
        exit 1
    fi
    echo "ok: ${n} commits in ${range}$(test "${warned}" -eq 0 || echo ", ${warned} with warnings")$(test "${kept}" -eq 0 || echo ", ${kept} with ${HUMAN_POSSESSIVE} sign-off kept")$(test "${unchanged}" -eq 0 || echo ", ${unchanged} not the bot's, rebased unchanged")"
}

# pair_published RANGE WAS: for check, pairs RANGE's commits with those of
# the published head WAS as 'rework' does, filling PAIRED (new commit ->
# old); the pairs start after RANGE's start, or after the merge-base when
# that is WAS itself. Sets PAIR_ERROR to why nothing is paired.
pair_published() {
    local range=$1 was=$2 from to old tip
    declare -gA PAIRED=()
    PAIR_ERROR=""
    if test -z "${was}"; then
        test "${#PAIR_EXPLICIT[@]}" -eq 0 || die "--pair needs the published head: pass --was OLD-HEAD"
        PAIR_ERROR="no published head to compare with (pass --was OLD-HEAD)"
        return 0
    fi
    if [[ "${range}" != *..* || "${range}" == *...* ]]; then
        PAIR_ERROR="'${range}' is not a BASE..TIP range"
        return 0
    fi
    from=${range%%..*} to=${range#*..}
    old=$(git rev-parse -q --verify "${was}^{commit}") || die "cannot resolve --was '${was}'"
    tip=$(git rev-parse -q --verify "${to:-HEAD}^{commit}") || die "cannot resolve '${to}'"
    from=$(git rev-parse -q --verify "${from:-HEAD}^{commit}") || die "cannot resolve the start of '${range}'"
    if test "${from}" = "${old}"; then
        from=$(git merge-base "${old}" "${tip}") || die "${was} and ${to:-HEAD} have no merge-base"
    fi
    if ! pair_commits "${old}" "${tip}" "${from}"; then
        test "${#PAIR_EXPLICIT[@]}" -eq 0 || die "cannot pair ${range} with ${was}: ${PAIR_ERROR}"
        return 0
    fi
    local i
    for i in "${!PAIR_NEW[@]}"; do
        test -z "${PAIR_OLD[i]}" || PAIRED[${PAIR_NEW[i]}]=${PAIR_OLD[i]}
    done
}

# refuse_rebase_in_progress: exits if a rebase is in progress.
refuse_rebase_in_progress() {
    local gitdir
    gitdir=$(git rev-parse --git-dir) || die "not in a git repository"
    if test -e "${gitdir}/rebase-merge" || test -e "${gitdir}/rebase-apply"; then
        die "a rebase is in progress; finish it first"
    fi
}

# pair_with_published WAS UPSTREAM: for rework and carry-signoff, pairs
# the commits of UPSTREAM..HEAD with those of UPSTREAM..WAS (see
# pair_commits; WAS defaults to @{upstream}, UPSTREAM to their
# merge-base), into PAIR_OLD and PAIR_NEW, and sets PAIRED_WAS,
# PAIRED_OLD_HEAD, PAIRED_HEAD and PAIRED_BASE. Exits if that fails, or
# if a rebase is in progress.
pair_with_published() {
    local was=$1 upstream=$2 old head base
    refuse_rebase_in_progress
    if test -z "${was}"; then
        git rev-parse -q --verify '@{upstream}^{commit}' >/dev/null 2>&1 ||
            die "HEAD has no upstream; pass the published head with --was OLD-HEAD"
        was='@{upstream}'
    fi
    old=$(git rev-parse -q --verify "${was}^{commit}") || die "cannot resolve '${was}'"
    head=$(git rev-parse -q --verify 'HEAD^{commit}') || die "cannot resolve HEAD"
    if test -n "${upstream}"; then
        base=$(git rev-parse -q --verify "${upstream}^{commit}") || die "cannot resolve '${upstream}'"
    else
        base=$(git merge-base "${old}" "${head}") || die "${was} and HEAD have no merge-base; pass UPSTREAM"
    fi
    pair_commits "${old}" "${head}" "${base}" ||
        die "cannot pair the reworked commits with ${was}: ${PAIR_ERROR}; a change that restructures the commits needs ${HUMAN_LOGIN} to sign off again$(test -n "${upstream}" || echo " (if HEAD was rebased onto a newer base, pass it as UPSTREAM)")"
    test "${#PAIR_NEW[@]}" -gt 0 || die "no commits in ${base}..HEAD"
    # With the merge-base as UPSTREAM, a rebase onto a newer base brings in
    # its commits, which are not ours to rewrite.
    if test -z "${upstream}"; then
        local i
        for i in "${!PAIR_NEW[@]}"; do
            test -z "${PAIR_OLD[i]}" || continue
            bot_authored "${PAIR_NEW[i]}" ||
                die "$(git rev-parse --short "${PAIR_NEW[i]}") is new since ${was} and not the bot's: if HEAD was rebased onto a newer base, pass it as UPSTREAM"
        done
    fi
    PAIRED_WAS=${was} PAIRED_OLD_HEAD=${old} PAIRED_HEAD=${head} PAIRED_BASE=${base}
}

# signed_pair NEW OLD WAS: for the pair OLD (of the published head WAS,
# empty for none) and NEW, succeeds if OLD is a bot commit that he signed
# off and committed, whose sign-off NEW may then keep; fails for any
# other pair that leaves NEW's sign-off as it is. Exits where NEW can't
# be either: a commit with his sign-off that is new since WAS or whose
# pair had none, and a pair of his signed commit that is not the bot's or
# has another sign-off.
signed_pair() {
    local n=$1 o=$2 was=$3
    if test -z "${o}"; then
        ! { bot_authored "${n}" && has_human_signoff "${n}"; } ||
            die "$(git rev-parse --short "${n}") has ${HUMAN_POSSESSIVE} sign-off, but is new since ${was}: ${SIGNOFF_REFUSAL}"
        return 1
    fi
    if signed_bot_commit "${o}"; then
        bot_authored "${n}" ||
            die "$(git rev-parse --short "${n}") is not the bot's commit, but its pair $(git rev-parse --short "${o}") on ${was} is; not keeping the sign-off"
        only_human_signoff "${n}" ||
            die "$(git rev-parse --short "${n}") has a Signed-off-by other than ${HUMAN_POSSESSIVE}: ${SIGNOFF_REFUSAL}"
        return 0
    fi
    ! { bot_authored "${n}" && has_human_signoff "${n}" && ! has_human_signoff "${o}"; } ||
        die "$(git rev-parse --short "${n}") has ${HUMAN_POSSESSIVE} sign-off, but its pair $(git rev-parse --short "${o}") on ${was} had none: ${SIGNOFF_REFUSAL}"
    return 1
}

# What rewrite_commits does to each commit, by its id: keep (his sign-off
# trailer, added if missing, and him as committer, as 'bot-pr promote'
# makes them) or drop (neither: the trailer removed, the bot as
# committer); any other commit is only recreated on its new parent, with
# its committer and date. REWRITTEN maps each commit to what it became.
declare -A REWRITE=() REWRITTEN=()
REWRITE_MSG=""
trap 'test -z "${REWRITE_MSG}" || rm -f "${REWRITE_MSG}"' EXIT

# rewrite_commits BASE HEAD REASON: rewrites BASE..HEAD as REWRITE says,
# keeping trees, authors and messages otherwise, and moves HEAD (at HEAD)
# to the result, with REASON in the reflog. Fails, changing nothing, if
# every commit is as REWRITE wants it already.
rewrite_commits() {
    local base=$1 head=$2 reason=$3 parent n action new rewriting=false committer
    local -a rewrite_range
    REWRITTEN=()
    mapfile -t rewrite_range < <(git rev-list --reverse "${base}..${head}")
    test "${#rewrite_range[@]}" -gt 0 || die "no commits in ${base}..${head}"
    # commit-tree below gives each commit one parent.
    test -z "$(git rev-list --merges "${base}..${head}")" || die "there are merge commits in ${base}..${head}; not rewriting them"
    parent=$(git rev-parse "${rewrite_range[0]}^")
    test -n "${REWRITE_MSG}" || REWRITE_MSG=$(mktemp) || die "cannot create a temporary file"
    for n in "${rewrite_range[@]}"; do
        action=${REWRITE[${n}]:-}
        if ! ${rewriting}; then
            local as_wanted=false
            case "${action}" in
                keep) ! { human_committed "${n}" && has_human_signoff "${n}"; } || as_wanted=true ;;
                drop) human_committed "${n}" || has_human_signoff "${n}" || as_wanted=true ;;
                *) as_wanted=true ;;
            esac
            if ${as_wanted}; then
                REWRITTEN[${n}]=${n}
                parent=${n}
                continue
            fi
        fi
        # The message, byte for byte (see bot-pr's add_signoff): the header
        # ends at the first empty line; commit-tree can't keep an encoding.
        ! git cat-file commit "${n}" |
            awk '/^$/ { in_body = 1 } !in_body && /^encoding / { found = 1 } END { exit !found }' ||
            die "$(git rev-parse --short "${n}") has a non-UTF-8 message encoding"
        git cat-file commit "${n}" | sed '1,/^$/d' >"${REWRITE_MSG}" || die "cannot read the message of ${n}"
        case "${action}" in
            keep)
                if ! has_human_signoff "${n}"; then
                    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
                        git interpret-trailers --in-place --no-divider --where end --if-exists addIfDifferent \
                        --trailer "${HUMAN_SIGNOFF}" "${REWRITE_MSG}" || die "adding the sign-off to ${n} failed"
                fi
                committer=(GIT_COMMITTER_NAME="${HUMAN_GIT_NAME}" GIT_COMMITTER_EMAIL="${HUMAN_GIT_EMAIL}") ;;
            drop)
                # His trailer lines, then the empty lines that leaves at the end.
                awk -v sob="${HUMAN_SIGNOFF}" '$0 != sob { line[n++] = $0 }
                    END { while (n > 0 && line[n - 1] == "") n--; for (i = 0; i < n; i++) print line[i] }' \
                    "${REWRITE_MSG}" >"${REWRITE_MSG}.new" || die "removing the sign-off from ${n} failed"
                mv "${REWRITE_MSG}.new" "${REWRITE_MSG}" || die "removing the sign-off from ${n} failed"
                committer=(GIT_COMMITTER_NAME="${BOT_GIT_NAME}" GIT_COMMITTER_EMAIL="${BOT_GIT_EMAIL}") ;;
            *)
                committer=(GIT_COMMITTER_NAME="$(git show -s --format=%cn "${n}")"
                    GIT_COMMITTER_EMAIL="$(git show -s --format=%ce "${n}")"
                    GIT_COMMITTER_DATE="$(git show -s --format=%cd --date=raw "${n}")") ;;
        esac
        new=$(env -u GIT_COMMITTER_DATE \
            GIT_AUTHOR_NAME="$(git show -s --format=%an "${n}")" GIT_AUTHOR_EMAIL="$(git show -s --format=%ae "${n}")" \
            GIT_AUTHOR_DATE="$(git show -s --format=%ad --date=raw "${n}")" "${committer[@]}" \
            git -c core.hooksPath=/dev/null -c commit.gpgSign=false -c i18n.commitEncoding=UTF-8 \
            commit-tree --no-gpg-sign "${n}^{tree}" -p "${parent}" -F "${REWRITE_MSG}") || die "rewriting ${n} failed"
        test "${action}" != drop || ! has_human_signoff "${new}" ||
            die "$(git rev-parse --short "${n}") has ${HUMAN_POSSESSIVE} sign-off in a form this can't remove; not updating HEAD"
        REWRITTEN[${n}]=${new}
        parent=${new}
        rewriting=true
    done
    ${rewriting} || return 1
    test "$(git rev-parse "${parent}^{tree}")" = "$(git rev-parse "${head}^{tree}")" ||
        die "the rewritten ${parent} has a different tree from HEAD; not updating HEAD"
    git update-ref -m "${reason}" HEAD "${parent}" "${head}" || die "cannot update HEAD to ${parent}"
}

cmd_rework() {
    local was="" upstream="" drops=()
    while test $# -gt 0; do
        case "$1" in
            --drop-signoff) test $# -ge 2 || die "--drop-signoff takes a COMMIT"; drops+=("$2"); shift 2 ;;
            --drop-signoff=*) drops+=("${1#*=}"); shift ;;
            --was) test $# -ge 2 || die "--was takes the published head"; was=$2; shift 2 ;;
            --was=*) was=${1#*=}; shift ;;
            --pair) test $# -ge 2 || die "--pair takes OLD=NEW"; PAIR_EXPLICIT+=("$2"); shift 2 ;;
            --pair=*) PAIR_EXPLICIT+=("${1#*=}"); shift ;;
            --patch-id) PAIR_BY_PATCH_ID=true; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) die "unknown option for rework: $1 (see --help)" ;;
            *) test -z "${upstream}" || die "rework takes one UPSTREAM"; upstream=$1; shift ;;
        esac
    done
    pair_with_published "${was}" "${upstream}"
    local old=${PAIRED_OLD_HEAD} head=${PAIRED_HEAD} base=${PAIRED_BASE}
    was=${PAIRED_WAS}

    local i o n d notes=()
    REWRITE=()
    # --drop-signoff: commits whose change goes beyond what he asked for
    # (a rebase that resolved conflicts in them, say) lose it instead.
    local -A in_head=()
    for n in "${PAIR_NEW[@]}"; do
        in_head[${n}]=1
    done
    for d in "${drops[@]}"; do
        n=$(git rev-parse -q --verify "${d}^{commit}") || die "cannot resolve --drop-signoff ${d}"
        test -n "${in_head[${n}]:-}" || die "--drop-signoff ${d} is not a commit of $(short "${base}")..HEAD"
        bot_authored "${n}" || die "--drop-signoff ${d} is not the bot's commit; its sign-offs are not the bot's to change"
        REWRITE[${n}]=drop
    done
    for i in "${!PAIR_NEW[@]}"; do
        o=${PAIR_OLD[i]} n=${PAIR_NEW[i]}
        test -z "${REWRITE[${n}]:-}" || continue
        if signed_pair "${n}" "${o}" "${was}"; then
            REWRITE[${n}]=keep
        fi
    done
    if ! rewrite_commits "${base}" "${head}" "${PROG} rework: keep ${HUMAN_POSSESSIVE} sign-off from ${was}"; then
        echo "nothing to do: no reworked commit lacks the sign-off its pair on ${was} had$(test "${#drops[@]}" -eq 0 || echo ", and none to drop it from has it")"
        return 0
    fi
    for i in "${!PAIR_NEW[@]}"; do
        o=${PAIR_OLD[i]} n=${PAIR_NEW[i]}
        test "${REWRITTEN[${n}]}" != "${n}" || continue
        case "${REWRITE[${n}]:-}" in
            keep) notes+=("$(kept_note "${REWRITTEN[${n}]}" "${o}")") ;;
            drop) notes+=("dropped ${HUMAN_POSSESSIVE} sign-off from $(short "${REWRITTEN[${n}]}") (was $(short "${n}")): it needs his approval and 'bot-pr signoff'") ;;
        esac
    done
    printf '%s\n' "${notes[@]}"
    if test "${#PAIR_EXPLICIT[@]}" -gt 0 || ${PAIR_BY_PATCH_ID}; then
        local args=(--was "${was}") spec
        for spec in "${PAIR_EXPLICIT[@]}"; do
            args+=(--pair "${spec}")
        done
        ! ${PAIR_BY_PATCH_ID} || args+=(--patch-id)
        echo "check it with the same pairs: ${PROG} check ${args[*]} $(git rev-parse --short "${base}")..HEAD"
    fi
}

# short COMMIT: COMMIT's abbreviated id.
short() {
    git rev-parse --short "$1"
}

# attestation_problem FILE: prints what is wrong with the attestation in
# FILE, or nothing if it has the shape carry-signoff wants (see usage).
attestation_problem() {
    local classes
    classes=$(printf '%s\n' "${CARRY_CLASSES[@]}" | jq -R . | jq -sc .) || die "jq failed"
    jq -r --argjson classes "${classes}" --argjson v "${ATTESTATION_VERSION}" '
        def sha: type == "string" and test("^[0-9a-f]{40}$");
        def line: type == "string" and test("\\S") and (test("\n") | not);
        def commit_problems: to_entries[] | .key as $i | .value |
            if type != "object" then "commits[\($i)] is not an object"
            elif (.old | sha | not) or (.new | sha | not) then "commits[\($i)] lacks full old and new commit ids"
            elif (.class | IN($classes[]) | not) then "commits[\($i)].class \(.class | tojson) is not one of \($classes | join(", "))"
            elif (.reason | line | not) then "commits[\($i)].reason is not one line"
            else empty end;
        [ if type != "object" then "it is not a JSON object"
          elif .version != $v then "version is not \($v)"
          elif (.was | sha | not) then "was is not a full commit id"
          elif (.head | sha | not) then "head is not a full commit id"
          elif (.pr | type == "string" and test("^https://github\\.com/[^/]+/[^/]+/pull/[0-9]+$") | not) then "pr is not a PR URL"
          elif (.reviewer | line | not) then "reviewer does not name the reviewing agent in one line"
          elif (.commits | type != "array") then "commits is not an array"
          else (.commits | commit_problems),
            (if (.commits | map(.new) | unique | length) != (.commits | length)
                or (.commits | map(.old) | unique | length) != (.commits | length)
             then "a commit is listed twice" else empty end)
          end ] | .[0] // empty' "$1" 2>/dev/null || echo "it is not valid JSON"
}

cmd_carry_signoff() {
    local was="" attestation="" record="" upstream=""
    while test $# -gt 0; do
        case "$1" in
            --was) test $# -ge 2 || die "--was takes the head he signed off"; was=$2; shift 2 ;;
            --was=*) was=${1#*=}; shift ;;
            --attestation) test $# -ge 2 || die "--attestation takes a FILE"; attestation=$2; shift 2 ;;
            --attestation=*) attestation=${1#*=}; shift ;;
            --record) test $# -ge 2 || die "--record takes a FILE"; record=$2; shift 2 ;;
            --record=*) record=${1#*=}; shift ;;
            --pair) test $# -ge 2 || die "--pair takes OLD=NEW"; PAIR_EXPLICIT+=("$2"); shift 2 ;;
            --pair=*) PAIR_EXPLICIT+=("${1#*=}"); shift ;;
            --patch-id) PAIR_BY_PATCH_ID=true; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) die "unknown option for carry-signoff: $1 (see --help)" ;;
            *) test -z "${upstream}" || die "carry-signoff takes one UPSTREAM"; upstream=$1; shift ;;
        esac
    done
    test -n "${was}" || die "carry-signoff needs --was H0, the head whose commits ${HUMAN_LOGIN} signed off"
    test -n "${attestation}" || die "carry-signoff needs --attestation FILE, from an independent review of the change (see --help)"
    command -v jq >/dev/null || die "jq not found in PATH"
    test -r "${attestation}" || die "cannot read ${attestation}"
    record=${record:-${attestation%.json}.carried.json}
    test "$(realpath -m "${record}")" != "$(realpath -m "${attestation}")" ||
        die "--record ${record} is the attestation itself; write the record elsewhere"
    local problem
    problem=$(attestation_problem "${attestation}")
    test -z "${problem}" || die "${attestation}: ${problem}; not carrying anything"

    # The attestation is for exactly this change: from WAS to HEAD.
    local att_was att_head old head
    att_was=$(jq -r .was "${attestation}") att_head=$(jq -r .head "${attestation}")
    old=$(git rev-parse -q --verify "${was}^{commit}") || die "cannot resolve '${was}'"
    head=$(git rev-parse -q --verify 'HEAD^{commit}') || die "cannot resolve HEAD"
    test "${old}" = "${att_was}" ||
        die "${attestation} attests a change from ${att_was:0:12}, not from ${was} (${old:0:12}); not carrying anything"
    test "${head}" = "${att_head}" ||
        die "${attestation} attests the head ${att_head:0:12}, but HEAD is ${head:0:12}: have the current head attested; not carrying anything"
    pair_with_published "${old}" "${upstream}"
    local base=${PAIRED_BASE}

    local -A att_old=() att_class=() used=()
    local o n c i
    while IFS=$'\t' read -r o n c; do
        att_old[${n}]=${o} att_class[${n}]=${c}
    done < <(jq -r '.commits[] | [.old, .new, .class] | @tsv' "${attestation}")
    REWRITE=()
    local -a unpaired=()
    for i in "${!PAIR_NEW[@]}"; do
        o=${PAIR_OLD[i]} n=${PAIR_NEW[i]}
        if signed_pair "${n}" "${o}" "${was}"; then
            c=${att_class[${n}]:-}
            test -n "${c}" ||
                die "$(short "${n}"), paired with $(short "${o}") that ${HUMAN_LOGIN} signed off, has no class in ${attestation}: every such commit needs one; not carrying anything"
            test "${att_old[${n}]}" = "${o}" ||
                die "${attestation} pairs $(short "${n}") with ${att_old[${n}]:0:12}, but it pairs with $(short "${o}") of ${was}; not carrying anything"
            used[${n}]=1
            if test "${c}" = "${CARRY_DROP_CLASS}"; then
                REWRITE[${n}]=drop
            else
                REWRITE[${n}]=keep
            fi
        elif test -n "${att_class[${n}]:-}"; then
            test -n "${o}" ||
                die "${attestation} classes $(short "${n}"), but it is new since ${was}, with no counterpart there: such a commit never gets ${HUMAN_POSSESSIVE} sign-off this way, only on his approval with 'bot-pr signoff'; not carrying anything"
            die "${attestation} classes $(short "${n}"), but its pair $(short "${o}") on ${was} is not a bot commit he signed off and committed, so there is no sign-off to carry; not carrying anything"
        elif test -z "${o}"; then
            unpaired+=("${n}")
        fi
    done
    for n in "${!att_class[@]}"; do
        test -n "${used[${n}]:-}" ||
            die "${attestation} classes ${n:0:12}, which is not a commit of $(short "${base}")..HEAD; not carrying anything"
    done

    # The record is what the PR comment is made of: never rewrite without it.
    { : >>"${record}"; } 2>/dev/null || die "cannot write ${record}; not carrying anything"
    rewrite_commits "${base}" "${head}" "${PROG} carry-signoff: from ${was} per ${attestation}" || true
    local new_head entries=()
    new_head=$(git rev-parse HEAD)
    for i in "${!PAIR_NEW[@]}"; do
        n=${PAIR_NEW[i]}
        case "${REWRITE[${n}]:-}" in
            keep) echo "carried ${HUMAN_POSSESSIVE} sign-off to $(short "${REWRITTEN[${n}]}") (was $(short "${PAIR_OLD[i]}"); ${att_class[${n}]})" ;;
            drop) echo "dropped ${HUMAN_POSSESSIVE} sign-off from $(short "${REWRITTEN[${n}]}") (was $(short "${PAIR_OLD[i]}"); ${CARRY_DROP_CLASS}): it needs his approval and 'bot-pr signoff'" ;;
            *) continue ;;
        esac
        entries+=("$(jq -c --arg attested "${n}" --arg new "${REWRITTEN[${n}]}" --arg action "${REWRITE[${n}]}" \
            '.commits[] | select(.new == $attested) | {old, attested: .new, new: $new, class, reason, carried: ($action == "keep")}' \
            "${attestation}")")
    done
    for n in "${unpaired[@]}"; do
        echo "$(short "${REWRITTEN[${n}]}") is new since ${was}: no sign-off of his; it needs his approval and 'bot-pr signoff'"
    done
    local new_commits
    new_commits=$(for n in "${unpaired[@]}"; do echo "${REWRITTEN[${n}]}"; done | jq -R . | jq -sc .)
    printf '%s\n' "${entries[@]}" | jq -s --slurpfile att "${attestation}" --arg head "${new_head}" --arg base "${base}" \
        --argjson new_commits "${new_commits}" \
        '{version: $att[0].version, pr: $att[0].pr, reviewer: $att[0].reviewer, was: $att[0].was,
          attested_head: $att[0].head, head: $head, base: $base, commits: ., new_commits: $new_commits}' >"${record}" ||
        die "cannot write ${record}"
    local args=(--was "${was}") spec
    for spec in "${PAIR_EXPLICIT[@]}"; do
        args+=(--pair "${spec}")
    done
    ! ${PAIR_BY_PATCH_ID} || args+=(--patch-id)
    echo "check it: ${PROG} check ${args[*]} $(short "${base}")..HEAD"
    echo "after pushing it, post the audit comment: bot-pr carry-note $(jq -r .pr "${attestation}") ${record}"
}

cmd_drop_signoff() {
    local upstream="" a c base head
    local -a named=()
    while test $# -gt 0; do
        case "$1" in
            -h|--help) usage; exit 0 ;;
            -*) die "unknown option for drop-signoff: $1 (see --help)" ;;
            *) if test -z "${upstream}"; then upstream=$1; else named+=("$1"); fi; shift ;;
        esac
    done
    test -n "${upstream}" || die "drop-signoff needs UPSTREAM (see --help)"
    refuse_rebase_in_progress
    base=$(git rev-parse -q --verify "${upstream}^{commit}") || die "cannot resolve '${upstream}'"
    head=$(git rev-parse -q --verify 'HEAD^{commit}') || die "cannot resolve HEAD"
    local -a range_commits
    local -A in_range=()
    mapfile -t range_commits < <(git rev-list --reverse "${base}..${head}")
    for c in "${range_commits[@]}"; do
        in_range[${c}]=1
    done
    REWRITE=()
    for a in "${named[@]}"; do
        c=$(git rev-parse -q --verify "${a}^{commit}") || die "cannot resolve '${a}'"
        test -n "${in_range[${c}]:-}" || die "${a} is not a commit of ${upstream}..HEAD"
        bot_authored "${c}" || die "${a} is not the bot's commit; drop-signoff never touches anyone else's"
        REWRITE[${c}]=drop
    done
    if test "${#named[@]}" -eq 0; then
        for c in "${range_commits[@]}"; do
            ! bot_authored "${c}" || REWRITE[${c}]=drop
        done
    fi
    if ! rewrite_commits "${base}" "${head}" "${PROG} drop-signoff: drop ${HUMAN_POSSESSIVE} sign-off"; then
        echo "nothing to do: none of those commits has ${HUMAN_POSSESSIVE} sign-off or him as committer"
        return 0
    fi
    for c in "${range_commits[@]}"; do
        test "${REWRITE[${c}]:-}" != drop || test "${REWRITTEN[${c}]}" = "${c}" ||
            echo "dropped ${HUMAN_POSSESSIVE} sign-off from $(short "${REWRITTEN[${c}]}") (was $(short "${c}"))"
    done
}

main() {
    case "${1:-}" in
        ""|-h|--help) usage; test $# -gt 0 ;;
        check) shift; cmd_check "$@" ;;
        rework|carry-signoff|drop-signoff)
            local cmd=$1
            shift
            refuse_shared_clone "${cmd}"
            "cmd_${cmd//-/_}" "$@" ;;
        *)
            refuse_signoff "$@"
            parse_git_command "$@"
            refuse_shared_clone "${GIT_CMD}" "${GIT_GLOBALS[@]}"
            export GIT_AUTHOR_NAME=${BOT_GIT_NAME} GIT_AUTHOR_EMAIL=${BOT_GIT_EMAIL} \
                GIT_COMMITTER_NAME=${BOT_GIT_NAME} GIT_COMMITTER_EMAIL=${BOT_GIT_EMAIL}
            exec git "$@" ;;
    esac
}

main "$@"
