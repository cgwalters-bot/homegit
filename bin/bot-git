#!/usr/bin/env bash
# git as cgwalters-bot: the one place that defines the git identity of the
# bot's commits, a git wrapper that commits and rebases with it, and a
# pre-push check of a branch's commits; see --help. bot-pr and dco-signoff
# source this file for the identity constants.

# The git identity of the bot's commits. The email is what marks a commit
# as the bot's rather than cgwalters' own; the bot's commits from before
# it was named after him have BOT_GIT_LEGACY_NAME.
readonly BOT_GIT_NAME="Colin Walters"
readonly BOT_GIT_EMAIL=walters+llm@verbum.org
readonly BOT_GIT_LEGACY_NAME=cgwalters-bot
# cgwalters' own identity: 'bot-pr promote' and 'bot-pr signoff' add his
# sign-off, as him, on his approval.
readonly HUMAN_GIT_NAME="Colin Walters"
readonly HUMAN_GIT_EMAIL=walters@verbum.org

# Sourced: only the constants.
if [[ "${BASH_SOURCE[0]}" != "$0" ]]; then
    return 0
fi

set -euo pipefail
shopt -s inherit_errexit

readonly PROG=${0##*/}
readonly AI_TRAILER_KEYS=(Generated-by Assisted-by)
# Subjects of commits meant to be squashed before pushing.
readonly SQUASH_SUBJECT_RE='^(fixup|squash|amend)! '
# The git commands for which -s means --signoff (for rebase and merge it
# picks a strategy), each with its short options that take a value, as
# "SEPARATE ATTACHED": the letters after one of those in a cluster are
# its value; if there are none, the next argument is, except for the
# ATTACHED ones, whose value is optional and only ever attached ('-' for
# none).
declare -rA SIGNOFF_SHORT_VALUE_OPTS=(
    [am]="- CpS"
    [cherry-pick]="m S"
    [commit]="CcFmt Su"
    [format-patch]="ov -"
    [revert]="m S"
)
readonly SIGNOFF_REFUSAL="the bot never adds a Signed-off-by; only 'bot-pr promote' and 'bot-pr signoff' add cgwalters' own on his approval"
# cgwalters' sign-off, as promote and signoff add it.
readonly HUMAN_SIGNOFF="Signed-off-by: ${HUMAN_GIT_NAME} <${HUMAN_GIT_EMAIL}>"
# The clones other agents use too, where the bot never commits: its
# homegit clone, and those listed in SHARED_CLONES_CONFIG, one path or
# glob per line ('~/' for the home directory, '#' for comments).
readonly DEFAULT_SHARED_CLONE=${HOME}/src/github/cgwalters-bot/homegit
readonly SHARED_CLONES_CONFIG=${BOT_GIT_SHARED_CLONES:-${XDG_CONFIG_HOME:-${HOME}/.config}/bot-git/shared-clones}
# Set to 1 to commit in a shared clone anyway.
readonly ALLOW_SHARED_ENV=BOT_GIT_ALLOW_SHARED_CLONE
# The git commands that create or rewrite commits (or the checked-out
# branch), which the bot must not run in a shared clone.
readonly COMMIT_COMMANDS=" am cherry-pick commit merge pull rebase revert stash "

usage() {
    cat <<EOF
Usage: ${PROG} GIT-ARGS...
       ${PROG} rework [--was OLD-HEAD] [--pair OLD=NEW]... [--patch-id] [UPSTREAM]
       ${PROG} check [--no-ai-trailer] [--promoted] [--was OLD-HEAD]
                     [--pair OLD=NEW]... [--patch-id] [RANGE]

The git identity of cgwalters-bot's commits is
'${BOT_GIT_NAME} <${BOT_GIT_EMAIL}>'. The email is what marks a commit as the
bot's; the bot's older commits are named '${BOT_GIT_LEGACY_NAME}'.

${PROG} GIT-ARGS... runs git with that identity as author and committer,
for every git command that creates or rewrites commits: commit, rebase,
cherry-pick, am, merge. Rebases and amends keep each commit's original
author. It refuses to add a Signed-off-by (-s/--signoff, or a
Signed-off-by --trailer): the bot never signs off; only 'bot-pr promote'
and 'bot-pr signoff' add cgwalters' own on his approval.

It also refuses those, revert, pull, stash and 'rework' in a shared clone that
other agents use: ${DEFAULT_SHARED_CLONE},
and any clone whose top directory matches a line of
${SHARED_CLONES_CONFIG}
(a path or glob per line; '~/' for the home directory, '#' for
comments; \$BOT_GIT_SHARED_CLONES names another file). Work in your own
worktree instead ('git worktree add'). For a rare one-line fix that has
to be made there, set ${ALLOW_SHARED_ENV}=1.

${PROG} rework keeps cgwalters' sign-off on the commits reworked to act on
his review, after they were rewritten (e.g. with '${PROG} rebase'): it pairs
each commit of UPSTREAM..HEAD with the one of UPSTREAM..OLD-HEAD, the
published branch (default: @{upstream}; UPSTREAM defaults to their
merge-base), with the same subject. Commits new in HEAD are left as they
are; it refuses if a subject appears twice on either side, a commit of
OLD-HEAD is gone (dropped, squashed into another, or retitled), or the
pairs changed order. Each bot commit whose pair on OLD-HEAD carried his
sign-off with him as committer, as 'bot-pr promote' and 'bot-pr signoff'
make them, gets both back: the '${HUMAN_SIGNOFF}'
trailer (added if the rework dropped it) and him as committer, with a
fresh date. Trees, authors and messages stay otherwise as they are. It
never adds his sign-off to any other commit, and refuses a bot commit
that has his trailer where its pair had none, or another sign-off next
to his. After a rebase onto a newer base, pass that base as UPSTREAM.
Use it only when the change is what he asked for; see AGENTS.md.

For a commit he asked to retitle, --pair OLD=NEW (repeatable) pairs the
commit OLD of OLD-HEAD with the one of HEAD that has NEW's subject, and
--patch-id pairs the commits left over whose patch-id is the same and
unique on both sides (a retitle with no other change). Both pair only a
bot commit of OLD-HEAD with his sign-off and him as committer with a bot
commit of HEAD; --pair refuses anything else, and a pair that the
subjects would contradict. Pass 'check' the same --pair and --patch-id.

${PROG} check [RANGE] checks the commits in RANGE (default:
@{upstream}..HEAD, else origin/HEAD..HEAD, which must not be empty) before
pushing, and lists what's wrong with them:
  - fixup!/squash!/amend! commits, which belong squashed, and merges;
  - bot commits (by the email) whose author or committer isn't the bot
    (by either name), and others' commits committed by the bot's email
    under another name;
  - bot commits with a Signed-off-by (with --promoted, for a head that
    'bot-pr promote' signed off, those committed by cgwalters with his;
    and those that '${PROG} rework' kept his on, committed by him, whose
    pair on the published branch had the same: @{upstream} for the
    default range, else --was OLD-HEAD, paired as 'rework' does, with
    --pair and --patch-id, with RANGE's start as UPSTREAM);
  - commits made as cgwalters with a Generated-by trailer, which is the
    bot's work done with plain git; it warns about those he authored with
    an AI trailer, and others' commits he committed;
  - bot commits without a ${AI_TRAILER_KEYS[0]} or ${AI_TRAILER_KEYS[1]} trailer
    (--no-ai-trailer skips this, for projects that say not to add one).
It exits 1 if it found any errors; warnings don't fail it.
EOF
}

die() {
    echo "${PROG}: error: $*" 1>&2
    exit 1
}

# message_has_signoff TEXT: succeeds if TEXT has a Signed-off-by line,
# with any blanks git would ignore.
message_has_signoff() {
    grep -qiE '^[[:space:]]*signed-off-by[[:space:]]*:' <<<"$1"
}

# refuse_signoff GIT-ARGS...: exits if the git command would add a
# Signed-off-by: -s/--signoff (or a prefix of it), a Signed-off-by
# --trailer, or one in a -m message or -F file. This is best effort,
# since git has more ways (configured trailer aliases, hooks, editing the
# message); 'check' is the gate before pushing.
refuse_signoff() {
    local cmd a
    parse_git_command "$@"
    cmd=${GIT_CMD}
    shift "${#GIT_GLOBALS[@]}"
    test -z "${cmd}" || shift
    local opts=${SIGNOFF_SHORT_VALUE_OPTS[${cmd}]:-}
    local separate=${opts% *} attached=${opts#* }
    while test $# -gt 0; do
        a=$1
        shift
        case "${a}" in
            --) break ;;
            # git takes unambiguous prefixes of long options too.
            --si*)
                [[ "--signoff" == "${a%%=*}"* ]] || continue
                die "refusing '${a}': ${SIGNOFF_REFUSAL}" ;;
            --tr*|--me*|--fi*)
                local opt=${a%%=*} v=${1:-}
                [[ "--trailer" == "${opt}"* || "--message" == "${opt}"* || "--file" == "${opt}"* ]] || continue
                if test "${a}" = "${opt}"; then
                    shift || true
                else
                    v=${a#*=}
                fi
                if [[ "--trailer" == "${opt}"* ]]; then
                    ! message_has_signoff "${v}" || die "refusing a Signed-off-by trailer: ${SIGNOFF_REFUSAL}"
                elif test "${cmd}" = commit; then
                    check_message "${opt}" "${v}"
                fi ;;
            --*) ;;
            -?*)
                test -n "${opts}" || continue
                # A cluster like -as or -sm MSG: its letters up to the
                # first that takes a value.
                local i ch v
                for ((i = 1; i < ${#a}; i++)); do
                    ch=${a:i:1}
                    test "${ch}" != s || die "refusing '-s' (--signoff) for 'git ${cmd}': ${SIGNOFF_REFUSAL}"
                    [[ "${separate}${attached}" == *"${ch}"* ]] || continue
                    v=${a:i+1}
                    if test -z "${v}" && [[ "${separate}" == *"${ch}"* ]]; then
                        v=${1:-}
                        shift || true
                    fi
                    test "${cmd}" != commit || check_message "-${ch}" "${v}"
                    break
                done ;;
        esac
    done
}

# parse_git_command GIT-ARGS...: sets GIT_GLOBALS to the global options
# before the command (some with a separate value) and GIT_CMD to the
# command, empty if there is none.
parse_git_command() {
    GIT_GLOBALS=() GIT_CMD=""
    while test $# -gt 0; do
        case "$1" in
            -C|-c|--git-dir|--work-tree|--namespace|--config-env)
                test $# -ge 2 || break
                GIT_GLOBALS+=("$1" "$2")
                shift 2 ;;
            -*) GIT_GLOBALS+=("$1"); shift ;;
            *) GIT_CMD=$1; break ;;
        esac
    done
}

# shared_clone_patterns: prints the shared clones' paths and globs, one
# per line, with '~/' expanded and plain paths resolved.
shared_clone_patterns() {
    local line
    {
        echo "${DEFAULT_SHARED_CLONE}"
        test ! -e "${SHARED_CLONES_CONFIG}" || cat "${SHARED_CLONES_CONFIG}" ||
            die "cannot read ${SHARED_CLONES_CONFIG}"
    } | while IFS= read -r line || test -n "${line}"; do
        line=${line%%#*}
        line=${line#"${line%%[![:space:]]*}"}
        line=${line%"${line##*[![:space:]]}"}
        test -n "${line}" || continue
        [[ "${line}" != \~/* ]] || line=${HOME}/${line#\~/}
        if [[ "${line}" == *[*?[]* ]]; then
            echo "${line%/}"
        else
            realpath -m "${line}"
        fi
    done
}

# refuse_shared_clone COMMAND GIT-GLOBALS...: exits if COMMAND creates or
# rewrites commits and the repository that git with GIT-GLOBALS works on
# is a shared clone, unless ALLOW_SHARED_ENV is 1.
refuse_shared_clone() {
    local cmd=$1 top pattern
    shift
    [[ "${COMMIT_COMMANDS}" == *" ${cmd} "* ]] || test "${cmd}" = rework || return 0
    test "${!ALLOW_SHARED_ENV:-}" != 1 || return 0
    # Not in a work tree (a bare repository, or none): git says so itself.
    top=$(git "$@" rev-parse --show-toplevel 2>/dev/null) || return 0
    top=$(realpath -e "${top}") || return 0
    while IFS= read -r pattern; do
        # shellcheck disable=SC2053 # a glob, on purpose
        [[ "${top}" == ${pattern} ]] || continue
        die "refusing '${cmd}' in ${top}: it is a shared clone other agents use. Work in your own worktree:
    git -C ${top} worktree add -b bot/<slug> ~/.cache/bot-work/<task>/${top##*/} origin/HEAD
For a rare one-line fix that has to be made there, set ${ALLOW_SHARED_ENV}=1."
    done < <(shared_clone_patterns)
}

# check_message OPTION VALUE: for git commit's -m/--message and
# -F/--file, exits if the message has a Signed-off-by.
check_message() {
    local text
    case "$1" in
        -m|--me*) text=$2 ;;
        -F|--fi*) test "$2" != - && test -r "$2" || return 0; text=$(<"$2") ;;
        *) return 0 ;;
    esac
    ! message_has_signoff "${text}" || die "refusing a message with a Signed-off-by: ${SIGNOFF_REFUSAL}"
}

# default_base: prints the default base: @{upstream}, else origin/HEAD.
default_base() {
    local base
    for base in '@{upstream}' origin/HEAD; do
        if git rev-parse -q --verify "${base}^{commit}" >/dev/null 2>&1; then
            echo "${base}"
            return 0
        fi
    done
    die "HEAD has no upstream and there is no origin/HEAD; pass the RANGE to check, e.g. origin/main..HEAD"
}

# is_bot_name NAME: succeeds for the bot's name, current or old.
is_bot_name() {
    test "$1" = "${BOT_GIT_NAME}" || test "$1" = "${BOT_GIT_LEGACY_NAME}"
}

# has_human_signoff COMMIT: succeeds if COMMIT has cgwalters' sign-off
# trailer.
has_human_signoff() {
    local sobs
    sobs=$(git show -s --format='%(trailers:key=Signed-off-by,valueonly)' "$1")
    grep -qxF "${HUMAN_GIT_NAME} <${HUMAN_GIT_EMAIL}>" <<<"${sobs}"
}

# only_human_signoff COMMIT: succeeds if COMMIT's Signed-off-by trailers
# are all cgwalters' own, if any.
only_human_signoff() {
    local sobs
    sobs=$(git show -s --format='%(trailers:key=Signed-off-by,valueonly)' "$1")
    ! grep -vxF -e "${HUMAN_GIT_NAME} <${HUMAN_GIT_EMAIL}>" -e "" <<<"${sobs}" >/dev/null
}

# human_committed COMMIT: succeeds if cgwalters committed COMMIT, under
# his name.
human_committed() {
    local c
    c=$(git show -s --format='%cn <%ce>' "$1")
    test "${c,,}" = "${HUMAN_GIT_NAME,,} <${HUMAN_GIT_EMAIL,,}>"
}

# bot_authored COMMIT: succeeds if COMMIT's author email is the bot's.
bot_authored() {
    local ae
    ae=$(git show -s --format=%ae "$1")
    test "${ae,,}" = "${BOT_GIT_EMAIL,,}"
}

# signed_bot_commit COMMIT: succeeds for a bot commit with cgwalters'
# sign-off and him as committer, as 'bot-pr promote' makes them.
signed_bot_commit() {
    bot_authored "$1" && human_committed "$1" && has_human_signoff "$1" && only_human_signoff "$1"
}

# Explicit pairs for pair_commits, as OLD=NEW revisions (--pair of
# 'rework' and 'check'), and whether it pairs the commits left over by
# patch-id (--patch-id).
PAIR_EXPLICIT=()
PAIR_BY_PATCH_ID=false

# patch_id COMMIT: COMMIT's stable patch-id, empty for an empty change.
patch_id() {
    git diff-tree -p --no-color "$1" | git patch-id --stable | cut -d' ' -f1
}

# pair_commits OLD NEW UPSTREAM: pairs each commit of UPSTREAM..NEW with
# one of UPSTREAM..OLD into PAIR_NEW and PAIR_OLD (oldest first, PAIR_OLD
# empty for a commit new in NEW): first the PAIR_EXPLICIT pairs, then by
# subject, then (with PAIR_BY_PATCH_ID) by patch-id. Explicit and
# patch-id pairs are only for a signed_bot_commit on OLD and a bot commit
# on NEW. Fails with the reason in PAIR_ERROR where a pair is ambiguous or
# a commit was restructured: a subject twice on either side, an explicit
# pair that is not one of those or that the subjects contradict, a commit
# of OLD gone from NEW (dropped, squashed into another, or retitled
# without a pair), pairs in another order, merges, or no commits on OLD.
pair_commits() {
    local old=$1 new=$2 upstream=$3 i j k o n spec subject last=-1
    # Keyed by "s" and the subject, which may be empty.
    local -A old_by_subject=() new_by_subject=() old_index=() old_used=()
    local -a olds old_subjects new_subjects pair_of
    PAIR_OLD=() PAIR_NEW=() PAIR_ERROR=""
    mapfile -t olds < <(git rev-list --reverse "${upstream}..${old}")
    mapfile -t PAIR_NEW < <(git rev-list --reverse "${upstream}..${new}")
    if test "${#olds[@]}" -eq 0; then
        PAIR_ERROR="no commits in ${upstream}..${old} to pair with"
        return 1
    fi
    if test -n "$(git rev-list --merges "${upstream}..${old}" "${upstream}..${new}")"; then
        PAIR_ERROR="there are merge commits"
        return 1
    fi
    for i in "${!olds[@]}"; do
        subject=$(git show -s --format=%s "${olds[i]}")
        if test -n "${old_by_subject[s${subject}]:-}"; then
            PAIR_ERROR="'${subject}' is the subject of two commits of ${upstream}..${old}"
            return 1
        fi
        old_by_subject[s${subject}]=${i}
        old_subjects[i]=${subject}
        old_index[${olds[i]}]=${i}
    done
    for j in "${!PAIR_NEW[@]}"; do
        subject=$(git show -s --format=%s "${PAIR_NEW[j]}")
        if test -n "${new_by_subject[s${subject}]:-}"; then
            PAIR_ERROR="'${subject}' is the subject of two commits of ${upstream}..${new}"
            return 1
        fi
        new_by_subject[s${subject}]=${j}
        new_subjects[j]=${subject}
        pair_of[j]=""
    done
    for spec in "${PAIR_EXPLICIT[@]}"; do
        if [[ "${spec}" != ?*=?* ]]; then
            PAIR_ERROR="--pair takes OLD=NEW, not '${spec}'"
            return 1
        fi
        o=$(git rev-parse -q --verify "${spec%%=*}^{commit}") || { PAIR_ERROR="cannot resolve OLD of --pair ${spec}"; return 1; }
        n=$(git rev-parse -q --verify "${spec#*=}^{commit}") || { PAIR_ERROR="cannot resolve NEW of --pair ${spec}"; return 1; }
        i=${old_index[${o}]:-}
        if test -z "${i}"; then
            PAIR_ERROR="OLD of --pair ${spec} is not a commit of ${upstream}..${old}"
            return 1
        fi
        # NEW by its subject, which a rewrite by 'rework' keeps, so that
        # 'check' takes the same --pair afterwards.
        subject=$(git show -s --format=%s "${n}")
        j=${new_by_subject[s${subject}]:-}
        if test -z "${j}"; then
            PAIR_ERROR="no commit of ${upstream}..${new} has the subject '${subject}' of NEW of --pair ${spec}"
            return 1
        fi
        if test -n "${old_used[${i}]:-}" || test -n "${pair_of[j]}"; then
            PAIR_ERROR="--pair ${spec} pairs a commit that is already paired"
            return 1
        fi
        if ! signed_bot_commit "${olds[i]}"; then
            PAIR_ERROR="OLD of --pair ${spec} is not a bot commit that cgwalters signed off and committed; only those take an explicit pair"
            return 1
        fi
        if ! bot_authored "${PAIR_NEW[j]}"; then
            PAIR_ERROR="'${subject}' of --pair ${spec} is not the bot's commit"
            return 1
        fi
        # The subjects must not pair either side with another commit.
        k=${new_by_subject[s${old_subjects[i]}]:-}
        if test -n "${k}" && test "${k}" != "${j}"; then
            PAIR_ERROR="--pair ${spec} is ambiguous: '${old_subjects[i]}' of OLD is still the subject of a commit of ${upstream}..${new}"
            return 1
        fi
        k=${old_by_subject[s${subject}]:-}
        if test -n "${k}" && test "${k}" != "${i}"; then
            PAIR_ERROR="--pair ${spec} is ambiguous: '${subject}' is the subject of another commit of ${upstream}..${old}"
            return 1
        fi
        pair_of[j]=${i}
        old_used[${i}]=1
    done
    for j in "${!PAIR_NEW[@]}"; do
        test -z "${pair_of[j]}" || continue
        i=${old_by_subject[s${new_subjects[j]}]:-}
        { test -n "${i}" && test -z "${old_used[${i}]:-}"; } || continue
        pair_of[j]=${i}
        old_used[${i}]=1
    done
    if ${PAIR_BY_PATCH_ID}; then
        # Only a patch-id that is unique among the commits left on both
        # sides; the counts are keyed by "o" or "n" and the patch-id.
        local -A pid_count=() old_by_pid=()
        local -a new_pids=()
        local pid
        for i in "${!olds[@]}"; do
            test -z "${old_used[${i}]:-}" || continue
            pid=$(patch_id "${olds[i]}")
            test -n "${pid}" || continue
            pid_count[o${pid}]=$((${pid_count[o${pid}]:-0} + 1))
            old_by_pid[${pid}]=${i}
        done
        for j in "${!PAIR_NEW[@]}"; do
            test -z "${pair_of[j]}" || continue
            pid=$(patch_id "${PAIR_NEW[j]}")
            new_pids[j]=${pid}
            test -n "${pid}" || continue
            pid_count[n${pid}]=$((${pid_count[n${pid}]:-0} + 1))
        done
        for j in "${!new_pids[@]}"; do
            pid=${new_pids[j]}
            { test -n "${pid}" && test "${pid_count[o${pid}]:-0}" -eq 1 && test "${pid_count[n${pid}]}" -eq 1; } || continue
            i=${old_by_pid[${pid}]}
            { signed_bot_commit "${olds[i]}" && bot_authored "${PAIR_NEW[j]}"; } || continue
            pair_of[j]=${i}
            old_used[${i}]=1
        done
    fi
    for j in "${!PAIR_NEW[@]}"; do
        i=${pair_of[j]}
        if test -z "${i}"; then
            PAIR_OLD+=("")
            continue
        fi
        if test "${i}" -lt "${last}"; then
            PAIR_ERROR="'${new_subjects[j]}' moved before an earlier commit"
            return 1
        fi
        last=${i}
        PAIR_OLD+=("${olds[i]}")
    done
    for i in "${!olds[@]}"; do
        test -z "${old_used[${i}]:-}" || continue
        PAIR_ERROR="'${old_subjects[i]}' of ${upstream}..${old} is gone from ${upstream}..${new} (if cgwalters asked to retitle it, pair it with --pair $(git rev-parse --short "${olds[i]}")=NEW)"
        return 1
    done
}

# kept_note NEW OLD: the line naming a sign-off kept from OLD on NEW.
kept_note() {
    echo "kept cgwalters' sign-off on $(git rev-parse --short "$1") (was on $(git rev-parse --short "$2")); name it in your reply"
}

# problems COMMIT CHECK_TRAILER PROMOTED: prints one line per problem
# with COMMIT, as 'error: ...' or 'warning: ...', or a 'note: ...' for a
# sign-off kept as its pair in PAIRED had it (see cmd_check).
problems() {
    local c=$1 check_trailer=$2 promoted=$3 an ae cn ce parents subject sobs ai key
    local -a f
    mapfile -t f < <(git show -s --format='%an%n%ae%n%cn%n%ce%n%p%n%s' "${c}")
    an=${f[0]} ae=${f[1],,} cn=${f[2]} ce=${f[3],,} parents=${f[4]} subject=${f[5]}
    sobs=$(git show -s --format='%(trailers:key=Signed-off-by,valueonly)' "${c}")
    ai=""
    for key in "${AI_TRAILER_KEYS[@]}"; do
        ai+=$(git show -s --format="%(trailers:key=${key})" "${c}")
    done
    if [[ "${subject}" =~ ${SQUASH_SUBJECT_RE} ]]; then
        echo "error: a '${subject%% *}' commit: squash it into the commit it fixes"
    fi
    if [[ "${parents}" == *" "* ]]; then
        echo "error: a merge commit: rebase instead ('bot-pr promote' refuses merges)"
    fi
    local human=${HUMAN_GIT_EMAIL,,} bot=${BOT_GIT_EMAIL,,}
    if test "${ae}" != "${bot}"; then
        if test "${ce}" = "${bot}" && ! is_bot_name "${cn}"; then
            echo "error: committed as '${cn} <${f[3]}>', not '${BOT_GIT_NAME} <${BOT_GIT_EMAIL}>': rebase with ${PROG}"
        fi
        # The bot's work, done with plain git on this machine, whose own
        # identity is cgwalters'.
        if { test "${ae}" = "${human}" || test "${ce}" = "${human}"; } &&
            git show -s --format="%(trailers:key=${AI_TRAILER_KEYS[0]})" "${c}" | grep -q .; then
            echo "error: has a ${AI_TRAILER_KEYS[0]} trailer but was made as cgwalters (${an} <${f[1]}> / ${cn} <${f[3]}>): commit with ${PROG}"
        elif test "${ae}" = "${human}" && test -n "${ai}"; then
            echo "warning: authored by cgwalters with an AI trailer: if the bot wrote it with plain git, recommit it with ${PROG}"
        elif test "${ae}" != "${human}" && test "${ce}" = "${human}"; then
            echo "warning: someone else's commit, committed by cgwalters: if the bot rebased it with plain git, redo that with ${PROG}"
        fi
        return 0
    fi
    is_bot_name "${an}" || echo "error: authored as '${an} <${f[1]}>', not '${BOT_GIT_NAME} <${BOT_GIT_EMAIL}>'"
    # What 'bot-pr promote' makes of a bot commit on cgwalters' approval:
    # committed by him, with his sign-off. Only with --promoted, since a
    # plain 'git commit --amend -s' here makes the same.
    local as_promoted=false was=${PAIRED[${c}]:-}
    if test "${cn} <${ce}>" = "${HUMAN_GIT_NAME} <${human}>" &&
        grep -qxF "${HUMAN_GIT_NAME} <${HUMAN_GIT_EMAIL}>" <<<"${sobs}"; then
        if ${promoted}; then
            as_promoted=true
        # What 'rework' makes of such a commit: only where its pair on the
        # published branch had the same.
        elif test -n "${was}" && signed_bot_commit "${was}" && only_human_signoff "${c}"; then
            as_promoted=true
            echo "note: $(kept_note "${c}" "${was}")"
        fi
    fi
    if ! ${as_promoted} && ! { test "${ce}" = "${bot}" && is_bot_name "${cn}"; }; then
        echo "error: committed as '${cn} <${f[3]}>', not '${BOT_GIT_NAME} <${BOT_GIT_EMAIL}>': commit and rebase with ${PROG}"
    fi
    if test -n "${sobs}" && ! ${as_promoted}; then
        echo "error: has Signed-off-by: $(paste -sd, - <<<"${sobs}" | sed 's/,/, /g'); ${SIGNOFF_REFUSAL} (for a head promote signed off, use --promoted; 'rework' keeps his only where the published branch had it${PAIR_ERROR:+, but ${PAIR_ERROR}})"
    fi
    if ${check_trailer} && test -z "${ai}"; then
        echo "error: no ${AI_TRAILER_KEYS[0]}: AI (or ${AI_TRAILER_KEYS[1]}) trailer"
    fi
}

cmd_check() {
    local range="" check_trailer=true promoted=false was=""
    while test $# -gt 0; do
        case "$1" in
            --no-ai-trailer) check_trailer=false; shift ;;
            --promoted) promoted=true; shift ;;
            --was) test $# -ge 2 || die "--was takes the published head"; was=$2; shift 2 ;;
            --was=*) was=${1#*=}; shift ;;
            --pair) test $# -ge 2 || die "--pair takes OLD=NEW"; PAIR_EXPLICIT+=("$2"); shift 2 ;;
            --pair=*) PAIR_EXPLICIT+=("${1#*=}"); shift ;;
            --patch-id) PAIR_BY_PATCH_ID=true; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) die "unknown option for check: $1 (see --help)" ;;
            *) test -z "${range}" || die "check takes one RANGE"; range=$1; shift ;;
        esac
    done
    local default=false base
    if test -z "${range}"; then
        default=true
        base=$(default_base)
        range="${base}..HEAD"
        echo "checking ${range}"
        test -n "${was}" || test "${base}" != '@{upstream}' || was=${base}
    fi
    pair_published "${range}" "${was}"
    local commits c n=0 bad=0 warned=0 kept=0 p=()
    commits=$(git rev-list --reverse "${range}") || die "cannot list the commits in '${range}'"
    for c in ${commits}; do
        n=$((n + 1))
        mapfile -t p < <(problems "${c}" "${check_trailer}" "${promoted}")
        test "${#p[@]}" -gt 0 || continue
        if printf '%s\n' "${p[@]}" | grep -q '^error:'; then
            bad=$((bad + 1))
        elif printf '%s\n' "${p[@]}" | grep -q '^warning:'; then
            warned=$((warned + 1))
        else
            kept=$((kept + 1))
        fi
        git show -s --format='%h %s (%an <%ae> / %cn <%ce>)' "${c}"
        printf '    %s\n' "${p[@]}"
    done
    ! ${default} || test "${n}" -gt 0 ||
        die "no commits in ${range}; pass the RANGE to check, e.g. origin/main..HEAD"
    if test "${bad}" -gt 0; then
        echo "${PROG}: ${bad} of ${n} commits in ${range} need fixing before pushing" 1>&2
        exit 1
    fi
    echo "ok: ${n} commits in ${range}$(test "${warned}" -eq 0 || echo ", ${warned} with warnings")$(test "${kept}" -eq 0 || echo ", ${kept} with cgwalters' sign-off kept")"
}

# pair_published RANGE WAS: for check, pairs RANGE's commits with those of
# the published head WAS as 'rework' does, filling PAIRED (new commit ->
# old); the pairs start after RANGE's start, or after the merge-base when
# that is WAS itself. Sets PAIR_ERROR to why nothing is paired.
pair_published() {
    local range=$1 was=$2 from to old tip
    declare -gA PAIRED=()
    PAIR_ERROR=""
    if test -z "${was}"; then
        test "${#PAIR_EXPLICIT[@]}" -eq 0 || die "--pair needs the published head: pass --was OLD-HEAD"
        PAIR_ERROR="no published head to compare with (pass --was OLD-HEAD)"
        return 0
    fi
    if [[ "${range}" != *..* || "${range}" == *...* ]]; then
        PAIR_ERROR="'${range}' is not a BASE..TIP range"
        return 0
    fi
    from=${range%%..*} to=${range#*..}
    old=$(git rev-parse -q --verify "${was}^{commit}") || die "cannot resolve --was '${was}'"
    tip=$(git rev-parse -q --verify "${to:-HEAD}^{commit}") || die "cannot resolve '${to}'"
    from=$(git rev-parse -q --verify "${from:-HEAD}^{commit}") || die "cannot resolve the start of '${range}'"
    if test "${from}" = "${old}"; then
        from=$(git merge-base "${old}" "${tip}") || die "${was} and ${to:-HEAD} have no merge-base"
    fi
    if ! pair_commits "${old}" "${tip}" "${from}"; then
        test "${#PAIR_EXPLICIT[@]}" -eq 0 || die "cannot pair ${range} with ${was}: ${PAIR_ERROR}"
        return 0
    fi
    local i
    for i in "${!PAIR_NEW[@]}"; do
        test -z "${PAIR_OLD[i]}" || PAIRED[${PAIR_NEW[i]}]=${PAIR_OLD[i]}
    done
}

cmd_rework() {
    local was="" upstream=""
    while test $# -gt 0; do
        case "$1" in
            --was) test $# -ge 2 || die "--was takes the published head"; was=$2; shift 2 ;;
            --was=*) was=${1#*=}; shift ;;
            --pair) test $# -ge 2 || die "--pair takes OLD=NEW"; PAIR_EXPLICIT+=("$2"); shift 2 ;;
            --pair=*) PAIR_EXPLICIT+=("${1#*=}"); shift ;;
            --patch-id) PAIR_BY_PATCH_ID=true; shift ;;
            -h|--help) usage; exit 0 ;;
            -*) die "unknown option for rework: $1 (see --help)" ;;
            *) test -z "${upstream}" || die "rework takes one UPSTREAM"; upstream=$1; shift ;;
        esac
    done
    local gitdir old head base
    gitdir=$(git rev-parse --git-dir) || die "not in a git repository"
    if test -e "${gitdir}/rebase-merge" || test -e "${gitdir}/rebase-apply"; then
        die "a rebase is in progress; finish it first"
    fi
    if test -z "${was}"; then
        git rev-parse -q --verify '@{upstream}^{commit}' >/dev/null 2>&1 ||
            die "HEAD has no upstream; pass the published head with --was OLD-HEAD"
        was='@{upstream}'
    fi
    old=$(git rev-parse -q --verify "${was}^{commit}") || die "cannot resolve '${was}'"
    head=$(git rev-parse -q --verify 'HEAD^{commit}') || die "cannot resolve HEAD"
    if test -n "${upstream}"; then
        base=$(git rev-parse -q --verify "${upstream}^{commit}") || die "cannot resolve '${upstream}'"
    else
        base=$(git merge-base "${old}" "${head}") || die "${was} and HEAD have no merge-base; pass UPSTREAM"
    fi
    pair_commits "${old}" "${head}" "${base}" ||
        die "cannot pair the reworked commits with ${was}: ${PAIR_ERROR}; a change that restructures the commits needs cgwalters to sign off again$(test -n "${upstream}" || echo " (if HEAD was rebased onto a newer base, pass it as UPSTREAM)")"
    # With the merge-base as UPSTREAM, a rebase onto a newer base brings in
    # its commits, which are not ours to rewrite.
    if test -z "${upstream}"; then
        local i
        for i in "${!PAIR_NEW[@]}"; do
            test -z "${PAIR_OLD[i]}" || continue
            bot_authored "${PAIR_NEW[i]}" ||
                die "$(git rev-parse --short "${PAIR_NEW[i]}") is new since ${was} and not the bot's: if HEAD was rebased onto a newer base, pass it as UPSTREAM"
        done
    fi

    local i o n parent msg new rewriting=false notes=() committer
    test "${#PAIR_NEW[@]}" -gt 0 || die "no commits in ${base}..HEAD"
    parent=$(git rev-parse "${PAIR_NEW[0]}^")
    msg=$(mktemp) || die "cannot create a temporary file"
    # shellcheck disable=SC2064 # msg is local; expand it now.
    trap "rm -f '${msg}'" EXIT
    for i in "${!PAIR_NEW[@]}"; do
        o=${PAIR_OLD[i]} n=${PAIR_NEW[i]}
        local keep=false
        if test -z "${o}"; then
            ! { bot_authored "${n}" && has_human_signoff "${n}"; } ||
                die "$(git rev-parse --short "${n}") has cgwalters' sign-off, but is new since ${was}: ${SIGNOFF_REFUSAL}"
        elif signed_bot_commit "${o}"; then
            bot_authored "${n}" ||
                die "$(git rev-parse --short "${n}") is not the bot's commit, but its pair $(git rev-parse --short "${o}") on ${was} is; not keeping the sign-off"
            only_human_signoff "${n}" ||
                die "$(git rev-parse --short "${n}") has a Signed-off-by other than cgwalters': ${SIGNOFF_REFUSAL}"
            keep=true
        elif bot_authored "${n}" && has_human_signoff "${n}" && ! has_human_signoff "${o}"; then
            die "$(git rev-parse --short "${n}") has cgwalters' sign-off, but its pair $(git rev-parse --short "${o}") on ${was} had none: ${SIGNOFF_REFUSAL}"
        fi
        if ! ${rewriting} && { ! ${keep} || { human_committed "${n}" && has_human_signoff "${n}"; }; }; then
            parent=${n}
            continue
        fi
        # The message, byte for byte (see bot-pr's add_signoff): the header
        # ends at the first empty line; commit-tree can't keep an encoding.
        ! git cat-file commit "${n}" |
            awk '/^$/ { in_body = 1 } !in_body && /^encoding / { found = 1 } END { exit !found }' ||
            die "$(git rev-parse --short "${n}") has a non-UTF-8 message encoding"
        git cat-file commit "${n}" | sed '1,/^$/d' >"${msg}" || die "cannot read the message of ${n}"
        if ${keep}; then
            if ! has_human_signoff "${n}"; then
                GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 \
                    git interpret-trailers --in-place --no-divider --where end --if-exists addIfDifferent \
                    --trailer "${HUMAN_SIGNOFF}" "${msg}" || die "adding the sign-off to ${n} failed"
            fi
            committer=(GIT_COMMITTER_NAME="${HUMAN_GIT_NAME}" GIT_COMMITTER_EMAIL="${HUMAN_GIT_EMAIL}")
        else
            committer=(GIT_COMMITTER_NAME="$(git show -s --format=%cn "${n}")"
                GIT_COMMITTER_EMAIL="$(git show -s --format=%ce "${n}")"
                GIT_COMMITTER_DATE="$(git show -s --format=%cd --date=raw "${n}")")
        fi
        new=$(env -u GIT_COMMITTER_DATE \
            GIT_AUTHOR_NAME="$(git show -s --format=%an "${n}")" GIT_AUTHOR_EMAIL="$(git show -s --format=%ae "${n}")" \
            GIT_AUTHOR_DATE="$(git show -s --format=%ad --date=raw "${n}")" "${committer[@]}" \
            git -c core.hooksPath=/dev/null -c commit.gpgSign=false -c i18n.commitEncoding=UTF-8 \
            commit-tree --no-gpg-sign "${n}^{tree}" -p "${parent}" -F "${msg}") || die "rewriting ${n} failed"
        ! ${keep} || notes+=("$(kept_note "${new}" "${o}")")
        parent=${new}
        rewriting=true
    done
    if ! ${rewriting}; then
        echo "nothing to do: no reworked commit lacks the sign-off its pair on ${was} had"
        return 0
    fi
    test "$(git rev-parse "${parent}^{tree}")" = "$(git rev-parse "${head}^{tree}")" ||
        die "the rewritten ${parent} has a different tree from HEAD; not updating HEAD"
    git update-ref -m "${PROG} rework: keep cgwalters' sign-off from ${was}" HEAD "${parent}" "${head}" ||
        die "cannot update HEAD to ${parent}"
    printf '%s\n' "${notes[@]}"
    if test "${#PAIR_EXPLICIT[@]}" -gt 0 || ${PAIR_BY_PATCH_ID}; then
        local args=(--was "${was}") spec
        for spec in "${PAIR_EXPLICIT[@]}"; do
            args+=(--pair "${spec}")
        done
        ! ${PAIR_BY_PATCH_ID} || args+=(--patch-id)
        echo "check it with the same pairs: ${PROG} check ${args[*]} $(git rev-parse --short "${base}")..HEAD"
    fi
}

main() {
    case "${1:-}" in
        ""|-h|--help) usage; test $# -gt 0 ;;
        check) shift; cmd_check "$@" ;;
        rework) shift; refuse_shared_clone rework; cmd_rework "$@" ;;
        *)
            refuse_signoff "$@"
            parse_git_command "$@"
            refuse_shared_clone "${GIT_CMD}" "${GIT_GLOBALS[@]}"
            export GIT_AUTHOR_NAME=${BOT_GIT_NAME} GIT_AUTHOR_EMAIL=${BOT_GIT_EMAIL} \
                GIT_COMMITTER_NAME=${BOT_GIT_NAME} GIT_COMMITTER_EMAIL=${BOT_GIT_EMAIL}
            exec git "$@" ;;
    esac
}

main "$@"
