#!/usr/bin/env bash
# Add cgwalters' DCO Signed-off-by to the commits of cgwalters-bot's open
# PRs in repositories that require DCO. Only a human can make the DCO
# statement, so this runs as him (his git identity and gh login), never as
# the bot; see --help.
set -euo pipefail
shopt -s inherit_errexit

readonly BOT_LOGIN=cgwalters-bot
readonly BOT_EMAIL=walters+llm@verbum.org
# The organization holding the forks that 'bot-pr promote' opens upstream
# PRs from, as FORGE_ORG:bot/SLUG.
readonly FORGE_ORG=${DCO_SIGNOFF_FORGE:-cgwalters-forge}
# A required status check whose name matches this (case-insensitively) is
# a DCO check.
readonly DCO_CONTEXT_RE=dco
readonly CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/dco-signoff
readonly PER_PAGE=100
readonly TITLE_LEN=50
readonly DEFAULT_WAIT=300
readonly WAIT_POLL=10
# For every git command that runs on bot-written content: no hooks, and no
# user configuration that would change which commits a rebase produces
# (e.g. rebase.autoSquash would squash the bot's 'fixup!' commits).
readonly GIT_SAFE=(-c core.hooksPath=/dev/null -c rebase.autoSquash=false
    -c rebase.updateRefs=false -c rebase.autoStash=false)

usage() {
    cat <<EOF
Usage: $(basename "$0") [OPTIONS] [PR...]

Sign off (DCO) the commits of ${BOT_LOGIN}'s open PRs, as you.

The bot never adds Signed-off-by by itself ('bot-pr promote' adds yours
only on your approval of the fork PR), so its other PRs to repositories
that require DCO stay blocked until a human signs off. This finds the open PRs authored
by ${BOT_LOGIN}, plus open PRs from ${FORGE_ORG} branches (where
'bot-pr promote' opens them from), keeps those whose base branch requires a
DCO status check (per the repository's rules), and prints a table of them:
the DCO check's state and how many commits lack your
'Signed-off-by: \$(git config user.name) <\$(git config user.email)>'.

Then, for each PR that needs it, it fetches the PR into a clone cache under
${CACHE_DIR}, shows its commits, rebases them with
'git rebase --signoff' onto their merge-base with the base branch (never
onto the base's current tip, so nothing but the trailers changes), with
hooks disabled, verifies that each rewritten commit has the original tree,
author and message plus your sign-off, asks, and force-pushes the PR's
branch with a lease on the head it fetched. Commits that already carry
your sign-off are kept as they are, and a PR whose commits all do is
skipped, so it is safe to rerun.

PR arguments (https://github.com/OWNER/REPO/pull/N or OWNER/REPO#N) limit
it to those PRs instead of searching.

Options:
  -n, --dry-run     Find the PRs and do everything locally, including the
                    rebase and its verification, but push nothing.
  -y, --yes         Push without asking for each PR.
  --repo OWNER/REPO Only PRs into OWNER/REPO. Repeatable.
  --include-others  Also sign off commits authored by people other than
                    you and ${BOT_LOGIN}. Your Signed-off-by on someone
                    else's commit is your DCO statement about their code,
                    so PRs with such commits are refused without this.
  --wait[=SECONDS]  After pushing, wait up to SECONDS (default
                    ${DEFAULT_WAIT}) for the DCO check on the new head.
  -h, --help        Show this help.

It refuses to run when gh is logged in as ${BOT_LOGIN}, or git's identity
is the bot's (${BOT_EMAIL}): the bot must never sign off. Pushing needs
push access to the PR's head repository (e.g. ${FORGE_ORG}) or, when the
PR allows maintainer edits, to its base repository.

Environment:
  DCO_SIGNOFF_GIT_URL  Prefix of the URLs fetched and pushed, followed by
                       OWNER/REPO.git (default: per 'gh config get
                       git_protocol', git@github.com: or https://github.com/).

Example:
  $(basename "$0") --dry-run
  $(basename "$0") https://github.com/bootc-dev/bootc/pull/2494
EOF
}

die() {
    echo "error: $*" 1>&2
    exit 1
}

warn() {
    echo "warning: $*" 1>&2
}

info() {
    echo "$*" 1>&2
}

# git on the clone cache, which holds bot-written content.
sgit() {
    git "${GIT_SAFE[@]}" "$@"
}

DRY_RUN=false
YES=false
LIST_ONLY=false
INCLUDE_OTHERS=false
WAIT=0
REPOS=()
PR_ARGS=()

parse_args() {
    while test $# -gt 0; do
        case "$1" in
            -h|--help) usage; exit 0 ;;
            -n|--dry-run) DRY_RUN=true ;;
            -y|--yes) YES=true ;;
            # Hidden: discovery only, which the bot may run too.
            --list-only) LIST_ONLY=true ;;
            --include-others) INCLUDE_OTHERS=true ;;
            --wait) WAIT=${DEFAULT_WAIT} ;;
            --wait=*)
                WAIT=${1#--wait=}
                [[ "${WAIT}" =~ ^[0-9]+$ ]] || die "--wait takes a number of seconds, not '${WAIT}'"
                ;;
            --repo)
                test $# -ge 2 || die "--repo needs OWNER/REPO"
                [[ "$2" =~ ^[^/[:space:]]+/[^/[:space:]]+$ ]] || die "--repo takes OWNER/REPO, not '$2'"
                REPOS+=("$2")
                shift
                ;;
            --repo=*)
                set -- --repo "${1#--repo=}" "${@:2}"
                continue
                ;;
            -*) die "unknown option '$1' (see --help)" ;;
            *) PR_ARGS+=("$(parse_pr "$1")") ;;
        esac
        shift
    done
}

# parse_pr URL|OWNER/REPO#N: print 'OWNER/REPO<TAB>N'.
parse_pr() {
    if [[ "$1" =~ ^(https://github\.com/)?([^/#[:space:]]+/[^/#[:space:]]+)(/pull/|#)([0-9]+)/?$ ]]; then
        printf '%s\t%s\n' "${BASH_REMATCH[2]}" "${BASH_REMATCH[4]}"
    else
        die "not a PR: '$1' (expected https://github.com/OWNER/REPO/pull/N or OWNER/REPO#N)"
    fi
}

ME_LOGIN=""
ME_NAME=""
ME_EMAIL=""
SOB=""

# Who is running this, and refuse if it's the bot, unless only listing.
identify() {
    ME_LOGIN=$(gh api user --jq .login) || die "could not ask GitHub who you are; check 'gh auth status'"
    ME_NAME=$(git config user.name) || die "git config user.name is not set"
    ME_EMAIL=$(git config user.email) || die "git config user.email is not set"
    SOB="Signed-off-by: ${ME_NAME} <${ME_EMAIL}>"
    "${LIST_ONLY}" && return 0
    test "${ME_LOGIN}" != "${BOT_LOGIN}" ||
        die "gh is logged in as ${BOT_LOGIN}, and the bot must never sign off: only a human can make the DCO statement"
    test "${ME_EMAIL,,}" != "${BOT_EMAIL,,}" ||
        die "git user.email is the bot's (${BOT_EMAIL}), and the bot must never sign off; run this with your own git identity"
    # 'git rebase --signoff' signs off as the committer, and the DCO check
    # accepts a sign-off by the commit's author or committer; so the
    # committer must be you, not e.g. GIT_COMMITTER_* left over from the bot.
    local committer
    committer=$(git var GIT_COMMITTER_IDENT | sed -E 's/ [0-9]+ [-+][0-9]{4}$//')
    test "${committer}" = "${ME_NAME} <${ME_EMAIL}>" ||
        die "git would commit as '${committer}', not as '${ME_NAME} <${ME_EMAIL}>' (check the GIT_COMMITTER_* variables)"
}

repo_wanted() {
    test "${#REPOS[@]}" -eq 0 && return 0
    local r
    for r in "${REPOS[@]}"; do
        test "${r,,}" = "${1,,}" && return 0
    done
    return 1
}

# Print 'OWNER/REPO<TAB>N' for the open PRs authored by the bot, and those
# from branches in FORGE_ORG's forks (whoever opened them), sorted. PRs
# into FORGE_ORG's forks are left out: they are review drafts, never merged.
discover() {
    {
        gh api --paginate -X GET search/issues -f q="is:pr is:open author:${BOT_LOGIN}" -F per_page="${PER_PAGE}" \
            --jq '.items[] | "\(.repository_url | sub(".*/repos/"; ""))\t\(.number)"'
        local fork parent
        for fork in $(gh api --paginate "orgs/${FORGE_ORG}/repos?per_page=${PER_PAGE}" --jq '.[] | select(.fork) | .name'); do
            parent=$(gh api "repos/${FORGE_ORG}/${fork}" --jq '.parent.full_name // empty')
            { test -n "${parent}" && repo_wanted "${parent}"; } || continue
            gh api --paginate "repos/${parent}/pulls?state=open&per_page=${PER_PAGE}" \
                --jq ".[] | select(.head.repo.owner.login == \"${FORGE_ORG}\") | \"${parent}\t\(.number)\""
        done
    } | awk -F'\t' -v forge="${FORGE_ORG}/" 'index($1, forge) != 1' | sort -u
}

declare -A CONTEXTS_CACHE=()

# dco_contexts REPO BRANCH: the DCO checks that BRANCH's rules require,
# as a JSON array of names.
dco_contexts() {
    local key="$1@$2" rules
    if test -z "${CONTEXTS_CACHE[${key}]:-}"; then
        # No access or no rules both mean no requirement we can see.
        rules=$(gh api "repos/$1/rules/branches/$2" 2>/dev/null) || rules='[]'
        CONTEXTS_CACHE[${key}]=$(jq -c --arg re "${DCO_CONTEXT_RE}" \
            '[.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context
              | select(test($re; "i"))] | unique' <<<"${rules}")
    fi
    printf '%s\n' "${CONTEXTS_CACHE[${key}]}"
}

# dco_state REPO SHA CONTEXTS: the combined state of the DCO checks on SHA:
# failure, pending, success, or missing (none reported yet).
dco_state() {
    local runs statuses
    runs=$(gh api "repos/$1/commits/$2/check-runs?per_page=${PER_PAGE}" \
        --jq '[.check_runs[] | {name, status, conclusion}]' 2>/dev/null) || runs='[]'
    statuses=$(gh api "repos/$1/commits/$2/status" --jq '[.statuses[] | {name: .context, state}]' 2>/dev/null) || statuses='[]'
    jq -nr --argjson c "$3" --argjson runs "${runs}" --argjson statuses "${statuses}" '
        [($runs[] | select(.name | IN($c[]))
          | if .status != "completed" then "pending"
            elif .conclusion | IN("success", "neutral", "skipped") then "success"
            else "failure" end),
         ($statuses[] | select(.name | IN($c[]))
          | if .state == "pending" then "pending" elif .state == "success" then "success" else "failure" end)]
        | if index(["failure"]) then "failure" elif index(["pending"]) then "pending"
          elif length > 0 then "success" else "missing" end'
}

# pr_record REPO N: a JSON summary of the PR, with its DCO requirement
# and, if it has one, the DCO state and its commits, each classified by
# whether it has SOB and whose it is (self, bot or other), and the plan.
pr_record() {
    local pr base contexts commits='[]' state=none
    pr=$(gh api "repos/$1/pulls/$2") || { warn "could not read $1#$2"; return 1; }
    base=$(jq -r .base.ref <<<"${pr}")
    contexts=$(dco_contexts "$1" "${base}")
    if test "${contexts}" != '[]'; then
        state=$(dco_state "$1" "$(jq -r .head.sha <<<"${pr}")" "${contexts}")
        commits=$(gh api --paginate "repos/$1/pulls/$2/commits?per_page=${PER_PAGE}" \
            --jq '.[] | {sha, parents: (.parents | length), name: .commit.author.name,
                         email: .commit.author.email, login: (.author.login // ""), message: .commit.message}' |
            jq -sc --arg sob "${SOB}" --arg me "${ME_LOGIN}" --arg myemail "${ME_EMAIL}" \
                --arg bot "${BOT_LOGIN}" --arg botemail "${BOT_EMAIL}" '
                map(. + {signed: (.message | split("\n") | map(rtrimstr("\r") | rtrimstr(" ")) | index([$sob]) != null),
                         who: (if (.email | ascii_downcase) == ($myemail | ascii_downcase) or .login == $me then "self"
                               elif (.email | ascii_downcase) == ($botemail | ascii_downcase) or .login == $bot then "bot"
                               else "other" end)}
                    | del(.message))')
    fi
    jq -c --arg repo "$1" --argjson include_others "${INCLUDE_OTHERS}" --argjson contexts "${contexts}" --arg state "${state}" --argjson commits "${commits}" '
        {repo: $repo, number, url: .html_url, title, base: .base.ref,
         head_repo: .head.repo.full_name, head_ref: .head.ref, head_sha: .head.sha,
         maintainer_can_modify, contexts: $contexts, dco: $state, commits: $commits,
         unsigned: ($commits | map(select(.signed | not)) | length),
         others: ($commits | map(select(.who == "other" and (.signed | not))) | length),
         merges: ($commits | map(select(.parents > 1)) | length)}
        # What to do: "sign", or why not.
        | .plan = if .unsigned == 0 then "signed"
            elif .head_repo == null then "head repository deleted"
            elif .merges > 0 then "has merge commits"
            elif .others > 0 and ($include_others | not) then "\(.others) by others: --include-others"
            else "sign" end' <<<"${pr}"
}

print_table() {
    {
        printf 'PR\tDCO\tUNSIGNED\tPLAN\tHEAD\tTITLE\n'
        printf '%s\n' "$@" | jq -r --argjson n "${TITLE_LEN}" '
            ["\(.repo)#\(.number)", .dco, "\(.unsigned)/\(.commits | length)", .plan,
             "\(.head_repo // "?" | split("/")[0]):\(.head_ref)",
             (.title | if length > $n then .[:$n - 3] + "..." else . end)] | @tsv'
    } | column -t -s $'\t'
}

git_url() {
    if test -z "${GIT_URL_PREFIX:-}"; then
        GIT_URL_PREFIX=${DCO_SIGNOFF_GIT_URL:-}
        if test -z "${GIT_URL_PREFIX}"; then
            case "$(gh config get git_protocol -h github.com 2>/dev/null || true)" in
                ssh) GIT_URL_PREFIX=git@github.com: ;;
                *) GIT_URL_PREFIX=https://github.com/ ;;
            esac
        fi
    fi
    printf '%s%s.git\n' "${GIT_URL_PREFIX}" "$1"
}

# can_push RECORD: succeed if we can push to the PR's branch, else explain.
can_push() {
    local head_repo base_repo
    head_repo=$(jq -r .head_repo <<<"$1")
    base_repo=$(jq -r .repo <<<"$1")
    test "$(gh api "repos/${head_repo}" --jq '.permissions.push // false' 2>/dev/null)" = true && return 0
    if test "$(jq -r .maintainer_can_modify <<<"$1")" = true &&
        test "$(gh api "repos/${base_repo}" --jq '.permissions.push // false' 2>/dev/null)" = true; then
        return 0
    fi
    info "  ${ME_LOGIN} can't push to ${head_repo}: ask to be given push access there, or for the PR to allow"
    info "  edits by maintainers of ${base_repo} (if you are one), or have its author add your sign-off."
    return 1
}

has_sob() {
    sgit -C "$1" show -s --format=%B "$2" | sed -e 's/[[:space:]]*$//' | grep -Fxc -- "${SOB}" || true
}

# message_sans_sob REPO COMMIT: the commit message without SOB lines.
message_sans_sob() {
    sgit -C "$1" show -s --format=%B "$2" | sed -e 's/[[:space:]]*$//' | grep -Fxv -- "${SOB}" || true
}

# verify REPO BASE OLD NEW: NEW must be OLD with SOB added to each commit
# after BASE lacking it, and nothing else changed: same trees, authors and
# messages otherwise, and still based on BASE.
verify() {
    local git=$1 base=$2 old new i
    mapfile -t old < <(sgit -C "${git}" rev-list --reverse "${base}..$3")
    mapfile -t new < <(sgit -C "${git}" rev-list --reverse "${base}..$4")
    test "${#old[@]}" -eq "${#new[@]}" || { info "  ${#old[@]} commits became ${#new[@]}"; return 1; }
    for i in "${!old[@]}"; do
        local o=${old[i]} n=${new[i]} os ns
        test "$(sgit -C "${git}" rev-parse "${o}^{tree}")" = "$(sgit -C "${git}" rev-parse "${n}^{tree}")" ||
            { info "  ${n:0:12}'s tree differs from ${o:0:12}'s"; return 1; }
        test "$(sgit -C "${git}" show -s --format='%an <%ae> %ad' --date=raw "${o}")" = \
            "$(sgit -C "${git}" show -s --format='%an <%ae> %ad' --date=raw "${n}")" ||
            { info "  ${n:0:12}'s author differs from ${o:0:12}'s"; return 1; }
        test "$(message_sans_sob "${git}" "${o}")" = "$(message_sans_sob "${git}" "${n}")" ||
            { info "  ${n:0:12}'s message differs from ${o:0:12}'s by more than the sign-off"; return 1; }
        os=$(has_sob "${git}" "${o}")
        ns=$(has_sob "${git}" "${n}")
        test "${ns}" -eq "$((os > 0 ? os : 1))" ||
            { info "  ${n:0:12} has ${ns} sign-offs by you, ${o:0:12} had ${os}"; return 1; }
    done
    test "$(sgit -C "${git}" merge-base "${base}" "$4")" = "$(sgit -C "${git}" rev-parse "${base}")" ||
        { info "  the rewritten commits are no longer based on ${base:0:12}"; return 1; }
}

wait_for_dco() {
    local repo=$1 sha=$2 contexts=$3 state deadline=$((SECONDS + WAIT))
    while :; do
        state=$(dco_state "${repo}" "${sha}" "${contexts}")
        case "${state}" in
            success|failure) break ;;
        esac
        test "${SECONDS}" -lt "${deadline}" || break
        sleep "${WAIT_POLL}"
    done
    printf '%s\n' "${state}"
}

CLONE=""
WORKTREE=""
cleanup() {
    if test -n "${WORKTREE}"; then
        sgit -C "${WORKTREE}" rebase --abort >/dev/null 2>&1 || true
        sgit -C "${CLONE}" worktree remove --force "${WORKTREE}" >/dev/null 2>&1 || rm -rf "${WORKTREE}"
        WORKTREE=""
    fi
}
trap cleanup EXIT

# reconcile RECORD: sign off one PR; fail if it wasn't (or, with
# --dry-run, couldn't be).
reconcile() {
    local rec=$1 repo num head_repo head_ref head_sha base mb upstream="" c tip new answer
    repo=$(jq -r .repo <<<"${rec}")
    num=$(jq -r .number <<<"${rec}")
    head_repo=$(jq -r .head_repo <<<"${rec}")
    head_ref=$(jq -r .head_ref <<<"${rec}")
    head_sha=$(jq -r .head_sha <<<"${rec}")
    base=$(jq -r .base <<<"${rec}")
    info ""
    info "${repo}#${num}: $(jq -r .title <<<"${rec}")"

    CLONE=${CACHE_DIR}/${repo}.git
    test -d "${CLONE}" || sgit init -q --bare "${CLONE}"
    sgit -C "${CLONE}" fetch -q --no-tags "$(git_url "${head_repo}")" \
        "+refs/heads/${head_ref}:refs/dco-signoff/${num}/head" ||
        { info "  could not fetch ${head_repo} ${head_ref}"; return 1; }
    sgit -C "${CLONE}" fetch -q --no-tags "$(git_url "${repo}")" \
        "+refs/heads/${base}:refs/dco-signoff/${num}/base" ||
        { info "  could not fetch ${repo} ${base}"; return 1; }
    test "$(sgit -C "${CLONE}" rev-parse "refs/dco-signoff/${num}/head")" = "${head_sha}" ||
        { info "  ${head_repo} ${head_ref} is no longer at ${head_sha:0:12}, the PR's head; rerun later"; return 1; }
    tip=$(sgit -C "${CLONE}" rev-parse "refs/dco-signoff/${num}/base")
    mb=$(sgit -C "${CLONE}" merge-base "${tip}" "${head_sha}") ||
        { info "  ${head_ref} has no merge-base with ${base}"; return 1; }
    test -z "$(sgit -C "${CLONE}" rev-list --merges "${mb}..${head_sha}")" ||
        { info "  has merge commits, which a rebase would flatten; sign off by hand"; return 1; }

    # Keep the commits up to the first one lacking a sign-off as they are.
    for c in $(sgit -C "${CLONE}" rev-list --reverse "${mb}..${head_sha}"); do
        if test "$(has_sob "${CLONE}" "${c}")" -eq 0; then
            upstream=$(sgit -C "${CLONE}" rev-parse "${c}^")
            break
        fi
    done
    test -n "${upstream}" || { info "  already signed off"; return 0; }

    info "  commits on ${base} (merge-base ${mb:0:12}; ${base} is at ${tip:0:12}), * = to sign off:"
    for c in $(sgit -C "${CLONE}" rev-list --reverse "${mb}..${head_sha}"); do
        local mark=" "
        test "$(has_sob "${CLONE}" "${c}")" -gt 0 || mark="*"
        info "  ${mark} $(sgit -C "${CLONE}" show -s --format='%h %s (%an <%ae>)' "${c}")"
    done

    can_push "${rec}" || return 1

    WORKTREE=$(mktemp -d "${TMPDIR:-/tmp}/dco-signoff.XXXXXX")
    sgit -C "${CLONE}" worktree add -q --detach "${WORKTREE}" "${head_sha}"
    if ! sgit -C "${WORKTREE}" rebase -q --signoff --force-rebase --no-autosquash \
        --keep-empty --empty=keep "${upstream}" >&2; then
        info "  the rebase failed"
        cleanup
        return 1
    fi
    new=$(sgit -C "${WORKTREE}" rev-parse HEAD)
    sgit -C "${CLONE}" update-ref "refs/dco-signoff/${num}/signed" "${new}"
    cleanup
    verify "${CLONE}" "${mb}" "${head_sha}" "${new}" || { info "  refusing to push ${new:0:12}"; return 1; }
    info "  signed off as ${new:0:12}: same trees and authors, adding '${SOB}'"

    if "${DRY_RUN}"; then
        info "  dry run: would push ${new:0:12} to ${head_repo} ${head_ref}, over ${head_sha:0:12}"
        return 0
    fi
    if ! "${YES}"; then
        printf '  push %s to %s %s? [y/N] ' "${new:0:12}" "${head_repo}" "${head_ref}" 1>&2
        read -r answer || answer=""
        case "${answer}" in
            y|Y|yes|YES) ;;
            *) info "  skipped"; return 1 ;;
        esac
    fi
    if ! sgit -C "${CLONE}" push -q --force-with-lease="refs/heads/${head_ref}:${head_sha}" \
        "$(git_url "${head_repo}")" "${new}:refs/heads/${head_ref}" >&2; then
        info "  push refused: ${head_repo} ${head_ref} changed since it was fetched at ${head_sha:0:12}; rerun to pick that up"
        return 1
    fi
    info "  pushed: $(jq -r .url <<<"${rec}")"
    if test "${WAIT}" -gt 0; then
        info "  waiting up to ${WAIT}s for DCO..."
    fi
    info "  DCO on ${new:0:12}: $(if test "${WAIT}" -gt 0; then
        wait_for_dco "${repo}" "${new}" "$(jq -c .contexts <<<"${rec}")"
    else
        dco_state "${repo}" "${new}" "$(jq -c .contexts <<<"${rec}")"
    fi)"
}

main() {
    parse_args "$@"
    command -v jq >/dev/null || die "jq is required"
    command -v gh >/dev/null || die "gh is required"
    identify

    local prs=() line repo num rec records=() skipped=0
    if test "${#PR_ARGS[@]}" -gt 0; then
        prs=("${PR_ARGS[@]}")
    else
        info "Searching for open PRs by ${BOT_LOGIN} and from ${FORGE_ORG}..."
        mapfile -t prs < <(discover)
    fi
    for line in "${prs[@]}"; do
        IFS=$'\t' read -r repo num <<<"${line}"
        repo_wanted "${repo}" || continue
        rec=$(pr_record "${repo}" "${num}") || continue
        if test "$(jq -r '.contexts | length' <<<"${rec}")" -eq 0; then
            skipped=$((skipped + 1))
            continue
        fi
        records+=("${rec}")
    done
    info "${#records[@]} open PRs need DCO (${skipped} others don't)."
    test "${#records[@]}" -gt 0 || return 0
    print_table "${records[@]}"
    "${LIST_ONLY}" && return 0

    local failed=0 plan
    for rec in "${records[@]}"; do
        plan=$(jq -r .plan <<<"${rec}")
        case "${plan}" in
            signed) continue ;;
            sign) reconcile "${rec}" || failed=$((failed + 1)) ;;
            *)
                info ""
                info "$(jq -r '"\(.repo)#\(.number)"' <<<"${rec}"): skipped, ${plan}"
                failed=$((failed + 1))
                ;;
        esac
    done
    test "${failed}" -eq 0 || die "${failed} PRs not signed off"
}

main "$@"
