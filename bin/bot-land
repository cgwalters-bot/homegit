#!/usr/bin/env node
// Land the current branch on one of the bot's own repositories through a
// pull request that auto-merges (rebase) once CI is green; see --help.
// Node's standard library only, and gh and git, like upstream-policy.
"use strict";

const { execFileSync } = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");

const PROG = path.basename(process.argv[1]);
const BIN = path.dirname(fs.realpathSync(process.argv[1]));
const BOT_GIT = path.join(BIN, "bot-git");
const BOT_BOARD = process.env.BOT_LAND_BOT_BOARD || path.join(BIN, "bot-board");
const REMOTE = "origin";
// The job the main branch rulesets require.
const CHECK_NAME = "ci";
const AI_TRAILER = "Generated-by: AI";
// Where cgwalters' review queue lives (as in bot-board): open issues
// labelled REVIEW_LABEL whose 'Review:' line pins a pull request's head.
const TRACKER_REPO = "cgwalters-forge/tracker";
const REVIEW_LABEL = "review";
const OPERATOR = "cgwalters";
const REVIEW_LINE_RE = /^Review: `(\S+)` at ([0-9a-f]{40})\s*$/m;
const DEFAULT_TIMEOUT_MIN = 30;
const POLL_SECONDS = Number(process.env.BOT_LAND_POLL_SECONDS || 20);
// A GitHub remote URL: https://github.com/O/R(.git), git@github.com:O/R(.git), ssh://git@github.com/O/R.
const GITHUB_URL_RE = /github\.com[:/]([A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+?)(?:\.git)?\/?$/;

const EX_ERROR = 1;
const EX_USAGE = 2;
const EX_FAILED = 3;
const EX_TIMEOUT = 4;

class Exit extends Error {
  constructor(status, message) {
    super(message);
    this.status = status;
  }
}

function usage() {
  return `Usage: ${PROG} [--title TITLE] [--body BODY] [--repo OWNER/REPO]
                [--no-auto [--ask TEXT --blocks ISSUE_URL | --no-ask]]
                [--no-wait] [--timeout MINUTES]

Lands the current branch of this worktree on one of the bot's own
repositories (homegit, cgwalters-bot/*, cgwalters-forge's own), whose
main takes changes only as pull requests with a green '${CHECK_NAME}' check,
up to date with main, rebase-merged:

  1. runs 'bot-git check ${REMOTE}/BASE..HEAD';
  2. pushes the branch to ${REMOTE} (with a lease, so a rebase can re-push);
  3. opens a pull request into the default branch BASE, or reuses the
     open one for this branch. TITLE defaults to the subject of a single
     commit (it is required for more); BODY to a list of the commits'
     subjects, plus '${AI_TRAILER}';
  4. enables auto-merge by rebase, unless --no-auto, for a pull request
     that waits for an approval: a reviewer's (pass --no-ask), or
     cgwalters' (architecture, security, the bot's rules). For the
     latter, --ask TEXT --blocks ISSUE_URL (implying --no-auto) puts it
     in his review queue: 'bot-board question ISSUE_URL TEXT --review
     PR_URL@HEAD --title "Review OWNER/REPO#N: PR TITLE"', ISSUE_URL
     being the ${TRACKER_REPO} issue it blocks. --no-auto with neither
     warns. On a pull request already open, an open review ask that pins
     HEAD is kept, and one that pins an older head is reported stale
     (bot-board can't re-pin it; --ask then opens a new one). Without
     --no-auto, it refuses a pull request that has an open review ask;
  5. unless --no-wait (or --no-auto), waits until it merges: when main
     moved on, it rebases the branch with bot-git and pushes it again;
     when '${CHECK_NAME}' fails or the pull request closes, it stops. Then it
     fast-forwards the shared clone this worktree belongs to, if that has
     BASE checked out and is clean.

--repo defaults to the OWNER/REPO of ${REMOTE}'s URL. --timeout (default
${DEFAULT_TIMEOUT_MIN}) bounds the wait.

Exit status: 0 merged (or opened, without waiting), ${EX_FAILED} '${CHECK_NAME}' failed
or the pull request was closed, ${EX_TIMEOUT} still open after the timeout,
${EX_USAGE} usage, ${EX_ERROR} anything else.
`;
}

function parseArgs(argv) {
  const opts = { title: null, body: null, repo: null, auto: true, ask: null, blocks: null, noAsk: false, wait: true, timeout: DEFAULT_TIMEOUT_MIN };
  const value = (i, name) => {
    if (i + 1 >= argv.length) throw new Exit(EX_USAGE, `${name} needs a value\n\n${usage()}`);
    return argv[i + 1];
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case "-h":
      case "--help":
        process.stdout.write(usage());
        process.exit(0);
      case "--title":
        opts.title = value(i++, a);
        break;
      case "--body":
        opts.body = value(i++, a);
        break;
      case "--repo":
        opts.repo = value(i++, a);
        break;
      case "--no-auto":
        opts.auto = false;
        break;
      case "--ask":
        opts.ask = value(i++, a);
        if (!/\S/.test(opts.ask)) throw new Exit(EX_USAGE, `--ask needs a text: what ${OPERATOR} is asked to approve`);
        break;
      case "--blocks":
        opts.blocks = value(i++, a);
        break;
      case "--no-ask":
        opts.noAsk = true;
        break;
      case "--no-wait":
        opts.wait = false;
        break;
      case "--timeout":
        opts.timeout = Number(value(i++, a));
        if (!Number.isFinite(opts.timeout) || opts.timeout <= 0) throw new Exit(EX_USAGE, `--timeout takes a positive number of minutes`);
        break;
      default:
        throw new Exit(EX_USAGE, `unexpected argument '${a}'\n\n${usage()}`);
    }
  }
  if ((opts.ask === null) !== (opts.blocks === null)) {
    throw new Exit(EX_USAGE, `--ask and --blocks go together: the ask's text, and the ${TRACKER_REPO} issue it blocks`);
  }
  if (opts.ask !== null && opts.noAsk) throw new Exit(EX_USAGE, `--ask and --no-ask contradict each other`);
  if (opts.noAsk && opts.auto) throw new Exit(EX_USAGE, `--no-ask goes with --no-auto: an auto-merged pull request needs no ask`);
  // A pull request waiting for cgwalters' approval must not merge before it.
  if (opts.ask !== null) opts.auto = false;
  if (opts.repo !== null && !/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(opts.repo)) {
    throw new Exit(EX_USAGE, `--repo takes OWNER/REPO, not '${opts.repo}'`);
  }
  return opts;
}

// run(cmd, args, what): CMD's trimmed output, or an EX_ERROR failure
// saying it couldn't WHAT, with CMD's error output.
function run(cmd, args, what, input) {
  try {
    return execFileSync(cmd, args, { encoding: "utf8", input, stdio: [input === undefined ? "ignore" : "pipe", "pipe", "pipe"] }).trim();
  } catch (e) {
    throw new Exit(EX_ERROR, `cannot ${what}: ${String(e.stderr || e.message).trim()}`);
  }
}

const git = (args, what) => run("git", args, what);
const ghJSON = (args, what) => JSON.parse(run("gh", ["api", ...args], what) || "null");

function log(msg) {
  process.stderr.write(`${PROG}: ${msg}\n`);
}

const sleep = (s) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, s * 1000);

function repoOf(opts) {
  if (opts.repo) return opts.repo;
  const url = git(["remote", "get-url", REMOTE], `read ${REMOTE}'s URL`);
  const m = url.match(GITHUB_URL_RE);
  if (!m) throw new Exit(EX_ERROR, `${REMOTE} (${url}) is not a GitHub repository; pass --repo`);
  return m[1];
}

// push(branch): push HEAD to BRANCH on REMOTE, over what we last saw there.
function push(branch) {
  git(["push", "--quiet", "--force-with-lease", "--set-upstream", REMOTE, `HEAD:refs/heads/${branch}`], `push ${branch} to ${REMOTE}`);
}

// openPull(repo, owner, branch, base, opts): the open pull request of
// BRANCH into BASE, opened now if there is none, and whether it existed.
function openPull(repo, owner, branch, base, opts) {
  const open = ghJSON([`repos/${repo}/pulls?state=open&base=${encodeURIComponent(base)}&head=${encodeURIComponent(`${owner}:${branch}`)}`], "list pull requests");
  if (Array.isArray(open) && open.length > 0) {
    log(`reusing ${open[0].html_url}`);
    return { pr: open[0], reused: true };
  }
  const subjects = git(["log", "--reverse", "--format=%s", `${REMOTE}/${base}..HEAD`], "list the commits").split("\n");
  let title = opts.title;
  if (title === null) {
    if (subjects.length !== 1) throw new Exit(EX_USAGE, `${subjects.length} commits: pass --title`);
    title = subjects[0];
  }
  const body = opts.body !== null ? opts.body : `${subjects.map((s) => `- ${s}`).join("\n")}\n\n${AI_TRAILER}`;
  const out = run(
    "gh",
    ["api", "-X", "POST", `repos/${repo}/pulls`, "-f", `title=${title}`, "-f", `head=${branch}`, "-f", `base=${base}`, "-F", "body=@-"],
    "open the pull request",
    body,
  );
  const pr = JSON.parse(out);
  log(`opened ${pr.html_url}`);
  return { pr, reused: false };
}

// openAsks(prURL): the open review asks in TRACKER_REPO for PRURL, as
// {url, sha} (the head each pins). Every page: one JSON line per issue.
function openAsks(prURL) {
  const lines = run(
    "gh",
    ["api", "--paginate", `repos/${TRACKER_REPO}/issues?labels=${REVIEW_LABEL}&state=open&per_page=100`, "--jq", ".[] | {html_url, body} | tojson"],
    `list the review asks in ${TRACKER_REPO}`,
  );
  const asks = [];
  for (const line of lines.split("\n").filter(Boolean)) {
    const issue = JSON.parse(line);
    const m = (issue.body || "").match(REVIEW_LINE_RE);
    if (m && m[1] === prURL) asks.push({ url: issue.html_url, sha: m[2] });
  }
  return asks;
}

// ask(repo, pr, head, opts, reused): put PR, at HEAD, in cgwalters'
// review queue with a review ask (--ask), or say why nothing does. On a
// REUSED pull request, an open ask at HEAD is enough, and one at an older
// head is stale: bot-board has no way to re-pin it.
function ask(repo, pr, head, opts, reused) {
  const asks = reused ? openAsks(pr.html_url) : [];
  const current = asks.filter((a) => a.sha === head);
  for (const a of asks.filter((a) => a.sha !== head)) {
    log(
      `warning: the review ask ${a.url} is stale: it pins ${a.sha.slice(0, 12)}, and ${pr.html_url} is now at ${head.slice(0, 12)}. ` +
        `Close it with 'bot-board resolve ${a.url} "Superseded: the pull request moved to ${head.slice(0, 12)}"'` +
        (opts.ask !== null ? "; a new one follows" : `, and ask again with --ask TEXT --blocks ISSUE_URL`),
    );
  }
  if (current.length > 0) {
    log(`${pr.html_url} is in ${OPERATOR}' review queue: ${current.map((a) => a.url).join(" ")}`);
    return;
  }
  if (opts.ask === null) {
    if (!opts.noAsk) {
      log(
        `warning: nothing puts ${pr.html_url} in ${OPERATOR}' review queue. If it waits for his approval (architecture, security, the bot's rules), ` +
          `run this again with --ask TEXT --blocks ISSUE_URL; if a reviewer approves it and the coordinator auto-merges it, pass --no-ask`,
      );
    }
    return;
  }
  const args = ["question", opts.blocks, opts.ask, "--review", `${pr.html_url}@${head}`, "--title", `Review ${repo}#${pr.number}: ${pr.title}`];
  let out;
  try {
    out = execFileSync(BOT_BOARD, args, { encoding: "utf8", stdio: ["ignore", "pipe", "inherit"] }).trim();
  } catch {
    // Not bot-board again: it may have opened the ask before failing, and
    // a re-run of bot-land keeps an open one at HEAD instead of adding one.
    throw new Exit(EX_ERROR, `opened ${pr.html_url}, but not its review ask; retry: ${[PROG, ...process.argv.slice(2)].map(shellQuote).join(" ")}`);
  }
  log(`asked ${OPERATOR} to review it: ${out}`);
}

function shellQuote(s) {
  return /^[A-Za-z0-9_@%+=:,./-]+$/.test(s) ? s : `'${s.replace(/'/g, "'\\''")}'`;
}

// checkFailed(repo, sha): the URL of a failed CHECK_NAME run on SHA, if any.
function checkFailed(repo, sha) {
  const runs = ghJSON([`repos/${repo}/commits/${sha}/check-runs?check_name=${CHECK_NAME}`], `read the ${CHECK_NAME} check`);
  const failed = ((runs && runs.check_runs) || []).find(
    (r) => r.status === "completed" && !["success", "neutral", "skipped"].includes(r.conclusion),
  );
  return failed ? failed.html_url || failed.conclusion : null;
}

// rebaseIfBehind(branch, base): rebase HEAD onto REMOTE/BASE with
// bot-git and push it again, unless it already has REMOTE/BASE (GitHub
// can take a while to see a push).
function rebaseIfBehind(branch, base) {
  git(["fetch", "--quiet", REMOTE, base], `fetch ${REMOTE}/${base}`);
  if (git(["merge-base", `${REMOTE}/${base}`, "HEAD"], "find the merge-base") === git(["rev-parse", `${REMOTE}/${base}`], "read the base")) return;
  log(`${base} moved on; rebasing onto it`);
  try {
    execFileSync(BOT_GIT, ["rebase", `${REMOTE}/${base}`], { stdio: ["ignore", "pipe", "pipe"] });
  } catch (e) {
    execFileSync("git", ["rebase", "--abort"], { stdio: "ignore" });
    throw new Exit(EX_FAILED, `the branch doesn't rebase cleanly onto ${REMOTE}/${base}; rebase it by hand: ${String(e.stderr || e.message).trim()}`);
  }
  push(branch);
}

// fastForwardShared(base): fast-forward the clone this worktree belongs to,
// if it has BASE checked out and is clean; say so otherwise.
function fastForwardShared(base) {
  const common = path.resolve(git(["rev-parse", "--git-common-dir"], "find the shared clone"));
  const shared = path.dirname(common);
  if (path.basename(common) !== ".git" || !fs.existsSync(shared)) return;
  let branch = "";
  try {
    branch = execFileSync("git", ["-C", shared, "symbolic-ref", "--quiet", "--short", "HEAD"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
  } catch {
    // Detached: not updated.
  }
  const dirty = run("git", ["-C", shared, "status", "--porcelain", "--untracked-files=no"], "read the shared clone's status");
  if (branch !== base || dirty !== "") {
    log(`not updating ${shared}: it has ${branch || "no branch"} checked out${dirty ? " with changes" : ""}`);
    return;
  }
  run("git", ["-C", shared, "pull", "--quiet", "--ff-only", REMOTE, base], `fast-forward ${shared}`);
  log(`fast-forwarded ${shared} to ${REMOTE}/${base}`);
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const repo = repoOf(opts);
  const owner = repo.split("/")[0];
  const branch = git(["symbolic-ref", "--quiet", "--short", "HEAD"], "read the current branch (detached HEAD?)");
  const info = ghJSON([`repos/${repo}`], `read ${repo}`);
  const base = info.default_branch;
  if (branch === base) throw new Exit(EX_USAGE, `on ${base} itself: commit on a topic branch (bot/<slug>)`);
  git(["fetch", "--quiet", REMOTE, base], `fetch ${REMOTE}/${base}`);
  const ahead = git(["rev-list", "--count", `${REMOTE}/${base}..HEAD`], "count the commits");
  if (ahead === "0") throw new Exit(EX_USAGE, `${branch} has no commits over ${REMOTE}/${base}`);
  try {
    execFileSync(BOT_GIT, ["check", `${REMOTE}/${base}..HEAD`], { stdio: ["ignore", "inherit", "inherit"] });
  } catch {
    throw new Exit(EX_ERROR, `bot-git check failed; fix the commits first`);
  }
  push(branch);
  const { pr, reused } = openPull(repo, owner, branch, base, opts);
  if (!opts.auto) {
    ask(repo, pr, git(["rev-parse", "HEAD"], "read HEAD"), opts, reused);
    console.log(pr.html_url);
    return;
  }
  // One that waits for cgwalters must not merge before he approves it.
  const asks = reused ? openAsks(pr.html_url) : [];
  if (asks.length > 0) {
    throw new Exit(
      EX_USAGE,
      `${pr.html_url} waits for ${OPERATOR}' approval (${asks.map((a) => a.url).join(" ")}), so not enabling auto-merge: ` +
        `re-push it with --no-auto (--ask to keep the ask at the new head), and enable auto-merge only once he approved it`,
    );
  }
  run("gh", ["pr", "merge", String(pr.number), "--repo", repo, "--auto", "--rebase"], "enable auto-merge");
  if (!opts.wait) {
    console.log(pr.html_url);
    return;
  }
  const deadline = Date.now() + opts.timeout * 60 * 1000;
  for (;;) {
    const cur = ghJSON([`repos/${repo}/pulls/${pr.number}`], `read ${pr.html_url}`);
    if (cur.merged) {
      log(`merged ${pr.html_url}`);
      git(["fetch", "--quiet", REMOTE, base], `fetch ${REMOTE}/${base}`);
      fastForwardShared(base);
      console.log(pr.html_url);
      return;
    }
    if (cur.state === "closed") throw new Exit(EX_FAILED, `${pr.html_url} was closed without merging`);
    // Only this head's runs count: a rebase cancels the previous one's.
    const head = git(["rev-parse", "HEAD"], "read HEAD");
    const failed = cur.head.sha === head ? checkFailed(repo, head) : null;
    if (failed) throw new Exit(EX_FAILED, `${CHECK_NAME} failed on ${pr.html_url}: ${failed}`);
    // Behind main: auto-merge waits for the branch to be up to date.
    if (cur.mergeable_state === "behind") rebaseIfBehind(branch, base);
    if (Date.now() > deadline) throw new Exit(EX_TIMEOUT, `${pr.html_url} is still open after ${opts.timeout} minutes`);
    sleep(POLL_SECONDS);
  }
}

try {
  main();
} catch (e) {
  if (!(e instanceof Exit)) throw e;
  process.stderr.write(`${PROG}: ${e.message}\n`);
  process.exit(e.status);
}
