#!/usr/bin/env node
// Land the current branch on one of the bot's own repositories through a
// pull request that auto-merges (rebase) once CI is green; see --help.
// Node's standard library only, and gh and git, like upstream-policy.
"use strict";

const { execFileSync } = require("node:child_process");
const fs = require("node:fs");
const path = require("node:path");

const PROG = path.basename(process.argv[1]);
const BIN_DIR = path.dirname(fs.realpathSync(process.argv[1]));
const BOT_GIT = path.join(BIN_DIR, "bot-git");
const BOT_BOARD = path.join(BIN_DIR, "bot-board");
// The Status on the board of a pull request that waits for the operator's
// approval (--no-auto).
const WAITING_STATUS = "Draft";
const REMOTE = "origin";
// The check to wait for when the base branch's rules require none.
const DEFAULT_CHECK = "ci";
const AI_TRAILER = "Generated-by: AI";
// Whose approval a --no-auto pull request waits for, the operator (see
// lib/operator.js): requesting their review puts it in their queue (the
// review app lists the bot's pull requests with review-requested:OPERATOR).
const operatorConfig = require(path.join(BIN_DIR, "..", "lib", "operator.js"));
const midstream = require(path.join(BIN_DIR, "..", "lib", "midstream.js"));
const OPERATOR = operatorConfig.loadOrExit(PROG).operator.login;
const OPERATOR_S = operatorConfig.possessive(OPERATOR);
const DEFAULT_TIMEOUT_MIN = 30;
const POLL_SECONDS = Number(process.env.BOT_LAND_POLL_SECONDS || 20);
// A GitHub remote URL: https://github.com/O/R(.git), git@github.com:O/R(.git), ssh://git@github.com/O/R.
const GITHUB_URL_RE = /github\.com[:/]([A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+?)(?:\.git)?\/?$/;

const EX_ERROR = 1;
const EX_USAGE = 2;
const EX_FAILED = 3;
const EX_TIMEOUT = 4;

class Exit extends Error {
  constructor(status, message) {
    super(message);
    this.status = status;
  }
}

function usage() {
  return `Usage: ${PROG} [--title TITLE] [--body BODY] [--repo OWNER/REPO] [--base BRANCH]
                [--no-auto [--no-review]] [--no-wait] [--timeout MINUTES]

Lands the current branch of this worktree on one of the bot's own
repositories (homegit, and the bot's and the forge org's own), whose
main takes changes only as pull requests with green required checks
(such as homegit's 'required-checks' gate),
up to date with main, rebase-merged:

  1. runs 'bot-git check ${REMOTE}/BASE..HEAD';
  2. pushes the branch to ${REMOTE} (with a lease, so a rebase can re-push);
  3. opens a pull request into BASE, or reuses the open one for this
     branch, whatever its base (and retargets it to --base, if given).
     TITLE defaults to the subject of a single commit (it is required for
     more); BODY to a list of the commits' subjects, plus '${AI_TRAILER}';
  4. enables auto-merge by rebase, unless --no-auto, for a pull request
     that waits for ${OPERATOR_S} approval (a truly critical harness
     change: who can authorize actions, wider credential exposure or token
     scope, a weaker sandbox or prompt-injection boundary; or loosening an
     upstream-policy verdict): then it
     requests their review, which puts it in their review queue, unless
     they already approved HEAD or requested changes on it, and puts it
     on the Workstream board with Status ${WAITING_STATUS}, so that
     bot-watch reports their review. A re-run after a push requests it
     again, since GitHub drops the request once they review. --no-review
     skips the request, for one that waits only for another reviewer.
     Without --no-auto, it refuses a pull request whose review by
     ${OPERATOR} is requested, or whose latest review by them requested
     changes;
  5. unless --no-wait (or --no-auto), waits until it merges: when main
     moved on, it rebases the branch with bot-git and pushes it again;
     when a required check fails or the pull request closes, it stops. Then it
     fast-forwards the shared clone this worktree belongs to, if that has
     BASE checked out and is clean.

BASE is --base, else the base of the open pull request for this branch,
else the repository's default branch. --base stacks this branch on
another unmerged one (its parent): the pull request then holds only this
branch's commits. Such a pull request needs --no-auto: auto-merge would
merge it into the parent branch, not the default branch, folding it into
the parent's pull request after that one's review, and leaving it
nothing to land on its own. Once the parent's pull request has merged, or
the parent branch is gone (deleted on merge), ${PROG} retargets the pull
request to the default branch, rebases the branch onto it with bot-git,
dropping the parent's commits (those up to the fork point with the
parent, as ${REMOTE}/PARENT or the pull request last saw it), and goes on
as for any other.

--repo defaults to the OWNER/REPO of ${REMOTE}'s URL. --timeout (default
${DEFAULT_TIMEOUT_MIN}) bounds the wait.

Exit status: 0 merged (or opened, without waiting), ${EX_FAILED} a required check failed
or the pull request was closed, ${EX_TIMEOUT} still open after the timeout,
${EX_USAGE} usage, ${EX_ERROR} anything else.
`;
}

function parseArgs(argv) {
  const opts = { title: null, body: null, repo: null, base: null, auto: true, review: true, wait: true, timeout: DEFAULT_TIMEOUT_MIN };
  const value = (i, name) => {
    if (i + 1 >= argv.length) throw new Exit(EX_USAGE, `${name} needs a value\n\n${usage()}`);
    return argv[i + 1];
  };
  for (let i = 0; i < argv.length; i++) {
    const a = argv[i];
    switch (a) {
      case "-h":
      case "--help":
        process.stdout.write(usage());
        process.exit(0);
      case "--title":
        opts.title = value(i++, a);
        break;
      case "--body":
        opts.body = value(i++, a);
        break;
      case "--repo":
        opts.repo = value(i++, a);
        break;
      case "--base":
        opts.base = value(i++, a);
        break;
      case "--no-auto":
        opts.auto = false;
        break;
      case "--no-review":
        opts.review = false;
        break;
      case "--no-wait":
        opts.wait = false;
        break;
      case "--timeout":
        opts.timeout = Number(value(i++, a));
        if (!Number.isFinite(opts.timeout) || opts.timeout <= 0) throw new Exit(EX_USAGE, `--timeout takes a positive number of minutes`);
        break;
      default:
        throw new Exit(EX_USAGE, `unexpected argument '${a}'\n\n${usage()}`);
    }
  }
  if (!opts.review && opts.auto) throw new Exit(EX_USAGE, `--no-review goes with --no-auto: an auto-merged pull request requests no review`);
  if (opts.repo !== null && !/^[A-Za-z0-9_.-]+\/[A-Za-z0-9_.-]+$/.test(opts.repo)) {
    throw new Exit(EX_USAGE, `--repo takes OWNER/REPO, not '${opts.repo}'`);
  }
  return opts;
}

// run(cmd, args, what): CMD's trimmed output, or an EX_ERROR failure
// saying it couldn't WHAT, with CMD's error output.
function run(cmd, args, what, input) {
  try {
    return execFileSync(cmd, args, { encoding: "utf8", input, stdio: [input === undefined ? "ignore" : "pipe", "pipe", "pipe"] }).trim();
  } catch (e) {
    throw new Exit(EX_ERROR, `cannot ${what}: ${String(e.stderr || e.message).trim()}`);
  }
}

const git = (args, what) => run("git", args, what);
const ghJSON = (args, what) => JSON.parse(run("gh", ["api", ...args], what) || "null");

function log(msg) {
  process.stderr.write(`${PROG}: ${msg}\n`);
}

const sleep = (s) => Atomics.wait(new Int32Array(new SharedArrayBuffer(4)), 0, 0, s * 1000);

function repoOf(opts) {
  if (opts.repo) return opts.repo;
  const url = git(["remote", "get-url", REMOTE], `read ${REMOTE}'s URL`);
  const m = url.match(GITHUB_URL_RE);
  if (!m) throw new Exit(EX_ERROR, `${REMOTE} (${url}) is not a GitHub repository; pass --repo`);
  return m[1];
}

// push(branch): push HEAD to BRANCH on REMOTE, over what we last saw there.
function push(branch) {
  git(["push", "--quiet", "--force-with-lease", "--set-upstream", REMOTE, `HEAD:refs/heads/${branch}`], `push ${branch} to ${REMOTE}`);
}

// findPull(repo, owner, branch): the open pull request of BRANCH, into
// any base, or null.
function findPull(repo, owner, branch) {
  const open = ghJSON([`repos/${repo}/pulls?state=open&head=${encodeURIComponent(`${owner}:${branch}`)}`], "list pull requests");
  return Array.isArray(open) && open.length > 0 ? open[0] : null;
}

// retarget(repo, pr, base): point PR at BASE.
function retarget(repo, pr, base) {
  run("gh", ["api", "--silent", "-X", "PATCH", `repos/${repo}/pulls/${pr.number}`, "-f", `base=${base}`], `retarget ${pr.html_url} to ${base}`);
  log(`retargeted ${pr.html_url} from ${pr.base.ref} to ${base}`);
  pr.base = { ...pr.base, ref: base };
}

// openPull(repo, branch, base, existing, opts): EXISTING (BRANCH's open
// pull request, retargeted to BASE if it has another), or a pull request
// of BRANCH into BASE opened now.
function openPull(repo, branch, base, existing, opts) {
  if (existing) {
    log(`reusing ${existing.html_url} (into ${existing.base.ref})`);
    if (existing.base.ref !== base) retarget(repo, existing, base);
    return existing;
  }
  const subjects = git(["log", "--reverse", "--format=%s", `${REMOTE}/${base}..HEAD`], "list the commits").split("\n");
  let title = opts.title;
  if (title === null) {
    if (subjects.length !== 1) throw new Exit(EX_USAGE, `${subjects.length} commits: pass --title`);
    title = subjects[0];
  }
  const body = opts.body !== null ? opts.body : `${subjects.map((s) => `- ${s}`).join("\n")}\n\n${AI_TRAILER}`;
  const out = run(
    "gh",
    ["api", "-X", "POST", `repos/${repo}/pulls`, "-f", `title=${title}`, "-f", `head=${branch}`, "-f", `base=${base}`, "-F", "body=@-"],
    "open the pull request",
    body,
  );
  const pr = JSON.parse(out);
  log(`opened ${pr.html_url}`);
  return pr;
}

// trackOnBoard(pr): puts PR on the board with Status WAITING_STATUS.
// Failing only warns: the pull request is open either way.
function trackOnBoard(pr) {
  const url = pr.html_url;
  try {
    const id = run(BOT_BOARD, ["add", url], `add ${url} to the board`).split("\n").pop();
    run(BOT_BOARD, ["set", id, "--status", WAITING_STATUS], `set ${id} to ${WAITING_STATUS}`);
    log(`on the board as ${id}, ${WAITING_STATUS}`);
  } catch (e) {
    if (!(e instanceof Exit)) throw e;
    log(`warning: ${e.message}; put it on the board by hand: bot-board add ${url}, then set its Status ${WAITING_STATUS}`);
  }
}

// decision(repo, pr): OPERATOR's latest deciding review of PR, as
// {state, sha}, or null if they never approved or requested changes.
function decision(repo, pr) {
  const last = run(
    "gh",
    ["api", "--paginate", `repos/${repo}/pulls/${pr.number}/reviews?per_page=100`, "--jq", `.[] | select(.user.login == "${OPERATOR}" and (.state | IN(\"APPROVED\", \"CHANGES_REQUESTED\", \"DISMISSED\"))) | "\\(.state) \\(.commit_id)"`],
    `read the reviews of ${pr.html_url}`,
  )
    .split("\n")
    .at(-1);
  if (!last) return null;
  const [state, sha] = last.split(" ");
  return { state, sha };
}

// requestReview(repo, pr, head): request OPERATOR's review of PR, unless
// they already approved HEAD, or requested changes on it (the bot's turn:
// a request would put either back in their queue).
function requestReview(repo, pr, head) {
  const d = decision(repo, pr);
  if (d && d.sha === head && d.state !== "DISMISSED") {
    const what = d.state === "APPROVED" ? "already approved" : "requested changes on";
    log(`${OPERATOR} ${what} ${head.slice(0, 12)}; not requesting their review`);
    return;
  }
  try {
    execFileSync("gh", ["api", "--silent", "-X", "POST", `repos/${repo}/pulls/${pr.number}/requested_reviewers`, "-f", `reviewers[]=${OPERATOR}`], {
      stdio: ["ignore", "ignore", "pipe"],
    });
  } catch (e) {
    throw new Exit(
      EX_ERROR,
      `${pr.html_url} is open, but couldn't request ${OPERATOR_S} review (are they a collaborator on ${repo}?): ${String(e.stderr || e.message).trim()}. ` +
        `Retry: ${[PROG, ...process.argv.slice(2)].map(shellQuote).join(" ")}`,
    );
  }
  log(`requested ${OPERATOR_S} review of ${pr.html_url}`);
}

function shellQuote(s) {
  return /^[A-Za-z0-9_@%+=:,./-]+$/.test(s) ? s : `'${s.replace(/'/g, "'\\''")}'`;
}

// requiredChecks(repo, base): the names of the status checks the rules
// of BASE require (DEFAULT_CHECK if none).
function requiredChecks(repo, base) {
  const rules = ghJSON([`repos/${repo}/rules/branches/${encodeURIComponent(base)}`], `read the rules of ${base}`) || [];
  const names = rules
    .filter((r) => r.type === "required_status_checks")
    .flatMap((r) => r.parameters.required_status_checks.map((c) => c.context));
  return names.length ? [...new Set(names)] : [DEFAULT_CHECK];
}

// checkFailed(repo, sha, names): "NAME URL" of a failed run on SHA of
// one of the checks NAMES, if any.
function checkFailed(repo, sha, names) {
  for (const name of names) {
    const runs = ghJSON([`repos/${repo}/commits/${sha}/check-runs?check_name=${encodeURIComponent(name)}`], `read the ${name} check`);
    const failed = ((runs && runs.check_runs) || []).find(
      (r) => r.status === "completed" && !["success", "neutral", "skipped"].includes(r.conclusion),
    );
    if (failed) return `${name} ${failed.html_url || failed.conclusion}`;
  }
  return null;
}

const resolves = (rev) => {
  try {
    execFileSync("git", ["rev-parse", "--verify", "--quiet", `${rev}^{commit}`], { stdio: "ignore" });
    return true;
  } catch {
    return false;
  }
};

// parentLanded(repo, owner, parent): why the stacked-on branch PARENT is
// done with ("merged in URL", "gone from REMOTE"), or null while it
// isn't: it still exists and has no merged pull request without an open one.
function parentLanded(repo, owner, parent) {
  try {
    execFileSync("git", ["ls-remote", "--exit-code", "--heads", REMOTE, parent], { stdio: "ignore" });
  } catch (e) {
    if (e.status === 2) return `gone from ${REMOTE}`;
    throw new Exit(EX_ERROR, `cannot read ${REMOTE}'s ${parent}: ${String(e.stderr || e.message).trim()}`);
  }
  const pulls = ghJSON([`repos/${repo}/pulls?state=all&head=${encodeURIComponent(`${owner}:${parent}`)}`], `list the pull requests of ${parent}`) || [];
  if (pulls.some((p) => p.state === "open")) return null;
  const merged = pulls.find((p) => p.merged_at);
  return merged ? `merged in ${merged.html_url}` : null;
}

// rebaseOffParent(parent, prBaseSha, base): rebase HEAD onto
// REMOTE/BASE with bot-git, dropping the commits it shares with the
// landed PARENT: those up to its fork point with REMOTE/PARENT (still
// there unless pruned), else with the base the pull request last had
// (PR_BASE_SHA). Without either, a plain rebase drops them only when
// the merge kept their patches.
function rebaseOffParent(parent, prBaseSha, base) {
  git(["fetch", "--quiet", REMOTE, base], `fetch ${REMOTE}/${base}`);
  const tip = [`${REMOTE}/${parent}`, prBaseSha].find((r) => r && resolves(r));
  const forkPoint = tip && git(["merge-base", tip, "HEAD"], `find the fork point with ${parent}`);
  const args = forkPoint ? ["rebase", "--onto", `${REMOTE}/${base}`, forkPoint] : ["rebase", `${REMOTE}/${base}`];
  try {
    execFileSync(BOT_GIT, args, { stdio: ["ignore", "pipe", "pipe"] });
  } catch (e) {
    execFileSync("git", ["rebase", "--abort"], { stdio: "ignore" });
    throw new Exit(EX_FAILED, `the branch doesn't rebase cleanly off ${parent} onto ${REMOTE}/${base}; rebase it by hand: ${String(e.stderr || e.message).trim()}`);
  }
  log(`rebased off ${parent} onto ${REMOTE}/${base}${forkPoint ? "" : " (no fork point known: dropped only the commits whose patches ${base} has)"}`);
}

// rebaseIfBehind(branch, base): rebase HEAD onto REMOTE/BASE with
// bot-git and push it again, unless it already has REMOTE/BASE (GitHub
// can take a while to see a push).
function rebaseIfBehind(branch, base) {
  git(["fetch", "--quiet", REMOTE, base], `fetch ${REMOTE}/${base}`);
  if (git(["merge-base", `${REMOTE}/${base}`, "HEAD"], "find the merge-base") === git(["rev-parse", `${REMOTE}/${base}`], "read the base")) return;
  log(`${base} moved on; rebasing onto it`);
  try {
    execFileSync(BOT_GIT, ["rebase", `${REMOTE}/${base}`], { stdio: ["ignore", "pipe", "pipe"] });
  } catch (e) {
    execFileSync("git", ["rebase", "--abort"], { stdio: "ignore" });
    throw new Exit(EX_FAILED, `the branch doesn't rebase cleanly onto ${REMOTE}/${base}; rebase it by hand: ${String(e.stderr || e.message).trim()}`);
  }
  push(branch);
}

// fastForwardShared(base): fast-forward the clone this worktree belongs to,
// if it has BASE checked out and is clean; say so otherwise.
function fastForwardShared(base) {
  const common = path.resolve(git(["rev-parse", "--git-common-dir"], "find the shared clone"));
  const shared = path.dirname(common);
  if (path.basename(common) !== ".git" || !fs.existsSync(shared)) return;
  let branch = "";
  try {
    branch = execFileSync("git", ["-C", shared, "symbolic-ref", "--quiet", "--short", "HEAD"], { encoding: "utf8", stdio: ["ignore", "pipe", "ignore"] }).trim();
  } catch {
    // Detached: not updated.
  }
  const dirty = run("git", ["-C", shared, "status", "--porcelain", "--untracked-files=no"], "read the shared clone's status");
  if (branch !== base || dirty !== "") {
    log(`not updating ${shared}: it has ${branch || "no branch"} checked out${dirty ? " with changes" : ""}`);
    return;
  }
  run("git", ["-C", shared, "pull", "--quiet", "--ff-only", REMOTE, base], `fast-forward ${shared}`);
  log(`fast-forwarded ${shared} to ${REMOTE}/${base}`);
}

function main() {
  const opts = parseArgs(process.argv.slice(2));
  const repo = repoOf(opts);
  const owner = repo.split("/")[0];
  const branch = git(["symbolic-ref", "--quiet", "--short", "HEAD"], "read the current branch (detached HEAD?)");
  const info = ghJSON([`repos/${repo}`], `read ${repo}`);
  const defaultBranch = info.default_branch;
  if (midstream.kind(info, operatorConfig.loadOrExit(PROG).forge_org) === "midstream") {
    throw new Exit(EX_USAGE, `${repo} is a midstream (its main mirrors upstream and only moves by fast-forward sync): its pull requests are never merged. Open a draft fork PR with 'bot-pr fork-pr' instead, or mark a real fork with 'bot-pr fork-setup --fork'`);
  }
  if (branch === defaultBranch || branch === opts.base) throw new Exit(EX_USAGE, `on ${branch} itself: commit on a topic branch (bot/<slug>)`);
  const existing = findPull(repo, owner, branch);
  let base = opts.base || (existing ? existing.base.ref : defaultBranch);
  if (base !== defaultBranch) {
    const landed = parentLanded(repo, owner, base);
    if (landed) {
      log(`${base} is ${landed}: retargeting to ${defaultBranch}`);
      rebaseOffParent(base, existing && existing.base.ref === base ? existing.base.sha : null, defaultBranch);
      base = defaultBranch;
    } else if (opts.auto) {
      throw new Exit(
        EX_USAGE,
        `stacked on ${base}${opts.base ? "" : ` (the base of ${existing.html_url})`}, so not enabling auto-merge, which would merge it into ${base} rather than ${defaultBranch}: pass --no-auto`,
      );
    }
  }
  git(["fetch", "--quiet", REMOTE, base], `fetch ${REMOTE}/${base}`);
  const ahead = git(["rev-list", "--count", `${REMOTE}/${base}..HEAD`], "count the commits");
  if (ahead === "0") throw new Exit(EX_USAGE, `${branch} has no commits over ${REMOTE}/${base}`);
  try {
    execFileSync(BOT_GIT, ["check", `${REMOTE}/${base}..HEAD`], { stdio: ["ignore", "inherit", "inherit"] });
  } catch {
    throw new Exit(EX_ERROR, `bot-git check failed; fix the commits first`);
  }
  push(branch);
  const pr = openPull(repo, branch, base, existing, opts);
  if (!opts.auto) {
    trackOnBoard(pr);
    if (opts.review) requestReview(repo, pr, git(["rev-parse", "HEAD"], "read HEAD"));
    console.log(pr.html_url);
    return;
  }
  // One that waits for their approval must not merge before it: their
  // review is requested, or they asked for changes (GitHub then drops the
  // request). Most never see their review, and those auto-merge.
  const why = (pr.requested_reviewers || []).some((u) => u.login === OPERATOR)
    ? "waits for"
    : decision(repo, pr)?.state === "CHANGES_REQUESTED"
      ? "has changes requested in"
      : null;
  if (why) {
    throw new Exit(
      EX_USAGE,
      `${pr.html_url} ${why} ${OPERATOR_S} review, so not enabling auto-merge: re-push it with --no-auto, and enable auto-merge only once they approved it`,
    );
  }
  run("gh", ["pr", "merge", String(pr.number), "--repo", repo, "--auto", "--rebase"], "enable auto-merge");
  if (!opts.wait) {
    console.log(pr.html_url);
    return;
  }
  const checks = requiredChecks(repo, base);
  const deadline = Date.now() + opts.timeout * 60 * 1000;
  for (;;) {
    const cur = ghJSON([`repos/${repo}/pulls/${pr.number}`], `read ${pr.html_url}`);
    if (cur.merged) {
      log(`merged ${pr.html_url}`);
      git(["fetch", "--quiet", REMOTE, base], `fetch ${REMOTE}/${base}`);
      fastForwardShared(base);
      console.log(pr.html_url);
      return;
    }
    if (cur.state === "closed") throw new Exit(EX_FAILED, `${pr.html_url} was closed without merging`);
    // Only this head's runs count: a rebase cancels the previous one's.
    const head = git(["rev-parse", "HEAD"], "read HEAD");
    const failed = cur.head.sha === head ? checkFailed(repo, head, checks) : null;
    if (failed) throw new Exit(EX_FAILED, `a required check failed on ${pr.html_url}: ${failed}`);
    // Behind main: auto-merge waits for the branch to be up to date.
    if (cur.mergeable_state === "behind") rebaseIfBehind(branch, base);
    if (Date.now() > deadline) throw new Exit(EX_TIMEOUT, `${pr.html_url} is still open after ${opts.timeout} minutes`);
    sleep(POLL_SECONDS);
  }
}

try {
  main();
} catch (e) {
  if (!(e instanceof Exit)) throw e;
  process.stderr.write(`${PROG}: ${e.message}\n`);
  process.exit(e.status);
}
