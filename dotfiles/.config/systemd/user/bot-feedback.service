# Report new reactions on cgwalters-bot's GitHub content and file a
# Workstream board item for each new 👎 or 😕. See 'bot-feedback --help'.
[Unit]
Description=Surface reactions on cgwalters-bot content
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# gh must be authenticated as cgwalters-bot: either 'gh auth login', or
# GH_TOKEN=... in this optional file.
EnvironmentFile=-%h/.config/bot-feedback.env
ExecStart=%h/.local/bin/bot-feedback --board
